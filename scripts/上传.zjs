{"repeatCount":-1,"pauseOnFail":true,"count":1,"minVerCode":2015000,"minVerName":"2.15.0","screenWidth":720,"screenHeight":1280,"screenDpi":2,"lastSaveScreenWidth":720,"lastSaveScreenHeight":1280,"lastSaveScreenDpi":2,"savedVerCode":26000050,"savedVerName":"26.5.0","description":""}
{"type":"运行JS代码","delayUnit":1,"jsCode":"(function () {\n\n    var OWNER = \"YYsakura-mm\";\n    var REPO = \"yysakura\";\n    var BRANCH = \"main\";\n\n    \/\/ GitHub上保存的文件名\n    var REPO_PATH = \"sync-test.txt\";\n\n    \/\/ 本地测试文件\n    var LOCAL_PATH = \"\/storage\/emulated\/0\/Download\/github-sync-test.txt\";\n\n    \/\/ -------------------------\n    \/\/ 读取本机保存的Token\n    \/\/ -------------------------\n    var token = zdjl.getStorage(\"github_token\", \"github-sync\");\n\n    \/\/ 第一次运行时让你手动输入\n    if (!token) {\n        token = zdjl.prompt(\n            \"第一次运行，请粘贴 GitHub Token\",\n            \"\"\n        );\n\n        if (!token) {\n            zdjl.alert(\"没有填写 Token，停止上传\");\n            return;\n        }\n\n        token = String(token).trim();\n\n        \/\/ Token只保存在自动精灵本机\n        zdjl.setStorage(\n            \"github_token\",\n            token,\n            \"github-sync\"\n        );\n    }\n\n    try {\n\n        \/\/ -------------------------\n        \/\/ 创建一个测试文件\n        \/\/ -------------------------\n        var testText =\n            \"GitHub同步测试成功\\n\" +\n            \"时间：\" + new Date().toLocaleString() + \"\\n\" +\n            \"设备：自动精灵\\n\";\n\n        zdjl.writeFile(\n            LOCAL_PATH,\n            testText\n        );\n\n        \/\/ -------------------------\n        \/\/ 直接用BASE64读取\n        \/\/ -------------------------\n        var base64Content = zdjl.readFile(\n            LOCAL_PATH,\n            {\n                encode: \"BASE64\"\n            }\n        );\n\n        var apiUrl =\n            \"https:\/\/api.github.com\/repos\/\" +\n            OWNER + \"\/\" +\n            REPO +\n            \"\/contents\/\" +\n            REPO_PATH;\n\n        var headers = [\n            {\n                \"Authorization\": \"Bearer \" + token\n            },\n            {\n                \"Accept\": \"application\/vnd.github+json\"\n            },\n            {\n                \"X-GitHub-Api-Version\": \"2022-11-28\"\n            }\n        ];\n\n        \/\/ -------------------------\n        \/\/ 先查文件是否已经存在\n        \/\/ 如果存在就取SHA\n        \/\/ -------------------------\n        var checkResult = zdjl.requestUrl({\n            url: apiUrl + \"?ref=\" + BRANCH,\n            method: \"GET\",\n            headers: headers,\n            timeout: 15000\n        });\n\n        var sha = null;\n\n        if (checkResult.code === 200) {\n\n            var info = JSON.parse(checkResult.body);\n\n            sha = info.sha;\n\n        } else if (checkResult.code === 404) {\n\n            \/\/ 第一次上传，没有SHA，正常\n\n        } else {\n\n            zdjl.alert(\n                \"查询GitHub失败\\n\\n\" +\n                \"HTTP：\" + checkResult.code + \"\\n\\n\" +\n                checkResult.body\n            );\n\n            return;\n        }\n\n        \/\/ -------------------------\n        \/\/ 创建上传数据\n        \/\/ -------------------------\n        var data = {\n            message: \"自动精灵同步测试\",\n            content: String(base64Content),\n            branch: BRANCH\n        };\n\n        \/\/ 文件已经存在时必须带SHA\n        if (sha) {\n            data.sha = sha;\n        }\n\n        \/\/ -------------------------\n        \/\/ PUT上传\n        \/\/ -------------------------\n        var uploadResult = zdjl.requestUrl({\n\n            url: apiUrl,\n\n            method: \"PUT\",\n\n            headers: [\n                {\n                    \"Authorization\": \"Bearer \" + token\n                },\n                {\n                    \"Accept\": \"application\/vnd.github+json\"\n                },\n                {\n                    \"X-GitHub-Api-Version\": \"2022-11-28\"\n                },\n                {\n                    \"Content-Type\": \"application\/json\"\n                }\n            ],\n\n            requestBody: JSON.stringify(data),\n\n            timeout: 20000\n        });\n\n        if (\n            uploadResult.code === 200 ||\n            uploadResult.code === 201\n        ) {\n\n            zdjl.alert(\n                \"GitHub上传成功\\n\\n\" +\n                \"文件：\" + REPO_PATH + \"\\n\" +\n                \"HTTP：\" + uploadResult.code\n            );\n\n        } else {\n\n            zdjl.alert(\n                \"GitHub上传失败\\n\\n\" +\n                \"HTTP：\" + uploadResult.code + \"\\n\\n\" +\n                uploadResult.body\n            );\n        }\n\n    } catch (e) {\n\n        zdjl.alert(\n            \"执行异常\\n\\n\" +\n            String(e)\n        );\n\n    }\n\n})();"}

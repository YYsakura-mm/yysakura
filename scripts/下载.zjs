{"type":"运行JS代码","delayUnit":1,"jsCode":"(function () {\n\n    var API_URL =\n        \"https:\/\/api.github.com\/repos\/\" +\n        \"YYsakura-mm\/yysakura\/contents\/sync-test.txt\";\n\n    var SAVE_PATH =\n        \"\/storage\/emulated\/0\/Download\/github-sync-downloaded.txt\";\n\n    try {\n\n        var result = zdjl.requestUrl({\n\n            url: API_URL,\n\n            method: \"GET\",\n\n            headers: [\n                {\n                    \"Accept\": \"application\/vnd.github.raw+json\"\n                },\n                {\n                    \"X-GitHub-Api-Version\": \"2022-11-28\"\n                }\n            ],\n\n            timeout: 15000\n        });\n\n        if (result.code !== 200) {\n\n            zdjl.alert(\n                \"下载失败\\n\\n\" +\n                \"HTTP：\" + result.code + \"\\n\\n\" +\n                result.body\n            );\n\n            return;\n        }\n\n        zdjl.writeFile(\n            SAVE_PATH,\n            result.body\n        );\n\n        zdjl.alert(\n            \"GitHub下载成功\\n\\n\" +\n            \"保存位置：\\n\" +\n            SAVE_PATH +\n            \"\\n\\n\" +\n            \"文件内容：\\n\" +\n            result.body\n        );\n\n    } catch (e) {\n\n        zdjl.alert(\n            \"下载异常\\n\\n\" +\n            String(e)\n        );\n\n    }\n\n})();"}

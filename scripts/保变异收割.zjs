{"repeatCount":-1,"pauseOnFail":false,"count":113,"minVerCode":2026000,"minVerName":"2.26.0","screenWidth":720,"screenHeight":1280,"screenDpi":2,"lastSaveScreenWidth":1280,"lastSaveScreenHeight":720,"lastSaveScreenDpi":2,"savedVerCode":26000050,"savedVerName":"26.5.0","description":"保变异收割｜第三方OCR保留｜流程胶水原生化｜两格预检+五种白名单｜非白名单一键收获","delay":"0.2","delayUnit":1,"globalCallbacks":{},"desc":"保变异收割V5｜白名单成熟直通24田；非白名单\/未知分流挪至末尾；OCR\/线路不变"}
{"type":"运行JS代码","delay":"0","delayUnit":1,"repeatCount":1,"desc":"本区开始：仅保留自己农场OCR锁定\/初始化兜底","jsCode":"\/\/ 每个账号只在第一次真正执行收割时 OCR 一次“自己农场状态原文”。\n\/\/ 直接复用已经稳定工作的“查看状态”同一块 植物状态 screen_area + medium SGOCR。\n\/\/ 不再把坐标字符串直接传给 ocrText，避免字符串被 SDK 当成 Base64 图片。\ntry{\n    var locked=String(zdjl.getVar(\"自己农场OCR已锁定\",\"global\")||\"否\");\n    var __runMark=String(zdjl.getVar(\"HUD启动时间\",\"global\")||\"\");\n    var __accountMark=String(zdjl.getVar(\"当前第几个号\",\"global\")||\"\")+\"|\"+String(zdjl.getVar(\"HUD当前账号\",\"global\")||\"\");\n    var __lockMark=String(zdjl.getVar(\"自己农场OCR锁定标记\",\"global\")||\"\");\n    var __wantMark=__runMark+\"|\"+__accountMark;\n    if(__lockMark!==__wantMark) locked=\"否\";\n    if(locked!=\"是\"){\n        var ocrFn=null;\n        var farmArea=null;\n\n        \/\/ 先取现成的全局OCR函数与“植物状态”区域。\n        try{ ocrFn=zdjl.getVar(\"ocrText\",\"global\"); }catch(__getOcrErr){}\n        try{ farmArea=zdjl.getVar(\"植物状态\",\"global\"); }catch(__getAreaErr){}\n        \/\/ 某些引擎会把全局变量直接注入同名JS符号，再给一层兼容兜底。\n        if(typeof ocrFn!=\"function\"){\n            try{ if(typeof ocrText==\"function\") ocrFn=ocrText; }catch(__directOcrErr){}\n        }\n        if(!farmArea){\n            try{ if(typeof 植物状态!=\"undefined\") farmArea=植物状态; }catch(__directAreaErr){}\n        }\n\n        \/\/ OCR函数或区域缺失时，先补跑正式初始化，再重新取得两者。\n        if(typeof ocrFn!=\"function\" || !farmArea){\n            try{\n                zdjl.runAction({\n                    \"type\":\"执行脚本\",\"delay\":\"0\",\"delayUnit\":1,\"repeatCount\":1,\n                    \"desc\":\"自己农场OCR前补初始化\",\"filePath\":\"初始化OCR.zjs\",\n                    \"runArgs\":\"\",\"continueCurrentAfterFinish\":true,\"useCurrentGestureMatrix\":false\n                });\n            }catch(__initOcrErr){}\n            try{ ocrFn=zdjl.getVar(\"ocrText\",\"global\"); }catch(__getOcrErr2){}\n            try{ farmArea=zdjl.getVar(\"植物状态\",\"global\"); }catch(__getAreaErr2){}\n            if(typeof ocrFn!=\"function\"){\n                try{ if(typeof ocrText==\"function\") ocrFn=ocrText; }catch(__directOcrErr2){}\n            }\n            if(!farmArea){\n                try{ if(typeof 植物状态!=\"undefined\") farmArea=植物状态; }catch(__directAreaErr2){}\n            }\n        }\n\n        var raw=\"\";\n        if(typeof ocrFn==\"function\" && farmArea){\n            \/\/ 最多三次。整块植物状态正常会包含“昵称的农场\/等级\/作物\/成熟”等多行文字；\n            \/\/ 只有极短结果（例如单独“农场”）不锁定，避免错误身份污染后续所有区。\n            for(var __i=0;__i<3;__i++){\n                try{ raw=String(ocrFn(farmArea,\"medium\")||\"\"); }\n                catch(__farmOcrErr){ raw=\"\"; }\n                raw=raw.replace(\/\\r\\n?\/g,\"\\n\").trim();\n                if(raw.replace(\/\\s\/g,\"\").length>=4) break;\n                if(__i<2){ try{ zdjl.sleep(300); }catch(__retrySleepErr){} }\n            }\n        }\n\n        zdjl.setVar(\"自己农场OCR原文\",raw,\"global\");\n        if(raw.replace(\/\\s\/g,\"\").length>=4){\n            zdjl.setVar(\"自己农场OCR已锁定\",\"是\",\"global\");\n            zdjl.setVar(\"自己农场OCR锁定标记\",__wantMark,\"global\");\n            try{ zdjl.toast(\"收割身份OCR√\",1200); }catch(__ocrToastErr){}\n        }else{\n            \/\/ 本区识别失败不锁死，下一区仍会再试。\n            zdjl.setVar(\"自己农场OCR已锁定\",\"否\",\"global\");\n            zdjl.setVar(\"自己农场OCR锁定标记\",\"\",\"global\");\n            try{ zdjl.toast(\"收割身份OCR×｜下区重试\",1500); }catch(__ocrFailToastErr){}\n        }\n    }\n}catch(__farmOcrOuterErr){\n    try{ zdjl.setVar(\"自己农场OCR已锁定\",\"否\",\"global\"); }catch(__farmOcrSetErr){}\n}"}
{"type":"设置变量","delay":"0","delayUnit":1,"desc":"本区开始：原生清空收割统计与两格预检状态","vars":[{"name":"收割扫描序号","value":{"varType":"number","varScope":"global","showInputInObjectSubVar":false,"mustInput":false,"showInputContentAlign":"left","number":0}},{"name":"变异本区记录","value":{"varType":"string","varScope":"global","showInputInObjectSubVar":false,"mustInput":false,"showInputContentAlign":"left","value":""}},{"name":"变异本区数量","value":{"varType":"number","varScope":"global","showInputInObjectSubVar":false,"mustInput":false,"showInputContentAlign":"left","number":0}},{"name":"收割预检未成熟","value":{"varType":"string","varScope":"global","showInputInObjectSubVar":false,"mustInput":false,"showInputContentAlign":"left","value":"否"}},{"name":"收割预检植物结论","value":{"varType":"string","varScope":"global","showInputInObjectSubVar":false,"mustInput":false,"showInputContentAlign":"left","value":"未知"}},{"name":"收割预检植物","value":{"varType":"string","varScope":"global","showInputInObjectSubVar":false,"mustInput":false,"showInputContentAlign":"left","value":""}},{"name":"收割预检状态1","value":{"varType":"string","varScope":"global","showInputInObjectSubVar":false,"mustInput":false,"showInputContentAlign":"left","value":""}},{"name":"收割预检状态2","value":{"varType":"string","varScope":"global","showInputInObjectSubVar":false,"mustInput":false,"showInputContentAlign":"left","value":""}},{"name":"收割预检名称1","value":{"varType":"string","varScope":"global","showInputInObjectSubVar":false,"mustInput":false,"showInputContentAlign":"left","value":""}},{"name":"收割预检名称2","value":{"varType":"string","varScope":"global","showInputInObjectSubVar":false,"mustInput":false,"showInputContentAlign":"left","value":""}},{"name":"收割预检成熟结论","value":{"varType":"string","varScope":"global","showInputInObjectSubVar":false,"mustInput":false,"showInputContentAlign":"left","value":"未知"}}]}

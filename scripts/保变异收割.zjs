{"type":"滑动","duration":"750","delayUnit":1,"desc":"收割预检｜第2格","startPos":{"type":"location","x":"25%","y":"75%"},"endPos":{"type":"location","x":"5%","y":"75%"}}
{"type":"运行JS代码","delay":"0","delayUnit":1,"repeatCount":1,"desc":"预检2：直接调用第三方SGOCR，重试与显示原文（对照10月5日稳定用法）","jsCode":"(function(){\nfunction N(v){return String(v==null?\"\":v).replace(\/\\r\\n?\/g,\"\\n\").trim();}\nfunction G(k,d){try{var v=zdjl.getVar(k,\"global\");return v==null?d:v;}catch(e){return d;}}\nfunction S(k,v){try{zdjl.setVar(k,v,\"global\");}catch(e){}}\nfunction R(area){\n  var fn=null,raw=\"\";\n  try{fn=zdjl.getVar(\"ocrText\",\"global\");}catch(e){}\n  if(typeof fn!=\"function\"){\n    try{if(typeof ocrText===\"function\")fn=ocrText;}catch(e){}\n  }\n  if(typeof fn!=\"function\"||!area)return \"\";\n  for(var i=0;i<3;i++){\n    try{raw=N(fn(area,\"medium\"));}catch(e){raw=\"\";}\n    if(raw.replace(\/\\s\/g,\"\").length>=2)break;\n    if(i<2)try{zdjl.sleep(220);}catch(e){}\n  }\n  return raw;\n}\nvar k=2,farm=G(\"植物状态\",null),nameArea=null;\ntry{nameArea=收割预检名称区域;}catch(e){}\nif(!nameArea)try{nameArea=zdjl.getVar(\"收割预检名称区域\",\"script\");}catch(e){}\nvar st=R(farm),nm=R(nameArea);\nS(\"收割预检状态\"+k,st);\nS(\"收割预检名称\"+k,nm);\ntry{zdjl.toast(\"预检\"+k+\"｜状态:\"+(st?st.replace(\/\\s+\/g,\" \").slice(0,48):\"OCR空\")+\"｜植物:\"+(nm?nm.replace(\/\\s+\/g,\" \").slice(0,18):\"OCR空\"),1900);}catch(e){}\n})();"}
{"type":"运行JS代码","delay":"0","delayUnit":1,"repeatCount":1,"desc":"收割两格综合判定：仅五种白名单+明确成熟可走24田；保存OCR原文","jsCode":"(function(){\nfunction G(k,d){try{var v=zdjl.getVar(k,\"global\");return v==null?d:v;}catch(e){return d;}}\nfunction S(k,v){try{zdjl.setVar(k,v,\"global\");}catch(e){}}\nfunction N(v){return String(v==null?\"\":v).replace(\/\\r\\n?\/g,\"\\n\").trim();}\nfunction C(v){var s=N(v).replace(\/\\s+\/g,\"\").replace(\/[0-9０-９]\/g,\"\").replace(\/(?:Lv|LV|lv|等级|级)\/g,\"\");var m=s.match(\/[\\u4e00-\\u9fff]{2,6}\/g);return m?m.join(\"\"):\"\";}\nvar variants=[\n  [\"樱桃\",[\"樱桃\",\"樱挑\",\"櫻桃\",\"樱祧\"]],\n  [\"灯笼果\",[\"灯笼果\",\"灯龙果\",\"灯笼杲\",\"燈籠果\"]],\n  [\"莲花\",[\"莲花\",\"连花\",\"蓮花\"]],\n  [\"枇杷\",[\"枇杷\",\"枇把\",\"批杷\",\"枇粑\"]],\n  [\"牛油果\",[\"牛油果\",\"牛油杲\"]]\n];\nfunction W(s){s=C(s);for(var i=0;i<variants.length;i++)for(var j=0;j<variants[i][1].length;j++)if(s.indexOf(variants[i][1][j])>=0)return variants[i][0];return \"\";}\nfunction D(a,b){if(!a||!b)return 99;if(a===b)return 0;if(Math.abs(a.length-b.length)>1)return 99;var p=[],i,j;for(i=0;i<=a.length;i++)p[i]=[i];for(j=1;j<=b.length;j++)p[0][j]=j;for(i=1;i<=a.length;i++)for(j=1;j<=b.length;j++)p[i][j]=Math.min(p[i-1][j]+1,p[i][j-1]+1,p[i-1][j-1]+(a.charAt(i-1)===b.charAt(j-1)?0:1));return p[a.length][b.length];}\nfunction nearWhitelist(s){s=C(s);if(s.length<2||s.length>5)return false;for(var i=0;i<variants.length;i++)for(var j=0;j<variants[i][1].length;j++)if(D(s,variants[i][1][j])<=1)return true;return false;}\nfunction Status(v){\n  var s=N(v).replace(\/\\s+\/g,\"\");\n  if(!s)return \"未知\";\n  \/\/ A countdown until ripening is decisive, even if an OCR fragment elsewhere says ripe.\n  if(\/(?:后|あと)(?:才)?成[熟热]\/.test(s)||\/未成熟|尚未成熟|暂未成熟|正在生长\/.test(s)||\/(?:\\d+|[一二三四五六七八九十半]+)(?:天|小时|时|分钟|分|秒).*?后?成[熟热]\/.test(s))return \"未成熟\";\n  \/\/ Mature status sometimes coexists with a post-maturity dehydration timer.\n  if(\/已成[熟热]|已经成[熟热]|成熟了|成熟啦|完全成熟|可收获|可以收获|可收割|可以收割|立即收获|立即收割\/.test(s)||\/(?:^|[|｜。；;\\n])成熟(?:$|[|｜。；;\\n])\/.test(N(v)))return \"成熟\";\n  \/\/ Dehydration without any maturity evidence is not proof of maturity.\n  if(\/后干[涸固]\/.test(s)||\/(?:\\d+|[一二三四五六七八九十半]+)(?:天|小时|时|分钟|分|秒).*?干[涸固]\/.test(s))return \"未成熟\";\n  return \"未知\";\n}\nvar st1=N(G(\"收割预检状态1\",\"\")),st2=N(G(\"收割预检状态2\",\"\"));\nvar raw1=N(G(\"收割预检名称1\",\"\")),raw2=N(G(\"收割预检名称2\",\"\"));\n\/\/ On some devices the small name area OCR misses, while the full crop status card still includes the name.\nvar n1=C(raw1),n2=C(raw2),w1=W(raw1)||W(st1),w2=W(raw2)||W(st2);\nvar plant=\"未知\",p=\"\";\nif(w1||w2){plant=\"白名单\";p=w1||w2;}\nelse if(n1&&n2&&D(n1,n2)<=1&&!nearWhitelist(n1)&&!nearWhitelist(n2)) {plant=\"非白名单\";p=n1===n2?n1:n1+\"\/\"+n2;}\nvar m1=Status(st1),m2=Status(st2),m=\"未知\";\nif(m1===\"未成熟\"||m2===\"未成熟\")m=\"未成熟\";\nelse if(m1===\"成熟\"||m2===\"成熟\")m=\"成熟\";\nS(\"收割预检植物结论\",plant);S(\"收割预检植物\",p);\nS(\"收割预检成熟结论\",m);S(\"收割预检未成熟\",m===\"未成熟\"?\"是\":\"否\");\nvar verdict=(plant===\"白名单\"&&m===\"成熟\")?\"进入24田\":(plant===\"非白名单\"?\"其他作物→一键收获\":\"不开一键收获→浇水\");\ntry{zdjl.toast(\"收割预检｜\"+plant+(p?\"(\"+p+\")\":\"\")+\"｜\"+m+\"｜\"+verdict,2200);}catch(e){}\n\/\/ Local diagnostic: retain the latest 12 scans for troubleshooting without guessing UI wording.\ntry{\n var path=\"\/sdcard\/Download\/收割预检诊断.txt\",prev=\"\";\n try{prev=String(zdjl.readFile(path)||\"\");}catch(e){}\n var entry=\"\\n==== \"+(new Date()).toISOString()+\" ====\"+\n \"\\n名称1=\"+raw1+\"\\n状态1=\"+st1+\"\\n名称2=\"+raw2+\"\\n状态2=\"+st2+\n \"\\n结论=\"+plant+\"\/\"+m+\"，处理=\"+verdict+\"\\n\";\n zdjl.writeFile(path,(prev+entry).slice(-12000));\n}catch(e){}\n})();"}
{"type":"控制执行","delay":"0","delayUnit":1,"desc":"第一格通过或第二格复核完成：统一进入复位与分流","jumpId":"预检已通过或已完成","controlRunType":"waitDelay","jumpToPosition":"","ContinueParentExecute":false}
{"type":"点击","delay":"0.5","delayUnit":1,"repeatCount":2,"desc":"收割预检完成后复位","scriptCallbacks":{"afterExecFinish":{"type":"运行JS代码","delay":"0","delayUnit":1,"repeatCount":1,"desc":"收割流程定位V3-20261010：预检结束复位→读取实际全局判定","jsCode":"(function(){\nvar pre=\"收割流程定位V3-20261010\",stage=\"预检结束复位→读取实际全局判定\", t=new Date().toISOString();\nfunction G(k){try{return String(zdjl.getVar(k,\"global\")||\"\");}catch(e){return \"读取失败:\"+String(e);}}\nvar p=G(\"收割预检植物结论\"),m=G(\"收割预检成熟结论\"),n=G(\"收割预检植物\"),\n ok=(p===\"白名单\"&&m===\"成熟\"),mark=\"植物=\"+p+\"(\"+n+\") 成熟=\"+m+\" 24田资格=\"+(ok?\"通过\":\"拒绝\");\ntry{var fn=\"\/sdcard\/Download\/收割预检诊断.txt\",old=\"\";try{old=String(zdjl.readFile(fn)||\"\");}catch(e){}\nzdjl.writeFile(fn,(old+\"\\n\"+pre+\" | \"+t+\" | \"+stage+\" | \"+mark).slice(-20000));}catch(e){}\ntry{zdjl.toast(stage+\" | \"+(ok?\"24田资格通过\":\"资格不通过\")+\" | \"+p+\"\/\"+m,2000);}catch(e){}\n})();"}},"posData":{"type":"location","x":"92.7%","y":"90.8%"}}
{"type":"运行JS代码","delay":"0","delayUnit":1,"repeatCount":1,"desc":"收割V4｜完成复位，准备分流到24田","jsCode":"(function(){\nvar s=\"完成复位，准备分流到24田\";\nfunction G(k){try{return String(zdjl.getVar(k,\"global\")||\"\");}catch(e){return \"[读取失败]\";}}\nvar t=(new Date()).toISOString(),mark=\"植物=\"+G(\"收割预检植物结论\")+\" 成熟=\"+G(\"收割预检成熟结论\")+\" 名称=\"+G(\"收割预检植物\");\ntry{var p=\"\/sdcard\/Download\/收割预检诊断.txt\",o=\"\";try{o=String(zdjl.readFile(p)||\"\");}catch(e){}\nzdjl.writeFile(p,(o+\"\\n收割V4-20261010 | \"+t+\" | \"+s+\" | \"+mark).slice(-25000));}catch(e){}\n\n})();"}

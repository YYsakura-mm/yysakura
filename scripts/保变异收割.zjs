{"type":"滑动","duration":"750","delayUnit":1,"desc":"收割预检｜第2格","startPos":{"type":"location","x":"25%","y":"75%"},"endPos":{"type":"location","x":"5%","y":"75%"}}
{"type":"运行JS代码","delay":"0","delayUnit":1,"repeatCount":1,"desc":"预检2：直接调用第三方SGOCR，重试与显示原文（对照10月5日稳定用法）","jsCode":"(function(){\nfunction N(v){return String(v==null?\"\":v).replace(\/\\r\\n?\/g,\"\\n\").trim();}\nfunction G(k,d){try{var v=zdjl.getVar(k,\"global\");return v==null?d:v;}catch(e){return d;}}\nfunction S(k,v){try{zdjl.setVar(k,v,\"global\");}catch(e){}}\nfunction R(area){\n  var fn=null,raw=\"\";\n  try{fn=zdjl.getVar(\"ocrText\",\"global\");}catch(e){}\n  if(typeof fn!=\"function\"){\n    try{if(typeof ocrText===\"function\")fn=ocrText;}catch(e){}\n  }\n  if(typeof fn!=\"function\"||!area)return \"\";\n  for(var i=0;i<3;i++){\n    try{raw=N(fn(area,\"medium\"));}catch(e){raw=\"\";}\n    if(raw.replace(\/\\s\/g,\"\").length>=2)break;\n    if(i<2)try{zdjl.sleep(220);}catch(e){}\n  }\n  return raw;\n}\nvar k=2,farm=G(\"植物状态\",null),nameArea=null;\ntry{nameArea=收割预检名称区域;}catch(e){}\nif(!nameArea)try{nameArea=zdjl.getVar(\"收割预检名称区域\",\"script\");}catch(e){}\nvar st=R(farm),nm=R(nameArea);\nS(\"收割预检状态\"+k,st);\nS(\"收割预检名称\"+k,nm);\ntry{zdjl.toast(\"预检\"+k+\"｜状态:\"+(st?st.replace(\/\\s+\/g,\" \").slice(0,48):\"OCR空\")+\"｜植物:\"+(nm?nm.replace(\/\\s+\/g,\" \").slice(0,18):\"OCR空\"),1900);}catch(e){}\n})();"}
{"type":"运行JS代码","delay":"0","delayUnit":1,"repeatCount":1,"desc":"第2格主导全田状态｜成熟+白名单进24田；其他成熟快捷；未成熟\/未知只浇水","jsCode":"(function(){\nfunction G(k,d){try{var v=zdjl.getVar(k,\"global\");return v==null?d:v;}catch(e){return d;}}\nfunction S(k,v){try{zdjl.setVar(k,v,\"global\");}catch(e){}}\nfunction N(v){return String(v==null?\"\":v).replace(\/\\r\\n?\/g,\"\\n\").trim();}\nfunction C(v){var s=N(v).replace(\/\\s+\/g,\"\").replace(\/[0-9０-９]\/g,\"\").replace(\/(?:Lv|LV|lv|等级|级)\/g,\"\");var m=s.match(\/[\\u4e00-\\u9fff]{2,6}\/g);return m?m.join(\"\"):\"\";}\nvar variants=[\n  [\"枇杷\",[\"枇杷\",\"枇把\",\"批杷\",\"枇粑\"]],\n  [\"牛油果\",[\"牛油果\",\"牛油杲\"]],\n  [\"百合\",[\"百合\",\"白合\"]],\n  [\"麒麟果\",[\"麒麟果\",\"麒麟杲\"]],\n  [\"无花果\",[\"无花果\",\"无花杲\",\"無花果\"]],\n  [\"五指毛桃\",[\"五指毛桃\",\"五指毛挑\"]]\n];\nfunction W(s){s=C(s);for(var i=0;i<variants.length;i++)for(var j=0;j<variants[i][1].length;j++)if(s.indexOf(variants[i][1][j])>=0)return variants[i][0];return \"\";}\nfunction D(a,b){if(!a||!b)return 99;if(a===b)return 0;if(Math.abs(a.length-b.length)>1)return 99;var p=[],i,j;for(i=0;i<=a.length;i++)p[i]=[i];for(j=1;j<=b.length;j++)p[0][j]=j;for(i=1;i<=a.length;i++)for(j=1;j<=b.length;j++)p[i][j]=Math.min(p[i-1][j]+1,p[i][j-1]+1,p[i-1][j-1]+(a.charAt(i-1)===b.charAt(j-1)?0:1));return p[a.length][b.length];}\nfunction nearWhitelist(s){s=C(s);if(s.length<2||s.length>5)return false;for(var i=0;i<variants.length;i++)for(var j=0;j<variants[i][1].length;j++)if(D(s,variants[i][1][j])<=1)return true;return false;}\nfunction Status(v){\n  var s=N(v).replace(\/\\s+\/g,\"\");\n  if(!s)return \"未知\";\n  \/\/ A countdown until ripening is decisive, even if an OCR fragment elsewhere says ripe.\n  if(\/(?:后|あと)(?:才)?成[熟热]\/.test(s)||\/未成熟|尚未成熟|暂未成熟|正在生长\/.test(s)||\/(?:\\d+|[一二三四五六七八九十半]+)(?:天|小时|时|分钟|分|秒).*?后?成[熟热]\/.test(s))return \"未成熟\";\n  \/\/ 用户实测规则：只要出现多久后干涸，直接判未成熟。\n  if(\/后干[涸固]\/.test(s)||\/(?:\\d+|[一二三四五六七八九十半]+)(?:天|小时|时|分钟|分|秒).*?干[涸固]\/.test(s))return \"未成熟\";\n  \/\/ Mature status sometimes coexists with a post-maturity dehydration timer.\n  if(\/已成[熟热]|已经成[熟热]|成熟了|成熟啦|完全成熟|可收获|可以收获|可收割|可以收割|立即收获|立即收割\/.test(s)||\/(?:^|[|｜。；;\\n])成熟(?:$|[|｜。；;\\n])\/.test(N(v)))return \"成熟\";\n  return \"未知\";\n}\nvar st1=N(G(\"收割预检状态1\",\"\")),st2=N(G(\"收割预检状态2\",\"\"));\nvar raw1=N(G(\"收割预检名称1\",\"\")),raw2=N(G(\"收割预检名称2\",\"\"));\nvar n1=C(raw1),n2=C(raw2),w1=W(raw1)||W(st1),w2=W(raw2)||W(st2);\nvar m1=Status(st1),m2=Status(st2),plant=\"未知\",p=\"\",m=m2,start=0;\n\/\/ 第二格是整轮田地的代表：未成熟\/看不懂 -> 只浇水，不能被第一格残留成熟作物覆盖。\nif(m2===\"未成熟\") {plant=\"未知\";p=n2||n1;m=\"未成熟\";}\nelse if(m2===\"未知\") {plant=\"未知\";p=n2||\"\";m=\"未知\";}\nelse if(w2 && m2===\"成熟\") {plant=\"白名单\";p=w2;start=2;}\nelse if(m2===\"成熟\" && ((\/灯笼果\/.test(raw2)||\/灯笼果\/.test(st2)) || (n2&&!nearWhitelist(n2)&&!w2))) {\n  plant=\"非白名单\";p=\/灯笼果\/.test(raw2+st2)?\"灯笼果\":n2;\n}\n\/\/ 第2格植物名字空白时，不凭第一格单独放行，避免上一轮金色残留造成误收。\nS(\"收割预检植物结论\",plant);S(\"收割预检植物\",p);\nS(\"收割预检成熟结论\",m);\nS(\"收割预检起始格\",start);\ntry{zdjl.toast(\"双格判定｜第1:\"+(n1||\"未知\")+\"(\"+m1+\") \/ 第2:\"+(n2||\"未知\")+\"(\"+m2+\")｜\"+plant+\"｜\"+m,2100);}catch(e){}\ntry{var path=\"\/sdcard\/Download\/收割预检诊断.txt\",prev=\"\";try{prev=String(zdjl.readFile(path)||\"\");}catch(e){}\nzdjl.writeFile(path,(prev+\"\\n双格判定｜1=\"+raw1+\"\/\"+st1+\"｜2=\"+raw2+\"\/\"+st2+\"｜结论=\"+plant+\"\/\"+m+\"\\n\").slice(-16000));}catch(e){}\n})();"}

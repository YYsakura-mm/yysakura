{"type":"滑动","duration":"1800","delay":"2.5","delayUnit":1,"condition":{"type":"image","repeatWhenFalse":true,"repeatWhenFalseLimitTimes":20,"repeatWhenFalseRepeatDelay":500,"image":{"type":"image","imageData":{"data":"iVBORw0KGgoAAAANSUhEUgAAABEAAAAQCAYAAADwMZRfAAAAAXNSR0IArs4c6QAAAARzQklUCAgICHwIZIgAAAKtSURBVDiNTZPLUltHEIa\/njPnHN0FAgkh4Ytkh4298M6rZJWXyJtkmwfLMptUJVm4ymUTKGRxkTBEIAmEzmWmszgqitn0VHdXX77qX3797Rft7bV5f9hjb7dBrVqmFIcInnJpRRjmiPDsWeC5Q7A\/\/\/SRbmeHVjMksoXbOcfiPiFLcpr1ABsaBC2CRhAREFMUU0Fmt79rpRSSpnOcy1AgSzLOzr+TLP7jh2GbZqPyVERFMdYgxoIWU9lmo4VIhgnWeG9RVfLcM5ncMD0b06xH1KsVgiDYDA9ogGgIhECANSYHPNZavC9WWS7mHJ+MmF5M2G1V6Xa2adQrz5gEG1v8DZgnRKvVmrPxBf\/89YnLyRWL5YqjkwtOR1Nu7+5xzlPkmw0TAEXUH6vPZ1xdjxh9G\/Pl81e+Hp0xvfNE+ZJyKWQ47DPo7\/Bm2OPFwQGVWnWzXgHW4iJcApPza47\/HTP6NmE2X\/KYNwi8Z\/WQMLqY8fiYgQRst\/aIS4oRMEZQFItbEyD0u31AEDE4PSH\/voRUiatVXuy3GbzcY\/CqSxSHrNMMVcVaizEGi1thBDqdNs3tBttbW9RrNf7482\/ubh2D1z1+\/PiO\/v4utVoZTECa5iwW9wQ2II4iLO7hCVJgDJ32Lodv33A6PgcVPrwb8nbQJ45DADLnubqZcTw6x3sljiMsbg4mhFxJ1itUPY2q5XVvh3JoOOhuUYoEkRwU8izl89Epn76MSNIUCQyW\/BpEQTyhz0GVWphx+KrO\/k7EVk2w8kggBUSXPXB5OeX6Zk6WZaiAxd8AHtXidAAq1vGyY0haDcplQyBpoRcATcjTDHUOFEQViy6KmG6OCDDiKcdKWFKMSfF4RAN0oyBjAFVUPQJYdF1oQi36JHEFBCOg5KhahHDTRBEBxaPegwj\/A\/UeM8rTHq6FAAAAAElFTkSuQmCC","imageWidth":17,"imageHeight":16,"imageLeft":1213,"imageTop":133,"screenWidth":1280,"screenHeight":720,"screenDpi":2},"limitArea":"93.8% 17.2% 96.5% 21%","searchMode":"color_2.21","minSimilarPercent":87,"quickSearch":true,"codeVersion":"V1_7","imageScaleType":"dpi"},"desc":""},"desc":"收割预检｜走入田区","scriptCallbacks":{"afterConditionFail":{"type":"控制执行","delay":"0","delayUnit":1,"desc":"无法进田→复位执行仅浇水（不中止本轮）","controlRunType":"jumpTo","jumpToPosition":":只浇水入口","ContinueParentExecute":false}},"startPos":{"type":"location","x":"20%","y":"75%"},"endPos":{"type":"location","x":"20%","y":"15%"}}
{"type":"滑动","duration":"800","delayUnit":1,"desc":"收割预检｜第1格","startPos":{"type":"location","x":"25%","y":"75%"},"endPos":{"type":"location","x":"5%","y":"75%"}}
{"type":"运行JS代码","delay":"0","delayUnit":1,"repeatCount":1,"desc":"预检1｜首格OCR＋成熟白名单立即放行；否则检查第2格","jsCode":"(function(){\nfunction N(v){return String(v==null?\"\":v).replace(\/\\r\\n?\/g,\"\\n\").trim();}\nfunction G(k,d){try{var v=zdjl.getVar(k,\"global\");return v==null?d:v;}catch(e){return d;}}\nfunction S(k,v){try{zdjl.setVar(k,v,\"global\");}catch(e){}}\nfunction R(area){\n  var fn=null,raw=\"\";\n  try{fn=zdjl.getVar(\"ocrText\",\"global\");}catch(e){}\n  if(typeof fn!=\"function\"){\n    try{if(typeof ocrText===\"function\")fn=ocrText;}catch(e){}\n  }\n  if(typeof fn!=\"function\"||!area)return \"\";\n  for(var i=0;i<3;i++){\n    try{raw=N(fn(area,\"medium\"));}catch(e){raw=\"\";}\n    if(raw.replace(\/\\s\/g,\"\").length>=2)break;\n    if(i<2)try{zdjl.sleep(220);}catch(e){}\n  }\n  return raw;\n}\nvar k=1,farm=G(\"植物状态\",null),nameArea=null;\ntry{nameArea=收割预检名称区域;}catch(e){}\nif(!nameArea)try{nameArea=zdjl.getVar(\"收割预检名称区域\",\"script\");}catch(e){}\nvar st=R(farm),nm=R(nameArea);\nS(\"收割预检状态\"+k,st);\nS(\"收割预检名称\"+k,nm);\n\n\/\/ 首格已成熟且为六种白名单：原地进入收割判定。否则继续查第二格。\nfunction C(v){var s=N(v).replace(\/\\s+\/g,\"\").replace(\/[0-9０-９]\/g,\"\").replace(\/(?:Lv|LV|lv|等级|级)\/g,\"\");var m=s.match(\/[\\u4e00-\\u9fff]{2,6}\/g);return m?m.join(\"\"):\"\";}\nvar variants=[\n  [\"枇杷\",[\"枇杷\",\"枇把\",\"批杷\",\"枇粑\"]],\n  [\"牛油果\",[\"牛油果\",\"牛油杲\"]],\n  [\"百合\",[\"百合\",\"白合\"]],\n  [\"麒麟果\",[\"麒麟果\",\"麒麟杲\"]],\n  [\"无花果\",[\"无花果\",\"无花杲\",\"無花果\"]],\n  [\"五指毛桃\",[\"五指毛桃\",\"五指毛挑\"]]\n];\nfunction W(s){s=C(s);for(var i=0;i<variants.length;i++)for(var j=0;j<variants[i][1].length;j++)if(s.indexOf(variants[i][1][j])>=0)return variants[i][0];return \"\";}\n\nfunction Status(v){\n  var s=N(v).replace(\/\\s+\/g,\"\");\n  if(!s)return \"未知\";\n  \/\/ A countdown until ripening is decisive, even if an OCR fragment elsewhere says ripe.\n  if(\/(?:后|あと)(?:才)?成[熟热]\/.test(s)||\/未成熟|尚未成熟|暂未成熟|正在生长\/.test(s)||\/(?:\\d+|[一二三四五六七八九十半]+)(?:天|小时|时|分钟|分|秒).*?后?成[熟热]\/.test(s))return \"未成熟\";\n  \/\/ 用户实测规则：只要出现多久后干涸，直接判未成熟。\n  if(\/后干[涸固]\/.test(s)||\/(?:\\d+|[一二三四五六七八九十半]+)(?:天|小时|时|分钟|分|秒).*?干[涸固]\/.test(s))return \"未成熟\";\n  \/\/ Mature status sometimes coexists with a post-maturity dehydration timer.\n  if(\/已成[熟热]|已经成[熟热]|成熟了|成熟啦|完全成熟|可收获|可以收获|可收割|可以收割|立即收获|立即收割\/.test(s)||\/(?:^|[|｜。；;\\n])成熟(?:$|[|｜。；;\\n])\/.test(N(v)))return \"成熟\";\n  return \"未知\";\n}\n\nvar __crop=W(nm)||W(st), __ripe=Status(st);\nif(__crop && __ripe===\"成熟\"){\n S(\"收割预检植物结论\",\"白名单\");\n S(\"收割预检植物\",__crop);\n S(\"收割预检成熟结论\",\"成熟\");\n S(\"收割预检起始格\",\"1\");\n}\n\ntry{zdjl.toast(\"预检\"+k+\"｜状态:\"+(st?st.replace(\/\\s+\/g,\" \").slice(0,48):\"OCR空\")+\"｜植物:\"+(nm?nm.replace(\/\\s+\/g,\" \").slice(0,18):\"OCR空\"),1900);}catch(e){}\n})();"}
{"type":"控制执行","delay":"0","delayUnit":1,"condition":{"type":"jsExpression","checkBeforeDelay":true,"expression":"Number(zdjl.getVar(\"收割预检起始格\",\"global\")||0)===1 && String(zdjl.getVar(\"收割预检植物结论\",\"global\")||\"\")===\"白名单\" && String(zdjl.getVar(\"收割预检成熟结论\",\"global\")||\"\")===\"成熟\"","desc":""},"desc":"首格白名单且成熟→当前格立即收割（不走第二格预检）","controlRunType":"jumpTo","jumpToPosition":":逐格入口","ContinueParentExecute":false}

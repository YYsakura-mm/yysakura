{"type":"运行JS代码","delay":"0","delayUnit":1,"repeatCount":1,"desc":"收割预检｜第2格OCR成熟状态+植物名称","jsCode":"function N(v){return String(v==null?\"\":v).replace(/\\r\\n?/g,\"\\n\").trim();}\nfunction R(area){\n    var fn=null;try{fn=zdjl.getVar(\"ocrText\",\"global\");}catch(e){}\n    if(typeof fn!=\"function\")return \"\";\n    var out=\"\";\n    for(var i=0;i<2;i++){\n        try{out=N(fn(area,\"medium\"));}catch(e2){out=\"\";}\n        if(out.replace(/\\s/g,\"\").length>=2)break;\n        try{zdjl.sleep(180);}catch(e3){}\n    }\n    return out;\n}\nfunction U(v){\n    var s=N(v).replace(/\\s+/g,\"\");\n    if(!s)return false;\n    if(/后成[熟热]/.test(s)||/后干[涸固]/.test(s))return true;\n    if(/(?:\\d+|[一二三四五六七八九十半]+)(?:天|小时|时|分钟|分|秒).*?(?:成[熟热]|干[涸固])/.test(s))return true;\n    if(/(?:成[熟热]|干[涸固]).*?\\d{1,2}[:：]\\d{2}/.test(s))return true;\n    if(/\\d{1,2}[:：]\\d{2}(?:[:：]\\d{2})?.*?(?:成[熟热]|干[涸固])/.test(s))return true;\n    return false;\n}\nfunction C(v){\n    var s=N(v).replace(/\\s+/g,\"\").replace(/[0-9０-９]/g,\"\").replace(/(?:Lv|LV|lv|等级|级)/g,\"\");\n    var m=s.match(/[\\u4e00-\\u9fff]{2,6}/g);\n    return m&&m.length?m.join(\"\"):\"\";\n}\nvar st=R(zdjl.getVar(\"植物状态\",\"global\"));\nvar nm=R(收割预检名称区域);\ntry{\n    zdjl.setVar(\"收割预检状态2\",st,\"global\");\n    zdjl.setVar(\"收割预检名称2\",nm,\"global\");\n    if(U(st))zdjl.setVar(\"收割预检未成熟\",\"是\",\"global\");\n    zdjl.toast(\"预检2｜\"+(U(st)?\"未成熟\":\"未命中未成熟\")+\"｜\"+(C(nm)||\"名称?\"),1100);\n}catch(e){}"}
{"type":"运行JS代码","delay":"0","delayUnit":1,"repeatCount":1,"desc":"收割预检｜综合两格结果","jsCode":"function G(k,d){try{var v=zdjl.getVar(k,\"global\");return (v===undefined||v===null)?d:v;}catch(e){return d;}}\nfunction S(k,v){try{zdjl.setVar(k,v,\"global\");}catch(e){}}\nfunction N(v){return String(v==null?\"\":v).replace(/\\r\\n?/g,\"\\n\").trim();}\nfunction C(v){\n    var s=N(v).replace(/\\s+/g,\"\").replace(/[0-9０-９]/g,\"\").replace(/(?:Lv|LV|lv|等级|级)/g,\"\");\n    var m=s.match(/[\\u4e00-\\u9fff]{2,6}/g);\n    return m&&m.length?m.join(\"\"):\"\";\n}\nfunction W(v){\n    var s=C(v);\n    var a=[\n      [\"樱桃\",[\"樱桃\",\"樱挑\",\"櫻桃\"]],\n      [\"灯笼果\",[\"灯笼果\",\"灯龙果\",\"灯笼杲\",\"燈籠果\"]],\n      [\"莲花\",[\"莲花\",\"连花\",\"蓮花\"]],\n      [\"枇杷\",[\"枇杷\",\"枇把\",\"批杷\",\"枇粑\"]],\n      [\"牛油果\",[\"牛油果\",\"牛油杲\"]]\n    ];\n    for(var i=0;i<a.length;i++)for(var j=0;j<a[i][1].length;j++)if(s.indexOf(a[i][1][j])>=0)return a[i][0];\n    return \"\";\n}\nfunction D(a,b){\n    if(!a||!b)return false;\n    if(a===b)return true;\n    if(Math.abs(a.length-b.length)>1)return false;\n    var n=a.length,m=b.length,dp=[],i,j;\n    for(i=0;i<=n;i++)dp[i]=[i];\n    for(j=1;j<=m;j++)dp[0][j]=j;\n    for(i=1;i<=n;i++)for(j=1;j<=m;j++)dp[i][j]=Math.min(dp[i-1][j]+1,dp[i][j-1]+1,dp[i-1][j-1]+(a.charAt(i-1)===b.charAt(j-1)?0:1));\n    return dp[n][m]<=1;\n}\nvar n1=C(G(\"收割预检名称1\",\"\")),n2=C(G(\"收割预检名称2\",\"\"));\nvar w1=W(G(\"收割预检名称1\",\"\")),w2=W(G(\"收割预检名称2\",\"\"));\nvar r=\"未知\",p=\"\";\nif(w1||w2){r=\"白名单\";p=w1||w2;}\nelse if(n1&&n2&&(n1===n2||D(n1,n2))){r=\"非白名单\";p=n1===n2?n1:(n1+\"/\"+n2);}\nS(\"收割预检植物结论\",r);\nS(\"收割预检植物\",p);\ntry{zdjl.toast(\"收割预检｜\"+String(G(\"收割预检未成熟\",\"否\"))+\"｜\"+r+(p?\"｜\"+p:\"\"),1600);}catch(e){}"}

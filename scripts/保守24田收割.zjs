{"repeatCount":-1,"pauseOnFail":false,"count":110,"minVerCode":2026000,"minVerName":"2.26.0","screenWidth":720,"screenHeight":1280,"screenDpi":2,"lastSaveScreenWidth":1280,"lastSaveScreenHeight":720,"lastSaveScreenDpi":2,"savedVerCode":26000050,"savedVerName":"26.5.0","description":"保守24田｜金色执行收割点击后剔除本格扫描记录，汇总仅统计未点击收获的金色","delay":"0.2","delayUnit":1,"globalCallbacks":{},"desc":"稳收24｜逐格金色统一90/80/70/65四档门槛｜移除独立精确60%额外补收｜路线不变"}
{"type":"设置变量","delay":"0","delayUnit":1,"desc":"初始化：保存浇水选项＋原生62种植物名单（可直接编辑）","vars":[{"name":"收割扫描序号","value":{"varType":"number","varScope":"global","showInputInObjectSubVar":false,"mustInput":false,"number":0}},{"name":"变异本区记录","value":{"varType":"string","varScope":"global","showInputInObjectSubVar":false,"mustInput":false,"value":""}},{"name":"变异本区数量","value":{"varType":"number","varScope":"global","showInputInObjectSubVar":false,"mustInput":false,"number":0}},{"name":"一键设置","value":{"varType":"string","varScope":"global","showInputInObjectSubVar":false,"mustInput":false,"value":"取消收获"}},{"name":"保守24作物判定","value":{"varType":"string","varScope":"global","showInputInObjectSubVar":false,"mustInput":false,"showInputContentAlign":"left","value":"未知"}},{"name":"保守24作物名称","value":{"varType":"string","varScope":"global","showInputInObjectSubVar":false,"mustInput":false,"showInputContentAlign":"left","value":""}},{"name":"保守24原浇水设置","value":{"varType":"expression","varScope":"global","showInputInObjectSubVar":false,"mustInput":false,"showInputContentAlign":"left","valueExp":"String(zdjl.getVar(\"浇水吗\",\"global\")||\"\")"}},{"name":"保守24首格判定","value":{"varType":"string","varScope":"global","showInputInObjectSubVar":false,"mustInput":false,"value":"未知"}},{"name":"保守24第二格判定","value":{"varType":"string","varScope":"global","showInputInObjectSubVar":false,"mustInput":false,"value":"未检查"}},{"name":"保守24农场等级","value":{"varType":"number","varScope":"global","showInputInObjectSubVar":false,"mustInput":false,"number":0}},{"name":"保守24首次农场等级","value":{"varType":"number","varScope":"global","showInputInObjectSubVar":false,"mustInput":false,"number":0}},{"name":"保守24首格名称","value":{"varType":"string","varScope":"global","showInputInObjectSubVar":false,"mustInput":false,"value":""}},{"name":"保守24第二格名称","value":{"varType":"string","varScope":"global","showInputInObjectSubVar":false,"mustInput":false,"value":""}},{"name":"保守24首格OCR","value":{"varType":"string","varScope":"global","showInputInObjectSubVar":false,"mustInput":false,"value":""}},{"name":"保守24第二格OCR","value":{"varType":"string","varScope":"global","showInputInObjectSubVar":false,"mustInput":false,"value":""}},{"name":"保守24首格直通","value":{"varType":"string","varScope":"global","showInputInObjectSubVar":false,"mustInput":false,"value":"否"}},{"name":"保守24入口等级","value":{"varType":"number","varScope":"global","showInputInObjectSubVar":false,"mustInput":false,"value":null}},{"name":"保守24入口OCR","value":{"varType":"string","varScope":"global","showInputInObjectSubVar":false,"mustInput":false,"value":""}},{"name":"保守24低级作物","value":{"varType":"string","varScope":"global","showInputInObjectSubVar":false,"mustInput":false,"showInputContentAlign":"left","value":"小麦|胡萝卜|番茄|蘑菇|土豆|玉米|草莓|向日葵|青椒|大蒜|香蕉|蓝莓|黄瓜|茄子|南瓜|柚子|卷心菜|白萝卜|葡萄|生菜|西瓜|辣椒|洋葱|花菜|猕猴桃|花生|木瓜|荞麦|莴笋|红枣|棉花|橘子|菠萝|四季豆|冬瓜|李子|杨桃|梨子|甘蔗|葫芦|桃子|柠檬|樱桃|桑葚|杏子|哈密瓜"}},{"name":"保守24高级作物","value":{"varType":"string","varScope":"global","showInputInObjectSubVar":false,"mustInput":false,"showInputContentAlign":"left","value":"枇杷|灯笼果|树莓|芒果|山竹|山楂|莲花|咖啡豆|火龙果|石榴|牛油果|龙胆花|仙人掌果|椰子|荔枝|百合"}},{"name":"保守24逐格入口名单","value":{"varType":"string","varScope":"global","showInputInObjectSubVar":false,"mustInput":false,"showInputContentAlign":"left","value":"枇杷|灯笼果|莲花|牛油果|芒果|山竹|火龙果|石榴"}},{"name":"保守24入口等级区域A","value":{"varType":"screen_area","varScope":"global","showInputInObjectSubVar":false,"mustInput":false,"showInputContentAlign":"left","screenArea":"14.2% 4.6% 19.6% 9.6%","showInput":false}},{"name":"保守24入口等级区域B","value":{"varType":"screen_area","varScope":"global","showInputInObjectSubVar":false,"mustInput":false,"showInputContentAlign":"left","screenArea":"13.5% 4.4% 20.2% 10.4%","showInput":false}}]}
{"type":"运行JS代码","delay":"0","delayUnit":1,"repeatCount":1,"desc":"入口等级OCR修复：使用原生屏幕区域对象；低于69双框确认一键直收","jsCode":"(function(){\nfunction V(n,v){try{zdjl.setVar(n,v,\"global\");}catch(e){}}\nvar f=null;try{f=zdjl.getVar(\"ocrText\",\"global\");}catch(e){}\nfunction read(a){try{return typeof f===\"function\"?String(f(a,\"medium\")||\"\"):\"\";}catch(e){return \"\";}}\nfunction num(s){var m=String(s).replace(/\\s/g,\"\").match(/(?:Lv\\.?|等级)?([1-9]\\d{0,2})(?:级)?/i);var n=m?+m[1]:0;return n<=150?n:0;}\nvar raw1=read(zdjl.getVar(\"保守24入口等级区域A\",\"global\")),l1=num(raw1),raw2=\"\",l2=0;\nif(l1>0&&l1<69){raw2=read(zdjl.getVar(\"保守24入口等级区域B\",\"global\"));l2=num(raw2);}\nvar lv=l1>=69?l1:l1>0&&l1===l2?l1:0;\nV(\"保守24入口等级\",lv);V(\"保守24农场等级\",lv);V(\"保守24首次农场等级\",lv);\nV(\"保守24入口OCR\",raw1+\" / \"+raw2);\nV(\"保守24作物判定\",lv>0&&lv<69?\"其他\":\"保护\");\nV(\"保守24入口判据\",lv>0&&lv<69?\"入口等级双检\":\"首格植物优先\");\ntry{zdjl.toast(\"稳收｜等级\"+(lv||\"?\")+\"｜\"+(lv&&lv<69?\"直接一键\":\"入田看首格\"),1400);}catch(e){}\n})();"}
{"type":"运行多个动作","delay":"0","delayUnit":1,"desc":"仅需24田时执行：先换作物、首次浇水和复位｜入口<69直接跳过整个动作组","runMode":"normal","scriptSet":[{"type":"执行脚本","delay":"0","delayUnit":1,"condition":{"type":"jsExpression","expression":"换作物吗==\"换经济\"","desc":""},"desc":"选择经济作物","scriptCallbacks":{"beforeStartExec":{"type":"运行多个动作","delay":"0","delayUnit":1,"desc":"HUD显示：换经","scriptSet":[{"type":"设置变量","delay":"0","delayUnit":1,"desc":"更新HUD任务","vars":[{"name":"HUD任务","value":{"varType":"string","varScope":"global","showInputInObjectSubVar":false,"mustInput":false,"showInputContentAlign":"left","value":"换经"}}]},{"type":"执行脚本","delay":"0","delayUnit":1,"desc":"刷新左下角HUD","filePath":"状态提示.zjs","continueCurrentAfterFinish":true}],"runMode":"normal"}},"filePath":"换经济作物.zjs","continueCurrentAfterFinish":true},{"type":"执行脚本","delay":"0","delayUnit":1,"condition":{"type":"jsExpression","expression":"换作物吗==\"换16经验\"","desc":""},"desc":"选择经济作物","scriptCallbacks":{"beforeStartExec":{"type":"运行多个动作","delay":"0","delayUnit":1,"desc":"HUD显示：换经","scriptSet":[{"type":"设置变量","delay":"0","delayUnit":1,"desc":"更新HUD任务","vars":[{"name":"HUD任务","value":{"varType":"string","varScope":"global","showInputInObjectSubVar":false,"mustInput":false,"showInputContentAlign":"left","value":"换经"}}]},{"type":"执行脚本","delay":"0","delayUnit":1,"desc":"刷新左下角HUD","filePath":"状态提示.zjs","continueCurrentAfterFinish":true}],"runMode":"normal"}},"filePath":"换16经验.zjs","continueCurrentAfterFinish":true},{"type":"执行脚本","delay":"0","delayUnit":1,"condition":{"type":"jsExpression","expression":"换作物吗==\"换8小时作物\"","desc":""},"desc":"选择8小时作物","filePath":"选择八小时作物.zjs","continueCurrentAfterFinish":true},{"type":"执行脚本","delay":"0.1","delayUnit":1,"condition":{"type":"conditionSet","conditions":[{"type":"image","runWhenFalse":true,"image":{"type":"image","imageData":{"data":"","imageWidth":12,"imageHeight":14,"imageLeft":1138,"imageTop":514,"screenWidth":1280,"screenHeight":720,"screenDpi":2},"limitArea":"88.6% 70.6% 90.3% 73.9%","searchMode":"color_2.21","minSimilarPercent":88,"quickSearch":true,"codeVersion":"V1_7","imageScaleType":"dpi"},"desc":""},{"type":"jsExpression","expression":"换作物吗==\"换英雄\"","desc":""}],"matchMode":"or","checkInMultiThreads":false,"desc":""},"desc":"换英雄植物","filePath":"选择英雄植物.zjs","continueCurrentAfterFinish":true},{"type":"执行脚本","delay":"0","delayUnit":1,"repeatCount":1,"desc":"稳收24：先到务农台取消一键收获并一键种植（沿用原流程）","scriptCallbacks":{"afterExecFinish":{"type":"控制执行","delay":"2","delayUnit":1,"controlRunType":"waitDelay","jumpToPosition":"","ContinueParentExecute":false}},"filePath":"一键种植.zjs","continueCurrentAfterFinish":true},{"type":"点击","delay":"3","delayUnit":1,"repeatCount":1,"desc":"稳收24：一键种植后复位｜沿用云端3秒动作延迟","posData":{"type":"location","x":"92.7%","y":"90.8%"}}],"condition":{"type":"jsExpression","checkBeforeDelay":true,"repeatWhenFalse":false,"expression":"String(zdjl.getVar(\"保守24作物判定\",\"global\")||\"未知\")!=\"其他\"","desc":"入口等级<69已确认走一键收获时，不执行换作物和一键种植"}}
{"type":"运行多个动作","delay":"0","delayUnit":1,"desc":"入田首格：先用植物定路线；高级其他才复核第二格","runMode":"normal","scriptSet":[{"type":"设置变量","delay":"0","delayUnit":1,"desc":"保留本次原浇水参数","vars":[{"name":"保守24原浇水设置","value":{"varType":"expression","varScope":"global","showInputInObjectSubVar":false,"mustInput":false,"showInputContentAlign":"left","valueExp":"String(zdjl.getVar(\"浇水吗\",\"global\")||\"\")"}}]},{"type":"设置变量","delay":"0","delayUnit":1,"desc":"预检名称区域｜沿用已验证智能收割的名称OCR区域","vars":[{"name":"保守24名称区域","value":{"varType":"screen_area","varScope":"script","showInputInObjectSubVar":false,"mustInput":false,"showInputContentAlign":"left","screenArea":"7% 15% 16.2% 24%"}}]},{"type":"滑动","duration":"1800","delayUnit":1,"desc":"预检植物｜稳收24｜第一组入口前进｜复用当前智能收割的2秒延迟","startPos":{"type":"location","x":"20%","y":"75%"},"endPos":{"type":"location","x":"20%","y":"15%"},"delay":"2"},{"type":"滑动","duration":"800","delayUnit":1,"desc":"预检植物｜第一组12块地｜第1格","startPos":{"type":"location","x":"25%","y":"75%"},"endPos":{"type":"location","x":"5%","y":"75%"}},{"type":"运行JS代码","delay":"0","delayUnit":1,"repeatCount":1,"desc":"第1格：先校验本账号农场身份，再执行原62植物首格分流（路线不动）","jsCode":"(function(){\nfunction G(n){try{return String(zdjl.getVar(n,\"global\")||\"\");}catch(e){return \"\";}}\nfunction S(n,v){try{zdjl.setVar(n,v,\"global\");}catch(e){}}\nfunction OCR(area){var f;try{f=zdjl.getVar(\"ocrText\",\"global\");}catch(e){}\n if(typeof f!==\"function\")return \"\";\n try{return String(f(area,\"medium\")||\"\");}catch(e){return \"\";}}\nfunction Plant(raw){\n var t=String(raw||\"\").replace(/\\s+/g,\"\").replace(/枇把|批杷|枇粑/g,\"枇杷\").replace(/樱挑|櫻桃/g,\"樱桃\").replace(/灯龙果|灯笼杲|燈籠果/g,\"灯笼果\").replace(/连花|蓮花/g,\"莲花\").replace(/牛油杲/g,\"牛油果\").replace(/火龍果/g,\"火龙果\");\n var lo=G(\"保守24低级作物\").split(\"|\"),hi=G(\"保守24高级作物\").split(\"|\");\n var all=lo.concat(hi).sort(function(a,b){return b.length-a.length;});\n for(var i=0;i<all.length;i++)if(all[i]&&t.indexOf(all[i])>=0)return all[i];\n return \"\";\n}\nfunction Name(){\n var n=OCR(zdjl.getVar(\"保守24名称区域\",\"global\")),p=Plant(n);\n if(p)return {p:p,raw:n};\n var area=null;try{area=zdjl.getVar(\"植物状态\",\"global\");}catch(e){}\n var card=OCR(area);\n var lines=card.split(/\\r?\\n/),withoutTitle=[];\n for(var i=0;i<lines.length;i++)if(lines[i].indexOf(\"农场\")<0)withoutTitle.push(lines[i]);\n return {p:Plant(withoutTitle.join(\"\\n\")),raw:n+\" | \"+card};\n}\nfunction Group(p){if(!p)return \"未知\";\n if(G(\"保守24低级作物\").split(\"|\").indexOf(p)>=0)return \"低级直收\";\n if(G(\"保守24逐格入口名单\").split(\"|\").indexOf(p)>=0)return \"保护\";\n return \"其他\";\n}\n// 在本账号首格已弹出植物卡时确认自己农场身份；避免稳收24沿用上一账号的OCR。\n// 只在本轮/当前账号的锁不存在时调用一次完整卡片OCR；不改原植物判定及24田路线。\ntry{\n var __rn=G(\"HUD启动时间\"),__sn=G(\"当前第几个号\"),__hn=G(\"HUD当前账号\");\n var __prefix=__rn+\"|\"+__sn+\"|\",__lock=G(\"自己农场OCR锁定标记\");\n var __has=(G(\"自己农场OCR已锁定\")===\"是\" && __rn && __lock.indexOf(__prefix)===0 && /[^\\s]{1,35}的农场/.test(G(\"自己农场OCR原文\").replace(/\\s+/g,\"\")));\n if(!__has){\n  var __farmArea=null;try{__farmArea=zdjl.getVar(\"植物状态\",\"global\");}catch(e){}\n  var __farmRaw=__farmArea?OCR(__farmArea):\"\";\n  if(/[^\\s]{1,35}的农场/.test(__farmRaw.replace(/\\s+/g,\"\"))){\n    S(\"自己农场OCR原文\",__farmRaw);\n    S(\"自己农场OCR锁定标记\",__prefix+__hn);\n    S(\"自己农场OCR已锁定\",\"是\");\n  }else{\n    S(\"自己农场OCR原文\",\"\");S(\"自己农场OCR锁定标记\",\"\");S(\"自己农场OCR已锁定\",\"否\");\n  }\n }\n}catch(__farmIdentityErr){S(\"自己农场OCR原文\",\"\");S(\"自己农场OCR锁定标记\",\"\");S(\"自己农场OCR已锁定\",\"否\");}\n\nvar s=Name(),kind=Group(s.p),firstDirect=kind===\"保护\";\nS(\"保守24首格判定\",kind);S(\"保守24首格直通\",firstDirect?\"是\":\"否\");\nS(\"保守24首格名称\",s.p);S(\"保守24首格OCR\",s.raw.slice(0,400));\nS(\"保守24作物名称\",s.p);\nS(\"保守24作物判定\",kind===\"低级直收\"?\"其他\":kind===\"其他\"?\"待复核\":\"保护\");\ntry{zdjl.toast(\"稳收①｜\"+(s.p||\"未知\")+\"｜\"+(kind===\"低级直收\"?\"直接一键\":kind===\"其他\"?\"看第二格\":\"24田\"),1600);}catch(e){}\n})();"},{"type":"运行多个动作","delay":"0","delayUnit":1,"desc":"仅>=69级首格明确非九种时才复核第2格；未知安全走24田","condition":{"type":"jsExpression","expression":"String(zdjl.getVar(\"保守24首格判定\",\"global\")||\"\")===\"其他\"","checkBeforeDelay":true,"repeatWhenFalse":false,"desc":"仅首格明确为高级非九种才检查第二格；低级立即一键"},"scriptSet":[{"type":"点击","delay":"0","delayUnit":1,"repeatCount":1,"desc":"稳收第2格｜只在首格为其他时移动前点击","scriptCallbacks":{"afterExecSuc":{"type":"控制执行","delay":"0.1","delayUnit":1,"controlRunType":"waitDelay","jumpToPosition":"","ContinueParentExecute":false}},"posData":{"type":"location","x":"39.6%","y":"70.3%"}},{"type":"滑动","duration":"750","delayUnit":1,"desc":"稳收第2格｜沿用智能收割原生移动750毫秒","startPos":{"type":"location","x":"25%","y":"75%"},"endPos":{"type":"location","x":"5%","y":"75%"}},{"type":"运行JS代码","delay":"0","delayUnit":1,"repeatCount":1,"desc":"第2格：不识等级，只核对植物是否同样无需保护","jsCode":"(function(){\nfunction G(n){try{return String(zdjl.getVar(n,\"global\")||\"\");}catch(e){return \"\";}}\nfunction S(n,v){try{zdjl.setVar(n,v,\"global\");}catch(e){}}\nfunction OCR(area){var f;try{f=zdjl.getVar(\"ocrText\",\"global\");}catch(e){}\n if(typeof f!==\"function\")return \"\";\n try{return String(f(area,\"medium\")||\"\");}catch(e){return \"\";}}\nfunction Plant(raw){\n var t=String(raw||\"\").replace(/\\s+/g,\"\").replace(/枇把|批杷|枇粑/g,\"枇杷\").replace(/樱挑|櫻桃/g,\"樱桃\").replace(/灯龙果|灯笼杲|燈籠果/g,\"灯笼果\").replace(/连花|蓮花/g,\"莲花\").replace(/牛油杲/g,\"牛油果\").replace(/火龍果/g,\"火龙果\");\n var lo=G(\"保守24低级作物\").split(\"|\"),hi=G(\"保守24高级作物\").split(\"|\");\n var all=lo.concat(hi).sort(function(a,b){return b.length-a.length;});\n for(var i=0;i<all.length;i++)if(all[i]&&t.indexOf(all[i])>=0)return all[i];\n return \"\";\n}\nfunction Name(){\n var n=OCR(zdjl.getVar(\"保守24名称区域\",\"global\")),p=Plant(n);\n if(p)return {p:p,raw:n};\n var area=null;try{area=zdjl.getVar(\"植物状态\",\"global\");}catch(e){}\n var card=OCR(area);\n var lines=card.split(/\\r?\\n/),withoutTitle=[];\n for(var i=0;i<lines.length;i++)if(lines[i].indexOf(\"农场\")<0)withoutTitle.push(lines[i]);\n return {p:Plant(withoutTitle.join(\"\\n\")),raw:n+\" | \"+card};\n}\nfunction Group(p){if(!p)return \"未知\";\n if(G(\"保守24低级作物\").split(\"|\").indexOf(p)>=0)return \"低级直收\";\n if(G(\"保守24逐格入口名单\").split(\"|\").indexOf(p)>=0)return \"保护\";\n return \"其他\";\n}\nvar s=Name(),kind=Group(s.p);\nvar first=G(\"保守24首格判定\");\nvar runOne=first===\"其他\"&&(kind===\"低级直收\"||kind===\"其他\");\nS(\"保守24第二格判定\",kind);S(\"保守24第二格名称\",s.p);\nS(\"保守24第二格OCR\",s.raw.slice(0,400));\nS(\"保守24作物判定\",runOne?\"其他\":\"保护\");\nS(\"保守24作物名称\",G(\"保守24首格名称\")+\"/\"+s.p);\ntry{zdjl.toast(\"稳收②｜\"+(s.p||\"未知\")+\"｜\"+(runOne?\"两格非保护→一键\":\"24田保护\"),1600);}catch(e){}\n})();"}],"runMode":"normal"},{"type":"运行多个动作","delay":"0","delayUnit":1,"desc":"首格确认九作物｜原地调用原第1格收割判定（直接复用24田现有回调）","runMode":"normal","scriptSet":[{"type":"执行脚本","delay":"0","delayUnit":1,"desc":"到达地块：执行收割判定.zjs","filePath":"收割判定.zjs","continueCurrentAfterFinish":true}],"condition":{"type":"jsExpression","checkBeforeDelay":true,"repeatWhenFalse":false,"expression":"String(zdjl.getVar(\"保守24首格直通\",\"global\")||\"否\")===\"是\" && String(zdjl.getVar(\"保守24作物判定\",\"global\")||\"未知\")===\"保护\"","desc":"仅首格名单识别成功，且最终走24田时在原地执行第1格判定"}},{"type":"点击","delay":"1","delayUnit":1,"repeatCount":1,"desc":"非首格直通时才复位（第二格复核/低级一键/OCR未知仍复位）","posData":{"type":"location","x":"92.7%","y":"90.8%"},"condition":{"type":"jsExpression","checkBeforeDelay":true,"repeatWhenFalse":false,"expression":"String(zdjl.getVar(\"保守24首格直通\",\"global\")||\"否\")!==\"是\"","desc":"复核、等级直收或OCR未知时保留原复位；首格名单直接衔接后续11格，不复位"}}],"condition":{"type":"jsExpression","checkBeforeDelay":true,"repeatWhenFalse":false,"expression":"String(zdjl.getVar(\"保守24作物判定\",\"global\")||\"保护\")!=\"其他\"","desc":"入口可靠确认<69后跳过全部入田/首格OCR；不确定者仍进入预检"}}

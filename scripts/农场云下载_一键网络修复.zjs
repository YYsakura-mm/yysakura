{"repeatCount":1,"pauseOnFail":false,"count":1,"minVerCode":2021000,"minVerName":"2.21.0","screenWidth":720,"screenHeight":1280,"screenDpi":2,"lastSaveScreenWidth":1280,"lastSaveScreenHeight":720,"lastSaveScreenDpi":2,"savedVerCode":26000050,"savedVerName":"26.5.0","delay":"100","delayUnit":0,"description":"农场云多源下载一键修复；只修改下载器和更新器，自动备份"}
{"type":"运行JS代码","delay":"0","delayUnit":1,"desc":"修复 GitHub API HTTP/2 CANCEL；添加 Raw/CDN 自动切换","jsCode":"(function(){\n  var DIR='/storage/emulated/0/自动精灵/';\n  var files=[\n    {name:'农场脚本下载.zjs',needle:'function getRaw(path,ref){',replacement:\"    var FARM_NET_PREFERRED=0; // 0=GitHub API, 1=GitHub Raw, 2=jsDelivr, 3=Fastly jsDelivr\\n    function getRaw(path,ref){\\n      var rev=String(ref||BRANCH),file=encodePath(path),bust=(rev===BRANCH?'?t='+Date.now():'');\\n      var urls=[\\n        'https://api.github.com/repos/'+OWNER+'/'+REPO+'/contents/'+file+'?ref='+encodeURIComponent(rev),\\n        'https://raw.githubusercontent.com/'+OWNER+'/'+REPO+'/'+encodeURIComponent(rev)+'/'+file+bust,\\n        'https://cdn.jsdelivr.net/gh/'+OWNER+'/'+REPO+'@'+encodeURIComponent(rev)+'/'+file+bust,\\n        'https://fastly.jsdelivr.net/gh/'+OWNER+'/'+REPO+'@'+encodeURIComponent(rev)+'/'+file+bust\\n      ];\\n      var errs=[],first404=null,initial=FARM_NET_PREFERRED,order=[initial];\\n      for(var j=0;j<urls.length;j++)if(j!==initial)order.push(j);\\n      for(var i=0;i<order.length;i++){\\n        var k=order[i],r=null;\\n        try{\\n          if(k===0){r=req('GET','contents/'+file+'?ref='+encodeURIComponent(rev),true,1);}\\n          else {r=zdjl.requestUrl({url:urls[k],method:'GET',headers:[{'Accept':'text/plain'},{'Cache-Control':'no-cache'}],timeout:16000,responseType:'TEXT'});}\\n          if(r&&r.code===200){\\n            var body=String(r.body==null?'':r.body);\\n            if(!/^\\\\s*\\\\{/.test(body))throw Error('返回不是ZJS/JSON文本');\\n            FARM_NET_PREFERRED=k;\\n            try{zdjl.appendFile('/sdcard/Download/农场云下载_网络记录.log',new Date().toISOString()+' OK host='+k+' file='+path+'\\\\n');}catch(_log){}\\n            return {code:200,body:body};\\n          }\\n          if(r&&r.code===404&&!first404)first404={code:404,body:r.body||''};\\n          errs.push(k+':HTTP '+(r?r.code:'?'));\\n        }catch(e){errs.push(k+':'+String(e).slice(0,170));}\\n      }\\n      try{zdjl.appendFile('/sdcard/Download/农场云下载_网络记录.log',new Date().toISOString()+' FAIL file='+path+' '+errs.join(' | ')+'\\\\n');}catch(_log2){}\\n      if(first404&&errs.every(function(x){return /HTTP 404/.test(x);}))return first404;\\n      throw Error('下载线路全部失败 ['+path+'] '+errs.join(' | '));\\n    }\",stamp:'FARM_NET_PREFERRED'},\n    {name:'农场脚本版本更新器.zjs',needle:'function fetchJson(path,timeout){',replacement:\"    var FARM_META_PREFERRED=0;\\n    function fetchJson(path,timeout){\\n      var rev=BRANCH,file=encodePath(path),stamp='?t='+Date.now(),sources=[\\n        'https://api.github.com/repos/'+OWNER+'/'+REPO+'/contents/'+file+'?ref='+encodeURIComponent(rev),\\n        'https://raw.githubusercontent.com/'+OWNER+'/'+REPO+'/'+encodeURIComponent(rev)+'/'+file+stamp,\\n        'https://cdn.jsdelivr.net/gh/'+OWNER+'/'+REPO+'@'+encodeURIComponent(rev)+'/'+file+stamp,\\n        'https://fastly.jsdelivr.net/gh/'+OWNER+'/'+REPO+'@'+encodeURIComponent(rev)+'/'+file+stamp\\n      ];\\n      var seq=[FARM_META_PREFERRED],errors=[];\\n      for(var j=0;j<4;j++)if(j!==FARM_META_PREFERRED)seq.push(j);\\n      for(var i=0;i<seq.length;i++){\\n        var k=seq[i];\\n        try{\\n          var h=[{'X-GitHub-Api-Version':'2022-11-28'},{'Accept':k===0?'application/vnd.github.raw+json':'application/json'},{'Cache-Control':'no-cache'}];\\n          if(k===0){var tok=getToken();if(tok)h.unshift({'Authorization':'Bearer '+tok});}\\n          var r=zdjl.requestUrl({url:sources[k],method:'GET',headers:h,timeout:Math.min(timeout||12000,15000),responseType:'TEXT'});\\n          if(!r||r.code!==200)throw Error('HTTP '+(r?r.code:'?'));\\n          var obj=JSON.parse(String(r.body||''));\\n          if(!obj||typeof obj!=='object')throw Error('非JSON对象');\\n          FARM_META_PREFERRED=k;\\n          return obj;\\n        }catch(e){errors.push(k+':'+String(e).slice(0,180));}\\n      }\\n      throw Error('云端元数据读取失败 ['+path+'] '+errors.join(' | '));\\n    }\",stamp:'FARM_META_PREFERRED'}\n  ];\n  var pending=[],already=[],all=[];\n  function trim(s){return String(s==null?'':s).replace(/^\\s+|\\s+$/g,'');}\n  function read(p){try{return String(zdjl.readFile(p));}catch(e){throw Error('无法读取 '+p+': '+e);}}\n  function verifyWrite(p,s){zdjl.writeFile(p,s);if(read(p)!==s)throw Error('写入校验失败 '+p);}\n  try{\n    // Fully validate both before changing any file.\n    for(var i=0;i<files.length;i++){\n      var f=files[i],path=DIR+f.name,raw=read(path),lines=raw.split(/\\r?\\n/),acts=[];\n      for(var j=0;j<lines.length;j++)if(trim(lines[j]))acts.push(JSON.parse(lines[j]));\n      if(acts.length<2||!acts[1].jsCode)throw Error(f.name+' 结构不是预期的两步ZJS，请勿强行修复');\n      var js=acts[1].jsCode;\n      if(js.indexOf(f.stamp)>=0){already.push(f.name);continue;}\n      var rows=js.split('\\n'),pos=[];\n      for(j=0;j<rows.length;j++)if(rows[j].indexOf(f.needle)>=0)pos.push(j);\n      if(pos.length!==1)throw Error(f.name+' 下载入口与当前云端版本不同，安全停止。匹配='+pos.length);\n      if(rows[pos[0]].indexOf('function ')===-1||rows[pos[0]].indexOf('{')===-1)throw Error('下载入口异常');\n      rows.splice(pos[0],1,f.replacement);\n      acts[1].jsCode=rows.join('\\n');\n      var next='';for(j=0;j<acts.length;j++)next+=JSON.stringify(acts[j])+'\\n';\n      // dry structural validation before write\n      var chk=next.split(/\\r?\\n/).filter(function(s){return !!trim(s);});\n      if(chk.length!==acts.length)throw Error('生成的动作数量有变化');\n      for(j=0;j<chk.length;j++)JSON.parse(chk[j]);\n      pending.push({name:f.name,path:path,old:raw,next:next,backup:path+'.networkfix.original.bak'});\n    }\n    // Back up and atomically best-effort roll back on errors.\n    var written=[];\n    try{\n      for(i=0;i<pending.length;i++){\n        var p=pending[i],hasBak=false;\n        try{hasBak=!!trim(zdjl.readFile(p.backup));}catch(ignore){}\n        if(!hasBak)verifyWrite(p.backup,p.old);\n      }\n      for(i=0;i<pending.length;i++){\n        p=pending[i];verifyWrite(p.path,p.next);written.push(p);\n      }\n    }catch(e){\n      var failures=[];\n      for(i=0;i<written.length;i++)try{verifyWrite(written[i].path,written[i].old);}catch(re){failures.push(written[i].name);}\n      throw Error(String(e)+(failures.length?'\\n以下文件回滚失败：'+failures.join('、'):''));\n    }\n    var names=pending.map(function(p){return p.name;});\n    zdjl.alert('网络下载入口修复完成\\n本次修复：'+(names.join('、')||'无')+'\\n已修复：'+already.join('、')+'\\n\\n原文件已备份为 *.networkfix.original.bak\\n现在可打开「农场脚本版本更新器」重试。\\n如果仍失败，请提供 /sdcard/Download/农场云下载_网络记录.log 中最后几行。');\n  }catch(e){zdjl.alert('网络入口修复未完成：\\n'+String(e)+'\\n\\n未更动业务总控、发布器或任何云端文件。');}\n})();"}

ch(e){}}\nfunction G(k){try{return String(zdjl.getVar(k,'global')||'');}catch(e){return '';}}\nfunction T(s){try{zdjl.toast(s,2500);}catch(e){}}\nfunction log(s){try{zdjl.appendFile('/sdcard/Download/农场总控_模板管理_V35.log',new Date().toISOString()+' '+s+'\\n');}catch(e){}}\nfunction has(o,k){return o&&Object.prototype.hasOwnProperty.call(o,k);}\nfunction read(){var d={schema:1,presets:{},hiddenDefaults:[],active:''};try{var q=JSON.parse(String(zdjl.readFile(P)||'{}'));if(q&&typeof q==='object'){if(q.presets&&typeof q.presets==='object'&&!Array.isArray(q.presets))d.presets=q.presets;if(Array.isArray(q.hiddenDefaults))d.hiddenDefaults=q.hiddenDefaults.filter(function(x){return typeof x==='string';});if(typeof q.active==='string')d.active=q.active;for(var k in q)if(has(q,k)&&!has(d,k))d[k]=q[k];}}catch(e){log('READ_FAIL '+e);}return d;}\nfunction names(d){var out=[],base=Object.keys(B);for(var i=0;i<base.length;i++)if(d.hiddenDefaults.indexOf(base[i])<0)out.push(base[i]);var saved=Object.keys(d.presets);for(var j=0;j<saved.length;j++)if(out.indexOf(saved[j])<0)out.push(saved[j]);return out;}\nfunction active(d){var list=names(d),n=d.active||G('FC_V20_ACTIVE')||G('快捷方案');return list.indexOf(n)>=0?n:(list[0]||'');}\nfunction use(d,n){d.active=n;S('快捷方案',n);S('FC_V20_ACTIVE',n);S('FC_V20_DISPLAY',n);S('FC_V30_TEMP_JSON','');}\nfunction write(d,backup){try{var old=String(zdjl.readFile(P)||'');if(backup&&old){var ts=Date.now();try{zdjl.writeFile(P+'.bak',old);}catch(e){}try{zdjl.writeFile(P+'.bak.'+ts,old);}catch(e){}}d.updatedAt=Date.now();zdjl.writeFile(P,JSON.stringify(d));log('SAVED active='+d.active+' n='+names(d).length);return true;}catch(e){T('保存失败：'+e);log('SAVE_FAIL '+e);return false;}}\nfunction pick(title,items){try{var r=zdjl.select({title:title,items:items});if(!r)return '';var s=String(r.item||'');return items.indexOf(s)>=0?s:(typeof r.result==='number'?items[r.result]||'':'');}catch(e){log('SELECT_FAIL '+e);T('选择窗口异常');return '';}}\nfunction validName(n){n=String(n||'').trim();return n.length>0&&n.length<=24&&!/[\\r\\n\\t]/.test(n)?n:'';}\nfunction deleteOne(d,target){var ns=names(d);if(ns.indexOf(target)<0){T('方案不存在');return false;}if(ns.length<=1){T('至少保留一份方案');return false;}if(has(d.presets,target))delete d.presets[target];if(has(B,target)&&d.hiddenDefaults.indexOf(target)<0)d.hiddenDefaults.push(target);var next=target===active(d)?names(d)[0]:active(d);use(d,next);if(write(d,true)){T('已删除：'+target);log('DELETE '+target);return true;}return false;}\nfunction promptName(title,def){var v=null;try{v=zdjl.prompt(title,def||'');}catch(e){log('PROMPT_FAIL '+e);T('输入窗口异常');return '';}return validName(v);}\nvar d=read(),ns=names(d);if(!ns.length){T('没有可用方案');return;}\nvar action=pick('切换方案 / 管理历史方案',ns.concat(['── 方案管理 ──','删除一份方案','清理历史（只保留当前）','恢复默认内置方案']));\nif(!action||action==='── 方案管理 ──')return;\nif(ns.indexOf(action)>=0){use(d,action);if(write(d)){T('已切换：'+action);log('SELECT '+action);}return;}\nif(action==='删除一份方案'){\n var target=pick('选择要删除的方案',ns);if(!target)return;\n if(pick('确认删除：'+target,['取消','确认删除'])!=='确认删除')return;\n deleteOne(d,target);return;\n}\nif(action==='清理历史（只保留当前）'){\n var keep=active(d);if(!keep){T('找不到当前方案');return;}\n if(ns.length<=1){T('当前只有一份方案');return;}\n var ok=pick('保留【'+keep+'】；删除其余'+(ns.length-1)+'份',['取消','确认清理']);\n if(ok!=='确认清理')return;\n for(var i=0;i<ns.length;i++){var n=ns[i];if(n===keep)continue;if(has(d.presets,n))delete d.presets[n];if(has(B,n)&&d.hiddenDefaults.indexOf(n)<0)d.hiddenDefaults.push(n);}\n use(d,keep);if(write(d,true)){T('清理完成：仅保留 '+keep);log('CLEAN keep='+keep+' removed='+(ns.length-1));}return;\n}\nif(action==='恢复默认内置方案'){\n if(pick('恢复旧版内置方案（不影响自定义）',['取消','确认恢复'])!=='确认恢复')return;\n d.hiddenDefaults=[];if(!names(d).length){T('没有可恢复的方案');return;}\n if(write(d,true)){T('已恢复内置方案');log('RESTORE_DEFAULTS');}return;\n}\n})();"}

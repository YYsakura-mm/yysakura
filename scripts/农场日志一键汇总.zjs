{"repeatCount":1,"pauseOnFail":false,"count":1,"minVerCode":2021000,"minVerName":"2.21.0","screenWidth":720,"screenHeight":1280,"screenDpi":2,"lastSaveScreenWidth":720,"lastSaveScreenHeight":1280,"savedVerCode":26000050,"savedVerName":"26.5.0","description":"只读汇总最近一次任务：王者切换、异常、其他实例并发、等级OCR。只生成同一个诊断文件，不清理原始日志或改动总控。"}
{"type":"运行JS代码","delay":"0","delayUnit":1,"repeatCount":1,"desc":"只生成一份简明诊断｜本轮配置、异常、并发、OCR、停止原因","jsCode":"(function(){\n  // FC130.1 single-entry, concise diagnostic report. ES5-compatible, read-only except OUT.\n  var ROOT='/sdcard/Download/', DIR=ROOT+'农场总控日志/';\n  var OUT=ROOT+'农场总控_统一诊断.txt';\n  var SPEC=[\n    ['任务链_本轮.log','TASK'],\n    ['农场总控_配置链路.log','CONFIG'],\n    ['农场总控_V43调度诊断.log','STAGE'],\n    ['双王者V3_日志.txt','SWITCH'],\n    ['农场总控_互斥与收尾.log','LOCK'],\n    ['农场总控_退出诊断.log','EXIT'],\n    ['农场总控_收尾诊断.log','FINISH'],\n    ['等级快收_记录.txt','OCR'],\n    ['常用输入记忆_V57.log','MEMORY'],\n    ['农场总控_执行追踪.jsonl','TRACE']\n  ];\n  function R(p){try{return String(zdjl.readFile(p)||'');}catch(e){return '';}}\n  function T(s){try{zdjl.toast(s,3000);}catch(e){}}\n  function L(t){return String(t||'').split(/\\r?\\n/);}\n  function iso(s){var x=String(s||'').match(/^(\\d{4}-\\d\\d-\\d\\dT\\d\\d:\\d\\d:\\d\\d(?:\\.\\d+)?Z?)/);return x?x[1]:'';}\n  function stamp(s){var t=Date.parse(s);return isFinite(t)?t:0;}\n  function last(a,n){return a.length>n?a.slice(a.length-n):a;}\n  function addUnique(a,k){if(k&&a.indexOf(k)<0)a.push(k);}\n  var raw={},arr={},i,j;\n  for(i=0;i<SPEC.length;i++){\n    var name=SPEC[i][0],path=(SPEC[i][1]==='TRACE'?ROOT:DIR)+name;\n    raw[name]=R(path);arr[name]=L(raw[name]);\n  }\n  // Anchor selection uses V53_NEW_RUN (not UI memory or another execution's last event).\n  var task=arr['任务链_本轮.log'],begin={at:'',id:''};\n  for(i=0;i<task.length;i++){\n    var m=task[i].match(/^(\\S+) (?:V53_NEW_RUN|MANUAL_START) runId=(\\d{12,}-\\d+)/);\n    if(m&&stamp(m[1])>=stamp(begin.at)){begin={at:m[1],id:m[2]};}\n  }\n  var trace=arr['农场总控_执行追踪.jsonl'],startMs=stamp(begin.at);\n  // RUN_BEGIN only has a session ID. Use it when no persisted run ID is available.\n  var runBegin=[],nodes=[];\n  for(i=0;i<trace.length;i++){\n    if(trace[i].indexOf('{')<0)continue;\n    try{\n      var node=JSON.parse(trace[i]);\n      var ms=Number(node.ms||node.t)||stamp(node.t);\n      if(!ms||!isFinite(ms))continue;\n      nodes.push({v:node,ms:ms});\n      if(node.ev==='RUN_BEGIN')runBegin.push({ms:ms,sid:node.sid||node.s||'',order:node.order||''});\n    }catch(e){}\n  }\n  var mySid='',uiOrder='';\n  // Prefer exact runId to map process SID, useful when the RUN_BEGIN lines are rotated away.\n  if(begin.id){for(i=0;i<nodes.length;i++){\n    var row=nodes[i],v=row.v;\n    if(row.ms>=startMs-120000&&String(v.runId||v.run||'')===begin.id && (v.sid||v.s)){\n      mySid=String(v.sid||v.s);break;\n    }\n  }}\n  for(i=0;i<runBegin.length;i++){\n    if(startMs&&Math.abs(runBegin[i].ms-startMs)<20000){if(!mySid)mySid=runBegin[i].sid;uiOrder=runBegin[i].order;}\n  }\n  if(!startMs&&runBegin.length){\n    var lastBegin=runBegin[runBegin.length-1];startMs=lastBegin.ms;mySid=lastBegin.sid;uiOrder=lastBegin.order;\n  }\n  if(!startMs)startMs=Date.now()-2*3600000;\n  var since=startMs-30000;\n  var out=['农场总控｜简明统一诊断（FC130.1）',\n    '导出：'+new Date().toISOString(),\n    '运行ID：'+(begin.id||'未检索到；仅按最近启动会话筛选'),\n    '启动：'+new Date(startMs).toISOString()+' ｜启动顺序：'+(uiOrder||'见冻结配置'),\n    '说明：只读取日志；不修改总控、配置、任务、进度，也不删除任何旧日志。',''];\n  var config=[],switches=[],errors=[],normalSkips=[],reviewSkips=[],stops=[],ocr=[],saves=[],changes=[],other={},traceMiss={},rawCount=0;\n  var starts={},returns={},taskNames={},finished=false,finalName='未见本轮结束确认',hadConflict=false;\n  var important=/(V40_DISPATCH_CONFIG|DISPATCH_NEW|V46_STAGE_START|NEXT_STAGE|FINAL_DONE|STAGE_DECISION|CLIENT_PHASE_COMPLETE|TASK_FINISHED|CONFIG_ERROR|FC71_RUN_CONFLICT|FC129_OLD_INSTANCE_STOP|FC94_OLD_STAGE_IGNORED|FC122_HANDOFF_SKIP|FC122_HANDOFF_ACCEPT|ZONE_COUNT_DECISION|FATAL|UNCAUGHT|ERROR|FAILED|GATE_DENY|ABORT|STAGE_BLOCKED)/;\n  for(i=0;i<SPEC.length;i++){\n    var src=SPEC[i][0],type=SPEC[i][1],lines=arr[src];\n    if(type==='TRACE')continue;\n    for(j=0;j<lines.length;j++){\n      var line=lines[j],dt=iso(line),ms=stamp(dt);if(!ms||ms<since)continue;\n      // Named other run is never evidence of current run's state.\n      var named=line.match(/(?:runId|token)=([0-9]{12,}-[0-9]+)/),different=begin.id&&named&&named[1]!==begin.id;\n      if(different){\n        if(/CONFIG_ERROR|NEXT_STAGE|CLIENT_PHASE_COMPLETE|ZONE_BEGIN|ZONE_RETURN|STALE_OWNER_SKIP/.test(line)){\n          var id=named[1];other[id]=(other[id]||0)+1;\n        }\n        continue;\n      }\n      if(type==='MEMORY'){\n        if(line.indexOf('REMEMBER_SAVE')>=0)saves.push(line);\n        continue; // REMEMBER_LOAD is UI restore, not a failure.\n      }\n      if(type==='OCR'){\n        if(/OCR_RESULT|ROUTE|CHILD|ERROR|AREA_MISSING/.test(line))ocr.push(line);\n        continue;\n      }\n      if(type==='TASK'){\n        if(line.indexOf('ZONE_BEGIN token=')>=0){\n          var a=line.match(/token=([0-9]{12,}-\\d+)\\|(\\d+)\\|(\\d+)\\|(\\d+)\\|(\\d+)\\|(\\d+) action=([^ ]+)/);\n          if(a&&(!begin.id||a[1]===begin.id)){\n            var key='王者'+a[2]+' 任务槽'+a[5]+' '+a[7],zonekey=a[1]+'|'+a[2]+'|'+a[3]+'|'+a[4]+'|'+a[5]+'|'+a[6];\n            taskNames[key]=(taskNames[key]||0)+1;starts[zonekey]=(starts[zonekey]||0)+1;\n          }\n        }\n        if(line.indexOf('ZONE_RETURN token=')>=0){\n          var b=line.match(/ZONE_RETURN token=([^ ]+)/);if(b)returns[b[1]]=(returns[b[1]]||0)+1;\n        }\n      }\n      if(important.test(line)){\n        var item='['+type+'] '+line;\n        if(line.indexOf('FC122_HANDOFF_SKIP')>=0){\n          // A completed one-king run has no next phase; this log is an expected skip.\n          var ph=line.match(/phase=(\\d+)\\/(\\d+)/), run=line.match(/\\brun=([0-9]{12,}-[0-9]+)/), fileRun=line.match(/\\bfileRun=([0-9]{12,}-[0-9]+)/);\n          var lastPhase=ph&&Number(ph[1])>=Number(ph[2])-1;\n          var sameRun=run&&fileRun&&run[1]===fileRun[1];\n          var isDone=line.indexOf('status=全部完成')>=0;\n          if(lastPhase&&sameRun&&isDone)normalSkips.push(item+' [无下一端，正常跳过]');\n          else if(run&&fileRun&&run[1]!==fileRun[1])errors.push(item+' [运行ID不一致]');\n          else reviewSkips.push(item+' [无法单凭SKIP判断异常]');\n        }else if(/CONFIG_ERROR|FC71_RUN_CONFLICT|FC129_OLD_INSTANCE_STOP|FC94_OLD_STAGE_IGNORED|FATAL|UNCAUGHT|GATE_DENY|ABORT|STAGE_BLOCKED/.test(line)){\n          errors.push(item);if(/RUN_CONFLICT/.test(line))hadConflict=true;\n        }else if(/V40_DISPATCH_CONFIG|DISPATCH_NEW|V46_STAGE_START/.test(line))config.push(item);\n        else if(/NEXT_STAGE|FINAL_DONE|STAGE_DECISION|CLIENT_PHASE_COMPLETE|TASK_FINISHED|FC122_HANDOFF_ACCEPT/.test(line))switches.push(item);\n        else if(/ERROR|FAILED/.test(line))errors.push(item);\n      }\n      if(/FINAL_DONE saved=true|全部完成/.test(line)&&type==='SWITCH')finished=true;\n    }\n  }\n  // Raw trace can be long: aggregate ordinary zone/menu chatter, keep only decisive events.\n  var sidCount={},sidFirst={},sidLast={},menuStats={},lastFinish=null;\n  for(i=0;i<nodes.length;i++){\n    var e=nodes[i].v,ms=nodes[i].ms;if(ms<since)continue;\n    var sid=String(e.sid||e.s||''),ev=String(e.ev||e.e||'');\n    if(!sid)continue;\n    sidCount[sid]=(sidCount[sid]||0)+1;\n    if(!sidFirst[sid]||ms<sidFirst[sid])sidFirst[sid]=ms;\n    if(!sidLast[sid]||ms>sidLast[sid])sidLast[sid]=ms;\n    if(ev==='RUN_BEGIN'&&!mySid&&Math.abs(ms-startMs)<20000)mySid=sid;\n    if(ev==='MENU_MISS'){\n      var mk=sid+'|'+String(e.z||e.zone||'?');var st=menuStats[mk]||{lines:0,max:0};\n      st.lines++;st.max=Math.max(st.max,Number(e.n)||0);menuStats[mk]=st;\n      continue;\n    }\n    if(ev==='FC106_FINISH_DECISION'&&e.ok===true){\n      lastFinish={sid:sid,ms:ms};if(!mySid||sid===mySid)finished=true;\n    }\n    if((!mySid||sid===mySid)&&/STOP_|FC93_STOP_REASON|FC93_UI_TO_MAIN_CHAIN|FC93_NORMAL_DETAIL_CLOSE|FC94_OLD_STAGE_IGNORED|FC129_/.test(ev)){\n      stops.push(new Date(ms).toISOString()+' sid='+sid+' '+ev+' '+(e.reason||e.error||e.result||''));\n    }\n    if(/OCR_RESULT|FC126_ROUTE|FC128_ROUTE/.test(ev))ocr.push(new Date(ms).toISOString()+' '+ev+' '+JSON.stringify(e));\n    if(/CONFLICT|CONFIG_ERROR|OCR_ERROR|UNEXPECTED/.test(ev))errors.push('[TRACE] '+new Date(ms).toISOString()+' sid='+sid+' '+ev);\n  }\n  var pending=[];for(var idkey in starts)if(Object.prototype.hasOwnProperty.call(starts,idkey)&&(!returns[idkey]||returns[idkey]<starts[idkey]))pending.push(idkey);\n  var sessions=[];for(var sk in sidCount)if(Object.prototype.hasOwnProperty.call(sidCount,sk)){\n    sessions.push({sid:sk,count:sidCount[sk],mine:sk===mySid,first:sidFirst[sk],last:sidLast[sk]});\n  }\n  sessions.sort(function(a,b){return b.count-a.count;});\n  if(lastFinish&&!finished&&lastFinish.sid===mySid)finished=true;\n  if(finished)finalName='有全部完成确认（详情关闭/停止可能属于正常收尾）';\n  out.push('【一、运行结论】');\n  out.push('状态：'+finalName);\n  out.push('统计：'+Object.keys(taskNames).length+'个任务槽、'+Object.keys(starts).length+'次进入区、'+Object.keys(returns).length+'次返回区');\n  out.push('结束时未配对的入区：'+(pending.length?last(pending,12).join('，'):'无（仅按日志判定）'));\n  out.push('时间窗口内其他SID数：'+(mySid?Math.max(0,sessions.length-1):'未知（尚未确定本轮sid）')+'（不等于并发实例数），本轮sid='+ (mySid||'未取得'));\n  out.push('');\n  out.push('【二、冻结配置及切换】');\n  if(!config.length)out.push('未找到本轮冻结配置');\n  for(i=0;i<last(config,12).length;i++)out.push(last(config,12)[i]);\n  for(i=0;i<last(switches,18).length;i++)out.push(last(switches,18)[i]);\n  out.push('');out.push('【三、异常与其他会话（仅按日志判断）】');\n  if(!errors.length)out.push('本轮未提取到确定性异常；不代表实际游戏动作全部成功。');\n  for(i=0;i<last(errors,24).length;i++)out.push(last(errors,24)[i]);\n  if(normalSkips.length){out.push('正常跳过的阶段交接：');for(i=0;i<last(normalSkips,6).length;i++)out.push(last(normalSkips,6)[i]);}\n  if(reviewSkips.length){out.push('需要结合流程核对的阶段跳过：');for(i=0;i<last(reviewSkips,6).length;i++)out.push(last(reviewSkips,6)[i]);}\n  if(sessions.length>1){out.push('时间窗口内出现过其他SID（不能据此断言两个实例同时运行）：');\n    for(i=0;i<Math.min(8,sessions.length);i++){\n      var si=sessions[i],isOther=!si.mine;\n      var tag=isOther?(si.last<startMs?'仅见于本轮启动前':'本轮启动后也有记录；不能据此推断仍在执行'):'本轮';\n      out.push('  '+(si.mine?'[本轮] ':'[其他] ')+si.sid+' 记录条数='+si.count+' 首='+new Date(si.first).toISOString()+' 末='+new Date(si.last).toISOString()+' ['+tag+']');\n    }\n  }\n  for(var oid in other)if(Object.prototype.hasOwnProperty.call(other,oid))out.push('其他runId='+oid+' 关键记录='+other[oid]);\n  out.push('');out.push('【四、等级OCR分流（最近20条；没有runId时仅按时间筛选）】');\n  if(!ocr.length)out.push('本轮没有收集到OCR分流记录（非收割任务正常）。');\n  for(i=0;i<last(ocr,20).length;i++)out.push(last(ocr,20)[i]);\n  out.push('');out.push('【五、收尾/停止原因】');\n  if(!stops.length)out.push('没有对应停止事件。');\n  for(i=0;i<last(stops,18).length;i++)out.push(last(stops,18)[i]);\n  out.push('说明：FC93_NORMAL_DETAIL_CLOSE、正常完成后的原生停止，不等同于异常中断。');\n  out.push('证据边界：入区/返回区与子脚本返回日志，不等于游戏实际浇水成功；判断真实执行需结合截图/游戏状态。');\n  out.push('');out.push('【六、其他摘要】');\n  var keys=Object.keys(taskNames).sort();for(i=0;i<keys.length;i++)out.push(keys[i]+'：'+taskNames[keys[i]]+'区');\n  keys=Object.keys(menuStats);var large=[];\n  for(i=0;i<keys.length;i++)if(menuStats[keys[i]].max>=100)large.push(keys[i]+' 最大重试序号='+menuStats[keys[i]].max);\n  if(large.length)out.push('菜单重试较多：'+last(large,12).join('；'));\n  if(saves.length)out.push('最近一次输入记忆保存（仅提示，不视为最终执行配置）：'+saves[saves.length-1]);\n  out.push('');out.push('＝＝＝＝ 结束｜仅需发送本文件，原始日志保留 ＝＝＝＝');\n  try{zdjl.writeFile(OUT,out.join('\\n')+'\\n');\n    if(R(OUT).indexOf('农场总控｜简明统一诊断')===0)T('诊断已汇总：Download/农场总控_统一诊断.txt');\n    else T('诊断导出回读异常');\n  }catch(e){T('诊断导出失败：'+String(e));}\n})();"}

{"type":"运行JS代码","delay":"0","delayUnit":1,"desc":"一键生成单文件统一诊断，包含摘要和完整证据","jsCode":"(function(){var z=zdjl,root='/sdcard/Download/',paths=[\"总控_步骤耗时.jsonl\", \"农场总控_步骤耗时报告.txt\", \"总控_启动来源取证.jsonl\", \"农场总控_观测追踪_V2.jsonl\", \"农场总控_执行追踪.jsonl\", \"总控停止原因.log\", \"农场总控日志/农场总控_配置链路.log\", \"农场总控日志/双王者V3_日志.txt\", \"农场总控日志/农场总控_收尾诊断.log\", \"农场总控日志/农场总控_退出诊断.log\", \"农场总控日志/农场总控_启动诊断.log\", \"农场总控日志/任务链_本轮.log\"],pack={schema:141,collectedAt:new Date().toISOString(),logs:[],progress:{},scripts:[]};function hash(s){var h=0;for(var i=0;i<s.length;i++)h=((h<<5)-h+s.charCodeAt(i))|0;return String(h);}for(var i=0;i<paths.length;i++){var item={path:paths[i]};try{var s=String(z.readFile(root+paths[i])||'');item.chars=s.length;item.fingerprint=hash(s);item.emptyOrMissing=!s;item.content=s;}catch(e){item.error=String(e);}pack.logs.push(item);}try{var d=JSON.parse(String(z.readFile(root+'双王者V3_进度.json')||'{}'));pack.progress={schema:d.schema,runId:d.runId,order:d.order,current:d.current,phase:d.phase,status:d.status,completed:d.completed,launchOwner:d.launchOwner,updatedAt:d.updatedAt};}catch(e){pack.progress.error=String(e);}var names=['总控.zjs','王者桌面启动.zjs','初始化OCR.zjs','祝福.zjs','普通祝福.zjs','智能祝福.zjs','祝福判定.zjs','1v1.zjs','55.zjs'];for(var i=0;i<names.length;i++){var m={name:names[i]};try{var s=String(z.readFile('/storage/emulated/0/自动精灵/'+names[i])||'');m.chars=s.length;m.fingerprint=hash(s);m.emptyOrMissing=!s;}catch(e){m.error=String(e);}pack.scripts.push(m);}var start=0;for(var pi=0;pi<pack.logs.length;pi++){if(pack.logs[pi].path==='总控_启动来源取证.jsonl'){var pl=String(pack.logs[pi].content||'').split(/\\r?\\n/);for(var pj=0;pj<pl.length;pj++){try{var pe=JSON.parse(pl[pj]);if(pe.event==='ENGINE_BOOT'&&Number(pe.t)>start)start=Number(pe.t);}catch(e){}}}}pack.scope={latestBootMs:start,mode:'recent-session-capped',limits:'each log <=22000 characters; first 5 and recent tail when capped',warning:'历史与中间事件可能省略；完整日志保留在设备。'};for(var pi=0;pi<pack.logs.length;pi++){var it=pack.logs[pi],raw=String(it.content||''),ls=raw.split(/\\r?\\n/),keep=[],unparsed=0;it.originalChars=raw.length;it.originalLines=ls.length;for(var pj=0;pj<ls.length;pj++){var line=ls[pj];if(!line)continue;var ms=0;try{var e=JSON.parse(line),t=e.ms||e.t||e.ts;ms=typeof t==='number'?t:Date.parse(String(t||''));}catch(err){var mt=line.match(/\\d{4}-\\d\\d-\\d\\dT\\d\\d:\\d\\d:\\d\\d(?:\\.\\d+)?Z/);if(mt)ms=Date.parse(mt[0]);}if(!start||!ms||ms>=start-60000)keep.push(line);if(!ms)unparsed++;}it.timeFilteredLines=keep.length;it.unparsedTimeLines=unparsed;var selected=keep.join('\\n');it.truncated=selected.length>22000;if(it.truncated){var head=keep.slice(0,5).join('\\n');if(head.length>4000)head=head.slice(0,4000);var tail=[],size=0;for(var pj=keep.length-1;pj>=5;pj--){if(size+keep[pj].length+1>17000)break;tail.unshift(keep[pj]);size+=keep[pj].length+1;}selected=head+'\\n[中间内容因报告大小限制省略，原始文件未删]\\n'+tail.join('\\n');}it.content=selected;it.includedChars=selected.length;it.filtered=selected!==raw;}var trace=[];for(var li=0;li<pack.logs.length;li++){if(pack.logs[li].path==='总控_启动来源取证.jsonl'){var ls=String(pack.logs[li].content||'').split(/\\r?\\n/);for(var ri=0;ri<ls.length;ri++){try{if(ls[ri])trace.push(JSON.parse(ls[ri]));}catch(e){}}}}var brief=['农场总控｜统一诊断与完整取证','采集时间：'+pack.collectedAt,'只需发送本文件；下方为本轮筛选证据；历史与超限内容可能省略，原件仍保留。',''],missing=[];for(var li=0;li<pack.logs.length;li++){var it=pack.logs[li];if(it.emptyOrMissing||it.error)missing.push(it.path+(it.error?'：'+it.error:'：空或不存在'));}brief.push('【证据完整性】');brief.push(missing.length?missing.join('\\n'):'指定日志均读到内容；报告按本轮和大小筛选，不代表证据完整。');brief.push('','【最近关键事件，保留各自运行身份】');var events=[];for(var ti=0;ti<trace.length;ti++){var e=trace[ti];if(e.event==='ENGINE_BOOT'||String(e.event).indexOf('PROGRESS_WRITE_')===0||(e.event==='ACTION_ENTER'&&String(e.source).indexOf('/vars/5/')>=0))events.push(e);}events=events.slice(-35);for(var ei=0;ei<events.length;ei++){var e=events[ei],f=e.file||{};brief.push(new Date(e.t).toISOString()+' '+e.event+' source='+e.source+' boot='+e.boot+' sid='+e.sid+' local='+e.localRun+' global='+e.globalRun+' file='+f.run+' order='+JSON.stringify(f.order||[])+' status='+f.status);}if(!events.length)brief.push('无新版取证事件；请结合下方V2与旧追踪分析，不能据此认定正常结束。');brief.push('','【当前进度快照】',JSON.stringify(pack.progress),'','【本轮筛选证据 JSON，截断情况见各日志字段】',JSON.stringify(pack));z.writeFile(root+'农场总控_统一诊断.txt',brief.join('\\n'));})();"}

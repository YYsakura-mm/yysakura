{"repeatCount":1,"pauseOnFail":false,"count":1,"minVerCode":2021000,"minVerName":"2.21.0","screenWidth":720,"screenHeight":1280,"screenDpi":2,"lastSaveScreenWidth":720,"lastSaveScreenHeight":1280,"savedVerCode":26000050,"savedVerName":"26.5.0","description":"只读收集总控关键日志，按本轮运行ID和时间合并成一份诊断文本；不会清除历史日志或修改任何配置。"}
{"type":"运行JS代码","delay":"0","delayUnit":1,"repeatCount":1,"desc":"一键汇总本轮王者任务配置、逐区轨迹、阶段交接、异常和其他并发运行","jsCode":"(function(){\n  // Single-file export. Read-only to farm progress, tasks and configs.\n  var DIR='/sdcard/Download/农场总控日志/';\n  var OUT='/sdcard/Download/农场总控_统一诊断.txt';\n  var sources=[\n    ['任务链_本轮.log','TASK'],\n    ['农场总控_配置链路.log','CONFIG'],\n    ['农场总控_V43调度诊断.log','STAGE'],\n    ['双王者V3_日志.txt','SWITCH'],\n    ['农场总控_互斥与收尾.log','LOCK'],\n    ['农场总控_退出诊断.log','EXIT'],\n    ['农场总控_临时运行启动.log','START'],\n    ['农场总控_V46流程.log','ZONE']\n  ];\n  function read(p){try{return String(zdjl.readFile(p)||'');}catch(e){return '';}}\n  function lines(s){return String(s||'').split(/\\r?\\n/).filter(function(x){return !!x;});}\n  function log(t){try{zdjl.toast(t,2500);}catch(e){}}\n  function pickLastRun(text){\n    var a=lines(text),last=null;\n    for(var i=0;i<a.length;i++){\n      var m=a[i].match(/^(\\d{4}-\\d\\d-\\d\\dT\\d\\d:\\d\\d:\\d\\d[^ ]*) V53_NEW_RUN runId=([^\\s]+)/);\n      if(m)last={at:m[1],runId:m[2]};\n    }\n    if(!last){for(var j=a.length-1;j>=0;j--){var k=a[j].match(/^(\\S+) MANUAL_START runId=(\\S+)/);if(k){last={at:k[1],runId:k[2]};break;}}}\n    return last;\n  }\n  var raw={};for(var i=0;i<sources.length;i++)raw[sources[i][0]]=read(DIR+sources[i][0]);\n  var run=pickLastRun(raw['任务链_本轮.log']);\n  var since=run?new Date(Math.max(0,Date.parse(run.at)-60000)).toISOString():'';\n  if(!since){ // For missing current-run log, still show recent tail, not older execution as fact.\n    since=new Date(Date.now()-2*3600*1000).toISOString().slice(0,19);\n  }\n  var keyRe=/(V53_NEW_RUN|MANUAL_START|PREPARE_OK|V43_FROZEN_TASKS|DISPATCH_NEW|V40_DISPATCH_CONFIG|V37_PLAN|V37_STAGE|INIT_OK|INIT_MISMATCH|V46_STAGE_START|ZONE_BEGIN|ZONE_RETURN|STAGE_INPUT|CHECK king=|CONFIG_ERROR|TASK_FINISHED|FLOW_BLOCKED|STAGE_DECISION|TASK_NEXT|TASK_SWITCH_PERSIST|NEXT_STAGE|FINAL_DONE|CLIENT_PHASE_COMPLETE|PHASE_FINISH|GATE_DENY|STALE_OWNER|FRESH_START|ERROR|ABORT|STOP|BLOCKED|DETAIL_|HOME_CLOSED|NEXT_TASK)/;\n  var rows=[],others=[],snapshots=[],counts={},eventCounts={};\n  function containsOtherRun(s){\n    var m=s.match(/(?:runId=|token=)(\\d{12,}-\\d+)/);\n    return !!(m&&run&&m[1]!==run.runId);\n  }\n  for(var si=0;si<sources.length;si++){\n    var fn=sources[si][0],tag=sources[si][1],arr=lines(raw[fn]);\n    for(var li=0;li<arr.length;li++){\n      var s=arr[li],m=s.match(/^(\\d{4}-\\d\\d-\\d\\dT\\d\\d:\\d\\d:\\d\\d[^ ]*) /);\n      if(!m||m[1]<since||!keyRe.test(s))continue;\n      if(containsOtherRun(s)){\n        if(/ZONE_BEGIN|ZONE_RETURN|NEXT_STAGE|CLIENT_PHASE_COMPLETE/.test(s))others.push({at:m[1],src:tag,s:s});\n        continue;\n      }\n      var entry={at:m[1],src:tag,s:s};rows.push(entry);\n      if(tag==='CONFIG'&&s.indexOf('V40_DISPATCH_CONFIG')>=0)snapshots.push(s);\n      if(tag==='TASK'&&s.indexOf('ZONE_BEGIN token=')>=0){\n        var k=s.match(/\\|(\\d+)\\|0\\|(\\d+)\\|(\\d+) action=([^ ]+)/);\n        // full token form: runId|client|phase|account|slot|zone\n        var v=s.match(/token=[^|]+\\|(\\d+)\\|(\\d+)\\|(\\d+)\\|(\\d+)\\|(\\d+) action=([^ ]+)/);\n        if(v){var ident='王者'+v[1]+' 任务槽'+v[4]+' '+v[6];counts[ident]=(counts[ident]||0)+1;}\n      }\n      var ev=s.match(/ (TASK_NEXT|NEXT_STAGE|FLOW_BLOCKED|GATE_DENY|CONFIG_ERROR|TASK_FINISHED|STAGE_DECISION|CLIENT_PHASE_COMPLETE|ZONE_BEGIN|ZONE_RETURN)\\b/);\n      if(ev)eventCounts[ev[1]]=(eventCounts[ev[1]]||0)+1;\n    }\n  }\n  rows.sort(function(a,b){return a.at<b.at?-1:a.at>b.at?1:0;});\n  others.sort(function(a,b){return a.at<b.at?-1:1;});\n  var out=[];\n  out.push('农场总控｜单文件执行诊断');\n  out.push('导出时间：'+new Date().toISOString());\n  out.push('本轮运行：'+(run?run.runId:'未找到，按最近2小时检索'));\n  out.push('日志起点：'+since);\n  out.push('说明：只读取原始日志；不会修改总控、配置、进度或任务。');\n  out.push('重要：输入框原始变化如果此前未记录，则无法从历史日志反推。');\n  out.push('');\n  out.push('＝＝＝＝ 冻结任务配置（最终执行依据）＝＝＝＝');\n  if(!snapshots.length)out.push('(未找到王者配置快照)');\n  for(var n=0;n<snapshots.length;n++)out.push(snapshots[n]);\n  out.push('');\n  out.push('＝＝＝＝ 进入各任务槽的次数（并非游戏内成功次数）＝＝＝＝');\n  var names=Object.keys(counts).sort();\n  if(!names.length)out.push('(没有匹配的 ZONE_BEGIN)');\n  for(n=0;n<names.length;n++)out.push(names[n]+'：'+counts[names[n]]+'区');\n  out.push('');\n  out.push('＝＝＝＝ 调度关键事件数量 ＝＝＝＝');\n  names=Object.keys(eventCounts).sort();for(n=0;n<names.length;n++)out.push(names[n]+'='+eventCounts[names[n]]);\n  out.push('');\n  out.push('＝＝＝＝ 本轮完整关键轨迹（时间排序）＝＝＝＝');\n  var cap=3000;if(rows.length>cap){out.push('事件过多，仅保留最后'+cap+'条，共'+rows.length+'条');rows=rows.slice(-cap);}\n  for(n=0;n<rows.length;n++)out.push('['+rows[n].src+'] '+rows[n].s);\n  out.push('');\n  out.push('＝＝＝＝ 发现其他运行编号仍在写日志（重点检查并发）＝＝＝＝');\n  out.push('其他实例记录数：'+others.length);\n  if(others.length>80)others=others.slice(0,40).concat(others.slice(-40));\n  for(n=0;n<others.length;n++)out.push('['+others[n].src+'] '+others[n].s);\n  out.push('');\n  out.push('＝＝＝＝ 终 ＝＝＝＝');\n  try{zdjl.writeFile(OUT,out.join('\\n')+'\\n');var test=read(OUT);\n    if(test.indexOf('农场总控｜单文件执行诊断')===0){log('已导出统一诊断：Download/农场总控_统一诊断.txt');}\n    else log('日志导出后回读异常，请检查下载目录');\n  }catch(e){log('日志导出失败：'+String(e));}\n})();"}

ext',humanRecMaxPositionCount:1}));}catch(e){zdjl.setVar('特升读取错误',String(e),'global');}zdjl.setVar(\"特升面板\",value,'global');})();"}],"runMode":"normal"},{"type":"运行JS代码","delay":"0","delayUnit":1,"desc":"识别特升在等级页","jsCode":"(function(){var value=null;try{value=(/\\d[\\d.,，．]*(?:万|萬|亿)?[/／]\\d/.test(zdjl.getVar('特升面板','global')) || /农场小[摊攤州]等级上限|可开[垦恳]农田/.test(zdjl.getVar('特升面板','global'))) || ((/作物售[价價]|售[价價]|小[摊攤]|当前等[级級]|下[一ー－-][级級]/.test(zdjl.getVar('特升面板','global'))) && !(/\\d[\\d.,，．]*(?:万|萬|亿)?[/／]\\d/.test(zdjl.getVar('特升面板','global')) || /农场小[摊攤州]等级上限|可开[垦恳]农田/.test(zdjl.getVar('特升面板','global')))) || (/(?:农[场場][币幣市]|[金錢钱][币幣]?).{0,4}不[足够夠]|余[额額]不足/.test(zdjl.getVar('特升面板','global')));}catch(e){zdjl.setVar('特升读取错误',String(e),'global');}zdjl.setVar(\"特升在等级页\",value,'global');})();"},{"type":"运行JS代码","delay":"0","delayUnit":1,"desc":"识别特升报价原文","jsCode":"(function(){var value=null;try{value=(function(r){return String((r && r.text) || r || '').replace(/\\s+/g,'');})(zdjl.recognitionScreen({recognitionArea:特升报价区,recognitionMode:'ocr_local_comp',ocrResultType:'text',humanRecMaxPositionCount:1}));}catch(e){zdjl.setVar('特升读取错误',String(e),'global');}zdjl.setVar(\"特升报价原文\",value,'global');})();"},{"type":"运行JS代码","delay":"0","delayUnit":1,"desc":"识别特升农原文","jsCode":"(function(){var value=null;try{value=zdjl.getVar('特升面板','global');}catch(e){zdjl.setVar('特升读取错误',String(e),'global');}zdjl.setVar(\"特升农原文\",value,'global');})();"},{"type":"运行JS代码","delay":"0","delayUnit":1,"desc":"识别特升农价","jsCode":"(function(){var value=null;try{value=(/\\d[\\d.,，．]*(?:万|萬|亿)?[/／]\\d/.test(zdjl.getVar('特升面板','global')) || /农场小[摊攤州]等级上限|可开[垦恳]农田/.test(zdjl.getVar('特升面板','global'))) ? (function(){\nfunction money(s){\n  var normalized=normalize(s).replace(/，/g,',');\n  normalized=normalized.replace(/^(\\d+),(\\d{1,2})(?=[万亿]?$)/,'$1.$2').replace(/,/g,'');\n  var m=normalized.match(/^(\\d+(?:\\.\\d+)?)(万|亿)?$/);\n  if(!m)return -1;\n  var n=Number(m[1])*(m[2]==='亿'?1e8:m[2]==='万'?1e4:1);\n  return isFinite(n)?n:-1;\n}\nfunction normalize(s){\n  return String(s==null?'':s).replace(/[０-９．，／％]/g,function(c){\n    return String.fromCharCode(c.charCodeAt(0)-65248);\n  }).replace(/[萬億]/g,function(c){return c==='萬'?'万':'亿';})\n    .replace(/[\\s\\u200b-\\u200d\\ufeff]/g,'').replace(/。(?=\\d)/g,'.')\n    .replace(/(\\d)[wW](?=\\D|$)/g,'$1万');\n}\nfunction price(s){\n  s=normalize(s).replace(/([0-9])(?:[wW]|[力方])(?=[升级开昇])/g,'$1万');\n  var hits=s.match(/\\d+(?:[.,，]\\d+)*(?:万|亿)?[升级开昇]{1,2}[级級](?!效果|奖励|所需)/g);\n  if(!hits)return -1;\n  var amount=hits[hits.length-1].replace(/[升级开昇级級]+$/,'');\n  // Whole coins are displayed as integers. A decimal upgrade quote with the\n  // unit dropped uses the same ten-thousand display as both recorded pages.\n  if(!/[万亿]$/.test(amount)&&/^\\d+[.,，]\\d{2}$/.test(amount))amount+='万';\n  return money(amount);\n}\nfunction buttonPrice(raw,panel){\n  var s=normalize(raw).replace(/^[^0-9]+/,'');\n  var n=price(s);\n  if(n>0)return n;\n  var amount=s.match(/^([0-9]+(?:[.,][0-9]+)*(?:万|亿)?)$/);\n  if(amount){\n    var value=amount[1];\n    if(!/[万亿]$/.test(value)&&/^[0-9]+[.,][0-9]{2}$/.test(value))value+='万';\n    return money(value);\n  }\n  // A full-panel OCR line can concatenate the XP reward and button amount.\n  if(/奖.{0,4}[0-9]{4,}[.,][0-9]{1,2}(?:万|亿)?[升级开昇]{1,2}[级級]/.test(normalize(panel)))return -1;\n  return price(panel);\n}\nfunction wallet(raw,panel){\n  panel=normalize(panel);\n  var n=money(raw);\n  if(n>=0)return n;\n  if(!/当前等[级級]|下[一ー－-][级級]|XP|作物售[价價]/i.test(panel))return -1;\n  var m=panel.match(/^(\\d+(?:\\.\\d+)?[万亿])/);\n  n=m?money(m[1]):-1;\n  var quote=price(panel);\n  return /农[场場][币幣市].{0,4}不[足够夠]/.test(panel)&&quote>0&&n>=quote?-1:n;\n}\nfunction eligible(s){\n  s=normalize(s);\n  var m=s.match(/([\\d.,，]+(?:万|亿)?)[/／]([\\d.,，]+(?:万|亿)?)/) ||\n        s.match(/([0-9]+(?:[.,][0-9]+)?[万亿])([0-9]+(?:[.,][0-9]+)?[万亿])/);\n  return !!m && money(m[2])>0 && money(m[1])>=money(m[2]);\n}\nfunction stallBonus(s){\n  var matches=normalize(s).match(/([0-9]{1,3})%[^0-9%]{0,5}([0-9]{1,3})%/g)||[];\n  if(matches.length!==1)return null;\n  var values=matches[0].match(/[0-9]+/g).map(Number);\n  return values[1]-values[0]===5?values:null;\n}\nreturn buttonPrice(zdjl.getVar('特升报价原文','global'),String(zdjl.getVar('特升面板','global')||''));})() : -1;}catch(e){zdjl.setVar('特升读取错误',String(e),'global');}zdjl.setVar(\"特升农价\",value,'global');})();"},{"type":"运行JS代码","delay":"0","delayUnit":1,"desc":"识别特升经验达标","jsCode":"(function(){var value=null;try{value=(function(){\nfunction money(s){\n  var normalized=normalize(s).replace(/，/g,',');\n  normalized=normalized.replace(/^(\\d+),(\\d{1,2})(?=[万亿]?$)/,'$1.$2').replace(/,/g,'');\n  var m=normalized.match(/^(\\d+(?:\\.\\d+)?)(万|亿)?$/);\n  if(!m)return -1;\n  var n=Number(m[1])*(m[2]==='亿'?1e8:m[2]==='万'?1e4:1);\n  return isFinite(n)?n:-1;\n}\nfunction normalize(s){\n  return String(s==null?'':s).replace(/[０-９．，／％]/g,function(c){\n    return String.fromCharCode(c.charCodeAt(0)-65248);\n  }).replace(/[萬億]/g,function(c){return c==='萬'?'万':'亿';})\n    .replace(/[\\s\\u200b-\\u200d\\ufeff]/g,'').replace(/。(?=\\d)/g,'.')\n    .replace(/(\\d)[wW](?=\\D|$)/g,'$1万');\n}\nfunction price(s){\n  s=normalize(s).replace(/([0-9])(?:[wW]|[力方])(?=[升级开昇])/g,'$1万');\n  var hits=s.match(/\\d+(?:[.,，]\\d+)*(?:万|亿)?[升级开昇]{1,2}[级級](?!效果|奖励|所需)/g);\n  if(!hits)return -1;\n  var amount=hits[hits.length-1].replace(/[升级开昇级級]+$/,'');\n  // Whole coins are displayed as integers. A decimal upgrade quote with the\n  // unit dropped uses the same ten-thousand display as both recorded pages.\n  if(!/[万亿]$/.test(amount)&&/^\\d+[.,，]\\d{2}$/.test(amount))amount+='万';\n  return money(amount);\n}\nfunction buttonPrice(raw,panel){\n  var s=normalize(raw).replace(/^[^0-9]+/,'');\n  var n=price(s);\n  if(n>0)return n;\n  var amount=s.match(/^([0-9]+(?:[.,][0-9]+)*(?:万|亿)?)$/);\n  if(amount){\n    var value=amount[1];\n    if(!/[万亿]$/.test(value)&&/^[0-9]+[.,][0-9]{2}$/.test(value))value+='万';\n    return money(value);\n  }\n  // A full-panel OCR line can concatenate the XP reward and button amount.\n  if(/奖.{0,4}[0-9]{4,}[.,][0-9]{1,2}(?:万|亿)?[升级开昇]{1,2}[级級]/.test(normalize(panel)))return -1;\n  return price(panel);\n}\nfunction wallet(raw,panel){\n  panel=normalize(panel);\n  var n=money(raw);\n  if(n>=0)return n;\n  if(!/当前等[级級]|下[一ー－-][级級]|XP|作物售[价價]/i.test(panel))return -1;\n  var m=panel.match(/^(\\d+(?:\\.\\d+)?[万亿])/);\n  n=m?money(m[1]):-1;\n  var quote=price(panel);\n  return /农[场場][币幣市].{0,4}不[足够夠]/.test(panel)&&quote>0&&n>=quote?-1:n;\n}\nfunction eligible(s){\n  s=normalize(s);\n  var m=s.match(/([\\d.,，]+(?:万|亿)?)[/／]([\\d.,，]+(?:万|亿)?)/) ||\n        s.match(/([0-9]+(?:[.,][0-9]+)?[万亿])([0-9]+(?:[.,][0-9]+)?[万亿])/);\n  return !!m && money(m[2])>0 && money(m[1])>=money(m[2]);\n}\nfunction stallBonus(s){\n  var matches=normalize(s).match(/([0-9]{1,3})%[^0-9%]{0,5}([0-9]{1,3})%/g)||[];\n  if(matches.length!==1)return null;\n  var values=matches[0].match(/[0-9]+/g).map(Number);\n  return values[1]-values[0]===5?values:null;\n}\nreturn eligible(String(zdjl.getVar('特升面板','global')||''));})();}catch(e){zdjl.setVar('特升读取错误',String(e),'global');}zdjl.setVar(\"特升经验达标\",value,'global');})();"},{"type":"运行JS代码","delay":"0","delayUnit":1,"desc":"识别特升余额原文","jsCode":"(function(){var value=null;try{value=(function(r){return String((r && r.text) || r || '').replace(/\\s+/g,'');})(zdjl.recognitionScreen({recognitionArea:特升余额区,recognitionMode:'ocr_local_comp',ocrResultType:'text',humanRecMaxPositionCount:1}));}catch(e){zdjl.setVar('特升读取错误',String(e),'global');}zdjl.setVar(\"特升余额原文\",value,'global');})();"},{"type":"运行JS代码","delay":"0","delayUnit":1,"desc":"识别特升余额","jsCode":"(function(){var value=null;try{value=(function(){\nfunction money(s){\n  var normalized=normalize(s).replace(/，/g,',');\n  normalized=normalized.replace(/^(\\d+),(\\d{1,2})(?=[万亿]?$)/,'$1.$2').replace(/,/g,'');\n  var m=normalized.match(/^(\\d+(?:\\.\\d+)?)(万|亿)?$/);\n  if(!m)return -1
2])>0 && money(m[1])>=money(m[2]);\n}\nfunction stallBonus(s){\n  var matches=normalize(s).match(/([0-9]{1,3})%[^0-9%]{0,5}([0-9]{1,3})%/g)||[];\n  if(matches.length!==1)return null;\n  var values=matches[0].match(/[0-9]+/g).map(Number);\n  return values[1]-values[0]===5?values:null;\n}\nreturn wallet(zdjl.getVar('特升余额原文','global'),zdjl.getVar('特升农原文','global'));})();}catch(e){zdjl.setVar('特升读取错误',String(e),'global');}zdjl.setVar(\"特升余额\",value,'global');})();"},{"type":"运行JS代码","delay":"0","delayUnit":1,"desc":"识别特升农币不足","jsCode":"(function(){var value=null;try{value=/(?:农[场場][币幣市]|[金錢钱][币幣]?).{0,4}不[足够夠]|余[额額]不足/.test(zdjl.getVar('特升面板','global'));}catch(e){zdjl.setVar('特升读取错误',String(e),'global');}zdjl.setVar(\"特升农币不足\",value,'global');})();"},{"type":"运行JS代码","delay":"0","delayUnit":1,"desc":"识别特升农可升","jsCode":"(function(){var value=null;try{value=zdjl.getVar('特升经验达标','global') && !zdjl.getVar('特升农币不足','global') && (zdjl.getVar('特升余额','global')<0 || zdjl.getVar('特升农价','global')<=0 || zdjl.getVar('特升余额','global')>=zdjl.getVar('特升农价','global'));}catch(e){zdjl.setVar('特升读取错误',String(e),'global');}zdjl.setVar(\"特升农可升\",value,'global');})();"},{"type":"运行JS代码","delay":"0","delayUnit":1,"desc":"识别特升需筹款","jsCode":"(function(){var value=null;try{value=zdjl.getVar('特升农币不足','global') || (zdjl.getVar('特升经验达标','global') && zdjl.getVar('特升农价','global')>0 && zdjl.getVar('特升余额','global')>=0 && zdjl.getVar('特升余额','global')<zdjl.getVar('特升农价','global'));}catch(e){zdjl.setVar('特升读取错误',String(e),'global');}zdjl.setVar(\"特升需筹款\",value,'global');})();"},{"type":"运行JS代码","delay":"0","delayUnit":1,"desc":"升级预算","jsCode":"\n(function(){\n  try {\n    var z=zdjl;\n    function get(k){return z.getVar(k,'global');}\n    z.appendFile('/sdcard/Download/农场特殊功能.jsonl', JSON.stringify({\n      at:new Date().toISOString(),version:'领奖后-v7',event:\"升级预算\",\n      run:get('双王者运行ID'),king:get('双王者当前端'),account:get('当前第几个号'),\n      zone:get('当前区'),task:get('做啥'),detail:{xp:get('特升经验达标'),farm:get('特
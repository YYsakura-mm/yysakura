alize(raw).replace(/^[^0-9]+/,'');\n  var n=price(s);\n  if(n>0)return n;\n  var amount=s.match(/^([0-9]+(?:[.,][0-9]+)*(?:万|亿)?)$/);\n  if(amount){\n    var value=amount[1];\n    if(!/[万亿]$/.test(value)&&/^[0-9]+[.,][0-9]{2}$/.test(value))value+='万';\n    return money(value);\n  }\n  // A full-panel OCR line can concatenate the XP reward and button amount.\n  if(/奖.{0,4}[0-9]{4,}[.,][0-9]{1,2}(?:万|亿)?[升级开昇]{1,2}[级級]/.test(normalize(panel)))return -1;\n  return price(panel);\n}\nfunction wallet(raw,panel){\n  panel=normalize(panel);\n  var n=money(raw);\n  if(n>=0)return n;\n  if(!/当前等[级級]|下[一ー－-][级級]|XP|作物售[价價]/i.test(panel))return -1;\n  var m=panel.match(/^(\\d+(?:\\.\\d+)?[万亿])/);\n  n=m?money(m[1]):-1;\n  var quote=price(panel);\n  return /农[场場][币幣市].{0,4}不[足够夠]/.test(panel)&&quote>0&&n>=quote?-1:n;\n}\nfunction eligible(s){\n  s=normalize(s);\n  var m=s.match(/([\\d.,，]+(?:万|亿)?)[/／]([\\d.,，]+(?:万|亿)?)/) ||\n        s.match(/([0-9]+(?:[.,][0-9]+)?[万亿])([0-9]+(?:[.,][0-9]+)?[万亿])/);\n  return !!m && money(m[2])>0 && money(m[1])>=money(m[2]);\n}\nfunction stallBonus(s){\n  var matches=normalize(s).match(/([0-9]{1,3})%[^0-9%]{0,5}([0-9]{1,3})%/g)||[];\n  if(matches.length!==1)return null;\n  var values=matches[0].match(/[0-9]+/g).map(Number);\n  return values[1]-values[0]===5?values:null;\n}\nreturn eligible(String(zdjl.getVar('特升面板','global')||''));})())) && !(/(?:农[场場][币幣市]|[金錢钱][币幣]?).{0,4}不[足够夠]|余[额額]不足/.test(zdjl.getVar('特升面板','global'))) && !(/经验不足|已满级|已达上限|未达到|无法升级/.test(zdjl.getVar('特升面板','global')));}catch(e){return false;}})()"}},{"type":"运行JS代码","delay":"0.65","delayUnit":1,"desc":"识别特升面板","jsCode":"(function(){var value=null;try{value=(function(r){return String((r && r.text) || r || '').replace(/\\s+/g,'');})(zdjl.recognitionScreen({recognitionArea:特升识别区,recognitionMode:'ocr_local_comp',ocrResultType:'text',humanRecMaxPositionCount:1}));}catch(e){zdjl.setVar('特升读取错误',String(e),'global');}zdjl.setVar(\"特升面板\",value,'global');})();"}],"runMode":"normal"
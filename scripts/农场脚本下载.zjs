{"repeatCount":1,"pauseOnFail":false,"count":1,"minVerCode":2021000,"minVerName":"2.21.0","screenWidth":720,"screenHeight":1280,"screenDpi":2,"lastSaveScreenWidth":1280,"lastSaveScreenHeight":720,"lastSaveScreenDpi":2,"savedVerCode":26000050,"savedVerName":"26.5.0","delay":"0","delayUnit":1,"description":"农场脚本下载 V4.6｜Git blob SHA增量比较｜只下载变化文件｜API一致性"}
{"type":"运行JS代码","delay":"0","delayUnit":1,"repeatCount":1,"desc":"V4.6增量下载｜3个小请求确认版本 + 只下载真正变化ZJS","jsCode":"(function(){\n    var OWNER=\"YYsakura-mm\";\n    var REPO=\"yysakura\";\n    var BRANCH=\"main\";\n    var BASE_DIR=\"/storage/emulated/0/自动精灵/\";\n    var META_DIR=\".farmcloud/\";\n    var CLOUD_DIR=\"scripts/\";\n    var NS=\"farm-cloud-v4\";\n    var TOKEN_NS=\"github-sync\";\n    var startedAt=Date.now();\n    var netCount=0;\n\n    function trimText(v){return String(v==null?\"\":v).replace(/^\\s+|\\s+$/g,\"\");}\n    function safeErrorText(e){\n        var s=String(e==null?\"\":e);\n        s=s.replace(/(Authorization value:\\s*Bearer\\s+)[^\\r\\n]+/ig,\"$1***\");\n        s=s.replace(/(Bearer\\s+)(github_pat_|gh[pousr]_)[A-Za-z0-9_\\-]+/g,\"$1***\");\n        return s;\n    }\n    function looksLikeToken(v){\n        var s=trimText(v);\n        return !!s&&!/[^\\x21-\\x7E]/.test(s)&&!/\\s/.test(s)&&s.length>=20&&/^(github_pat_|gh[pousr]_)/.test(s);\n    }\n    function getToken(){\n        var t=\"\";\n        try{t=trimText(zdjl.getStorage(\"github_read_token\",NS));}catch(e){}\n        if(looksLikeToken(t))return t;\n        try{t=trimText(zdjl.getStorage(\"github_token\",TOKEN_NS));}catch(e2){}\n        if(looksLikeToken(t))return t;\n        try{t=trimText(zdjl.getStorage(\"github_token\",NS));}catch(e3){}\n        return looksLikeToken(t)?t:\"\";\n    }\n    var token=getToken();\n\n    function encPath(path){\n        var a=String(path).split(\"/\"),out=[];\n        for(var i=0;i<a.length;i++)out.push(encodeURIComponent(a[i]));\n        return out.join(\"/\");\n    }\n    function headers(raw){\n        var h=[\n            {\"X-GitHub-Api-Version\":\"2022-11-28\"},\n            {\"Accept\":raw?\"application/vnd.github.raw+json\":\"application/vnd.github+json\"}\n        ];\n        if(token)h.unshift({\"Authorization\":\"Bearer \"+token});\n        return h;\n    }\n    function transient(code){return code===408||code===429||code===500||code===502||code===503||code===504;}\n    function req(opt,maxTry){\n        maxTry=maxTry||2;\n        var last=null,err=null;\n        for(var i=1;i<=maxTry;i++){\n            try{\n                netCount++;\n                last=zdjl.requestUrl(opt);\n                if(last&&!transient(last.code))return last;\n                err=new Error(\"HTTP \"+(last?last.code:\"?\"));\n            }catch(e){err=e;}\n            if(i<maxTry)try{zdjl.sleep(500*i);}catch(se){}\n        }\n        if(last)return last;\n        throw err||new Error(\"网络请求失败\");\n    }\n    function apiContents(path,ref){\n        var u=\"https://api.github.com/repos/\"+OWNER+\"/\"+REPO+\"/contents/\"+encPath(path);\n        if(ref)u+=\"?ref=\"+encodeURIComponent(ref);\n        return u;\n    }\n    function getRaw(path,ref){\n        var r=req({url:apiContents(path,ref||BRANCH),method:\"GET\",headers:headers(true),timeout:20000},2);\n        if(r.code===403&&!token)throw new Error(\"GitHub匿名API额度不足，请在主设备发布器或版本更新器中保存Token后再试。\");\n        return r;\n    }\n    function getJson(path,ref){\n        var r=getRaw(path,ref);\n        if(r.code!==200)throw new Error(\"读取 \"+path+\" 失败 HTTP \"+r.code+\"\\n\"+r.body);\n        return JSON.parse(String(r.body||\"\"));\n    }\n\n    function utf8Bytes(str){\n        var bytes=[]; str=String(str);\n        for(var i=0;i<str.length;i++){\n            var c=str.charCodeAt(i);\n            if(c<0x80) bytes.push(c);\n            else if(c<0x800){\n                bytes.push(0xC0|(c>>6),0x80|(c&63));\n            }else if(c>=0xD800&&c<=0xDBFF&&i+1<str.length){\n                var c2=str.charCodeAt(++i);\n                var cp=0x10000+(((c&0x3FF)<<10)|(c2&0x3FF));\n                bytes.push(0xF0|(cp>>18),0x80|((cp>>12)&63),0x80|((cp>>6)&63),0x80|(cp&63));\n            }else{\n                bytes.push(0xE0|(c>>12),0x80|((c>>6)&63),0x80|(c&63));\n            }\n        }\n        return bytes;\n    }\n    function rol(v,n){return ((v<<n)|(v>>>(32-n)))>>>0;}\n    function hex8(n){return (\"00000000\"+(n>>>0).toString(16)).slice(-8);}\n    function sha1Bytes(bytes){\n        var msg=bytes.slice(), bitLen=msg.length*8;\n        msg.push(0x80);\n        while((msg.length%64)!==56) msg.push(0);\n        var hi=Math.floor(bitLen/0x100000000), lo=bitLen>>>0;\n        msg.push((hi>>>24)&255,(hi>>>16)&255,(hi>>>8)&255,hi&255,\n                 (lo>>>24)&255,(lo>>>16)&255,(lo>>>8)&255,lo&255);\n        var h0=0x67452301,h1=0xEFCDAB89,h2=0x98BADCFE,h3=0x10325476,h4=0xC3D2E1F0;\n        var w=new Array(80);\n        for(var o=0;o<msg.length;o+=64){\n            for(var i=0;i<16;i++){\n                var p=o+i*4;\n                w[i]=(((msg[p]<<24)|(msg[p+1]<<16)|(msg[p+2]<<8)|msg[p+3])>>>0);\n            }\n            for(var j=16;j<80;j++) w[j]=rol(w[j-3]^w[j-8]^w[j-14]^w[j-16],1);\n            var a=h0,b=h1,c=h2,d=h3,e=h4;\n            for(var t=0;t<80;t++){\n                var f,k;\n                if(t<20){f=(b&c)|((~b)&d);k=0x5A827999;}\n                else if(t<40){f=b^c^d;k=0x6ED9EBA1;}\n                else if(t<60){f=(b&c)|(b&d)|(c&d);k=0x8F1BBCDC;}\n                else{f=b^c^d;k=0xCA62C1D6;}\n                var temp=(rol(a,5)+(f>>>0)+e+k+w[t])>>>0;\n                e=d;d=c;c=rol(b,30);b=a;a=temp;\n            }\n            h0=(h0+a)>>>0; h1=(h1+b)>>>0; h2=(h2+c)>>>0; h3=(h3+d)>>>0; h4=(h4+e)>>>0;\n        }\n        return hex8(h0)+hex8(h1)+hex8(h2)+hex8(h3)+hex8(h4);\n    }\n    function gitBlobSha(text){\n        var body=utf8Bytes(String(text));\n        var head=utf8Bytes(\"blob \"+body.length+\"\\0\");\n        return sha1Bytes(head.concat(body));\n    }\n\n    function safeName(name){return typeof name===\"string\"&&/^[^\\\\\\/\\x00-\\x1f]+\\.zjs$/i.test(name)&&name.indexOf(\"..\")<0;}\n    function validateScript(text,name){\n        var lines=String(text||\"\").split(/\\r?\\n/),count=0;\n        for(var i=0;i<lines.length;i++){\n            if(!trimText(lines[i]))continue;\n            var row=JSON.parse(lines[i]);\n            if(!row||typeof row!==\"object\"||Array.isArray(row))throw new Error(name+\"格式错误\");\n            if(count===0){\n                if(row.type!==undefined||row.count===undefined||row.repeatCount===undefined)throw new Error(name+\"文件头异常\");\n            }else if(!row.type)throw new Error(name+\"动作类型缺失\");\n            count++;\n        }\n        if(count<2)throw new Error(name+\"没有可执行动作\");\n    }\n    function localText(path){try{return String(zdjl.readFile(path));}catch(e){return null;}}\n    function backupName(name){return BASE_DIR+name+\".bak\";}\n    function rank(n){\n        if(n===\"总控.zjs\")return 4;\n        if(n===\"农场脚本下载.zjs\")return 3;\n        if(n===\"农场脚本版本更新器.zjs\")return 2;\n        if(n===\"农场脚本版本发布器.zjs\")return 1;\n        return 0;\n    }\n    function restoreJournal(){\n        var path=BASE_DIR+\".farm-update-transaction.json\",raw=localText(path);\n        if(!raw)return;\n        var j;try{j=JSON.parse(raw);}catch(e){throw new Error(\"旧更新恢复日志损坏，请先备份脚本目录\");}\n        if(!j||j.status!==\"writing\"||!Array.isArray(j.items))return;\n        var bad=[];\n        for(var i=0;i<j.items.length;i++){\n            var it=j.items[i];\n            if(!it||!safeName(it.name)||it.oldText===null)continue;\n            try{\n                zdjl.writeFile(BASE_DIR+it.name,it.oldText);\n                if(localText(BASE_DIR+it.name)!==it.oldText)throw new Error(\"读回不一致\");\n            }catch(e2){bad.push(it.name);}\n        }\n        if(bad.length)throw new Error(\"上次更新恢复失败：\"+bad.join(\"、\"));\n        j.status=\"rolledBack\";zdjl.writeFile(path,JSON.stringify(j));\n    }\n\n    try{\n        restoreJournal();\n\n        // 1. 读取正式发布锚点\n        var latest=getJson(META_DIR+\"latest.json\",BRANCH);\n        var ref=String(latest.snapshotSha||BRANCH);\n\n        // 2. 读取该快照的正式清单\n        var manifest=getJson(META_DIR+\"manifest.json\",ref);\n        if(!manifest||!Array.isArray(manifest.files)||!manifest.files.length)throw new Error(\"正式清单为空\");\n        var files=manifest.files.slice();\n        if(files.indexOf(\"总控.zjs\")<0)throw new Error(\"正式清单缺少 总控.zjs\");\n\n        // 3. 一次读取 scripts 目录，拿到所有 blob SHA\n        var dir=req({\n            url:\"https://api.github.com/repos/\"+OWNER+\"/\"+REPO+\"/contents/\"+encPath(\"scripts\")+\"?ref=\"+encodeURIComponent(ref),\n            method:\"GET\",headers:headers(false),timeout:15000\n        },2);\n        if(dir.code===403&&!token)throw new Error(\"GitHub匿名API额度不足，请先设置Token。\");\n        if(dir.code!==200)throw new Error(\"读取云端脚本目录失败 HTTP \"+dir.code+\"\\n\"+dir.body);\n\n        var arr=JSON.parse(String(dir.body||\"[]\")),remote={};\n        for(var r=0;r<arr.length;r++){\n            var it=arr[r];\n            if(it&&it.type===\"file\"&&safeName(String(it.name||\"\"))){\n                remote[String(it.name)]={sha:String(it.sha||\"\")};\n            }\n        }\n\n        // 4. 本地直接计算 Git blob SHA。没有变化的文件完全不下载。\n        var changed=[],same=0;\n        for(var i=0;i<files.length;i++){\n            var n=String(files[i]);\n            if(!safeName(n))throw new Error(\"清单存在非法文件名：\"+n);\n            if(!remote[n])throw new Error(\"云端快照缺少：\"+n);\n            var old=localText(BASE_DIR+n);\n            if(old!==null && gitBlobSha(old)===remote[n].sha)same++;\n            else changed.push(n);\n        }\n\n        if(!changed.length){\n            zdjl.alert(\n                \"已经是最新版｜V4.6增量更新\\n\\n\"+\n                \"版本：\"+(latest.displayName||latest.id||\"\")+\n                \"\\n脚本：\"+files.length+\n                \"\\n下载文件：0\"+\n                \"\\n网络请求：\"+netCount+\n                \"\\n耗时：\"+((Date.now()-startedAt)/1000).toFixed(1)+\"秒\"\n            );\n            return;\n        }\n\n        // 5. 只下载真正变化的脚本\n        var staged=[];\n        for(var j=0;j<changed.length;j++){\n            var name=changed[j];\n            var rr=getRaw(CLOUD_DIR+name,ref);\n            if(rr.code!==200)throw new Error(name+\" 下载失败 HTTP \"+rr.code+\"\\n\"+rr.body);\n            var content=String(rr.body||\"\");\n            if(gitBlobSha(content)!==remote[name].sha)throw new Error(name+\" 下载后SHA校验不一致\");\n            validateScript(content,name);\n            staged.push({name:name,oldText:localText(BASE_DIR+name),text:content});\n        }\n\n        // 依赖校验：只解析下载到的变化脚本；依赖必须在正式清单或本地已存在。\n        var manifestSet={};\n        for(var ms=0;ms<files.length;ms++)manifestSet[String(files[ms])]=1;\n        function visit(o,owner){\n            if(!o||typeof o!==\"object\")return;\n            if(o.type===\"执行脚本\"&&o.filePath){\n                var dep=String(o.filePath);\n                if(!safeName(dep))throw new Error(owner+\" 依赖名称异常：\"+dep);\n                if(!manifestSet[dep]&&localText(BASE_DIR+dep)===null)throw new Error(owner+\" 缺少依赖：\"+dep);\n            }\n            for(var k in o)if(Object.prototype.hasOwnProperty.call(o,k))visit(o[k],owner);\n        }\n        for(var si=0;si<staged.length;si++){\n            var ls=staged[si].text.split(/\\r?\\n/);\n            for(var li=0;li<ls.length;li++)if(trimText(ls[li]))visit(JSON.parse(ls[li]),staged[si].name);\n        }\n\n        staged.sort(function(a,b){\n            var ra=rank(a.name),rb=rank(b.name);\n            if(ra!==rb)return ra-rb;\n            return a.name<b.name?-1:(a.name>b.name?1:0);\n        });\n\n        var journalPath=BASE_DIR+\".farm-update-transaction.json\";\n        var journal={status:\"writing\",version:latest.id||\"\",items:staged};\n        var jt=JSON.stringify(journal);\n        zdjl.writeFile(journalPath,jt);\n        if(localText(journalPath)!==jt)throw new Error(\"恢复日志写入失败，未覆盖脚本\");\n\n        try{\n            for(var w=0;w<staged.length;w++){\n                var s=staged[w];\n                if(s.oldText!==null){\n                    zdjl.writeFile(backupName(s.name),s.oldText);\n                    if(localText(backupName(s.name))!==s.oldText)throw new Error(s.name+\"备份失败\");\n                }\n                zdjl.writeFile(BASE_DIR+s.name,s.text);\n                if(localText(BASE_DIR+s.name)!==s.text)throw new Error(s.name+\"写入校验失败\");\n            }\n            journal.status=\"committed\";zdjl.writeFile(journalPath,JSON.stringify(journal));\n        }catch(writeErr){\n            var bad=[];\n            for(var ri=0;ri<staged.length;ri++){\n                var oi=staged[ri];if(oi.oldText===null)continue;\n                try{\n                    zdjl.writeFile(BASE_DIR+oi.name,oi.oldText);\n                    if(localText(BASE_DIR+oi.name)!==oi.oldText)throw new Error(\"读回不一致\");\n                }catch(re){bad.push(oi.name);}\n            }\n            journal.status=bad.length?\"writing\":\"rolledBack\";\n            try{zdjl.writeFile(journalPath,JSON.stringify(journal));}catch(ignore){}\n            throw new Error(\"写入失败：\"+safeErrorText(writeErr)+(bad.length?\"\\n未恢复：\"+bad.join(\"、\"):\"\\n原文件已恢复\"));\n        }\n\n        zdjl.alert(\n            \"V4.6 增量更新完成\\n\\n\"+\n            \"版本：\"+(latest.displayName||latest.id||\"\")+\n            \"\\n已下载/更新：\"+staged.length+\n            \"\\n原本一致：\"+same+\n            \"\\n网络请求：\"+netCount+\n            \"\\n耗时：\"+((Date.now()-startedAt)/1000).toFixed(1)+\"秒\"+\n            \"\\n\\n【已更新】\\n\"+changed.join(\"\\n\")\n        );\n    }catch(e){\n        zdjl.alert(\"农场脚本增量更新失败\\n\\n\"+safeErrorText(e)+\"\\n\\n网络请求：\"+netCount+\"\\n耗时：\"+((Date.now()-startedAt)/1000).toFixed(1)+\"秒\");\n    }\n})();"}

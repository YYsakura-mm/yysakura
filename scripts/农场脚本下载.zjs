{"repeatCount":1,"pauseOnFail":false,"count":1,"minVerCode":2021000,"minVerName":"2.21.0","screenWidth":720,"screenHeight":1280,"screenDpi":2,"lastSaveScreenWidth":1280,"lastSaveScreenHeight":720,"lastSaveScreenDpi":2,"savedVerCode":26000050,"savedVerName":"26.5.0","delay":"0.2","delayUnit":1,"description":"农场脚本云更新 V4.2｜月日时分版本锚点｜备注显示｜多选历史版｜本机版本记录"}
{"type":"运行JS代码","delay":"0","delayUnit":1,"desc":"农场脚本云更新 V4.2｜月日时分版本锚点｜备注显示｜多选历史版｜本机版本记录","jsCode":"(function () {\n    var OWNER = \"YYsakura-mm\";\n    var REPO = \"yysakura\";\n    var BRANCH = \"main\";\n    var BASE_DIR = \"/storage/emulated/0/自动精灵/\";\n    var CLOUD_DIR = \"scripts/\";\n    var META_DIR = \".farmcloud/\";\n    var NS = \"farm-cloud-v4\";\n    var TOKEN_NS = \"github-sync\";\n\n    function trimText(v) {\n        return String(v == null ? \"\" : v).replace(/^\\s+|\\s+$/g, \"\");\n    }\n\n    function displayTimeOf(v) {\n        if (v && v.displayTime) return String(v.displayTime);\n\n        var p = String(v && v.publishedAt ? v.publishedAt : \"\");\n        var m = p.match(/^\\d{4}-(\\d{2})-(\\d{2})\\s+(\\d{2}):(\\d{2})/);\n        if (m) return m[1] + \"-\" + m[2] + \" \" + m[3] + \":\" + m[4];\n\n        var id = String(v && v.id ? v.id : \"\");\n        var im = id.match(/^V\\d{4}(\\d{2})(\\d{2})-(\\d{2})(\\d{2})/);\n        if (im) return im[1] + \"-\" + im[2] + \" \" + im[3] + \":\" + im[4];\n\n        return id || \"未知时间\";\n    }\n\n    function versionLabel(v) {\n        if (v && v.displayName) return String(v.displayName);\n        var base = displayTimeOf(v);\n        var note = trimText(v && v.note ? v.note : \"\");\n        return base + (note ? \"｜\" + note : \"\");\n    }\n\n    function encodeRepoPath(path) {\n        var a = String(path).split(\"/\");\n        var out = [];\n        for (var i = 0; i < a.length; i++) out.push(encodeURIComponent(a[i]));\n        return out.join(\"/\");\n    }\n\n    function getToken() {\n        var t = trimText(zdjl.getStorage(\"github_read_token\", NS));\n        if (!t) t = trimText(zdjl.getStorage(\"github_token\", TOKEN_NS));\n        if (!t) t = trimText(zdjl.getStorage(\"github_token\", NS));\n        return t;\n    }\n\n    function headers(rawMode) {\n        var h = [\n            {\"X-GitHub-Api-Version\": \"2022-11-28\"},\n            {\"Accept\": rawMode ? \"application/vnd.github.raw+json\" : \"application/vnd.github+json\"}\n        ];\n        var t = getToken();\n        if (t) h.unshift({\"Authorization\":\"Bearer \" + t});\n        return h;\n    }\n\n    function waitMs(ms) {\n        var end = Date.now() + ms;\n        while (Date.now() < end) {}\n    }\n\n    function isTransientCode(code) {\n        return code === 408 ||\n               code === 429 ||\n               code === 500 ||\n               code === 502 ||\n               code === 503 ||\n               code === 504;\n    }\n\n    function requestWithRetry(options, maxTry) {\n        maxTry = maxTry || 3;\n        var lastErr = null;\n        var lastResp = null;\n\n        for (var attempt = 1; attempt <= maxTry; attempt++) {\n            try {\n                lastResp = zdjl.requestUrl(options);\n\n                if (!lastResp || !isTransientCode(lastResp.code)) {\n                    return lastResp;\n                }\n\n                lastErr = new Error(\n                    \"HTTP \" + lastResp.code +\n                    \"（第\" + attempt + \"/\" + maxTry + \"次）\"\n                );\n            } catch (e) {\n                lastErr = e;\n            }\n\n            if (attempt < maxTry) {\n                waitMs(1000 * attempt);\n            }\n        }\n\n        if (lastResp && isTransientCode(lastResp.code)) {\n            return lastResp;\n        }\n\n        throw lastErr || new Error(\"网络请求失败\");\n    }\n\n    function contentsUrl(path, ref) {\n        var u =\n            \"https://api.github.com/repos/\" +\n            OWNER + \"/\" + REPO +\n            \"/contents/\" + encodeRepoPath(path);\n        if (ref) u += \"?ref=\" + encodeURIComponent(ref);\n        return u;\n    }\n\n    function getRaw(path, ref) {\n        return requestWithRetry({\n            url: contentsUrl(path, ref || BRANCH),\n            method: \"GET\",\n            headers: headers(true),\n            timeout: 30000\n        }, 3);\n    }\n\n    function getJson(path, ref) {\n        var r = getRaw(path, ref);\n        if (r.code !== 200) {\n            throw new Error(\"读取 \" + path + \" 失败 HTTP \" + r.code + \"\\n\" + r.body);\n        }\n        return JSON.parse(r.body);\n    }\n\n    function latestRelease() {\n        return getJson(META_DIR + \"latest.json\", BRANCH);\n    }\n\n    function historyObj() {\n        return getJson(META_DIR + \"versions.json\", BRANCH);\n    }\n\n    function manifestFor(ref) {\n        var m = getJson(META_DIR + \"manifest.json\", ref);\n        if (!m.files || !m.files.length) throw new Error(\"版本清单为空\");\n        return m;\n    }\n\n    function selectOne(title, items) {\n        try {\n            var r = zdjl.select({\n                title: title,\n                items: items,\n                multi: false\n            });\n            if (!r) return null;\n            return r.item;\n        } catch (e) {\n            var text = title + \"\\n\\n\";\n            for (var i = 0; i < items.length; i++) text += (i + 1) + \". \" + items[i] + \"\\n\";\n            var ans = trimText(zdjl.prompt(text, \"1\"));\n            if (!ans) return null;\n            if (/^\\d+$/.test(ans)) {\n                var n = Number(ans);\n                if (n >= 1 && n <= items.length) return items[n - 1];\n            }\n            for (var j = 0; j < items.length; j++) if (items[j] === ans) return items[j];\n            return null;\n        }\n    }\n\n    function selectMany(title, items) {\n        try {\n            var r = zdjl.select({\n                title: title,\n                items: items,\n                multi: true\n            });\n            if (!r || !r.items || !r.items.length) return null;\n            return r.items;\n        } catch (e) {\n            // 旧版本不支持多选弹窗时退回“逗号序号”\n            var text = title + \"\\n\\n输入序号，可用英文逗号分隔，例如 1,3,5\\n\\n\";\n            for (var i = 0; i < items.length; i++) text += (i + 1) + \". \" + items[i] + \"\\n\";\n            var ans = trimText(zdjl.prompt(text, \"1\"));\n            if (!ans) return null;\n            var parts = ans.split(\",\");\n            var out = [], seen = {};\n            for (var p = 0; p < parts.length; p++) {\n                var n = Number(trimText(parts[p]));\n                if (n >= 1 && n <= items.length && !seen[n]) {\n                    seen[n] = true;\n                    out.push(items[n - 1]);\n                }\n            }\n            return out.length ? out : null;\n        }\n    }\n\n    function chooseVersion() {\n        var h = historyObj();\n        var arr = h.versions || [];\n        if (!arr.length) {\n            zdjl.alert(\"云端还没有历史版本\");\n            return null;\n        }\n\n        var maxShow = Math.min(30, arr.length);\n        var labels = [];\n        for (var i = 0; i < maxShow; i++) {\n            labels.push((i + 1) + \". \" + versionLabel(arr[i]));\n        }\n\n        var picked = selectOne(\"选择历史版本｜时间就是版本锚点\", labels);\n        if (!picked) return null;\n\n        for (var j = 0; j < labels.length; j++) {\n            if (labels[j] === picked) return arr[j];\n        }\n        return null;\n    }\n    function backupName(name) {\n        return BASE_DIR + name + \".bak\";\n    }\n\n    function localText(path) {\n        try { return String(zdjl.readFile(path)); }\n        catch (e) { return null; }\n    }\n\n    function markInstalled(name, release) {\n        try {\n            zdjl.setStorage(\"installed_\" + name, release.id, NS);\n            zdjl.setStorage(\"installed_label_\" + name, versionLabel(release), NS);\n        } catch (e) {}\n    }\n\n    function updateOne(name, release, doWrite) {\n        var r = getRaw(CLOUD_DIR + name, release.snapshotSha);\n\n        if (r.code === 404) return {status:\"cloudMissing\", name:name};\n        if (r.code !== 200) return {status:\"failed\", name:name, detail:\"HTTP \" + r.code};\n\n        var cloudText = String(r.body);\n        var path = BASE_DIR + name;\n        var oldText = localText(path);\n\n        if (oldText !== null && oldText === cloudText) {\n            if (doWrite) markInstalled(name, release);\n            return {status:\"same\", name:name};\n        }\n\n        if (!doWrite) return {status:\"different\", name:name};\n\n        if (oldText !== null) {\n            try { zdjl.writeFile(backupName(name), oldText); } catch (ignoreBak) {}\n        }\n\n        try {\n            zdjl.writeFile(path, cloudText);\n            markInstalled(name, release);\n            return {status:\"updated\", name:name};\n        } catch (e2) {\n            return {status:\"failed\", name:name, detail:String(e2)};\n        }\n    }\n\n    function runMany(release, files, doWrite) {\n        var updated = [];\n        var same = [];\n        var different = [];\n        var cloudMissing = [];\n        var failed = [];\n\n        for (var i = 0; i < files.length; i++) {\n            var r;\n            try {\n                r = updateOne(files[i], release, doWrite);\n            } catch (e) {\n                failed.push(files[i] + \"｜\" + String(e));\n                continue;\n            }\n\n            if (r.status === \"updated\") updated.push(r.name);\n            else if (r.status === \"same\") same.push(r.name);\n            else if (r.status === \"different\") different.push(r.name);\n            else if (r.status === \"cloudMissing\") cloudMissing.push(r.name);\n            else failed.push(r.name + \"｜\" + (r.detail || \"未知错误\"));\n        }\n\n        var msg =\n            (doWrite ? \"云更新完成\" : \"检查更新完成\") + \"\\n\\n\" +\n            \"版本锚点：\" + versionLabel(release) + \"\\n\" +\n            \"内部ID：\" + (release.id || \"\") + \"\\n\" +\n            \"完整时间：\" + (release.publishedAt || \"\");\n\n        if (doWrite) {\n            msg += \"\\n\\n已更新/新建：\" + updated.length +\n                   \"\\n已经一致：\" + same.length +\n                   \"\\n云端缺失：\" + cloudMissing.length +\n                   \"\\n失败：\" + failed.length;\n            if (updated.length) msg += \"\\n\\n【已更新】\\n\" + updated.join(\"\\n\");\n        } else {\n            msg += \"\\n\\n需要更新：\" + different.length +\n                   \"\\n已经一致：\" + same.length +\n                   \"\\n云端缺失：\" + cloudMissing.length +\n                   \"\\n失败：\" + failed.length;\n            if (different.length) msg += \"\\n\\n【需要更新】\\n\" + different.join(\"\\n\");\n        }\n\n        if (cloudMissing.length) msg += \"\\n\\n【云端缺失】\\n\" + cloudMissing.join(\"\\n\");\n        if (failed.length) msg += \"\\n\\n【失败】\\n\" + failed.join(\"\\n\");\n\n        zdjl.alert(msg);\n    }\n\n    function showVersions() {\n        var h = historyObj();\n        var arr = h.versions || [];\n        if (!arr.length) {\n            zdjl.alert(\"云端还没有版本历史\");\n            return;\n        }\n\n        var maxShow = Math.min(30, arr.length);\n        var msg = \"云端版本历史\\n\\n总版本数：\" + arr.length + \"\\n最近 \" + maxShow + \" 个：\\n\\n\";\n\n        for (var i = 0; i < maxShow; i++) {\n            var v = arr[i];\n            msg += (i + 1) + \". \" + versionLabel(v) + \"\\n\";\n            msg += \"   ID：\" + (v.id || \"\") + \"\\n\";\n            msg += \"   文件：\" + (v.fileCount == null ? \"?\" : v.fileCount);\n            msg += \"｜修改：\" + (v.changedCount == null ? \"?\" : v.changedCount);\n            msg += \"｜新增：\" + (v.addedCount == null ? \"?\" : v.addedCount);\n            msg += \"｜移出：\" + (v.removedCount == null ? \"?\" : v.removedCount);\n            msg += \"\\n\\n\";\n        }\n\n        zdjl.alert(msg);\n    }\n\n    function showLocalState() {\n        var latest = latestRelease();\n        var manifest = manifestFor(latest.snapshotSha);\n        var files = manifest.files || [];\n        var msg = \"本机脚本版本记录\\n\\n\";\n\n        for (var i = 0; i < files.length; i++) {\n            var label = trimText(zdjl.getStorage(\"installed_label_\" + files[i], NS));\n            var id = trimText(zdjl.getStorage(\"installed_\" + files[i], NS));\n\n            msg += files[i] + \"\\n\";\n            if (label) {\n                msg += \"  \" + label;\n                if (id) msg += \"｜\" + id;\n            } else if (id) {\n                msg += \"  \" + id;\n            } else {\n                msg += \"  未记录/可能手动替换\";\n            }\n            msg += \"\\n\";\n        }\n\n        zdjl.alert(msg);\n    }\n    function rollbackBak() {\n        var latest = latestRelease();\n        var manifest = manifestFor(latest.snapshotSha);\n        var name = selectOne(\"选择要恢复 .bak 的脚本\", manifest.files);\n        if (!name) return;\n\n        var bak = localText(BASE_DIR + name + \".bak\");\n        if (bak === null) {\n            zdjl.alert(\"没有找到备份：\\n\" + name + \".bak\");\n            return;\n        }\n\n        var now = localText(BASE_DIR + name);\n        if (now !== null) {\n            try { zdjl.writeFile(BASE_DIR + name + \".before-bak-restore.bak\", now); } catch (ignore) {}\n        }\n\n        zdjl.writeFile(BASE_DIR + name, bak);\n        zdjl.alert(\"已恢复本地备份\\n\\n\" + name);\n    }\n\n    function setReadToken() {\n        var current = getToken();\n        var ans = trimText(zdjl.prompt(\n            \"可选：设置只读Token，提高GitHub API请求额度。\\n\" +\n            \"输入 CLEAR 可清除。\\n\\n当前：\" + (current ? \"已有Token\" : \"未设置Token\"),\n            \"\"\n        ));\n\n        if (!ans) return;\n        if (ans.toUpperCase() === \"CLEAR\") {\n            zdjl.setStorage(\"github_read_token\", \"\", NS);\n            zdjl.alert(\"已清除更新器专用只读Token\");\n        } else {\n            zdjl.setStorage(\"github_read_token\", ans, NS);\n            zdjl.alert(\"已保存更新器专用只读Token\");\n        }\n    }\n\n    var latestForMenu = null;\n    try { latestForMenu = latestRelease(); } catch (ignoreLatestMenu) {}\n\n    var latestText = latestForMenu ? versionLabel(latestForMenu) : \"最新版\";\n\n    var menuItems = [\n        \"最新版｜\" + latestText + \"｜全部更新\",\n        \"最新版｜\" + latestText + \"｜选择一个或多个脚本\",\n        \"历史版本｜全部回退\",\n        \"历史版本｜选择一个或多个脚本\",\n        \"只检查最新版，不写文件\",\n        \"查看版本历史\",\n        \"查看本机各脚本版本记录\",\n        \"恢复某脚本的本地 .bak\",\n        \"设置/更换只读Token\"\n    ];\n\n    var menu = selectOne(\"农场脚本云更新 V4.2\", menuItems);\n    if (!menu) return;\n\n    try {\n        if (menu === menuItems[0]) {\n            var l1 = latestForMenu || latestRelease();\n            var m1 = manifestFor(l1.snapshotSha);\n            runMany(l1, m1.files, true);\n\n        } else if (menu === menuItems[1]) {\n            var l2 = latestForMenu || latestRelease();\n            var m2 = manifestFor(l2.snapshotSha);\n            var f2 = selectMany(\"选择要更新的脚本｜\" + versionLabel(l2), m2.files);\n            if (f2) runMany(l2, f2, true);\n\n        } else if (menu === menuItems[2]) {\n            var v3 = chooseVersion();\n            if (v3) {\n                var m3 = manifestFor(v3.snapshotSha);\n                runMany(v3, m3.files, true);\n            }\n\n        } else if (menu === menuItems[3]) {\n            var v4 = chooseVersion();\n            if (v4) {\n                var m4 = manifestFor(v4.snapshotSha);\n                var f4 = selectMany(\"选择要恢复的脚本｜\" + versionLabel(v4), m4.files);\n                if (f4) runMany(v4, f4, true);\n            }\n\n        } else if (menu === menuItems[4]) {\n            var l5 = latestForMenu || latestRelease();\n            var m5 = manifestFor(l5.snapshotSha);\n            runMany(l5, m5.files, false);\n\n        } else if (menu === menuItems[5]) {\n            showVersions();\n\n        } else if (menu === menuItems[6]) {\n            showLocalState();\n\n        } else if (menu === menuItems[7]) {\n            rollbackBak();\n\n        } else if (menu === menuItems[8]) {\n            setReadToken();\n        }\n    } catch (e) {\n        zdjl.alert(\"执行异常\\n\\n\" + String(e));\n    }\n})();"}

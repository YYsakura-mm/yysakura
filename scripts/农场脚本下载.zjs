{"repeatCount":1,"pauseOnFail":false,"count":1,"minVerCode":2021000,"minVerName":"2.21.0","screenWidth":720,"screenHeight":1280,"screenDpi":2,"lastSaveScreenWidth":1280,"lastSaveScreenHeight":720,"lastSaveScreenDpi":2,"savedVerCode":26000050,"savedVerName":"26.5.0","delay":"0","delayUnit":1,"description":"农场脚本下载｜单包一次请求｜所有变化文件全部覆盖｜总控最后写"}
{"type":"运行JS代码","delay":"0","delayUnit":1,"repeatCount":1,"desc":"最新版单包下载｜包括总控在内所有变化ZJS全部更新","jsCode":"(function(){\n    var OWNER=\"YYsakura-mm\";\n    var REPO=\"yysakura\";\n    var BRANCH=\"main\";\n    var BASE_DIR=\"/storage/emulated/0/自动精灵/\";\n    var PACKAGE_PATH=\".farmcloud/latest-package.json\";\n    var NS=\"farm-cloud-v4\";\n    var TOKEN_NS=\"github-sync\";\n\n    function trimText(v){return String(v==null?\"\":v).replace(/^\\s+|\\s+$/g,\"\");}\n    function encodeRepoPath(path){var a=String(path).split(\"/\"),out=[];for(var i=0;i<a.length;i++)out.push(encodeURIComponent(a[i]));return out.join(\"/\");}\n    function looksLikeToken(v){var s=trimText(v);if(!s||/[^\\x21-\\x7E]/.test(s)||/\\s/.test(s)||s.length<20)return false;return /^(github_pat_|gh[pousr]_)/.test(s);}\n    function safeErrorText(e){var s=String(e==null?\"\":e);s=s.replace(/(Authorization value:\\s*Bearer\\s+)[^\\r\\n]+/ig,\"$1***\");s=s.replace(/(Bearer\\s+)(github_pat_|gh[pousr]_)[A-Za-z0-9_\\-]+/g,\"$1***\");return s;}\n    function getToken(){\n        var t=\"\";\n        try{t=trimText(zdjl.getStorage(\"github_read_token\",NS));}catch(e){}\n        if(looksLikeToken(t))return t;\n        try{t=trimText(zdjl.getStorage(\"github_token\",TOKEN_NS));}catch(e2){}\n        if(looksLikeToken(t))return t;\n        try{t=trimText(zdjl.getStorage(\"github_token\",NS));}catch(e3){}\n        return looksLikeToken(t)?t:\"\";\n    }\n    function rawUrl(){return \"https://raw.githubusercontent.com/\"+encodeURIComponent(OWNER)+\"/\"+encodeURIComponent(REPO)+\"/\"+encodeURIComponent(BRANCH)+\"/\"+encodeRepoPath(PACKAGE_PATH)+\"?t=\"+Date.now();}\n    function apiUrl(){return \"https://api.github.com/repos/\"+OWNER+\"/\"+REPO+\"/contents/\"+encodeRepoPath(PACKAGE_PATH)+\"?ref=\"+encodeURIComponent(BRANCH);}\n    function isTransient(code){return code===408||code===429||code===500||code===502||code===503||code===504;}\n    function requestRetry(opt,maxTry){\n        var last=null,err=null;maxTry=maxTry||2;\n        for(var i=1;i<=maxTry;i++){\n            try{last=zdjl.requestUrl(opt);if(last&&!isTransient(last.code))return last;err=new Error(\"HTTP \"+(last?last.code:\"?\"));}catch(e){err=e;}\n            if(i<maxTry)try{zdjl.sleep(700*i);}catch(se){}\n        }\n        if(last)return last;throw err||new Error(\"网络请求失败\");\n    }\n    function fetchPackage(){\n        var r=null;\n        try{\n            r=requestRetry({url:rawUrl(),method:\"GET\",headers:[{\"Accept\":\"application/json\"}],timeout:60000},2);\n            if(r&&r.code===200)return {resp:r,via:\"raw\"};\n            if(r&&r.code===404)throw new Error(\"云端还没有 latest-package.json，请先用 V4.5.7 发布器发布一次\");\n        }catch(rawErr){\n            if(String(rawErr).indexOf(\"latest-package.json\")>=0)throw rawErr;\n        }\n\n        var token=getToken(),hs=[{\"Accept\":\"application/vnd.github.raw+json\"},{\"X-GitHub-Api-Version\":\"2022-11-28\"}];\n        if(token)hs.unshift({\"Authorization\":\"Bearer \"+token});\n        var api=requestRetry({url:apiUrl(),method:\"GET\",headers:hs,timeout:60000},2);\n        if(api&&api.code===200)return {resp:api,via:\"api\"};\n        if(api&&api.code===403&&!token)throw new Error(\"GitHub匿名API额度已用完；raw通道也不可用。可以稍后再试，或在版本更新器里设置只读Token。\");\n        throw new Error(\"下载最新版单包失败 HTTP \"+(api?api.code:\"?\")+\"\\n\"+(api&&api.body?api.body:\"\"));\n    }\n    function safeName(name){return typeof name===\"string\"&&/^[^\\\\\\/\\x00-\\x1f]+\\.zjs$/i.test(name)&&name.indexOf(\"..\")<0;}\n    function validateScript(text,name){\n        var lines=String(text||\"\").split(/\\r?\\n/),count=0;\n        for(var i=0;i<lines.length;i++){\n            if(!trimText(lines[i]))continue;\n            var row=JSON.parse(lines[i]);\n            if(!row||typeof row!==\"object\"||Array.isArray(row))throw new Error(name+\"格式错误\");\n            if(count===0){if(row.type!==undefined||row.count===undefined||row.repeatCount===undefined)throw new Error(name+\"文件头异常\");}\n            else if(!row.type)throw new Error(name+\"动作类型缺失\");\n            count++;\n        }\n        if(count<2)throw new Error(name+\"没有可执行动作\");\n    }\n    function localText(path){try{return String(zdjl.readFile(path));}catch(e){return null;}}\n    function backupName(name){return BASE_DIR+name+\".bak\";}\n    function restoreJournal(){\n        var path=BASE_DIR+\".farm-update-transaction.json\",raw=localText(path);if(!raw)return;\n        var j;try{j=JSON.parse(raw);}catch(e){throw new Error(\"旧更新恢复日志损坏，请先备份脚本目录\");}\n        if(!j||j.status!==\"writing\"||!j.items)return;\n        var bad=[];\n        for(var i=0;i<j.items.length;i++){\n            var it=j.items[i];if(!it||!safeName(it.name)||it.oldText===null)continue;\n            try{zdjl.writeFile(BASE_DIR+it.name,it.oldText);if(localText(BASE_DIR+it.name)!==it.oldText)throw new Error(\"读回不一致\");}catch(e2){bad.push(it.name);}\n        }\n        if(bad.length)throw new Error(\"上次更新恢复失败：\"+bad.join(\"、\"));\n        j.status=\"rolledBack\";zdjl.writeFile(path,JSON.stringify(j));\n    }\n\n    try{\n        restoreJournal();\n        var got=fetchPackage();\n        var pkg=JSON.parse(String(got.resp.body||\"\"));\n        if(!pkg||pkg.schema!==1||pkg.mode!==\"single-package\"||!Array.isArray(pkg.files))throw new Error(\"最新版单包格式不正确\");\n        if(Number(pkg.fileCount)!==pkg.files.length||pkg.files.length<1)throw new Error(\"最新版单包文件数不一致\");\n\n        var map={},order=[];\n        for(var i=0;i<pkg.files.length;i++){\n            var it=pkg.files[i],name=it&&String(it.name||\"\"),content=it&&String(it.content==null?\"\":it.content);\n            if(!safeName(name))throw new Error(\"单包存在非法文件名：\"+name);\n            if(map[name]!==undefined)throw new Error(\"单包重复文件：\"+name);\n            validateScript(content,name);map[name]=content;order.push(name);\n        }\n\n        // 依赖只在内存中解析，不执行任何下载到的代码。\n        function visit(o,owner){\n            if(!o||typeof o!==\"object\")return;\n            if(o.type===\"执行脚本\"&&o.filePath){\n                var dep=String(o.filePath);\n                if(!safeName(dep))throw new Error(owner+\" 依赖名称异常：\"+dep);\n                if(map[dep]===undefined&&localText(BASE_DIR+dep)===null)throw new Error(owner+\" 缺少依赖：\"+dep);\n            }\n            for(var k in o)if(Object.prototype.hasOwnProperty.call(o,k))visit(o[k],owner);\n        }\n        for(var oi=0;oi<order.length;oi++){\n            var nm=order[oi],ls=map[nm].split(/\\r?\\n/);\n            for(var li=0;li<ls.length;li++)if(trimText(ls[li]))visit(JSON.parse(ls[li]),nm);\n        }\n\n        var staged=[],same=0;\n        for(var si=0;si<order.length;si++){\n            var n=order[si];\n            var old=localText(BASE_DIR+n),wanted=map[n];\n            if(old===wanted)same++;else staged.push({name:n,oldText:old,text:wanted});\n        }\n\n        // 所有变化文件都允许覆盖，包括正在运行的总控。\n        // 总控固定最后写，先完成其它脚本和云工具更新。\n        staged.sort(function(x,y){\n            function rank(n){\n                if(n===\"总控.zjs\")return 4;\n                if(n===\"农场脚本下载.zjs\")return 3;\n                if(n===\"农场脚本版本更新器.zjs\")return 2;\n                if(n===\"农场脚本版本发布器.zjs\")return 1;\n                return 0;\n            }\n            return rank(x.name)-rank(y.name);\n        });\n\n        if(!staged.length){\n            zdjl.alert(\"已经是最新版｜\"+(pkg.displayName||pkg.versionId||\"\")+\"\\n网络请求：1次（\"+got.via+\"）\");\n            return;\n        }\n\n        var journalPath=BASE_DIR+\".farm-update-transaction.json\";\n        var journal={status:\"writing\",version:pkg.versionId||\"\",items:staged};\n        var jt=JSON.stringify(journal);zdjl.writeFile(journalPath,jt);if(localText(journalPath)!==jt)throw new Error(\"恢复日志写入失败，未覆盖脚本\");\n\n        try{\n            for(var wi=0;wi<staged.length;wi++){\n                var s=staged[wi];\n                if(s.oldText!==null){zdjl.writeFile(backupName(s.name),s.oldText);if(localText(backupName(s.name))!==s.oldText)throw new Error(s.name+\"备份失败\");}\n                zdjl.writeFile(BASE_DIR+s.name,s.text);if(localText(BASE_DIR+s.name)!==s.text)throw new Error(s.name+\"写入校验失败\");\n            }\n            journal.status=\"committed\";zdjl.writeFile(journalPath,JSON.stringify(journal));\n            zdjl.alert(\"单包更新完成｜\"+(pkg.displayName||pkg.versionId||\"\")+\"\\n网络请求：1次（\"+got.via+\"）\\n已更新/新建：\"+staged.length+\"\\n已经一致：\"+same+\"\\n总控如有变化也已覆盖（固定最后写）\");\n        }catch(writeErr){\n            var bad=[];\n            for(var ri=0;ri<staged.length;ri++){\n                var oldItem=staged[ri];if(oldItem.oldText===null)continue;\n                try{zdjl.writeFile(BASE_DIR+oldItem.name,oldItem.oldText);if(localText(BASE_DIR+oldItem.name)!==oldItem.oldText)throw new Error(\"读回不一致\");}catch(re){bad.push(oldItem.name);}\n            }\n            journal.status=bad.length?\"writing\":\"rolledBack\";try{zdjl.writeFile(journalPath,JSON.stringify(journal));}catch(ignore){}\n            throw new Error(\"写入失败：\"+safeErrorText(writeErr)+(bad.length?\"\\n以下文件未恢复：\"+bad.join(\"、\"):\"\\n原有文件已恢复\"));\n        }\n    }catch(e){\n        zdjl.alert(\"农场脚本单包下载失败\\n\\n\"+safeErrorText(e));\n    }\n})();"}

{"type":"运行JS代码","delay":"0","delayUnit":1,"desc":"农场脚本云下载 V5.1｜版本Tag｜增量下载｜事务写入｜总控校验","jsCode":"(function(){\n    var OWNER=\"YYsakura-mm\",REPO=\"yysakura\",BRANCH=\"main\";\n    var BASE_DIR=\"/storage/emulated/0/自动精灵/\",V5_DIR=\".farmcloud/v5/\",NS=\"farm-cloud-v5\",TOKEN_NS=\"github-sync\";\n    var BASE_FILE=BASE_DIR+\".farm-cloud-base-v5.json\",TARGET_KEY=\"target_release\";\n    var MANAGED=[\"1v1.zjs\", \"55.zjs\", \"一键种植.zjs\", \"保变异收割.zjs\", \"关广告.zjs\", \"农场脚本下载.zjs\", \"农场脚本版本发布器.zjs\", \"农场脚本版本更新器.zjs\", \"切换账号.zjs\", \"初始化OCR.zjs\", \"占位保存.zjs\", \"变异植物上传.zjs\", \"变异植物识别.zjs\", \"总控.zjs\", \"换16经验.zjs\", \"换经济作物.zjs\", \"收割判定.zjs\", \"查看状态.zjs\", \"浇水领奖.zjs\", \"状态提示.zjs\", \"祝福.zjs\", \"祝福判定.zjs\", \"祝福识别收方.zjs\", \"祝福识别送方.zjs\", \"进游戏关闭广告.zjs\", \"退出农场.zjs\", \"选择八小时作物.zjs\", \"选择英雄植物.zjs\", \"重启王者.zjs\"];\n    function trimText(v){return String(v==null?\"\":v).replace(/^\\s+|\\s+$/g,\"\");}\n    function safeErrorText(e){var s=String(e==null?\"\":e);s=s.replace(/(Authorization value:\\s*Bearer\\s+)[^\\r\\n]+/ig,\"$1***\");s=s.replace(/(Bearer\\s+)(github_pat_|gh[pousr]_)[A-Za-z0-9_\\-]+/g,\"$1***\");return s;}\n    function looksLikeToken(v){var s=trimText(v);return !!s&&!/[^\\x21-\\x7E]/.test(s)&&!/\\s/.test(s)&&s.length>=20&&/^(github_pat_|gh[pousr]_)/.test(s);}\n    function getToken(){var t=\"\";try{t=trimText(zdjl.getStorage(\"github_read_token\",NS));}catch(e){}if(looksLikeToken(t))return t;try{t=trimText(zdjl.getStorage(\"github_token\",TOKEN_NS));}catch(e2){}return looksLikeToken(t)?t:\"\";}\n    var TOKEN=getToken();\n    function headers(raw){var h=[{\"X-GitHub-Api-Version\":\"2022-11-28\"},{\"Accept\":raw?\"application/vnd.github.raw+json\":\"application/vnd.github+json\"}];if(TOKEN)h.unshift({\"Authorization\":\"Bearer \"+TOKEN});return h;}\n    function apiUrl(path){return \"https://api.github.com/repos/\"+OWNER+\"/\"+REPO+\"/\"+path;}\n    function transient(c){return c===408||c===429||c===500||c===502||c===503||c===504;}\n    function req(method,path,raw,maxTry){var last=null,err=null;maxTry=maxTry||4;for(var a=1;a<=maxTry;a++){try{last=zdjl.requestUrl({url:apiUrl(path),method:method,headers:headers(!!raw),timeout:45000});if(last&&!transient(last.code))return last;err=new Error(\"HTTP \"+(last?last.code:\"?\"));}catch(e){err=e;}if(a<maxTry)try{zdjl.sleep(800*a);}catch(se){}}if(last)return last;throw err||new Error(\"网络请求失败\");}\n    function requireCode(r,codes,label){for(var i=0;i<codes.length;i++)if(r&&r.code===codes[i])return r;throw new Error(label+\" HTTP \"+(r?r.code:\"?\")+\"\\n\"+(r&&r.body?r.body:\"\"));}\n    function encodePath(path){var a=String(path).split(\"/\"),o=[];for(var i=0;i<a.length;i++)o.push(encodeURIComponent(a[i]));return o.join(\"/\");}\n    function getRaw(path,ref){return req(\"GET\",\"contents/\"+encodePath(path)+\"?ref=\"+encodeURIComponent(ref||BRANCH),true,4);}\n    function getJson(path,ref){var r=getRaw(path,ref);if(r.code===404)return null;requireCode(r,[200],\"读取 \"+path);return JSON.parse(String(r.body||\"\"));}\n    function localText(path){try{return String(zdjl.readFile(path));}catch(e){return null;}}\n    function writeVerified(path,text){zdjl.writeFile(path,text);if(localText(path)!==text)throw new Error(\"写入后校验失败：\"+path);}\n    function loadBase(){var s=localText(BASE_FILE);if(!s)return null;try{return JSON.parse(s);}catch(e){return null;}}\n    function saveBase(p){writeVerified(BASE_FILE,JSON.stringify(p));}\n    function validateScript(text,name){var ls=String(text||\"\").split(/\\r?\\n/),count=0;for(var i=0;i<ls.length;i++){if(!trimText(ls[i]))continue;var row=JSON.parse(ls[i]);if(!row||typeof row!==\"object\"||Array.isArray(row))throw new Error(name+\" 格式错误\");if(count===0){if(row.type!==undefined||row.count===undefined||row.repeatCount===undefined)throw new Error(name+\" 文件头异常\");}else if(!row.type)throw new Error(name+\" 动作类型缺失\");count++;}if(count<2)throw new Error(name+\" 没有可执行动作\");}\n    function mapOf(pkg){var m={};if(pkg&&Array.isArray(pkg.files))for(var i=0;i<pkg.files.length;i++)m[String(pkg.files[i].name)]=String(pkg.files[i].content==null?\"\":pkg.files[i].content);return m;}\n    function completeBase(b){var m=mapOf(b);for(var i=0;i<MANAGED.length;i++)if(m[MANAGED[i]]===undefined)return false;return true;}\n    function latest(){var v=getJson(V5_DIR+\"latest.json\",BRANCH);if(!v)throw new Error(\"云端还没有 V5.1 正式版本。请先在主设备运行 V5.1 发布器。\");return v;}\n    function chooseTarget(){\n        var target=\"\";try{target=trimText(zdjl.getStorage(TARGET_KEY,NS));zdjl.setStorage(TARGET_KEY,\"\",NS);}catch(e){}\n        if(!target)return latest();\n        var h=getJson(V5_DIR+\"versions.json\",BRANCH),a=h&&h.versions||[];for(var i=0;i<a.length;i++)if(String(a[i].id||a[i].versionId)===target)return a[i];\n        throw new Error(\"历史版本不存在：\"+target);\n    }\n    function fetchScript(name,ref){var r=getRaw(\"scripts/\"+name,ref);requireCode(r,[200],\"下载 \"+name);var t=String(r.body||\"\");validateScript(t,name);return t;}\n    function targetPackage(rel){\n        var ref=String(rel.tagName||rel.snapshotSha||\"\"),base=loadBase(),files=[],m={},i,n;\n        if(!ref)throw new Error(\"版本缺少 Tag 引用\");\n        if(base&&completeBase(base)&&String(base.versionId||\"\")===String(rel.id||rel.versionId||\"\")){\n            return {schema:51,versionId:String(rel.id||rel.versionId),displayName:String(rel.displayName||\"\"),tagName:ref,parentVersionId:String(rel.parentVersionId||\"\"),files:base.files};\n        }\n        if(base&&completeBase(base)&&String(base.versionId||\"\")===String(rel.parentVersionId||\"\")&&Array.isArray(rel.changedFiles)){\n            m=mapOf(base);for(i=0;i<rel.changedFiles.length;i++){n=String(rel.changedFiles[i]);if(MANAGED.indexOf(n)>=0)m[n]=fetchScript(n,ref);}\n            for(i=0;i<MANAGED.length;i++){n=MANAGED[i];if(m[n]===undefined)m[n]=fetchScript(n,ref);files.push({name:n,content:m[n]});}\n        }else{\n            for(i=0;i<MANAGED.length;i++){n=MANAGED[i];files.push({name:n,content:fetchScript(n,ref)});}\n        }\n        return {schema:51,versionId:String(rel.id||rel.versionId),displayName:String(rel.displayName||rel.publishedAt||\"\"),tagName:ref,parentVersionId:String(rel.parentVersionId||\"\"),files:files};\n    }\n    function restoreJournal(){var p=BASE_DIR+\".farm-update-transaction.json\",s=localText(p);if(!s)return;var j;try{j=JSON.parse(s);}catch(e){throw new Error(\"旧更新恢复日志损坏\");}if(!j||j.status!==\"writing\"||!Array.isArray(j.items))return;var bad=[];for(var i=0;i<j.items.length;i++){var it=j.items[i];if(!it||it.oldText===null)continue;try{writeVerified(BASE_DIR+it.name,it.oldText);}catch(e2){bad.push(it.name);}}if(bad.length)throw new Error(\"上次更新恢复失败：\"+bad.join(\"、\"));j.status=\"rolledBack\";writeVerified(p,JSON.stringify(j));}\n    try{\n        restoreJournal();var rel=chooseTarget(),target=targetPackage(rel),tm=mapOf(target),staged=[],same=0,mainChanged=false;\n        for(var i=0;i<MANAGED.length;i++){var n=MANAGED[i],old=localText(BASE_DIR+n),wanted=tm[n];if(wanted===undefined)throw new Error(\"目标版本缺少：\"+n);if(old===wanted)same++;else{staged.push({name:n,oldText:old,text:wanted});if(n===\"总控.zjs\")mainChanged=true;}}\n        staged.sort(function(a,b){function rank(n){if(n===\"总控.zjs\")return 4;if(n===\"农场脚本下载.zjs\")return 3;if(n===\"农场脚本版本更新器.zjs\")return 2;if(n===\"农场脚本版本发布器.zjs\")return 1;return 0;}return rank(a.name)-rank(b.name);});\n        if(!staged.length){saveBase(target);zdjl.alert(\"已经是目标版本｜\"+target.displayName+\"\\n正式脚本：\"+MANAGED.length+\"\\n总控磁盘内容：与云端完全一致\");return;}\n        var jp=BASE_DIR+\".farm-update-transaction.json\",journal={status:\"writing\",version:target.versionId,items:staged},jt=JSON.stringify(journal);writeVerified(jp,jt);\n        try{\n            for(i=0;i<staged.length;i++){var s=staged[i];if(s.oldText!==null){writeVerified(BASE_DIR+s.name+\".bak\",s.oldText);}writeVerified(BASE_DIR+s.name,s.text);}\n            journal.status=\"committed\";writeVerified(jp,JSON.stringify(journal));saveBase(target);\n            var msg=\"V5.1 更新完成｜\"+target.displayName+\"\\n已更新：\"+staged.length+\"\\n已经一致：\"+same+\"\\n正式脚本：\"+MANAGED.length+\"\\n总控.zjs：\"+(mainChanged?\"已覆盖并读回校验通过\":\"原本一致\");\n            if(mainChanged)msg+=\"\\n\\n注意：总控文件已经同步，但自动精灵的 rememberInputValue 会保留部分本机输入记忆；界面旧值不等于文件没更新。\";\n            zdjl.alert(msg);\n        }catch(w){var bad=[];for(i=0;i<staged.length;i++){var it=staged[i];if(it.oldText===null)continue;try{writeVerified(BASE_DIR+it.name,it.oldText);}catch(re){bad.push(it.name);}}journal.status=bad.length?\"writing\":\"rolledBack\";try{writeVerified(jp,JSON.stringify(journal));}catch(ignore){}throw new Error(\"更新写入失败：\"+safeErrorText(w)+(bad.length?\"\\n未恢复：\"+bad.join(\"、\"):\"\\n原文件已恢复\"));}\n    }catch(e){zdjl.alert(\"V5.1 下载失败\\n\\n\"+safeErrorText(e));}\n})();"}

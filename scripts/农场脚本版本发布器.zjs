{"repeatCount":1,"pauseOnFail":false,"count":1,"minVerCode":2021000,"minVerName":"2.21.0","screenWidth":720,"screenHeight":1280,"screenDpi":2,"lastSaveScreenWidth":1280,"lastSaveScreenHeight":720,"lastSaveScreenDpi":2,"savedVerCode":26000050,"savedVerName":"26.5.0","delay":"0.2","delayUnit":1,"description":"农场脚本版本发布器 V4.6｜Git blob SHA一次比对｜只上传变化文件｜秒级增量","desc":"农场脚本云发布 V4.5｜动态扫描正式业务ZJS｜排除云工具/旧模板/旧识别原型｜Git快照"}
{"type":"运行JS代码","delay":"0","delayUnit":1,"desc":"V4.6增量发布｜一次目录SHA比对 + 只上传变化ZJS","jsCode":"(function(){\n    var OWNER=\"YYsakura-mm\";\n    var REPO=\"yysakura\";\n    var BRANCH=\"main\";\n    var BASE_DIR=\"/storage/emulated/0/自动精灵/\";\n    var CLOUD_DIR=\"scripts/\";\n    var META_DIR=\".farmcloud/\";\n    var NS=\"farm-cloud-v4\";\n    var TOKEN_NS=\"github-sync\";\n    var startedAt=Date.now();\n    var netCount=0;\n\n    function trimText(v){return String(v==null?\"\":v).replace(/^\\s+|\\s+$/g,\"\");}\n    function safeErrorText(e){\n        var s=String(e==null?\"\":e);\n        s=s.replace(/(Authorization value:\\s*Bearer\\s+)[^\\r\\n]+/ig,\"$1***\");\n        s=s.replace(/(Bearer\\s+)(github_pat_|gh[pousr]_)[A-Za-z0-9_\\-]+/g,\"$1***\");\n        return s;\n    }\n    function looksLikeToken(v){\n        var s=trimText(v);\n        return !!s && !/[^\\x21-\\x7E]/.test(s) && !/\\s/.test(s) && s.length>=20 && /^(github_pat_|gh[pousr]_)/.test(s);\n    }\n    function clearToken(){\n        try{zdjl.setStorage(\"github_token\",\"\",TOKEN_NS);}catch(e){}\n        try{zdjl.setStorage(\"github_token\",\"\",NS);}catch(e2){}\n    }\n    function getToken(){\n        var t=\"\";\n        try{t=trimText(zdjl.getStorage(\"github_token\",TOKEN_NS));}catch(e){}\n        if(!looksLikeToken(t)){\n            try{t=trimText(zdjl.getStorage(\"github_token\",NS));}catch(e2){}\n        }\n        if(!looksLikeToken(t)){\n            t=trimText(zdjl.prompt(\"第一次运行：粘贴 GitHub Fine-grained Token\",\"\"));\n            if(!looksLikeToken(t)){\n                zdjl.alert(\"Token格式无效，停止发布\");\n                return \"\";\n            }\n            zdjl.setStorage(\"github_token\",t,TOKEN_NS);\n            zdjl.setStorage(\"github_token\",t,NS);\n        }\n        return t;\n    }\n    var token=getToken();\n    if(!token)return;\n\n    function encPath(path){\n        var a=String(path).split(\"/\"),out=[];\n        for(var i=0;i<a.length;i++)out.push(encodeURIComponent(a[i]));\n        return out.join(\"/\");\n    }\n    function apiContents(path,ref){\n        var u=\"https://api.github.com/repos/\"+OWNER+\"/\"+REPO+\"/contents/\"+encPath(path);\n        if(ref)u+=\"?ref=\"+encodeURIComponent(ref);\n        return u;\n    }\n    function headers(raw){\n        return [\n            {\"Authorization\":\"Bearer \"+token},\n            {\"X-GitHub-Api-Version\":\"2022-11-28\"},\n            {\"Accept\":raw?\"application/vnd.github.raw+json\":\"application/vnd.github+json\"}\n        ];\n    }\n    function transient(code){return code===408||code===429||code===500||code===502||code===503||code===504;}\n    function req(opt,maxTry){\n        maxTry=maxTry||2;\n        var last=null,err=null;\n        for(var i=1;i<=maxTry;i++){\n            try{\n                netCount++;\n                last=zdjl.requestUrl(opt);\n                if(last && !transient(last.code)) return last;\n                err=new Error(\"HTTP \"+(last?last.code:\"?\"));\n            }catch(e){err=e;}\n            if(i<maxTry)try{zdjl.sleep(500*i);}catch(se){}\n        }\n        if(last)return last;\n        throw err||new Error(\"网络请求失败\");\n    }\n    function getRaw(path,ref){\n        return req({url:apiContents(path,ref||BRANCH),method:\"GET\",headers:headers(true),timeout:15000},2);\n    }\n    function getInfo(path,ref){\n        return req({url:apiContents(path,ref||BRANCH),method:\"GET\",headers:headers(false),timeout:15000},2);\n    }\n    function readJsonOrNull(path,ref){\n        var r=getRaw(path,ref||BRANCH);\n        if(r.code===404)return null;\n        if(r.code===401||r.code===403){clearToken();throw new Error(\"GitHub鉴权失败 HTTP \"+r.code);}\n        if(r.code!==200)throw new Error(\"读取 \"+path+\" 失败 HTTP \"+r.code+\"\\n\"+r.body);\n        return JSON.parse(String(r.body||\"\"));\n    }\n\n    function utf8Bytes(str){\n        var bytes=[]; str=String(str);\n        for(var i=0;i<str.length;i++){\n            var c=str.charCodeAt(i);\n            if(c<0x80) bytes.push(c);\n            else if(c<0x800){\n                bytes.push(0xC0|(c>>6),0x80|(c&63));\n            }else if(c>=0xD800&&c<=0xDBFF&&i+1<str.length){\n                var c2=str.charCodeAt(++i);\n                var cp=0x10000+(((c&0x3FF)<<10)|(c2&0x3FF));\n                bytes.push(0xF0|(cp>>18),0x80|((cp>>12)&63),0x80|((cp>>6)&63),0x80|(cp&63));\n            }else{\n                bytes.push(0xE0|(c>>12),0x80|((c>>6)&63),0x80|(c&63));\n            }\n        }\n        return bytes;\n    }\n    function rol(v,n){return ((v<<n)|(v>>>(32-n)))>>>0;}\n    function hex8(n){return (\"00000000\"+(n>>>0).toString(16)).slice(-8);}\n    function sha1Bytes(bytes){\n        var msg=bytes.slice(), bitLen=msg.length*8;\n        msg.push(0x80);\n        while((msg.length%64)!==56) msg.push(0);\n        var hi=Math.floor(bitLen/0x100000000), lo=bitLen>>>0;\n        msg.push((hi>>>24)&255,(hi>>>16)&255,(hi>>>8)&255,hi&255,\n                 (lo>>>24)&255,(lo>>>16)&255,(lo>>>8)&255,lo&255);\n        var h0=0x67452301,h1=0xEFCDAB89,h2=0x98BADCFE,h3=0x10325476,h4=0xC3D2E1F0;\n        var w=new Array(80);\n        for(var o=0;o<msg.length;o+=64){\n            for(var i=0;i<16;i++){\n                var p=o+i*4;\n                w[i]=(((msg[p]<<24)|(msg[p+1]<<16)|(msg[p+2]<<8)|msg[p+3])>>>0);\n            }\n            for(var j=16;j<80;j++) w[j]=rol(w[j-3]^w[j-8]^w[j-14]^w[j-16],1);\n            var a=h0,b=h1,c=h2,d=h3,e=h4;\n            for(var t=0;t<80;t++){\n                var f,k;\n                if(t<20){f=(b&c)|((~b)&d);k=0x5A827999;}\n                else if(t<40){f=b^c^d;k=0x6ED9EBA1;}\n                else if(t<60){f=(b&c)|(b&d)|(c&d);k=0x8F1BBCDC;}\n                else{f=b^c^d;k=0xCA62C1D6;}\n                var temp=(rol(a,5)+(f>>>0)+e+k+w[t])>>>0;\n                e=d;d=c;c=rol(b,30);b=a;a=temp;\n            }\n            h0=(h0+a)>>>0; h1=(h1+b)>>>0; h2=(h2+c)>>>0; h3=(h3+d)>>>0; h4=(h4+e)>>>0;\n        }\n        return hex8(h0)+hex8(h1)+hex8(h2)+hex8(h3)+hex8(h4);\n    }\n    function gitBlobSha(text){\n        var body=utf8Bytes(String(text));\n        var head=utf8Bytes(\"blob \"+body.length+\"\\0\");\n        return sha1Bytes(head.concat(body));\n    }\n\n    function base64Text(str){\n        var chars=\"ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789+/\";\n        var b=utf8Bytes(String(str)),out=\"\";\n        for(var i=0;i<b.length;i+=3){\n            var b1=b[i],b2=i+1<b.length?b[i+1]:0,b3=i+2<b.length?b[i+2]:0;\n            var n=(b1<<16)|(b2<<8)|b3;\n            out+=chars.charAt((n>>18)&63);\n            out+=chars.charAt((n>>12)&63);\n            out+=i+1<b.length?chars.charAt((n>>6)&63):\"=\";\n            out+=i+2<b.length?chars.charAt(n&63):\"=\";\n        }\n        return out;\n    }\n\n    function putText(path,text,message,knownSha){\n        var body={message:message,content:base64Text(text),branch:BRANCH};\n        if(knownSha)body.sha=knownSha;\n        return req({\n            url:apiContents(path,null),method:\"PUT\",\n            headers:[\n                {\"Authorization\":\"Bearer \"+token},\n                {\"Accept\":\"application/vnd.github+json\"},\n                {\"X-GitHub-Api-Version\":\"2022-11-28\"},\n                {\"Content-Type\":\"application/json\"}\n            ],\n            requestBody:JSON.stringify(body),\n            timeout:25000\n        },2);\n    }\n    function putTextIfChanged(path,text,message){\n        var wantedSha=gitBlobSha(text);\n        var info=getInfo(path,BRANCH);\n        if(info.code===200){\n            var obj=JSON.parse(String(info.body||\"{}\"));\n            if(String(obj.sha||\"\")===wantedSha)return {ok:true,changed:false,sha:obj.sha};\n            var p=putText(path,text,message,obj.sha);\n            return {ok:p.code===200||p.code===201,changed:true,code:p.code,body:p.body};\n        }\n        if(info.code===404){\n            var c=putText(path,text,message,null);\n            return {ok:c.code===200||c.code===201,changed:true,code:c.code,body:c.body};\n        }\n        return {ok:false,changed:false,code:info.code,body:info.body};\n    }\n\n    function isManagedZjs(name){return /\\.zjs$/i.test(String(name));}\n    function managedFileOrder(a,b){\n        function rank(n){\n            if(n===\"总控.zjs\")return 4;\n            if(n===\"农场脚本下载.zjs\")return 3;\n            if(n===\"农场脚本版本更新器.zjs\")return 2;\n            if(n===\"农场脚本版本发布器.zjs\")return 1;\n            return 0;\n        }\n        var ra=rank(String(a)),rb=rank(String(b));\n        if(ra!==rb)return ra-rb;\n        return String(a)<String(b)?-1:(String(a)>String(b)?1:0);\n    }\n    function listByNodeFs(dir){\n        if(typeof require!==\"function\")return null;\n        var fs=require(\"fs\");\n        if(!fs||typeof fs.readdirSync!==\"function\")return null;\n        var names=fs.readdirSync(dir),out=[];\n        for(var i=0;i<names.length;i++){\n            var n=String(names[i]);\n            if(!isManagedZjs(n))continue;\n            try{var st=fs.statSync(dir+n);if(st&&st.isFile())out.push(n);}catch(e){}\n        }\n        return out;\n    }\n    function listByJavaFile(dir){\n        var FileClass=null;\n        try{if(typeof Java!==\"undefined\"&&Java&&typeof Java.type===\"function\")FileClass=Java.type(\"java.io.File\");}catch(e){}\n        if(!FileClass)try{if(typeof Packages!==\"undefined\"&&Packages.java&&Packages.java.io&&Packages.java.io.File)FileClass=Packages.java.io.File;}catch(e2){}\n        if(!FileClass)return null;\n        var arr=new FileClass(dir).listFiles(),out=[];\n        if(arr==null)return out;\n        for(var i=0;i<arr.length;i++){\n            try{if(arr[i].isFile()){var n=String(arr[i].getName());if(isManagedZjs(n))out.push(n);}}catch(e3){}\n        }\n        return out;\n    }\n    function scanLocal(){\n        var files=null;\n        try{files=listByNodeFs(BASE_DIR);}catch(e){}\n        if(files===null)try{files=listByJavaFile(BASE_DIR);}catch(e2){}\n        if(files===null)throw new Error(\"当前环境无法枚举自动精灵目录\");\n        files.sort(managedFileOrder);\n        var out=[],seen={};\n        for(var i=0;i<files.length;i++)if(!seen[files[i]]){seen[files[i]]=1;out.push(files[i]);}\n        return out;\n    }\n    function pad2(n){return Number(n)<10?\"0\"+Number(n):String(Number(n));}\n    function nowInfo(){\n        var d=new Date(),y=d.getFullYear(),mo=pad2(d.getMonth()+1),da=pad2(d.getDate()),h=pad2(d.getHours()),mi=pad2(d.getMinutes()),s=pad2(d.getSeconds());\n        return {id:\"V\"+y+mo+da+\"-\"+h+mi+s,text:y+\"-\"+mo+\"-\"+da+\" \"+h+\":\"+mi+\":\"+s,displayTime:mo+\"-\"+da+\" \"+h+\":\"+mi};\n    }\n    function displayName(t,note){note=trimText(note);return t+(note?\"｜\"+note:\"\");}\n    function arrayDiff(a,b){\n        var m={},out=[];\n        for(var i=0;i<b.length;i++)m[String(b[i])]=1;\n        for(var j=0;j<a.length;j++)if(!m[String(a[j])])out.push(a[j]);\n        return out;\n    }\n\n    try{\n        var FILES=scanLocal();\n        if(FILES.indexOf(\"总控.zjs\")<0)throw new Error(\"本地正式目录缺少 总控.zjs\");\n\n        // 一次读取所有本地文件并计算 Git blob SHA。\n        var localMap={},localSha={};\n        for(var i=0;i<FILES.length;i++){\n            var n=FILES[i],txt=String(zdjl.readFile(BASE_DIR+n));\n            localMap[n]=txt;\n            localSha[n]=gitBlobSha(txt);\n        }\n\n        // 关键优化：只请求一次 scripts 目录，GitHub直接返回每个文件的blob SHA。\n        var dir=req({\n            url:\"https://api.github.com/repos/\"+OWNER+\"/\"+REPO+\"/contents/\"+encPath(\"scripts\")+\"?ref=\"+encodeURIComponent(BRANCH),\n            method:\"GET\",headers:headers(false),timeout:15000\n        },2);\n        if(dir.code===401||dir.code===403){clearToken();throw new Error(\"GitHub鉴权失败 HTTP \"+dir.code);}\n        if(dir.code!==200&&dir.code!==404)throw new Error(\"读取云端 scripts 目录失败 HTTP \"+dir.code+\"\\n\"+dir.body);\n\n        var remoteArr=dir.code===200?JSON.parse(String(dir.body||\"[]\")):[],remote={};\n        for(var r=0;r<remoteArr.length;r++){\n            var it=remoteArr[r];\n            if(it&&it.type===\"file\"&&isManagedZjs(it.name))remote[String(it.name)]={sha:String(it.sha||\"\")};\n        }\n\n        var oldManifest=null;\n        try{oldManifest=readJsonOrNull(META_DIR+\"manifest.json\",BRANCH);}catch(ignoreManifest){}\n        var oldFiles=oldManifest&&Array.isArray(oldManifest.files)?oldManifest.files:[];\n        var added=arrayDiff(FILES,oldFiles),removed=arrayDiff(oldFiles,FILES);\n\n        var note=trimText(zdjl.prompt(\n            \"扫描到 \"+FILES.length+\" 个ZJS。\\n新增：\"+added.length+\"｜移出：\"+removed.length+\n            \"\\n\\nV4.6增量模式：只比较Git blob SHA，只上传真正变化文件。\\n\\n版本说明（可留空）：\",\"\"\n        ));\n\n        var t=nowInfo();\n        var changed=[],created=[],updated=[],unchanged=[];\n        for(var j=0;j<FILES.length;j++){\n            var name=FILES[j],ri=remote[name];\n            if(ri&&ri.sha===localSha[name])unchanged.push(name);\n            else changed.push(name);\n        }\n\n        // 只上传 changed，不再逐文件GET。\n        for(var k=0;k<changed.length;k++){\n            var cn=changed[k],known=remote[cn]?remote[cn].sha:null;\n            var put=putText(CLOUD_DIR+cn,localMap[cn],\"农场脚本发布 \"+t.id+\"：\"+cn,known);\n            if(put.code===401||put.code===403){clearToken();throw new Error(cn+\" 上传鉴权失败 HTTP \"+put.code);}\n            if(put.code!==200&&put.code!==201)throw new Error(cn+\" 上传失败 HTTP \"+put.code+\"\\n\"+put.body);\n            if(known)updated.push(cn);else created.push(cn);\n        }\n\n        var manifest={\n            schema:4,\n            mode:\"git-sha-incremental\",\n            description:\"V4.6：GitHub目录blob SHA增量同步；不再使用latest-package日常更新\",\n            files:FILES\n        };\n        var manifestResult=putTextIfChanged(META_DIR+\"manifest.json\",JSON.stringify(manifest,null,2),\"更新增量脚本清单 \"+t.id);\n        if(!manifestResult.ok)throw new Error(\"manifest写入失败 HTTP \"+manifestResult.code+\"\\n\"+manifestResult.body);\n\n        var realChange=changed.length>0||added.length>0||removed.length>0||manifestResult.changed;\n        if(!realChange){\n            zdjl.alert(\n                \"没有发现变化｜V4.6增量模式\\n\\n\"+\n                \"脚本：\"+FILES.length+\n                \"\\n网络请求：\"+netCount+\n                \"\\n耗时：\"+((Date.now()-startedAt)/1000).toFixed(1)+\"秒\"+\n                \"\\n\\n全部 Git blob SHA 与云端一致。\"\n            );\n            return;\n        }\n\n        // manifest写好以后再取当前main快照，历史版本更新器继续兼容。\n        var ref=req({\n            url:\"https://api.github.com/repos/\"+OWNER+\"/\"+REPO+\"/git/ref/heads/\"+encodeURIComponent(BRANCH),\n            method:\"GET\",headers:headers(false),timeout:15000\n        },2);\n        if(ref.code!==200)throw new Error(\"读取main快照失败 HTTP \"+ref.code+\"\\n\"+ref.body);\n        var snapshotSha=JSON.parse(String(ref.body||\"{}\")).object.sha;\n\n        var release={\n            schema:4,id:t.id,publishedAt:t.text,displayTime:t.displayTime,\n            displayName:displayName(t.displayTime,note),\n            snapshotSha:snapshotSha,note:note,fileCount:FILES.length,\n            changedCount:changed.length,addedCount:added.length,removedCount:removed.length,\n            changedFiles:changed,addedFiles:added,removedFiles:removed,\n            syncMode:\"git-sha-incremental\"\n        };\n\n        var history={schema:4,versions:[]};\n        try{\n            var oldHistory=readJsonOrNull(META_DIR+\"versions.json\",BRANCH);\n            if(oldHistory&&Array.isArray(oldHistory.versions))history=oldHistory;\n        }catch(eh){}\n        history.schema=4;if(!Array.isArray(history.versions))history.versions=[];\n        history.versions.unshift(release);\n        if(history.versions.length>100)history.versions=history.versions.slice(0,100);\n\n        var hr=putTextIfChanged(META_DIR+\"versions.json\",JSON.stringify(history,null,2),\"记录版本历史 \"+t.id);\n        if(!hr.ok)throw new Error(\"versions写入失败 HTTP \"+hr.code+\"\\n\"+hr.body);\n\n        var lr=putTextIfChanged(META_DIR+\"latest.json\",JSON.stringify(release,null,2),\"发布最新版 \"+t.id);\n        if(!lr.ok)throw new Error(\"latest写入失败 HTTP \"+lr.code+\"\\n\"+lr.body);\n\n        var msg=\n            \"农场脚本 V4.6 增量发布成功\\n\\n\"+\n            \"版本：\"+release.displayName+\n            \"\\n脚本总数：\"+FILES.length+\n            \"\\n内容变化：\"+changed.length+\n            \"\\n未变化：\"+unchanged.length+\n            \"\\n网络请求：\"+netCount+\n            \"\\n耗时：\"+((Date.now()-startedAt)/1000).toFixed(1)+\"秒\"+\n            \"\\n\\n不再生成/上传1.6MB latest-package.json。\";\n        if(changed.length)msg+=\"\\n\\n【本次上传】\\n\"+changed.join(\"\\n\");\n        zdjl.alert(msg);\n    }catch(e){\n        zdjl.alert(\"农场脚本增量发布失败\\n\\n\"+safeErrorText(e)+\"\\n\\n网络请求：\"+netCount+\"\\n耗时：\"+((Date.now()-startedAt)/1000).toFixed(1)+\"秒\");\n    }\n})();"}

{"repeatCount":1,"pauseOnFail":false,"count":2,"minVerCode":2015000,"minVerName":"2.15.0","screenWidth":720,"screenHeight":1280,"screenDpi":2,"lastSaveScreenWidth":720,"lastSaveScreenHeight":1280,"lastSaveScreenDpi":2,"savedVerCode":26000050,"savedVerName":"26.5.0","delay":"0.2","delayUnit":1,"description":"农场脚本版本发布器 V4.5.5｜38文件云同步+Token污染自愈+云工具自同步","desc":"农场脚本云发布 V4.5｜动态扫描正式业务ZJS｜排除云工具\/旧模板\/旧识别原型｜Git快照"}
{"type":"运行JS代码","delay":"0","delayUnit":1,"desc":"农场脚本云发布 V4.2｜动态扫描全部业务ZJS｜月日时分版本锚点｜Git快照","scriptCallbacks":{"afterExecSuc":{"type":"控制执行","delay":"0","delayUnit":1,"controlRunType":"stop","ContinueParentExecute":false}},"jsCode":"(function () {\n    var OWNER = \"YYsakura-mm\";\n    var REPO = \"yysakura\";\n    var BRANCH = \"main\";\n    var BASE_DIR = \"\/storage\/emulated\/0\/自动精灵\/\";\n    var CLOUD_DIR = \"scripts\/\";\n    var META_DIR = \".farmcloud\/\";\n    var NS = \"farm-cloud-v4\";\n    var TOKEN_NS = \"github-sync\";\n\n    \/\/ 正式发布器与更新器本身也属于云版本。\n    \/\/ 这样一台设备修复云工具后，其他设备也能通过同一版本收到修复。\n    \/\/ 仅排除旧\/临时\/测试同步工具。\n    var EXCLUDE_PREFIXES = [\n        \"农场脚本批量上传器\",\n        \"农场脚本批量更新器\",\n        \"GitHub上传器\",\n        \"GitHub下载更新器\",\n        \"ZJS目录扫描测试\",\n        \"轻量状态跳转模板\",\n        \"脚本更新器\",\n        \"识别情况\"\n    ];\n\n    function trimText(v) {\n        return String(v == null ? \"\" : v).replace(\/^\\s+|\\s+$\/g, \"\");\n    }\n\n    function endsWithIgnoreCase(s, suffix) {\n        s = String(s).toLowerCase();\n        suffix = String(suffix).toLowerCase();\n        return s.lastIndexOf(suffix) === s.length - suffix.length;\n    }\n\n    function isManagedZjs(name) {\n        name = String(name);\n        if (!endsWithIgnoreCase(name, \".zjs\")) return false;\n        for (var i = 0; i < EXCLUDE_PREFIXES.length; i++) {\n            if (name.indexOf(EXCLUDE_PREFIXES[i]) === 0) return false;\n        }\n        return true;\n    }\n\n    function listByNodeFs(dir) {\n        if (typeof require !== \"function\") return null;\n        var fs = require(\"fs\");\n        if (!fs || typeof fs.readdirSync !== \"function\") return null;\n\n        var names = fs.readdirSync(dir);\n        var out = [];\n\n        for (var i = 0; i < names.length; i++) {\n            var n = String(names[i]);\n            if (!isManagedZjs(n)) continue;\n\n            try {\n                var stat = fs.statSync(dir + n);\n                if (!stat || typeof stat.isFile !== \"function\" || !stat.isFile()) continue;\n            } catch (ignoreStat) {\n                continue;\n            }\n\n            out.push(n);\n        }\n\n        return out;\n    }\n\n    function listByJavaFile(dir) {\n        var FileClass = null;\n\n        try {\n            if (typeof Java !== \"undefined\" && Java && typeof Java.type === \"function\") {\n                FileClass = Java.type(\"java.io.File\");\n            }\n        } catch (ignoreJavaType) {}\n\n        if (!FileClass) {\n            try {\n                if (typeof Packages !== \"undefined\" &&\n                    Packages.java && Packages.java.io && Packages.java.io.File) {\n                    FileClass = Packages.java.io.File;\n                }\n            } catch (ignorePackages) {}\n        }\n\n        if (!FileClass) return null;\n\n        var folder = new FileClass(dir);\n        var arr = folder.listFiles();\n        if (arr == null) return [];\n\n        var out = [];\n        for (var i = 0; i < arr.length; i++) {\n            var f = arr[i];\n            try {\n                if (!f.isFile()) continue;\n                var n = String(f.getName());\n                if (isManagedZjs(n)) out.push(n);\n            } catch (ignoreOne) {}\n        }\n\n        return out;\n    }\n\n    function managedFileOrder(a, b) {\n        a = String(a); b = String(b);\n        function rank(n) {\n            if (n === \"农场脚本下载.zjs\") return 3;\n            if (n === \"农场脚本版本更新器.zjs\") return 2;\n            if (n === \"农场脚本版本发布器.zjs\") return 1;\n            return 0;\n        }\n        var ra = rank(a), rb = rank(b);\n        if (ra !== rb) return ra - rb;\n        return a < b ? -1 : (a > b ? 1 : 0);\n    }\n\n    function scanZjsFiles(dir) {\n        var files = null;\n        var errors = [];\n\n        try {\n            files = listByNodeFs(dir);\n        } catch (e1) {\n            errors.push(\"Node fs：\" + safeErrorText(e1));\n        }\n\n        if (files === null) {\n            try {\n                files = listByJavaFile(dir);\n            } catch (e2) {\n                errors.push(\"Java File：\" + safeErrorText(e2));\n            }\n        }\n\n        if (files === null) {\n            throw new Error(\n                \"当前自动精灵JS运行环境没有可用的目录枚举接口。\\n\\n\" +\n                (errors.length ? errors.join(\"\\n\") : \"Node fs 与 Java File 均不可用。\")\n            );\n        }\n\n        files.sort(managedFileOrder);\n\n        \/\/ 去重\n        var unique = [];\n        var seen = {};\n        for (var i = 0; i < files.length; i++) {\n            if (!seen[files[i]]) {\n                seen[files[i]] = true;\n                unique.push(files[i]);\n            }\n        }\n        return unique;\n    }\n\n    function pad2(n) {\n        n = Number(n);\n        return n < 10 ? \"0\" + n : String(n);\n    }\n\n    function nowInfo() {\n        var d = new Date();\n        var y = d.getFullYear();\n        var mo = pad2(d.getMonth() + 1);\n        var da = pad2(d.getDate());\n        var h = pad2(d.getHours());\n        var mi = pad2(d.getMinutes());\n        var s = pad2(d.getSeconds());\n        return {\n            id: \"V\" + y + mo + da + \"-\" + h + mi + s,\n            text: y + \"-\" + mo + \"-\" + da + \" \" + h + \":\" + mi + \":\" + s,\n            displayTime: mo + \"-\" + da + \" \" + h + \":\" + mi\n        };\n    }\n\n    function makeDisplayName(displayTime, note) {\n        note = trimText(note);\n        return String(displayTime) + (note ? \"｜\" + note : \"\");\n    }\n\n    function encodeRepoPath(path) {\n        var a = String(path).split(\"\/\");\n        var out = [];\n        for (var i = 0; i < a.length; i++) out.push(encodeURIComponent(a[i]));\n        return out.join(\"\/\");\n    }\n\n    function cleanBase64(s) {\n        return String(s == null ? \"\" : s).replace(\/\\s\/g, \"\");\n    }\n\n    function utf8Bytes(str) {\n        var bytes = [];\n        for (var i = 0; i < str.length; i++) {\n            var c = str.charCodeAt(i);\n            if (c < 0x80) {\n                bytes.push(c);\n            } else if (c < 0x800) {\n                bytes.push(0xC0 | (c >> 6));\n                bytes.push(0x80 | (c & 0x3F));\n            } else if (c >= 0xD800 && c <= 0xDBFF && i + 1 < str.length) {\n                var c2 = str.charCodeAt(++i);\n                var cp = 0x10000 + (((c & 0x3FF) << 10) | (c2 & 0x3FF));\n                bytes.push(0xF0 | (cp >> 18));\n                bytes.push(0x80 | ((cp >> 12) & 0x3F));\n                bytes.push(0x80 | ((cp >> 6) & 0x3F));\n                bytes.push(0x80 | (cp & 0x3F));\n            } else {\n                bytes.push(0xE0 | (c >> 12));\n                bytes.push(0x80 | ((c >> 6) & 0x3F));\n                bytes.push(0x80 | (c & 0x3F));\n            }\n        }\n        return bytes;\n    }\n\n    function base64Text(str) {\n        var chars = \"ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789+\/\";\n        var b = utf8Bytes(String(str));\n        var out = \"\";\n        for (var i = 0; i < b.length; i += 3) {\n            var b1 = b[i];\n            var b2 = i + 1 < b.length ? b[i + 1] : 0;\n            var b3 = i + 2 < b.length ? b[i + 2] : 0;\n            var n = (b1 << 16) | (b2 << 8) | b3;\n            out += chars.charAt((n >> 18) & 63);\n            out += chars.charAt((n >> 12) & 63);\n            out += i + 1 < b.length ? chars.charAt((n >> 6) & 63) : \"=\";\n            out += i + 2 < b.length ? chars.charAt(n & 63) : \"=\";\n        }\n        return out;\n    }\n\n    function looksLikeGitHubToken(v) {\n        var s = trimText(v);\n        if (!s) return false;\n        \/\/ GitHub PAT 必须是纯 ASCII，且正常会以 github_pat_ \/ gh*_ 开头。\n        \/\/ 最低长度保护可以直接拦住“版本说明被误存成 Token”这类污染。\n        if (\/[^\\x21-\\x7E]\/.test(s) || \/\\s\/.test(s) || s.length < 20) return false;\n        return \/^(github_pat_|gh[pousr]_)\/.test(s);\n    }\n\n    function clearToken() {\n        try { zdjl.setStorage(\"github_token\", \"\", TOKEN_NS); } catch (e) {}\n        \/\/ 兼容清理旧版曾经使用过的 farm-cloud-v4 命名空间。\n        try { zdjl.setStorage(\"github_token\", \"\", NS); } catch (e2) {}\n    }\n\n    function getToken() {\n        var primary = trimText(zdjl.getStorage(\"github_token\", TOKEN_NS));\n        if (primary && !looksLikeGitHubToken(primary)) {\n            \/\/ 发现污染值时绝不能拿去拼 Authorization。\n            try { zdjl.setStorage(\"github_token\", \"\", TOKEN_NS); } catch (e0) {}\n            primary = \"\";\n        }\n        if (looksLikeGitHubToken(primary)) return primary;\n\n        \/\/ 只把旧命名空间里的“合法 Token”迁移进专用命名空间。\n        var legacy = trimText(zdjl.getStorage(\"github_token\", NS));\n        if (legacy && !looksLikeGitHubToken(legacy)) {\n            try { zdjl.setStorage(\"github_token\", \"\", NS); } catch (e1) {}\n            legacy = \"\";\n        }\n        if (looksLikeGitHubToken(legacy)) {\n            try { zdjl.setStorage(\"github_token\", legacy, TOKEN_NS); } catch (e2) {}\n            try { zdjl.setStorage(\"github_token\", \"\", NS); } catch (e3) {}\n            return legacy;\n        }\n\n        var entered = trimText(zdjl.prompt(\n            \"GitHub Token 已缺失或旧值异常，请重新粘贴 Fine-grained PAT\",\n            \"\"\n        ));\n        if (!entered) return \"\";\n        if (!looksLikeGitHubToken(entered)) {\n            zdjl.alert(\n                \"这不是有效的 GitHub Token。\\\\n\\\\n\" +\n                \"应类似：github_pat_...\\\\n\" +\n                \"不会保存本次输入，请重新运行发布器。\"\n            );\n            return \"\";\n        }\n        zdjl.setStorage(\"github_token\", entered, TOKEN_NS);\n        \/\/ 新版不再把 Token 复制进 farm-cloud-v4，避免业务配置与密钥混存。\n        try { zdjl.setStorage(\"github_token\", \"\", NS); } catch (e4) {}\n        return entered;\n    }\n\n    function safeErrorText(e) {\n        var s = String(e == null ? \"\" : e);\n        \/\/ 防止底层请求库把 Authorization 值原样塞进报错弹窗。\n        s = s.replace(\/(Authorization value:\\\\s*Bearer\\\\s+)[^\\\\r\\\\n]+\/ig, \"$1***\");\n        s = s.replace(\/(Bearer\\\\s+)(github_pat_|gh[pousr]_)[A-Za-z0-9_\\\\-]+\/g, \"$1***\");\n        return s;\n    }\n\n    var token = getToken();\n    if (!token) {\n        zdjl.alert(\"没有可用的 GitHub Token，停止发布\");\n        return;\n    }\n\n    function authHeaders(rawMode) {\n        var h = [\n            {\"Authorization\": \"Bearer \" + token},\n            {\"X-GitHub-Api-Version\": \"2022-11-28\"},\n            {\"Accept\": rawMode ? \"application\/vnd.github.raw+json\" : \"application\/vnd.github+json\"}\n        ];\n        return h;\n    }\n\n    function waitMs(ms) {\n        zdjl.sleep(ms);\n    }\n\n    function isTransientCode(code) {\n        return code === 408 ||\n               code === 429 ||\n               code === 500 ||\n               code === 502 ||\n               code === 503 ||\n               code === 504;\n    }\n\n    function requestWithRetry(options, maxTry) {\n        maxTry = maxTry || 3;\n        var lastErr = null;\n        var lastResp = null;\n\n        for (var attempt = 1; attempt <= maxTry; attempt++) {\n            try {\n                lastResp = zdjl.requestUrl(options);\n\n                if (!lastResp || !isTransientCode(lastResp.code)) {\n                    return lastResp;\n                }\n\n                lastErr = new Error(\n                    \"HTTP \" + lastResp.code +\n                    \"（第\" + attempt + \"\/\" + maxTry + \"次）\"\n                );\n            } catch (e) {\n                lastErr = e;\n            }\n\n            if (attempt < maxTry) {\n                waitMs(1000 * attempt);\n            }\n        }\n\n        if (lastResp && isTransientCode(lastResp.code)) {\n            return lastResp;\n        }\n\n        throw lastErr || new Error(\"网络请求失败\");\n    }\n\n    function contentsUrl(path, ref) {\n        var u =\n            \"https:\/\/api.github.com\/repos\/\" +\n            OWNER + \"\/\" + REPO +\n            \"\/contents\/\" + encodeRepoPath(path);\n        if (ref) u += \"?ref=\" + encodeURIComponent(ref);\n        return u;\n    }\n\n    function getInfo(path, ref) {\n        return requestWithRetry({\n            url: contentsUrl(path, ref || BRANCH),\n            method: \"GET\",\n            headers: authHeaders(false),\n            timeout: 25000\n        }, 3);\n    }\n\n    function getRaw(path, ref) {\n        return requestWithRetry({\n            url: contentsUrl(path, ref || BRANCH),\n            method: \"GET\",\n            headers: authHeaders(true),\n            timeout: 25000\n        }, 3);\n    }\n\n    function putBase64(path, base64Content, message, knownSha) {\n        var data = {\n            message: message,\n            content: cleanBase64(base64Content),\n            branch: BRANCH\n        };\n        if (knownSha) data.sha = knownSha;\n\n        return requestWithRetry({\n            url: contentsUrl(path, null),\n            method: \"PUT\",\n            headers: [\n                {\"Authorization\": \"Bearer \" + token},\n                {\"Accept\": \"application\/vnd.github+json\"},\n                {\"X-GitHub-Api-Version\": \"2022-11-28\"},\n                {\"Content-Type\": \"application\/json\"}\n            ],\n            requestBody: JSON.stringify(data),\n            timeout: 35000\n        }, 3);\n    }\n\n    function putTextIfChanged(path, text, message) {\n        var wanted = cleanBase64(base64Text(text));\n        var info = getInfo(path, BRANCH);\n        var sha = null;\n\n        if (info.code === 200) {\n            var obj = JSON.parse(info.body);\n            sha = obj.sha;\n            if (obj.content && cleanBase64(obj.content) === wanted) {\n                return {ok:true, changed:false, code:200};\n            }\n        } else if (info.code === 404) {\n            sha = null;\n        } else {\n            return {ok:false, changed:false, code:info.code, body:info.body};\n        }\n\n        var r = putBase64(path, wanted, message, sha);\n        return {\n            ok: r.code === 200 || r.code === 201,\n            changed: r.code === 200 || r.code === 201,\n            code: r.code,\n            body: r.body\n        };\n    }\n\n    function readJsonOrNull(path) {\n        var r = getRaw(path, BRANCH);\n        if (r.code === 404) return null;\n        if (r.code !== 200) throw new Error(\"读取 \" + path + \" 失败 HTTP \" + r.code + \"\\n\" + r.body);\n        return JSON.parse(r.body);\n    }\n\n    function getMainHeadSha() {\n        var r = requestWithRetry({\n            url: \"https:\/\/api.github.com\/repos\/\" + OWNER + \"\/\" + REPO + \"\/git\/ref\/heads\/\" + encodeURIComponent(BRANCH),\n            method: \"GET\",\n            headers: authHeaders(false),\n            timeout: 25000\n        }, 3);\n        if (r.code !== 200) throw new Error(\"读取main提交失败 HTTP \" + r.code + \"\\n\" + r.body);\n        return JSON.parse(r.body).object.sha;\n    }\n\n    function arrayDiff(newArr, oldArr) {\n        var oldMap = {}, out = [];\n        for (var i = 0; i < oldArr.length; i++) oldMap[oldArr[i]] = true;\n        for (var j = 0; j < newArr.length; j++) {\n            if (!oldMap[newArr[j]]) out.push(newArr[j]);\n        }\n        return out;\n    }\n\n    var FILES;\n    try {\n        FILES = scanZjsFiles(BASE_DIR);\n    } catch (scanErr) {\n        zdjl.alert(\"扫描自动精灵目录失败\\n\\n\" + String(scanErr));\n        return;\n    }\n\n    if (!FILES.length) {\n        zdjl.alert(\"没有扫描到任何受管理 .zjs 文件，停止发布。\");\n        return;\n    }\n\n    var oldManifest = null;\n    try { oldManifest = readJsonOrNull(META_DIR + \"manifest.json\"); } catch (ignoreOldManifest) {}\n\n    var oldFiles = oldManifest && oldManifest.files ? oldManifest.files : [];\n    var addedNames = arrayDiff(FILES, oldFiles);\n    var removedNames = arrayDiff(oldFiles, FILES);\n\n    var note = trimText(zdjl.prompt(\n        \"扫描到 \" + FILES.length + \" 个同步脚本。\\n\" +\n        \"新增：\" + addedNames.length + \"｜移出清单：\" + removedNames.length +\n        \"\\n\\n版本说明（可留空）：\",\n        \"\"\n    ));\n\n    var t = nowInfo();\n\n    var created = [];\n    var updated = [];\n    var unchanged = [];\n    var failed = [];\n\n    for (var i = 0; i < FILES.length; i++) {\n        var name = FILES[i];\n        var localPath = BASE_DIR + name;\n        var repoPath = CLOUD_DIR + name;\n        var localB64;\n\n        try {\n            localB64 = cleanBase64(zdjl.readFile(localPath, {encode:\"BASE64\"}));\n        } catch (e1) {\n            failed.push(name + \"｜读取失败：\" + safeErrorText(e1));\n            continue;\n        }\n\n        var check;\n        try {\n            check = getInfo(repoPath, BRANCH);\n        } catch (e2) {\n            failed.push(name + \"｜查询异常：\" + safeErrorText(e2));\n            continue;\n        }\n\n        var sha = null;\n\n        if (check.code === 200) {\n            try {\n                var info = JSON.parse(check.body);\n                sha = info.sha;\n                if (info.content && cleanBase64(info.content) === localB64) {\n                    unchanged.push(name);\n                    continue;\n                }\n            } catch (e3) {\n                failed.push(name + \"｜解析云端信息失败：\" + safeErrorText(e3));\n                continue;\n            }\n        } else if (check.code === 404) {\n            sha = null;\n        } else if (check.code === 401 || check.code === 403) {\n            clearToken();\n            zdjl.alert(\n                \"GitHub鉴权失败\\n\\nHTTP：\" + check.code +\n                \"\\n已清除本机Token，下次运行会重新要求输入。\\n\\n\" + check.body\n            );\n            return;\n        } else {\n            failed.push(name + \"｜查询HTTP \" + check.code);\n            continue;\n        }\n\n        var put;\n        try {\n            put = putBase64(\n                repoPath,\n                localB64,\n                \"农场脚本发布 \" + t.id + \"：\" + name,\n                sha\n            );\n        } catch (e4) {\n            failed.push(name + \"｜上传异常：\" + safeErrorText(e4));\n            continue;\n        }\n\n        if (put.code === 201) created.push(name);\n        else if (put.code === 200) updated.push(name);\n        else if (put.code === 401 || put.code === 403) {\n            clearToken();\n            zdjl.alert(\n                \"GitHub上传鉴权失败\\n\\n文件：\" + name +\n                \"\\nHTTP：\" + put.code +\n                \"\\n已清除本机Token，下次运行会重新要求输入。\\n\\n\" + put.body\n            );\n            return;\n        } else {\n            failed.push(name + \"｜上传HTTP \" + put.code);\n        }\n    }\n\n    if (failed.length) {\n        zdjl.alert(\n            \"本次未发布正式版本\\n\\n\" +\n            \"有 \" + failed.length + \" 个文件失败，latest不会更新，避免产生半成品版本。\\n\\n\" +\n            \"【失败】\\n\" + failed.join(\"\\n\")\n        );\n        return;\n    }\n\n    var manifestObj = {\n        schema: 4,\n        mode: \"auto-directory\",\n        description: \"自动扫描正式 .zjs，包含发布器、更新器和一键下载器；云工具固定排最后\",\n        files: FILES,\n        excludedPrefixes: EXCLUDE_PREFIXES\n    };\n\n    var manifestResult;\n    try {\n        manifestResult = putTextIfChanged(\n            META_DIR + \"manifest.json\",\n            JSON.stringify(manifestObj, null, 2),\n            \"更新自动扫描脚本清单 \" + t.id\n        );\n    } catch (e5) {\n        zdjl.alert(\"清单发布失败，latest未更新\\n\\n\" + safeErrorText(e5));\n        return;\n    }\n\n    if (!manifestResult.ok) {\n        zdjl.alert(\n            \"清单发布失败，latest未更新\\n\\nHTTP：\" +\n            manifestResult.code + \"\\n\\n\" + (manifestResult.body || \"\")\n        );\n        return;\n    }\n\n    var changedFiles = created.concat(updated);\n    var hasRealChange =\n        changedFiles.length > 0 ||\n        addedNames.length > 0 ||\n        removedNames.length > 0 ||\n        manifestResult.changed;\n\n    if (!hasRealChange) {\n        zdjl.alert(\n            \"没有发现任何变化\\n\\n\" +\n            \"当前自动扫描业务脚本：\" + FILES.length + \"\\n\" +\n            \"所有脚本与云端正式版本一致。\\n\\n没有创建新版本。\"\n        );\n        return;\n    }\n\n    var snapshotSha;\n    try {\n        snapshotSha = getMainHeadSha();\n    } catch (e6) {\n        zdjl.alert(\"读取版本快照SHA失败，latest未更新\\n\\n\" + safeErrorText(e6));\n        return;\n    }\n\n    var release = {\n        schema: 4,\n        id: t.id,\n        publishedAt: t.text,\n        displayTime: t.displayTime,\n        displayName: makeDisplayName(t.displayTime, note),\n        snapshotSha: snapshotSha,\n        note: note,\n        fileCount: FILES.length,\n        changedCount: changedFiles.length,\n        addedCount: addedNames.length,\n        removedCount: removedNames.length,\n        changedFiles: changedFiles,\n        addedFiles: addedNames,\n        removedFiles: removedNames\n    };\n\n    var history = {schema:4, versions:[]};\n    try {\n        var oldHistory = readJsonOrNull(META_DIR + \"versions.json\");\n        if (oldHistory && oldHistory.versions) history = oldHistory;\n    } catch (e7) {\n        zdjl.alert(\"读取版本历史失败，停止发布latest\\n\\n\" + safeErrorText(e7));\n        return;\n    }\n\n    history.schema = 4;\n    if (!history.versions) history.versions = [];\n    history.versions.unshift(release);\n\n    var dedup = [];\n    var seen = {};\n    for (var h = 0; h < history.versions.length; h++) {\n        var v = history.versions[h];\n        var key = String(v.id) + \"|\" + String(v.snapshotSha);\n        if (!seen[key]) {\n            seen[key] = true;\n            dedup.push(v);\n        }\n    }\n    history.versions = dedup;\n\n    var histResult;\n    try {\n        histResult = putTextIfChanged(\n            META_DIR + \"versions.json\",\n            JSON.stringify(history, null, 2),\n            \"记录版本历史 \" + t.id\n        );\n    } catch (e8) {\n        zdjl.alert(\"版本历史写入失败，latest未更新\\n\\n\" + safeErrorText(e8));\n        return;\n    }\n\n    if (!histResult.ok) {\n        zdjl.alert(\n            \"版本历史写入失败，latest未更新\\n\\nHTTP：\" +\n            histResult.code + \"\\n\\n\" + (histResult.body || \"\")\n        );\n        return;\n    }\n\n    var latestResult;\n    try {\n        latestResult = putTextIfChanged(\n            META_DIR + \"latest.json\",\n            JSON.stringify(release, null, 2),\n            \"发布最新版 \" + t.id\n        );\n    } catch (e9) {\n        zdjl.alert(\n            \"脚本快照和历史已经写入，但latest写入失败。\\n\\n\" + safeErrorText(e9)\n        );\n        return;\n    }\n\n    if (!latestResult.ok) {\n        zdjl.alert(\n            \"脚本快照和历史已经写入，但latest写入失败。\\n\\nHTTP：\" +\n            latestResult.code + \"\\n\\n\" + (latestResult.body || \"\")\n        );\n        return;\n    }\n\n    var msg =\n        \"农场脚本 V4.2 发布成功\\n\\n\" +\n        \"版本锚点：\" + release.displayName + \"\\n\" +\n        \"内部ID：\" + release.id + \"\\n\" +\n        \"完整时间：\" + release.publishedAt + \"\\n\" +\n        \"自动发现脚本：\" + FILES.length + \"\\n\" +\n        \"新加入清单：\" + addedNames.length + \"\\n\" +\n        \"移出清单：\" + removedNames.length + \"\\n\" +\n        \"内容修改：\" + updated.length + \"\\n\" +\n        \"云端新建：\" + created.length + \"\\n\" +\n        \"未变化：\" + unchanged.length;\n\n    if (note) msg += \"\\n版本说明：\" + note;\n    if (addedNames.length) msg += \"\\n\\n【新增脚本】\\n\" + addedNames.join(\"\\n\");\n    if (removedNames.length) msg += \"\\n\\n【移出当前版本】\\n\" + removedNames.join(\"\\n\");\n    if (updated.length) msg += \"\\n\\n【内容更新】\\n\" + updated.join(\"\\n\");\n\n    zdjl.alert(msg);\n})();"}

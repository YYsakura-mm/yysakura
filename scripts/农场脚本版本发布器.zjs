{"repeatCount":1,"pauseOnFail":false,"count":1,"minVerCode":2021000,"minVerName":"2.21.0","screenWidth":720,"screenHeight":1280,"screenDpi":2,"lastSaveScreenWidth":1280,"lastSaveScreenHeight":720,"lastSaveScreenDpi":2,"savedVerCode":26000050,"savedVerName":"26.5.0","delay":"0.2","delayUnit":1,"description":"农场脚本云发布 V5.3｜旧设备零搬运迁移桥｜安全基线｜按钮二次确认｜原子Tag","desc":"农场脚本云发布 V5.3｜旧设备零搬运迁移桥｜安全基线｜按钮二次确认｜原子Tag"}
{"type":"运行JS代码","delay":"0","delayUnit":1,"desc":"云发布｜发布测试版；测试通过后转为稳定版","jsCode":"(function(){\n    var OWNER=\"YYsakura-mm\";\n    var REPO=\"yysakura\";\n    var BRANCH=\"main\";\n    var BASE_DIR=\"/storage/emulated/0/自动精灵/\";\n    var META_DIR=\".farmcloud/\";\n    var V5_DIR=\".farmcloud/v5/\";\n    var NS=\"farm-cloud-v5\";\n    var TOKEN_NS=\"github-sync\";\n    var BASE_FILE=BASE_DIR+\".farm-cloud-base-v5.json\";\n    // 从每个云端版本自身的 managedFiles 读取，不再写死脚本数量。\n    var MANAGED=[];\n    var SENSITIVE_RE=/(账号配置|密钥|密码|口令|令牌|token|secret|credentials|备份|旧版|缓存|临时|测试|实验|sample|demo)/i;\n    function safeName(n){return typeof n===\"string\"&&n.length>0&&n.length<=110&&/^[^\\\\/\\x00-\\x1f]+\\.zjs$/i.test(n)&&n.indexOf(\"..\")<0&&n.charAt(0)!==\".\";}\n    function uniqueNames(names){var a=[],seen={};if(!Array.isArray(names))return a;for(var i=0;i<names.length;i++){var n=String(names[i]);if(!safeName(n))throw new Error(\"云端存在不安全脚本名：\"+n);if(!seen[n]){seen[n]=1;a.push(n);}}return a;}\n    function remoteNames(rel,base){\n        if(rel&&Array.isArray(rel.managedFiles)&&rel.managedFiles.length)return uniqueNames(rel.managedFiles);\n        if(base&&Array.isArray(base.files)&&base.files.length)return uniqueNames(base.files.map(function(it){return it.name;}));\n        throw new Error(\"远程版本没有 managedFiles，且无可用的本机基线。请先用上一版下载器同步一次。\");\n    }\n    function discoverCandidates(){\n        var names=[],sources=[],seen={},list=null;\n        function add(n,source){if(typeof n!==\"string\")return;if(n.indexOf(\"/\")>=0)n=n.slice(n.lastIndexOf(\"/\")+1);if(safeName(n)&&!seen[n]){seen[n]=true;names.push(n);sources.push(source);}}\n        function addArray(a,src){if(Array.isArray(a))for(var i=0;i<a.length;i++)add(typeof a[i]===\"string\"?a[i]:(a[i]&&(a[i].name||a[i].fileName||a[i].path)),src);}\n        try{if(typeof zdjl.listFiles===\"function\")addArray(zdjl.listFiles(BASE_DIR),\"目录\");}catch(ignore1){}\n        try{if(typeof zdjl.listDir===\"function\")addArray(zdjl.listDir(BASE_DIR),\"目录\");}catch(ignore2){}\n        try{if(typeof files!==\"undefined\"&&files&&typeof files.listDir===\"function\")addArray(files.listDir(BASE_DIR),\"目录\");}catch(ignore3){}\n        try{if(typeof require===\"function\"){var fs=require(\"fs\");if(fs&&typeof fs.readdirSync===\"function\")addArray(fs.readdirSync(BASE_DIR),\"目录\");}}catch(ignore4){}\n        try{if(typeof Java!==\"undefined\"&&Java&&typeof Java.type===\"function\"){\n            var File=Java.type(\"java.io.File\"),items=new File(BASE_DIR).list();\n            if(items){var ar=[];for(var i=0;i<items.length;i++)ar.push(String(items[i]));addArray(ar,\"目录\");}\n        }}catch(ignore5){}\n        try{if(typeof java!==\"undefined\"&&java&&java.io&&java.io.File){\n            var items2=new java.io.File(BASE_DIR).list();if(items2){var ar2=[];for(var j=0;j<items2.length;j++)ar2.push(String(items2[j]));addArray(ar2,\"目录\");}\n        }}catch(ignore6){}\n        // 自动精灵现有文件分组：当设备不提供目录枚举时，还可发现分组中新增脚本。\n        try{var groupText=localText(BASE_DIR+\".config/script_groups.json\");if(groupText){\n            var groups=JSON.parse(groupText);if(Array.isArray(groups))for(var k=0;k<groups.length;k++)addArray(groups[k].files,\"脚本分组\");\n        }}catch(ignore7){}\n        return {names:names,sources:sources};\n    }\n    function selectOne(title,items){\n        try{var r=zdjl.select({title:title,items:items,multi:false});if(r==null||r===false||r===\"\")return null;\n            if(typeof r===\"string\")return items.indexOf(r)>=0?r:null;\n            if(typeof r===\"number\")return items[r]||null;\n            if(r.item!=null)return String(r.item);\n            if(r.value!=null)return String(r.value);\n            if(r.index!=null)return items[Number(r.index)]||null;\n            if(r.selectedIndex!=null)return items[Number(r.selectedIndex)]||null;\n        }catch(e){}\n        return null;\n    }\n    function pickNewScripts(existing){\n        var discovered=discoverCandidates(),candidates=[],i,n;\n        for(i=0;i<discovered.names.length;i++){\n            n=discovered.names[i];if(existing.indexOf(n)>=0||SENSITIVE_RE.test(n))continue;\n            if(localText(BASE_DIR+n)===null)continue;\n            candidates.push(n);\n        }\n        var added=[],mode=\"\";\n        if(candidates.length){\n            mode=selectOne(\"发现 \"+candidates.length+\" 个未纳入云同步的ZJS，是否登记？\",[\"选择新脚本纳入本次发布\",\"暂不登记，直接发布\"]);\n            if(mode===\"选择新脚本纳入本次发布\"){\n                try{var r=zdjl.select({title:\"选择允许上传的新增脚本（可能发布到GitHub，请排除隐私数据）\",items:candidates,multi:true});\n                    if(r){var picked=Array.isArray(r.items)?r.items:(Array.isArray(r.result)?r.result.map(function(x){return typeof x===\"number\"?candidates[x]:x;}):[]);\n                        for(i=0;i<picked.length;i++)if(candidates.indexOf(String(picked[i]))>=0&&added.indexOf(String(picked[i]))<0)added.push(String(picked[i]));}\n                }catch(ignoreSelect){}\n                if(!added.length){var text=trimText(zdjl.prompt(\"多选窗口无结果；可输入要登记的脚本完整文件名（多个用逗号隔开）。留空则跳过：\",\"\"));\n                    if(text)added=parseManual(text,candidates,true);\n                }\n            }\n        }else{\n            mode=selectOne(\"云发布V6｜未发现待登记脚本\",[\"检查并发布现有脚本\",\"手动登记新增脚本并发布\"]);\n            if(mode===null)return null;\n            if(mode===\"手动登记新增脚本并发布\"){\n                var text2=trimText(zdjl.prompt(\"输入新增脚本完整文件名，例如：新脚本.zjs。多个用逗号隔开：\",\"\"));\n                if(text2)added=parseManual(text2,[],false);\n            }\n        }\n        for(i=0;i<added.length;i++){n=added[i];if(existing.indexOf(n)>=0)continue;\n            if(SENSITIVE_RE.test(n))throw new Error(\"新脚本名称含敏感/测试标记，拒绝自动发布：\"+n);\n            var content=localText(BASE_DIR+n);if(content===null)throw new Error(\"登记的新增文件不存在：\"+n);\n            validateScript(content,n);\n        }\n        return added;\n    }\n    function parseManual(text,allowed,limit){\n        var raw=String(text).split(/[，,;；\\n]+/),out=[];\n        for(var i=0;i<raw.length;i++){var n=trimText(raw[i]);if(!n)continue;\n            if(!safeName(n))throw new Error(\"脚本名不合法：\"+n);\n            if(limit&&allowed.indexOf(n)<0)throw new Error(\"不在候选列表：\"+n);\n            if(out.indexOf(n)<0)out.push(n);\n        }\n        return out;\n    }\n\n\n    function trimText(v){return String(v==null?\"\":v).replace(/^\\s+|\\s+$/g,\"\");}\n    function safeErrorText(e){\n        var s=String(e==null?\"\":e);\n        s=s.replace(/(Authorization value:\\s*Bearer\\s+)[^\\r\\n]+/ig,\"$1***\");\n        s=s.replace(/(Bearer\\s+)(github_pat_|gh[pousr]_)[A-Za-z0-9_\\-]+/g,\"$1***\");\n        return s;\n    }\n    function looksLikeToken(v){var s=trimText(v);return !!s&&!/[^\\x21-\\x7E]/.test(s)&&!/\\s/.test(s)&&s.length>=20&&/^(github_pat_|gh[pousr]_)/.test(s);}\n    function getToken(){\n        var t=\"\";\n        try{t=trimText(zdjl.getStorage(\"github_token\",TOKEN_NS));}catch(e){}\n        if(looksLikeToken(t))return t;\n        try{t=trimText(zdjl.getStorage(\"github_token\",NS));}catch(e2){}\n        if(looksLikeToken(t))return t;\n        t=trimText(zdjl.prompt(\"GitHub Token 缺失，请粘贴 Fine-grained PAT\",\"\"));\n        if(!looksLikeToken(t)){zdjl.alert(\"Token 无效，停止发布\");return \"\";}\n        zdjl.setStorage(\"github_token\",t,TOKEN_NS);\n        return t;\n    }\n    var TOKEN=getToken(); if(!TOKEN)return;\n\n    function headers(raw){\n        var h=[{\"X-GitHub-Api-Version\":\"2022-11-28\"},{\"Accept\":raw?\"application/vnd.github.raw+json\":\"application/vnd.github+json\"}];\n        if(TOKEN)h.unshift({\"Authorization\":\"Bearer \"+TOKEN});\n        return h;\n    }\n    function apiUrl(path){return \"https://api.github.com/repos/\"+OWNER+\"/\"+REPO+\"/\"+path;}\n    function transient(code){return code===408||code===409||code===429||code===500||code===502||code===503||code===504;}\n    function req(method,path,body,raw,maxTry){\n        var last=null,lastErr=null; maxTry=maxTry||4;\n        for(var a=1;a<=maxTry;a++){\n            try{\n                var opt={url:apiUrl(path),method:method,headers:headers(!!raw),timeout:45000};\n                if(body!==undefined&&body!==null){opt.headers.push({\"Content-Type\":\"application/json\"});opt.requestBody=JSON.stringify(body);}\n                last=zdjl.requestUrl(opt);\n                if(last&&!transient(last.code))return last;\n                lastErr=new Error(\"HTTP \"+(last?last.code:\"?\"));\n            }catch(e){lastErr=e;}\n            if(a<maxTry)try{zdjl.sleep(800*a);}catch(se){}\n        }\n        if(last)return last;\n        throw lastErr||new Error(\"网络请求失败\");\n    }\n    function requireCode(r,codes,label){for(var i=0;i<codes.length;i++)if(r&&r.code===codes[i])return r;throw new Error(label+\" HTTP \"+(r?r.code:\"?\")+\"\\n\"+(r&&r.body?r.body:\"\"));}\n    function encodePath(path){var a=String(path).split(\"/\"),o=[];for(var i=0;i<a.length;i++)o.push(encodeURIComponent(a[i]));return o.join(\"/\");}\n    function getRaw(path,ref){return req(\"GET\",\"contents/\"+encodePath(path)+\"?ref=\"+encodeURIComponent(ref||BRANCH),null,true,4);}\n    function getJson(path,ref){var r=getRaw(path,ref);if(r.code===404)return null;requireCode(r,[200],\"读取 \"+path);return JSON.parse(String(r.body||\"\"));}\n    function localText(path){try{return String(zdjl.readFile(path));}catch(e){return null;}}\n    function writeVerified(path,text){zdjl.writeFile(path,text);if(localText(path)!==text)throw new Error(\"本地写入校验失败：\"+path);}\n    function loadBase(){var s=localText(BASE_FILE);if(!s)return null;try{return JSON.parse(s);}catch(e){return null;}}\n    function saveBase(pkg){writeVerified(BASE_FILE,JSON.stringify(pkg));}\n    function pad2(n){return n<10?\"0\"+n:String(n);}\n    function nowInfo(){var d=new Date(),y=d.getFullYear(),mo=pad2(d.getMonth()+1),da=pad2(d.getDate()),h=pad2(d.getHours()),mi=pad2(d.getMinutes()),s=pad2(d.getSeconds());return{id:\"V\"+y+mo+da+\"-\"+h+mi+s,text:y+\"-\"+mo+\"-\"+da+\" \"+h+\":\"+mi+\":\"+s,display:mo+\"-\"+da+\" \"+h+\":\"+mi};}\n    function validateScript(text,name){\n        var ls=String(text||\"\").split(/\\r?\\n/),count=0;\n        for(var i=0;i<ls.length;i++){\n            if(!trimText(ls[i]))continue;\n            var row=JSON.parse(ls[i]);\n            if(!row||typeof row!==\"object\"||Array.isArray(row))throw new Error(name+\" 格式错误\");\n            if(count===0){if(row.type!==undefined||row.count===undefined||row.repeatCount===undefined)throw new Error(name+\" 文件头异常\");}\n            else if(!row.type)throw new Error(name+\" 动作类型缺失\");\n            count++;\n        }\n        if(count<2)throw new Error(name+\" 没有可执行动作\");\n    }\n    function readLocalManaged(){\n        var a=[];\n        for(var i=0;i<MANAGED.length;i++){\n            var n=MANAGED[i],t=localText(BASE_DIR+n);\n            if(t===null)throw new Error(\"正式脚本缺失：\"+n);\n            validateScript(t,n); a.push({name:n,content:t});\n        }\n        return {files:a};\n    }\n    function mapOf(pkg){var m={};if(pkg&&Array.isArray(pkg.files))for(var i=0;i<pkg.files.length;i++)m[String(pkg.files[i].name)]=String(pkg.files[i].content==null?\"\":pkg.files[i].content);return m;}\n    function completePkg(pkg){var m=mapOf(pkg);for(var i=0;i<MANAGED.length;i++)if(m[MANAGED[i]]===undefined)return false;return true;}\n    function diffNames(base,local){var bm=mapOf(base),lm=mapOf(local),a=[];for(var i=0;i<MANAGED.length;i++){var n=MANAGED[i];if(String(bm[n]===undefined?\"\":bm[n])!==String(lm[n]===undefined?\"\":lm[n]))a.push(n);}return a;}\n    function lineCount(s){s=String(s||\"\");return s?s.split(/\\r?\\n/).length:0;}\n    function getHead(){var r=req(\"GET\",\"git/ref/heads/\"+encodeURIComponent(BRANCH),null,false,4);requireCode(r,[200],\"读取 main HEAD\");return JSON.parse(r.body).object.sha;}\n    function getCommitTreeSha(commitSha){var r=req(\"GET\",\"git/commits/\"+commitSha,null,false,4);requireCode(r,[200],\"读取 main commit\");return JSON.parse(r.body).tree.sha;}\n    function createBlob(text){var r=req(\"POST\",\"git/blobs\",{content:String(text),encoding:\"utf-8\"},false,4);requireCode(r,[201],\"创建 Git blob\");return JSON.parse(r.body).sha;}\n    function createTree(baseTree,entries){var r=req(\"POST\",\"git/trees\",{base_tree:baseTree,tree:entries},false,4);requireCode(r,[201],\"创建 Git tree\");return JSON.parse(r.body).sha;}\n    function createCommit(message,treeSha,parentSha){var r=req(\"POST\",\"git/commits\",{message:message,tree:treeSha,parents:[parentSha]},false,4);requireCode(r,[201],\"创建 Git commit\");return JSON.parse(r.body).sha;}\n    function refSha(kind,name){var r=req(\"GET\",\"git/ref/\"+kind+\"/\"+encodeURIComponent(name),null,false,3);if(r.code===404)return \"\";requireCode(r,[200],\"读取 ref\");return JSON.parse(r.body).object.sha;}\n    function createTagRef(name,sha){\n        var r=req(\"POST\",\"git/refs\",{ref:\"refs/tags/\"+name,sha:sha},false,3);\n        if(r&&r.code===201)return;\n        var existing=refSha(\"tags\",name);if(existing===sha)return;\n        requireCode(r,[201],\"创建版本Tag\");\n    }\n    function fetchFullByRelease(rel){\n        var ref=String((rel&&(rel.tagName||rel.snapshotSha))||BRANCH),arr=[];\n        var names=(rel&&Array.isArray(rel.managedFiles)&&rel.managedFiles.length)?uniqueNames(rel.managedFiles):MANAGED;\n        for(var i=0;i<names.length;i++){\n            var n=names[i],r=getRaw(\"scripts/\"+n,ref);\n            requireCode(r,[200],\"读取云端 \"+n);arr.push({name:n,content:String(r.body||\"\")});\n        }\n        return {schema:51,versionId:String(rel&&rel.id||rel&&rel.versionId||\"\"),displayName:String(rel&&rel.displayName||rel&&rel.publishedAt||\"\"),tagName:String(rel&&rel.tagName||rel&&rel.snapshotSha||\"\"),files:arr};\n    }\n    function preview(changed,base,local,cloudRemove,bootstrap){\n        var bm=mapOf(base),lm=mapOf(local),s=(bootstrap?\"【首次建立 V5.1 安全基线】\":\"【本次准备发布】\")+\"\\n\";\n        s+=\"真正变化文件：\"+changed.length+\"\\n\\n\";\n        for(var i=0;i<changed.length;i++){var n=changed[i],a=String(bm[n]||\"\"),b=String(lm[n]||\"\");s+=(i+1)+\". \"+n+\"｜行 \"+lineCount(a)+\"→\"+lineCount(b)+\"｜字符 \"+a.length+\"→\"+b.length+\"\\n\";}\n        if(changed.indexOf(\"总控.zjs\")>=0)s+=\"\\n★ 总控.zjs 确认发生变化，本次会同步。\\n\";\n        var extra=[];for(var j=0;j<changed.length;j++)if(mapOf(base)[changed[j]]===undefined)extra.push(changed[j]);\n        if(extra.length)s+=\"\\n【新增正式脚本】\\n\"+extra.join(\"\\n\")+\"\\n请确认无隐私内容后再发布！\\n\";\n        if(cloudRemove.length)s+=\"\\n【一次性清理云端旧杂项】\"+cloudRemove.length+\" 个\\n\"+cloudRemove.join(\"\\n\")+\"\\n（只清云端，本机文件不删；以后不再出现）\\n\";\n        return s;\n    }\n\n    var TEST_BRANCH=\"farm-test\",TEST_DIR=V5_DIR+\"test/\";\n    function releaseId(rel){return String(rel&&(rel.id||rel.versionId)||\"\");}\n    function requireRelease(rel,channel){\n        if(!releaseId(rel)||!rel.tagName||(channel===\"test\"?rel.channel!==\"test\":rel.channel===\"test\"))throw Error(\"云端版本或通道信息不符\");\n        return rel;\n    }\n    function stableAt(ref){return requireRelease(getJson(V5_DIR+\"latest.json\",ref),\"stable\");}\n    function testingAt(ref){\n        var rel=getJson(TEST_DIR+\"latest.json\",ref);\n        return rel?requireRelease(rel,\"test\"):null;\n    }\n    function noteFor(title){\n        var summary=trimText(zdjl.prompt(title+\"｜发布说明标题（必填）\",\"\"));\n        if(!summary)return null;\n        var note=trimText(zdjl.prompt(\"填写详细中文介绍（必填）：说明改了什么、如何验证、还有哪些待测试项。\",\"改动：\\n验证：\\n待验证或已知限制：\"));\n        if(!note||!/[\\u4e00-\\u9fff]/.test(note)||note.replace(/改动[：:]|验证[：:]|待验证或已知限制[：:]|\\s/g,\"\").length===0){\n            zdjl.alert(\"未填写详细中文说明，已取消发布。\");return null;\n        }\n        return {summary:summary.replace(/[\\r\\n]+/g,\" \").slice(0,80),note:note};\n    }\n    function releaseFor(channel,parent,info,names,changed,stable,source){\n        var t=nowInfo(),id=(channel===\"test\"?\"T\":\"\")+t.id,tag=\"farm-v5-\"+(channel===\"test\"?\"test-\":\"\")+t.id;\n        return {schema:5,syncSchema:60,id:id,versionId:id,parentVersionId:releaseId(parent),\n            publishedAt:t.text,displayTime:t.display,displayName:t.display+\"｜\"+(channel===\"test\"?\"测试｜\":\"\")+info.summary,\n            note:info.note,fileCount:names.length,changedCount:changed.length,changedFiles:changed,removedLegacyFiles:[],\n            managedFiles:names,tagName:tag,snapshotSha:tag,mode:\"atomic-tag\",channel:channel,\n            stableBaseVersionId:releaseId(stable),promotedFromVersionId:source?releaseId(source):\"\"};\n    }\n    function put(entries,path,value){\n        entries.push({path:path,mode:\"100644\",type:\"blob\",sha:createBlob(JSON.stringify(value,null,path===META_DIR+\"latest-package.json\"?null:2))});\n    }\n    function putHistory(entries,dir,release,ref){\n        var old=getJson(dir+\"versions.json\",ref);\n        put(entries,dir+\"latest.json\",release);\n        put(entries,dir+\"versions.json\",{schema:5,versions:[release].concat(old&&Array.isArray(old.versions)?old.versions.slice(0,99):[])});\n    }\n    function createBranchAt(name,head){\n        var r=req(\"POST\",\"git/refs\",{ref:\"refs/heads/\"+name,sha:head},false,3);\n        if(!r||r.code!==201){\n            if(refSha(\"heads\",name)!==head)requireCode(r,[201],\"创建测试分支\");\n        }\n    }\n    function moveBranch(branch,commit,expected){\n        if(refSha(\"heads\",branch)!==expected)throw Error(\"目标分支已变化，请重新预览\");\n        var response=req(\"PATCH\",\"git/refs/heads/\"+encodeURIComponent(branch),{sha:commit,force:false},false,3);\n        if(response&&response.code===200)return;\n        if(refSha(\"heads\",branch)!==commit)requireCode(response,[200],\"更新 \"+branch);\n    }\n    function finish(branch,head,entries,release){\n        var tree=createTree(getCommitTreeSha(head),entries);\n        var commit=createCommit(\"农场脚本发布 \"+release.displayName+\"\\n\\n\"+release.note,tree,head);\n        createTagRef(release.tagName,commit);\n        moveBranch(branch,commit,head);\n        zdjl.alert(\"发布成功：\"+release.displayName+\"\\n版本：\"+releaseId(release)+\"\\n\\n\"+release.note);\n    }\n    function publishTest(){\n        var main=getHead(),stable=stableAt(main),testHead=refSha(\"heads\",TEST_BRANCH);\n        var prior=testHead?testingAt(testHead):null;\n        var base=loadBase(),baseId=base&&releaseId(base),testCurrent=prior&&prior.stableBaseVersionId===releaseId(stable);\n        var parent=baseId===releaseId(stable)?stable:testCurrent&&baseId===releaseId(prior)?prior:null;\n        if(!parent||base.partialFileVersions&&Object.keys(base.partialFileVersions).length){\n            zdjl.alert(\"请先整套同步当前稳定版，或整套安装基于当前稳定版的最新测试版，再修改并发布。混合版本不能发布。\");return;\n        }\n        MANAGED=remoteNames(parent,base);\n        var compareBase=fetchFullByRelease(parent),extras=pickNewScripts(MANAGED);\n        if(extras===null)return;\n        for(var i=0;i<extras.length;i++)if(MANAGED.indexOf(extras[i])<0)MANAGED.push(extras[i]);\n        var local=readLocalManaged(),changed=diffNames(compareBase,local);\n        if(!changed.length){zdjl.alert(\"没有检测到脚本改动。\");return;}\n        var info=noteFor(\"发布测试版\");\n        if(!info)return;\n        if(selectOne(preview(changed,compareBase,local,[],false)+\"\\n发布到测试版，不更新稳定版。\\n\\n\"+info.note,[\"确认发布测试版\",\"取消\"])!==\"确认发布测试版\")return;\n        if(getHead()!==main||refSha(\"heads\",TEST_BRANCH)!==testHead)throw Error(\"确认期间版本变化，已取消\");\n        var head=testHead||main;\n        if(!testHead)createBranchAt(TEST_BRANCH,head);\n        var entries=[],current=mapOf(local),rootFiles=scriptEntries(head);\n        for(var i=0;i<MANAGED.length;i++){\n            var name=MANAGED[i],old=rootFiles[name],previous=rootFilesFor(parent,name);\n            if(old&&previous&&old.sha===previous.sha&&changed.indexOf(name)<0)continue;\n            entries.push({path:\"scripts/\"+name,mode:\"100644\",type:\"blob\",sha:changed.indexOf(name)<0&&previous?previous.sha:createBlob(current[name])});\n        }\n        var release=releaseFor(\"test\",parent,info,MANAGED,changed,stable,null);\n        putHistory(entries,TEST_DIR,release,head);\n        finish(TEST_BRANCH,head,entries,release);\n        saveBase({schema:60,versionId:releaseId(release),displayName:release.displayName,tagName:release.tagName,channel:\"test\",files:local.files});\n    }\n    function scriptEntries(ref){\n        var tagCommit=refSha(\"tags\",ref)||ref;\n        var response=req(\"GET\",\"git/trees/\"+getCommitTreeSha(tagCommit)+\"?recursive=1\",null,false,4);\n        requireCode(response,[200],\"读取版本文件清单\");\n        var data=JSON.parse(response.body),files={};\n        if(!Array.isArray(data.tree)||data.truncated)throw Error(\"云端文件清单不完整\");\n        for(var i=0;i<data.tree.length;i++){\n            var entry=data.tree[i],name=String(entry.path||\"\").slice(8);\n            if(entry.type===\"blob\"&&String(entry.path).indexOf(\"scripts/\")===0&&safeName(name))files[name]=entry;\n        }\n        return files;\n    }\n    var blobCache={};\n    function rootFilesFor(rel,name){\n        var tag=rel.tagName;\n        if(!blobCache[tag])blobCache[tag]=scriptEntries(tag);\n        return blobCache[tag][name];\n    }\n    function promoteTest(){\n        var main=getHead(),stable=stableAt(main),testHead=refSha(\"heads\",TEST_BRANCH);\n        var test=testHead?testingAt(testHead):null;\n        if(!test){zdjl.alert(\"还没有可转正的测试版。\");return;}\n        if(stable.promotedFromVersionId===releaseId(test)){zdjl.alert(\"这个测试版已经转为稳定版。\");return;}\n        if(test.stableBaseVersionId!==releaseId(stable))throw Error(\"该测试版基于旧稳定版，请先基于当前稳定版重新发布测试\");\n        var names=remoteNames(test,null),source=scriptEntries(test.tagName),current=scriptEntries(main),changed=[],entries=[];\n        for(var i=0;i<stable.managedFiles.length;i++)if(names.indexOf(stable.managedFiles[i])<0)throw Error(\"测试版缺少稳定版文件，拒绝转正\");\n        for(var i=0;i<names.length;i++){\n            var name=names[i],file=source[name];\n            if(!file)throw Error(\"测试Tag缺少文件：\"+name);\n            if(!current[name]||current[name].sha!==file.sha){changed.push(name);entries.push({path:\"scripts/\"+name,mode:file.mode,type:\"blob\",sha:file.sha});}\n        }\n        if(!changed.length){zdjl.alert(\"测试版和稳定版脚本已经一致。\");return;}\n        var info=noteFor(\"测试通过，转为稳定版\");\n        if(!info)return;\n        if(selectOne(\"确认把已经测试过的版本转为稳定版？\\n\"+test.displayName+\"\\n原测试说明：\\n\"+test.note+\"\\n\\n改动文件：\\n\"+changed.join(\"\\n\")+\"\\n\\n\"+info.note,[\"确认转为稳定版\",\"取消\"])!==\"确认转为稳定版\")return;\n        if(getHead()!==main||refSha(\"heads\",TEST_BRANCH)!==testHead)throw Error(\"确认期间版本变化，已取消\");\n        var release=releaseFor(\"stable\",stable,info,names,changed,stable,test);\n        var bootstrapNames=[\"总控.zjs\",\"农场脚本版本发布器.zjs\",\"农场脚本版本更新器.zjs\",\"农场脚本下载.zjs\"],bootstrapFiles=[];\n        for(var i=0;i<bootstrapNames.length;i++){\n            var response=getRaw(\"scripts/\"+bootstrapNames[i],test.tagName);\n            requireCode(response,[200],\"读取旧设备升级包脚本\");\n            validateScript(response.body,bootstrapNames[i]);\n            bootstrapFiles.push({name:bootstrapNames[i],content:String(response.body)});\n        }\n        var legacy={schema:1,syncSchema:60,mode:\"single-package\",versionId:release.id,publishedAt:release.publishedAt,\n            displayTime:release.displayTime,displayName:release.displayName,note:release.note,fileCount:bootstrapFiles.length,files:bootstrapFiles};\n        put(entries,META_DIR+\"latest-package.json\",legacy);\n        put(entries,META_DIR+\"manifest.json\",{schema:6,syncSchema:60,mode:\"dynamic-confirmed-set\",files:names,ignoredExtraZjs:true,autoDiscovery:\"best-effort-with-manual-registration\"});\n        putHistory(entries,META_DIR,release,main);\n        putHistory(entries,V5_DIR,release,main);\n        finish(BRANCH,main,entries,release);\n    }\n    try{\n        var choices=[\"发布测试版\",\"测试通过后转为稳定版\",\"取消\"],choice=selectOne(\"选择发布通道\",choices);\n        if(choice===choices[0])publishTest();\n        else if(choice===choices[1])promoteTest();\n    }catch(e){zdjl.alert(\"云发布失败\\n\\n\"+safeErrorText(e));}\n})();"}

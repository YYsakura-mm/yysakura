{"repeatCount":1,"pauseOnFail":false,"count":1,"minVerCode":2021000,"minVerName":"2.21.0","screenWidth":720,"screenHeight":1280,"screenDpi":2,"lastSaveScreenWidth":1280,"lastSaveScreenHeight":720,"lastSaveScreenDpi":2,"savedVerCode":26000050,"savedVerName":"26.5.0","delay":"0.1","delayUnit":1,"description":"农场云更新V6.1｜整套同步、历史回退、按文件选择、混合版本识别"}
{"type":"运行JS代码","delay":"0","delayUnit":1,"desc":"云更新｜稳定版、测试版、历史版本与指定文件","jsCode":"(function(){\n\n    var OWNER=\"YYsakura-mm\",REPO=\"yysakura\",BRANCH=\"main\";\n    var BASE_DIR=\"/storage/emulated/0/自动精灵/\";\n    var V5_DIR=\".farmcloud/v5/\";\n    var NS=\"farm-cloud-v5\",TOKEN_NS=\"github-sync\";\n    var BASE_FILE=BASE_DIR+\".farm-cloud-base-v5.json\";\n    // 更新器只从本机基线和远程版本元数据读取文件名单。\n    var MANAGED=[];\n    function trimText(v){return String(v==null?\"\":v).replace(/^\\s+|\\s+$/g,\"\");}\n    function localText(path){try{return String(zdjl.readFile(path));}catch(e){return null;}}\n    function encodePath(path){var a=String(path).split(\"/\"),o=[];for(var i=0;i<a.length;i++)o.push(encodeURIComponent(a[i]));return o.join(\"/\");}\n    function looksLikeToken(v){var s=trimText(v);return !!s&&!/[^\\x21-\\x7E]/.test(s)&&!/\\s/.test(s)&&s.length>=20&&/^(github_pat_|gh[pousr]_)/.test(s);}\n    function getToken(){var t=\"\";try{t=trimText(zdjl.getStorage(\"github_read_token\",NS));}catch(e){}if(looksLikeToken(t))return t;try{t=trimText(zdjl.getStorage(\"github_token\",TOKEN_NS));}catch(e2){}if(looksLikeToken(t))return t;try{t=trimText(zdjl.getStorage(\"github_token\",NS));}catch(e3){}return looksLikeToken(t)?t:\"\";}\n    var FARM_META_PREFERRED=0;\n    function fetchJson(path,timeout,optional,ref){\n      var rev=ref||BRANCH,file=encodePath(path),stamp='?t='+Date.now(),sources=[\n        'https://api.github.com/repos/'+OWNER+'/'+REPO+'/contents/'+file+'?ref='+encodeURIComponent(rev),\n        'https://raw.githubusercontent.com/'+OWNER+'/'+REPO+'/'+encodeURIComponent(rev)+'/'+file+stamp,\n        'https://cdn.jsdelivr.net/gh/'+OWNER+'/'+REPO+'@'+encodeURIComponent(rev)+'/'+file+stamp,\n        'https://fastly.jsdelivr.net/gh/'+OWNER+'/'+REPO+'@'+encodeURIComponent(rev)+'/'+file+stamp\n      ];\n      var seq=[FARM_META_PREFERRED],errors=[],notFound=0;\n      for(var j=0;j<4;j++)if(j!==FARM_META_PREFERRED)seq.push(j);\n      for(var i=0;i<seq.length;i++){\n        var k=seq[i];\n        try{\n          var h=[{'X-GitHub-Api-Version':'2022-11-28'},{'Accept':k===0?'application/vnd.github.raw+json':'application/json'},{'Cache-Control':'no-cache'}];\n          if(k===0){var tok=getToken();if(tok)h.unshift({'Authorization':'Bearer '+tok});}\n          var r=zdjl.requestUrl({url:sources[k],method:'GET',headers:h,timeout:Math.min(timeout||12000,15000),responseType:'TEXT'});\n          if(r&&r.code===404)notFound++;\n          if(!r||r.code!==200)throw Error('HTTP '+(r?r.code:'?'));\n          var obj=JSON.parse(String(r.body||''));\n          if(!obj||typeof obj!=='object')throw Error('非JSON对象');\n          FARM_META_PREFERRED=k;\n          return obj;\n        }catch(e){errors.push(k+':'+String(e).slice(0,180));}\n      }\n      if(optional&&notFound===seq.length)return null;\n      throw Error('云端元数据读取失败 ['+path+'] '+errors.join(' | '));\n    }\n    function loadBase(){var s=localText(BASE_FILE);if(!s)return null;try{return JSON.parse(s);}catch(e){return null;}}\n    function vid(v){return String(v&&(v.versionId||v.id)||\"\");}\n    function label(v){return v?String(v.displayName||v.displayTime||v.publishedAt||v.versionId||v.id||\"未知\"):\"未知\";}\n    function safeName(n){return typeof n===\"string\"&&n.length<=110&&/^[^\\\\/\\x00-\\x1f]+\\.zjs$/i.test(n)&&n.indexOf(\"..\")<0&&n.charAt(0)!==\".\";}\n    function managedNames(b,cloud){var a=[],seen={},list=[];\n        if(b&&Array.isArray(b.files))for(var i=0;i<b.files.length;i++)list.push(String(b.files[i].name));\n        if(cloud&&Array.isArray(cloud.managedFiles))for(var j=0;j<cloud.managedFiles.length;j++)list.push(String(cloud.managedFiles[j]));\n        for(var k=0;k<list.length;k++){var n=list[k];if(safeName(n)&&!seen[n]){seen[n]=1;a.push(n);}}\n        return a;\n    }\n    function localChanges(b,cloud){if(!b||!Array.isArray(b.files))return null;var m={},out=[];\n        for(var i=0;i<b.files.length;i++){var it=b.files[i];if(it&&it.name!=null)m[String(it.name)]=String(it.content==null?\"\":it.content);}\n        var names=managedNames(b,cloud);\n        for(i=0;i<names.length;i++){var n=names[i],cur=localText(BASE_DIR+n);\n            if(m[n]!==undefined){if(cur!==m[n])out.push(n);}\n            else if(cur!==null)out.push(n); // 云端新增文件本地同名存在，必须提示覆盖冲突\n        }\n        return out;\n    }\n\n    var TARGET_KEY=\"target_release\",SUBSET_KEY=\"target_subset_v1\",CHANNEL_KEY=\"target_channel_v1\";\n    function snapshot(){var b=loadBase(),c=null,err=\"\";try{c=fetchJson(V5_DIR+\"latest.json\",10000);}catch(e){err=String(e);}var ch=localChanges(b,c),same=!!(b&&c&&vid(b)&&vid(b)===vid(c));var mixed=!!(b&&b.partialFileVersions&&Object.keys(b.partialFileVersions).length);var state;if(mixed)state=\"🟠 部分文件来自不同版本\";else if(!b)state=\"⚠ 本机未建立基线\";else if(!c)state=\"⚠ 云端版本读取失败\";else if(!same)state=b.channel===\"test\"?\"本机正在使用测试版\":\"本机与最新稳定版不同\";else if(ch&&ch.length)state=\"🟡 版本ID已最新，但本地有未发布改动\";else if(ch)state=\"✅ 本机与云端完全一致\";else state=\"⚠ 版本ID已读取，但本地改动无法完整核验\";return {base:b,cloud:c,changes:ch,same:same,state:state,error:err};}\n    function brief(s){return \"本机：\"+(s.base?label(s.base):\"未建立基线\")+\"\\n云端：\"+(s.cloud?label(s.cloud):\"读取失败/离线\")+\"\\n状态：\"+s.state+\"\\n本地未发布改动：\"+(s.changes?s.changes.length:\"?\");}\n    function selectOne(title,items,initial){try{var config={title:title,items:items,multi:false};if(initial)config.selectItems=[initial];var r=zdjl.select(config);if(r===null||r===undefined||r===false||r===\"\")return null;if(typeof r===\"number\")return items[r]!==undefined?items[r]:null;if(typeof r===\"string\")return items.indexOf(r)>=0?r:null;if(r.cancelled===true||r.canceled===true)return null;if(items.indexOf(r.item)>=0)return r.item;if(r.value!=null&&items.indexOf(String(r.value))>=0)return String(r.value);if(typeof r.result==='number')return items[r.result]||null;if(r.index!=null)return items[Number(r.index)]!==undefined?items[Number(r.index)]:null;if(r.selectedIndex!=null)return items[Number(r.selectedIndex)]!==undefined?items[Number(r.selectedIndex)]:null;return null;}catch(e){if(initial)throw e;var m=title+\"\\n\\n\";for(var i=0;i<items.length;i++)m+=(i+1)+\". \"+items[i]+\"\\n\";var n=Number(trimText(zdjl.prompt(m,\"1\")));return n>=1&&n<=items.length?items[n-1]:null;}}\n    function channelName(channel){return channel===\"test\"?\"测试版\":\"稳定版\";}\n    function releaseDetails(rel){return label(rel)+\"\\n版本：\"+vid(rel)+(rel.note&&rel.note!==rel.displayName?\"\\n\\n\"+String(rel.note):\"\");}\n    function latestFor(channel){\n        var rel=channel===\"test\"?fetchJson(V5_DIR+\"test/latest.json\",15000,true,\"farm-test\"):fetchJson(V5_DIR+\"latest.json\",15000);\n        if(!rel){zdjl.alert(\"暂时没有可下载的测试版。稳定版不受影响。\");return null;}\n        verifyChannel(rel,channel);\n        return rel;\n    }\n    function verifyChannel(rel,channel){\n        if(!rel||!vid(rel)||!rel.tagName||(channel===\"test\"?rel.channel!==\"test\":rel.channel===\"test\"))throw Error(\"云端版本通道或版本信息不符，已取消\");\n    }\n    function runDownloader(rel,channel,subset){\n        var target=vid(rel);\n        zdjl.setStorage(SUBSET_KEY,subset?JSON.stringify({schema:1,versionId:target,files:subset,at:Date.now()}):\"\",NS);\n        zdjl.setStorage(TARGET_KEY,target,NS);\n        zdjl.setStorage(CHANNEL_KEY,channel,NS);\n        try{zdjl.runAction({\"type\":\"执行脚本\",\"delay\":\"0\",\"delayUnit\":1,\"filePath\":\"农场脚本下载.zjs\",\"continueCurrentAfterFinish\":true});}\n        finally{zdjl.setStorage(CHANNEL_KEY,\"\",NS);zdjl.setStorage(TARGET_KEY,\"\",NS);zdjl.setStorage(SUBSET_KEY,\"\",NS);}\n    }\n    function syncRelease(rel,channel,historical){\n        if(!rel)return;\n        verifyChannel(rel,channel);\n        var base=loadBase(),changes=localChanges(base,rel),mixed=base&&base.partialFileVersions&&Object.keys(base.partialFileVersions).length;\n        if(base&&vid(base)===vid(rel)&&changes&&!changes.length&&!mixed){zdjl.alert(\"本机已经是这个\"+channelName(channel)+\"。\\n\\n\"+releaseDetails(rel));return;}\n        var info=channel===\"test\"?\"测试版可能有未发现的问题。\\n\":\"\";\n        if(base)info+=\"本机：\"+label(base)+\"\\n\";\n        if(mixed)info+=\"本机有混合版本文件，本次将整套同步。\\n\";\n        if(changes&&changes.length)info+=\"以下本机改动将被覆盖：\\n\"+changes.join(\"\\n\")+\"\\n\\n\";\n        var message=info+\"准备安装\"+channelName(channel)+\"：\\n\"+releaseDetails(rel);\n        if(channel===\"test\"){\n            if(confirmTestDownload(message))runDownloader(rel,channel);\n            return;\n        }\n        var word=historical?\"安装历史版\":\"更新稳定版\";\n        var entered=trimText(zdjl.prompt(message+\"\\n\\n输入“\"+word+\"”继续：\",\"\"));\n        if(entered===word)runDownloader(rel,channel);\n    }\n    function confirmTestDownload(message){\n        return selectOne(message,[\"下载测试版\",\"取消\"],\"下载测试版\")===\"下载测试版\";\n    }\n    function showStatus(s){var msg=\"版本状态\\n\\n\"+brief(s)+\"\\n本机ID：\"+(s.base?vid(s.base):\"无\")+\"\\n云端ID：\"+(s.cloud?vid(s.cloud):\"未知\");if(s.changes&&s.changes.length)msg+=\"\\n\\n【本地未发布改动】\\n\"+s.changes.join(\"\\n\");if(s.base&&s.base.partialFileVersions){var mix=s.base.partialFileVersions,keys=Object.keys(mix);if(keys.length)msg+=\"\\n\\n【混合版本文件】\\n\"+keys.map(function(n){return n+\" ← \"+mix[n];}).join(\"\\n\");}if(s.error)msg+=\"\\n\\n云端错误：\"+s.error;zdjl.alert(msg);}\n    function choosePagedHistory(title,items,refs){\n      var page=0,per=15,max=Math.ceil(items.length/per);\n      for(var guard=0;guard<250;guard++){\n        var start=page*per,shown=items.slice(start,start+per),prev='◀ 上一页',next='下一页 ▶',cancel='取消';\n        if(page>0)shown.push(prev);\n        if(start+per<items.length)shown.push(next);\n        shown.push(cancel);\n        var chosen=selectOne(title+'（'+(page+1)+'/'+max+'）',shown);\n        if(!chosen||chosen===cancel)return null;\n        if(chosen===prev){page=Math.max(0,page-1);continue;}\n        if(chosen===next){page=Math.min(max-1,page+1);continue;}\n        var ix=shown.indexOf(chosen);return ix>=0&&ix<Math.min(per,items.length-start)?refs[start+ix]:null;\n      }\n      return null;\n    }\n    function history(channel,action){\n        var testing=channel===\"test\",path=V5_DIR+(testing?\"test/\":\"\"),ref=testing?\"farm-test\":BRANCH;\n        var history=fetchJson(path+\"versions.json\",20000,testing,ref),versions=history&&history.versions||[],items=[],refs=[];\n        for(var i=0;i<versions.length&&items.length<150;i++){\n            var rel=versions[i];\n            if(!vid(rel)||!rel.tagName||(testing?rel.channel!==\"test\":rel.channel===\"test\"))continue;\n            items.push(label(rel)+\"｜\"+vid(rel)+\"｜改\"+(rel.changedCount==null?\"?\":rel.changedCount));refs.push(rel);\n        }\n        if(!items.length){zdjl.alert(\"没有\"+channelName(channel)+\"历史版本。\");return;}\n        var selected=choosePagedHistory(\"选择\"+channelName(channel)+\"历史版本\",items,refs);\n        if(!selected)return;\n        if(action===\"details\")zdjl.alert(releaseDetails(selected));\n        else if(action===\"subset\")selective(selected,channel);\n        else syncRelease(selected,channel,true);\n    }\n    function selectFileNumbers(rel){\n      if(!Array.isArray(rel.managedFiles)||!rel.managedFiles.length){zdjl.alert('目标版本缺少完整文件清单，拒绝部分更新。');return null;}\n      var names=[],seen={};for(var i=0;i<rel.managedFiles.length;i++){\n        var n=String(rel.managedFiles[i]);if(!safeName(n))throw Error('目标版本含不安全文件名：'+n);\n        if(!seen[n]){seen[n]=1;names.push(n);}}\n      var q='目标版本：'+label(rel)+'\\n输入要更新的文件编号，例如 2,5,9。取消请留空。\\n\\n';\n      for(i=0;i<names.length;i++)q+=(i+1)+'. '+names[i]+'\\n';\n      var input=trimText(zdjl.prompt(q,''));if(!input)return null;\n      if(!/^\\d+(?:[\\s,，、;；]+\\d+)*$/.test(input)){zdjl.alert('只能输入编号，比如 2,5,9。');return null;}\n      var chunks=input.split(/[\\s,，、;；]+/),out=[],used={};\n      for(i=0;i<chunks.length;i++){\n        var id=Number(chunks[i]);if(!isFinite(id)||id<1||id>names.length||id!==Math.floor(id))throw Error('文件编号超出范围：'+chunks[i]);\n        var f=names[id-1];if(!used[f]){used[f]=1;out.push(f);}}\n      return out;\n    }\n    function selective(rel,channel){\n      var b=loadBase();if(!b||!Array.isArray(b.files)||!vid(b)){zdjl.alert('部分更新需要本机存在完整的同步基线；请先整套同步一次。');return;}\n      if(!rel||!vid(rel)||!rel.tagName){zdjl.alert('目标版本缺少版本ID或Tag，拒绝。');return;}\n      var selected=selectFileNumbers(rel);if(!selected||!selected.length)return;\n      var uu=selected.indexOf('农场脚本版本更新器.zjs')>=0,dd=selected.indexOf('农场脚本下载.zjs')>=0;\n      if(uu!==dd){zdjl.alert('更新云工具需要同时选择“版本更新器”与“下载器”，以免接口不兼容。');return;}\n      var changed=localChanges(b,rel)||[],over=[];\n      for(var i=0;i<selected.length;i++)if(changed.indexOf(selected[i])>=0)over.push(selected[i]);\n      var warn=over.length?'\\n\\n其中 '+over.length+' 个文件本机有未发布改动：\\n'+over.join('\\n'):'';\n      if(channel==='test'){\n        var summary='仅覆盖以下 '+selected.length+' 个测试版脚本：\\n'+selected.join('\\n')+'\\n来源：'+releaseDetails(rel)+'\\n其他脚本和数据保持不变。'+warn;\n        if(confirmTestDownload(summary))runDownloader(rel,channel,selected);\n        return;\n      }\n      var value=trimText(zdjl.prompt('仅覆盖以下 '+selected.length+' 个脚本：\\n'+selected.join('\\n')+'\\n来源：'+releaseDetails(rel)+'\\n其他脚本和数据保持不变。'+warn+'\\n\\n输入“确认部分更新”执行：',''));\n      if(value==='确认部分更新')runDownloader(rel,channel,selected);\n    }\n    function restoreBak(){var a=[],m=managedNames(loadBase(),null);for(var i=0;i<m.length;i++)if(localText(BASE_DIR+m[i]+\".bak\")!==null)a.push(m[i]);if(!a.length){zdjl.alert(\"没有可用 .bak\");return;}var n=selectOne(\"选择恢复 .bak\",a);if(!n)return;var bak=localText(BASE_DIR+n+\".bak\"),now=localText(BASE_DIR+n);if(now!==null)zdjl.writeFile(BASE_DIR+n+\".before-bak-restore.bak\",now);zdjl.writeFile(BASE_DIR+n,bak);if(localText(BASE_DIR+n)!==bak)throw new Error(\"恢复读回不一致\");zdjl.alert(\"已恢复：\"+n+\"\\n\\n它会显示为本地未发布改动，不会改变版本ID。\");}\n    try{\n        var channels=[\"稳定版\",\"测试版\",\"查看本机与稳定版状态\",\"恢复某脚本本地 .bak\"];\n        var selected=selectOne(\"农场脚本云同步｜选择版本通道\",channels);\n        if(!selected)return;\n        if(selected===channels[2]){showStatus(snapshot());return;}\n        if(selected===channels[3]){restoreBak();return;}\n        var channel=selected===channels[1]?\"test\":\"stable\";\n        var menu=[\"整套下载最新\"+channelName(channel),\"只更新指定文件｜最新\"+channelName(channel),\"从历史版本整套安装\",\"从历史版本更新指定文件\",\"查看历史版本详细说明\"];\n        var item=selectOne(channelName(channel)+\"｜选择操作\",menu);\n        if(item===menu[0])syncRelease(latestFor(channel),channel,false);\n        else if(item===menu[1]){var rel=latestFor(channel);if(rel)selective(rel,channel);}\n        else if(item===menu[2])history(channel,\"full\");\n        else if(item===menu[3])history(channel,\"subset\");\n        else if(item===menu[4])history(channel,\"details\");\n    }catch(e){zdjl.alert(\"更新器异常\\n\\n\"+String(e));}\n})();"}

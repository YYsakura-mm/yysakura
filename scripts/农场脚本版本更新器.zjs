{"type":"运行JS代码","delay":"0","delayUnit":1,"desc":"农场脚本云更新 V5.1｜最新版/历史版｜基线审计｜本地备份","jsCode":"(function(){\n    var OWNER=\"YYsakura-mm\",REPO=\"yysakura\",BRANCH=\"main\",BASE_DIR=\"/storage/emulated/0/自动精灵/\",V5_DIR=\".farmcloud/v5/\",NS=\"farm-cloud-v5\",TOKEN_NS=\"github-sync\",BASE_FILE=BASE_DIR+\".farm-cloud-base-v5.json\",TARGET_KEY=\"target_release\";\n    var MANAGED=[\"1v1.zjs\", \"55.zjs\", \"一键种植.zjs\", \"保变异收割.zjs\", \"关广告.zjs\", \"农场脚本下载.zjs\", \"农场脚本版本发布器.zjs\", \"农场脚本版本更新器.zjs\", \"切换账号.zjs\", \"初始化OCR.zjs\", \"占位保存.zjs\", \"变异植物上传.zjs\", \"变异植物识别.zjs\", \"总控.zjs\", \"换16经验.zjs\", \"换经济作物.zjs\", \"收割判定.zjs\", \"查看状态.zjs\", \"浇水领奖.zjs\", \"状态提示.zjs\", \"祝福.zjs\", \"祝福判定.zjs\", \"祝福识别收方.zjs\", \"祝福识别送方.zjs\", \"进游戏关闭广告.zjs\", \"退出农场.zjs\", \"选择八小时作物.zjs\", \"选择英雄植物.zjs\", \"重启王者.zjs\"];\n    function trimText(v){return String(v==null?\"\":v).replace(/^\\s+|\\s+$/g,\"\");}\n    function encodePath(path){var a=String(path).split(\"/\"),o=[];for(var i=0;i<a.length;i++)o.push(encodeURIComponent(a[i]));return o.join(\"/\");}\n    function looksLikeToken(v){var s=trimText(v);return !!s&&!/[^\\x21-\\x7E]/.test(s)&&!/\\s/.test(s)&&s.length>=20&&/^(github_pat_|gh[pousr]_)/.test(s);}\n    function getToken(){var t=\"\";try{t=trimText(zdjl.getStorage(\"github_read_token\",NS));}catch(e){}if(looksLikeToken(t))return t;try{t=trimText(zdjl.getStorage(\"github_token\",TOKEN_NS));}catch(e2){}return looksLikeToken(t)?t:\"\";}\n    function fetchJson(path){var hs=[{\"Accept\":\"application/vnd.github.raw+json\"},{\"X-GitHub-Api-Version\":\"2022-11-28\"}],t=getToken(),last=null; if(t)hs.unshift({\"Authorization\":\"Bearer \"+t});for(var a=1;a<=4;a++){try{last=zdjl.requestUrl({url:\"https://api.github.com/repos/\"+OWNER+\"/\"+REPO+\"/contents/\"+encodePath(path)+\"?ref=\"+encodeURIComponent(BRANCH),method:\"GET\",headers:hs,timeout:45000});if(last&&last.code===200)return JSON.parse(String(last.body||\"\"));}catch(e){}if(a<4)try{zdjl.sleep(800*a);}catch(se){}}throw new Error(\"读取 \"+path+\" 失败 HTTP \"+(last?last.code:\"?\"));}\n    function localText(path){try{return String(zdjl.readFile(path));}catch(e){return null;}}\n    function selectOne(title,items){try{var r=zdjl.select({title:title,items:items,multi:false});if(!r)return null;return r.item;}catch(e){var m=title+\"\\n\\n\";for(var i=0;i<items.length;i++)m+=(i+1)+\". \"+items[i]+\"\\n\";var n=Number(trimText(zdjl.prompt(m,\"1\")));return n>=1&&n<=items.length?items[n-1]:null;}}\n    function runDownloader(){zdjl.runAction({\"type\":\"执行脚本\",\"delay\":\"0\",\"delayUnit\":1,\"filePath\":\"农场脚本下载.zjs\",\"continueCurrentAfterFinish\":true});}\n    function showBase(){var s=localText(BASE_FILE);if(!s){zdjl.alert(\"本机没有 V5.1 基线。\\n请先运行下载器，或主设备首次运行发布器。\");return;}var b=JSON.parse(s),m={},chg=[];if(Array.isArray(b.files))for(var i=0;i<b.files.length;i++)m[b.files[i].name]=String(b.files[i].content);for(i=0;i<MANAGED.length;i++){var n=MANAGED[i];if(localText(BASE_DIR+n)!==m[n])chg.push(n);}zdjl.alert(\"本机基线\\n\\n版本：\"+(b.displayName||b.versionId||\"\")+\"\\n基线后本地改动：\"+chg.length+(chg.length?\"\\n\\n\"+chg.join(\"\\n\"):\"\"));}\n    function history(rollback){var h=fetchJson(V5_DIR+\"versions.json\"),a=h.versions||[],items=[],refs=[];for(var i=0;i<a.length&&items.length<30;i++){var v=a[i];items.push((v.displayName||v.id||\"\")+\"｜改\"+(v.changedCount==null?\"?\":v.changedCount));refs.push(v);}if(!items.length){zdjl.alert(\"没有 V5.1 历史\");return;}if(!rollback){zdjl.alert(\"最近版本\\n\\n\"+items.join(\"\\n\"));return;}var p=selectOne(\"选择完整回退版本\",items);if(!p)return;var idx=items.indexOf(p),v=refs[idx],ok=trimText(zdjl.prompt(\"准备安装历史版本：\\n\"+(v.displayName||v.id)+\"\\n\\n回退后不能直接发布，必须先重新更新到最新版。\\n输入“回退”继续：\",\"\"));if(ok!==\"回退\")return;zdjl.setStorage(TARGET_KEY,String(v.id||v.versionId),NS);runDownloader();}\n    function restoreBak(){var a=[];for(var i=0;i<MANAGED.length;i++)if(localText(BASE_DIR+MANAGED[i]+\".bak\")!==null)a.push(MANAGED[i]);if(!a.length){zdjl.alert(\"没有可用 .bak\");return;}var n=selectOne(\"选择恢复 .bak\",a);if(!n)return;var bak=localText(BASE_DIR+n+\".bak\"),now=localText(BASE_DIR+n);if(now!==null)zdjl.writeFile(BASE_DIR+n+\".before-bak-restore.bak\",now);zdjl.writeFile(BASE_DIR+n,bak);if(localText(BASE_DIR+n)!==bak)throw new Error(\"恢复读回不一致\");zdjl.alert(\"已恢复：\"+n+\"\\n发布前请确认这是你真正想要的本地改动。\");}\n    var menu=[\"最新版｜整套更新\",\"查看本机基线与本地改动\",\"查看最近云端版本\",\"历史版本｜整套回退\",\"恢复某脚本本地 .bak\"];\n    var m=selectOne(\"农场脚本云同步 V5.1\",menu);if(!m)return;try{if(m===menu[0]){zdjl.setStorage(TARGET_KEY,\"\",NS);runDownloader();}else if(m===menu[1])showBase();else if(m===menu[2])history(false);else if(m===menu[3])history(true);else if(m===menu[4])restoreBak();}catch(e){zdjl.alert(\"V5.1 更新器异常\\n\\n\"+String(e));}\n})();"}

{"repeatCount":1,"pauseOnFail":false,"count":2,"minVerCode":2015000,"minVerName":"2.15.0","screenWidth":720,"screenHeight":1280,"screenDpi":2,"lastSaveScreenWidth":720,"lastSaveScreenHeight":1280,"lastSaveScreenDpi":2,"savedVerCode":26000050,"savedVerName":"26.5.0","delay":"0.2","delayUnit":1,"description":"农场脚本版本更新器 V4.5.5｜修正ZJS头校验+raw CDN下载+一键全部更新+事务恢复","desc":"农场脚本云更新 V4.5｜总控内可更新全部子脚本并自动跳过正在运行的总控自身｜事务校验\/恢复"}
{"type":"运行JS代码","delay":"0","delayUnit":1,"desc":"农场脚本云更新 V4.5.5｜raw优先避免GitHub匿名API限额｜兼容旧ZJS根配置","scriptCallbacks":{"afterExecSuc":{"type":"控制执行","delay":"0","delayUnit":1,"controlRunType":"stop","ContinueParentExecute":false}},"jsCode":"(function () {\n    var OWNER = \"YYsakura-mm\";\n    var REPO = \"yysakura\";\n    var BRANCH = \"main\";\n    var BASE_DIR = \"\/storage\/emulated\/0\/自动精灵\/\";\n    var CLOUD_DIR = \"scripts\/\";\n    var META_DIR = \".farmcloud\/\";\n    var NS = \"farm-cloud-v4\";\n    var TOKEN_NS = \"github-sync\";\n\n    \/\/ 从总控内调用更新器时，不能覆盖正在执行的总控.zjs。\n    \/\/ 否则部分自动精灵版本会立即终止\/失去当前父脚本执行链。\n    function calledFromMainControl() {\n        try {\n            return String(zdjl.getVar(\"云工具由总控调用\", \"global\") || \"\") === \"更新器\";\n        } catch (e) {\n            return false;\n        }\n    }\n\n    function trimText(v) {\n        return String(v == null ? \"\" : v).replace(\/^\\s+|\\s+$\/g, \"\");\n    }\n\n    function displayTimeOf(v) {\n        if (v && v.displayTime) return String(v.displayTime);\n\n        var p = String(v && v.publishedAt ? v.publishedAt : \"\");\n        var m = p.match(\/^\\d{4}-(\\d{2})-(\\d{2})\\s+(\\d{2}):(\\d{2})\/);\n        if (m) return m[1] + \"-\" + m[2] + \" \" + m[3] + \":\" + m[4];\n\n        var id = String(v && v.id ? v.id : \"\");\n        var im = id.match(\/^V\\d{4}(\\d{2})(\\d{2})-(\\d{2})(\\d{2})\/);\n        if (im) return im[1] + \"-\" + im[2] + \" \" + im[3] + \":\" + im[4];\n\n        return id || \"未知时间\";\n    }\n\n    function versionLabel(v) {\n        if (v && v.displayName) return String(v.displayName);\n        var base = displayTimeOf(v);\n        var note = trimText(v && v.note ? v.note : \"\");\n        return base + (note ? \"｜\" + note : \"\");\n    }\n\n    function encodeRepoPath(path) {\n        var a = String(path).split(\"\/\");\n        var out = [];\n        for (var i = 0; i < a.length; i++) out.push(encodeURIComponent(a[i]));\n        return out.join(\"\/\");\n    }\n\n    function looksLikeGitHubToken(v) {\n        var s = trimText(v);\n        if (!s) return false;\n        if (\/[^\\x21-\\x7E]\/.test(s) || \/\\s\/.test(s) || s.length < 20) return false;\n        return \/^(github_pat_|gh[pousr]_)\/.test(s);\n    }\n\n    function getToken() {\n        var readToken = trimText(zdjl.getStorage(\"github_read_token\", NS));\n        if (readToken && !looksLikeGitHubToken(readToken)) {\n            try { zdjl.setStorage(\"github_read_token\", \"\", NS); } catch (e0) {}\n            readToken = \"\";\n        }\n        if (looksLikeGitHubToken(readToken)) return readToken;\n\n        var writeToken = trimText(zdjl.getStorage(\"github_token\", TOKEN_NS));\n        if (writeToken && !looksLikeGitHubToken(writeToken)) {\n            try { zdjl.setStorage(\"github_token\", \"\", TOKEN_NS); } catch (e1) {}\n            writeToken = \"\";\n        }\n        if (looksLikeGitHubToken(writeToken)) return writeToken;\n\n        \/\/ 兼容旧版存储，但非法值只清理、不参与 Authorization。\n        var legacy = trimText(zdjl.getStorage(\"github_token\", NS));\n        if (legacy && !looksLikeGitHubToken(legacy)) {\n            try { zdjl.setStorage(\"github_token\", \"\", NS); } catch (e2) {}\n            legacy = \"\";\n        }\n        if (looksLikeGitHubToken(legacy)) return legacy;\n        return \"\";\n    }\n\n    function headers(rawMode) {\n        var h = [\n            {\"X-GitHub-Api-Version\": \"2022-11-28\"},\n            {\"Accept\": rawMode ? \"application\/vnd.github.raw+json\" : \"application\/vnd.github+json\"}\n        ];\n        var t = getToken();\n        if (t) h.unshift({\"Authorization\":\"Bearer \" + t});\n        return h;\n    }\n\n    function waitMs(ms) {\n        zdjl.sleep(ms);\n    }\n\n    function isTransientCode(code) {\n        return code === 408 ||\n               code === 429 ||\n               code === 500 ||\n               code === 502 ||\n               code === 503 ||\n               code === 504;\n    }\n\n    function requestWithRetry(options, maxTry) {\n        maxTry = maxTry || 3;\n        var lastErr = null;\n        var lastResp = null;\n\n        for (var attempt = 1; attempt <= maxTry; attempt++) {\n            try {\n                lastResp = zdjl.requestUrl(options);\n\n                if (!lastResp || !isTransientCode(lastResp.code)) {\n                    return lastResp;\n                }\n\n                lastErr = new Error(\n                    \"HTTP \" + lastResp.code +\n                    \"（第\" + attempt + \"\/\" + maxTry + \"次）\"\n                );\n            } catch (e) {\n                lastErr = e;\n            }\n\n            if (attempt < maxTry) {\n                waitMs(1000 * attempt);\n            }\n        }\n\n        if (lastResp && isTransientCode(lastResp.code)) {\n            return lastResp;\n        }\n\n        throw lastErr || new Error(\"网络请求失败\");\n    }\n\n    function contentsUrl(path, ref) {\n        var u =\n            \"https:\/\/api.github.com\/repos\/\" +\n            OWNER + \"\/\" + REPO +\n            \"\/contents\/\" + encodeRepoPath(path);\n        if (ref) u += \"?ref=\" + encodeURIComponent(ref);\n        return u;\n    }\n\n    function rawCdnUrl(path, ref) {\n        var useRef = String(ref || BRANCH);\n        var u =\n            \"https:\/\/raw.githubusercontent.com\/\" +\n            encodeURIComponent(OWNER) + \"\/\" +\n            encodeURIComponent(REPO) + \"\/\" +\n            encodeURIComponent(useRef) + \"\/\" +\n            encodeRepoPath(path);\n        \/\/ main 上的 latest.json \/ versions.json 避免 CDN 短缓存。\n        if (useRef === BRANCH) u += \"?t=\" + Date.now();\n        return u;\n    }\n\n    function getRaw(path, ref) {\n        var useRef = ref || BRANCH;\n        var rawResp = null;\n        try {\n            rawResp = requestWithRetry({\n                url: rawCdnUrl(path, useRef),\n                method: \"GET\",\n                headers: [{\"Accept\":\"text\/plain\"}],\n                timeout: 30000\n            }, 2);\n            if (rawResp && rawResp.code === 200) return rawResp;\n            if (rawResp && rawResp.code === 404) return rawResp;\n        } catch (rawErr) {}\n\n        \/\/ raw CDN 不可用时才回退 GitHub Contents API。\n        \/\/ 这样普通下载不会每个脚本都消耗一次匿名 API 配额。\n        var apiResp = requestWithRetry({\n            url: contentsUrl(path, useRef),\n            method: \"GET\",\n            headers: headers(true),\n            timeout: 30000\n        }, 3);\n\n        if (apiResp && apiResp.code === 403 && !getToken()) {\n            throw new Error(\n                \"GitHub HTTP 403：匿名 API 请求额度可能已耗尽。\\n\" +\n                \"当前版本会优先走 raw CDN；若仍出现此错误，可在更新器中设置只读 Token。\"\n            );\n        }\n        return apiResp;\n    }\n\n    function getJson(path, ref) {\n        var r = getRaw(path, ref);\n        if (r.code !== 200) {\n            throw new Error(\"读取 \" + path + \" 失败 HTTP \" + r.code + \"\\n\" + r.body);\n        }\n        return JSON.parse(r.body);\n    }\n\n    function latestRelease() {\n        return getJson(META_DIR + \"latest.json\", BRANCH);\n    }\n\n    function historyObj() {\n        return getJson(META_DIR + \"versions.json\", BRANCH);\n    }\n\n    function manifestFor(ref) {\n        var m = getJson(META_DIR + \"manifest.json\", ref);\n        if (!m.files || !m.files.length) throw new Error(\"版本清单为空\");\n        return m;\n    }\n\n    function selectOne(title, items) {\n        try {\n            var r = zdjl.select({\n                title: title,\n                items: items,\n                multi: false\n            });\n            if (!r) return null;\n            return r.item;\n        } catch (e) {\n            var text = title + \"\\n\\n\";\n            for (var i = 0; i < items.length; i++) text += (i + 1) + \". \" + items[i] + \"\\n\";\n            var ans = trimText(zdjl.prompt(text, \"1\"));\n            if (!ans) return null;\n            if (\/^\\d+$\/.test(ans)) {\n                var n = Number(ans);\n                if (n >= 1 && n <= items.length) return items[n - 1];\n            }\n            for (var j = 0; j < items.length; j++) if (items[j] === ans) return items[j];\n            return null;\n        }\n    }\n\n    function selectMany(title, items) {\n        try {\n            var r = zdjl.select({\n                title: title,\n                items: items,\n                multi: true\n            });\n            if (!r || !r.items || !r.items.length) return null;\n            return r.items;\n        } catch (e) {\n            \/\/ 旧版本不支持多选弹窗时退回“逗号序号”\n            var text = title + \"\\n\\n输入序号，可用英文逗号分隔，例如 1,3,5\\n\\n\";\n            for (var i = 0; i < items.length; i++) text += (i + 1) + \". \" + items[i] + \"\\n\";\n            var ans = trimText(zdjl.prompt(text, \"1\"));\n            if (!ans) return null;\n            var parts = ans.split(\",\");\n            var out = [], seen = {};\n            for (var p = 0; p < parts.length; p++) {\n                var n = Number(trimText(parts[p]));\n                if (n >= 1 && n <= items.length && !seen[n]) {\n                    seen[n] = true;\n                    out.push(items[n - 1]);\n                }\n            }\n            return out.length ? out : null;\n        }\n    }\n\n    function chooseVersion() {\n        var h = historyObj();\n        var arr = h.versions || [];\n        if (!arr.length) {\n            zdjl.alert(\"云端还没有历史版本\");\n            return null;\n        }\n\n        var maxShow = Math.min(30, arr.length);\n        var labels = [];\n        for (var i = 0; i < maxShow; i++) {\n            labels.push((i + 1) + \". \" + versionLabel(arr[i]));\n        }\n\n        var picked = selectOne(\"选择历史版本｜时间就是版本锚点\", labels);\n        if (!picked) return null;\n\n        for (var j = 0; j < labels.length; j++) {\n            if (labels[j] === picked) return arr[j];\n        }\n        return null;\n    }\n    function backupName(name) {\n        return BASE_DIR + name + \".bak\";\n    }\n\n    function localText(path) {\n        try { return String(zdjl.readFile(path)); }\n        catch (e) { return null; }\n    }\n\n    function markInstalled(name, release) {\n        try {\n            zdjl.setStorage(\"installed_\" + name, release.id, NS);\n            zdjl.setStorage(\"installed_label_\" + name, versionLabel(release), NS);\n        } catch (e) {}\n    }\n\n    function updateOne(name, release, doWrite) {\n        \/\/ 总控作为父脚本正在运行时，写回总控.zjs 会让当前执行链在部分环境直接结束。\n        \/\/ 只在“由总控内调用 + 实际写入”时跳过总控自身；独立运行更新器仍可正常更新总控。\n        if (doWrite && calledFromMainControl() && String(name) === \"总控.zjs\") {\n            return {status:\"runningMainSkipped\", name:name};\n        }\n\n        var r = getRaw(CLOUD_DIR + name, release.snapshotSha);\n\n        if (r.code === 404) return {status:\"cloudMissing\", name:name};\n        if (r.code !== 200) return {status:\"failed\", name:name, detail:\"HTTP \" + r.code};\n\n        var cloudText = String(r.body);\n        var path = BASE_DIR + name;\n        var oldText = localText(path);\n\n        if (oldText !== null && oldText === cloudText) {\n            if (doWrite) markInstalled(name, release);\n            return {status:\"same\", name:name};\n        }\n\n        if (!doWrite) return {status:\"different\", name:name};\n\n        if (oldText !== null) {\n            try { zdjl.writeFile(backupName(name), oldText); } catch (ignoreBak) {}\n        }\n\n        try {\n            zdjl.writeFile(path, cloudText);\n            markInstalled(name, release);\n            return {status:\"updated\", name:name};\n        } catch (e2) {\n            return {status:\"failed\", name:name, detail:String(e2)};\n        }\n    }\n\n\n    function validateScript(text, name) {\n        var lines=String(text||\"\").split(\/\\r?\\n\/), count=0;\n        for(var i=0;i<lines.length;i++){\n            if(!trimText(lines[i]))continue;\n            var row=JSON.parse(lines[i]);\n            if(!row||typeof row!==\"object\"||Array.isArray(row))throw new Error(name+\"格式错误\");\n            if(count===0){\n                \/\/ 根配置并不要求每个旧脚本都有 savedVerCode。\n                \/\/ 正式判断只要求：第一行不是动作，且具有 ZJS 根配置核心字段。\n                if(row.type!==undefined ||\n                   row.count===undefined ||\n                   row.repeatCount===undefined){\n                    throw new Error(name+\"文件头异常\");\n                }\n            }else if(!row.type){\n                throw new Error(name+\"动作类型缺失\");\n            }\n            count++;\n        }\n        if(count<2)throw new Error(name+\"没有可执行动作\");\n    }\n    function safeName(name){\n        return typeof name===\"string\" && \/^[^\\\\\\\/\\x00-\\x1f]+\\.zjs$\/i.test(name) && name.indexOf(\"..\")<0;\n    }\n    function restoreJournal(){\n        var journalPath=BASE_DIR+\".farm-update-transaction.json\";\n        var raw=localText(journalPath);\n        if(!raw)return true;\n        var journal;\n        try{journal=JSON.parse(raw);}catch(e){throw new Error(\"更新恢复日志损坏，请恢复整个旧包\");}\n        if(journal.status!==\"writing\")return true;\n        var failed=[];\n        for(var i=0;i<journal.items.length;i++){\n            var it=journal.items[i];\n            if(!safeName(it.name)){failed.push(\"非法文件名\");continue;}\n            if(it.oldText===null)continue; \/\/ 新增文件不被旧版调用，保留以便再次更新。\n            try{zdjl.writeFile(BASE_DIR+it.name,it.oldText);if(localText(BASE_DIR+it.name)!==it.oldText)throw new Error(\"读回不一致\");}\n            catch(e){failed.push(it.name);}\n        }\n        if(failed.length)throw new Error(\"恢复未完成：\"+failed.join(\"、\")+\"；请不要启动总控\");\n        journal.status=\"rolledBack\";\n        zdjl.writeFile(journalPath,JSON.stringify(journal));\n        return true;\n    }\n    function runMany(release, files, doWrite) {\n        var fromMain=calledFromMainControl();\n        var skippedMain=0;\n        if(doWrite && fromMain){\n            var filtered=[];\n            for(var fi=0;fi<files.length;fi++){\n                if(String(files[fi])===\"总控.zjs\"){skippedMain++;continue;}\n                filtered.push(files[fi]);\n            }\n            files=filtered;\n\n            \/\/ 总控内更新可以覆盖其他子脚本，但不能在当前执行链里恢复\/覆盖总控自身。\n            \/\/ 若上一次批量更新未完成，必须先离线恢复，避免把旧事务和本轮混在一起。\n            var oldJournal=localText(BASE_DIR+\".farm-update-transaction.json\");\n            if(oldJournal){\n                try{\n                    var oldObj=JSON.parse(oldJournal);\n                    if(oldObj && oldObj.status===\"writing\"){\n                        zdjl.alert(\"发现上次未完成的云更新事务。\\n\\n请先单独运行版本更新器完成离线恢复，再从总控更新。\");\n                        return;\n                    }\n                }catch(__oldJournalErr){\n                    zdjl.alert(\"云更新恢复日志损坏。请先单独运行版本更新器处理，当前未覆盖任何脚本。\");\n                    return;\n                }\n            }\n        }\n        if(doWrite && !fromMain)restoreJournal();\n        var staged=[],same=[],failed=[],seen={};\n        for(var i=0;i<files.length;i++){\n            var name=files[i];\n            if(!safeName(name)){failed.push(\"非法文件名\");continue;}\n            if(seen[name])continue;seen[name]=true;\n            try{\n                var r=getRaw(CLOUD_DIR+name,release.snapshotSha);\n                if(!r||r.code!==200)throw new Error(\"下载失败\");\n                var text=String(r.body);validateScript(text,name);\n                var old=localText(BASE_DIR+name);\n                if(old===text)same.push(name);else staged.push({name:name,oldText:old,text:text});\n            }catch(e){failed.push(name+\"：\"+String(e));}\n        }\n        \/\/ 只解析依赖，不执行下载的代码。\n        for(var si=0;si<staged.length;si++){\n            try{\n                var source=staged[si].text.split(\/\\r?\\n\/);\n                function visit(o){\n                    if(!o||typeof o!==\"object\")return;\n                    if(o.type===\"执行脚本\"&&o.filePath){\n                        var dep=String(o.filePath);\n                        if(!safeName(dep))throw new Error(\"依赖名称不合法：\"+dep);\n                        if(!seen[dep]&&localText(BASE_DIR+dep)===null)throw new Error(\"缺少依赖：\"+dep+\"；请选择整套更新\");\n                    }\n                    for(var k in o)if(Object.prototype.hasOwnProperty.call(o,k))visit(o[k]);\n                }\n                for(var li=0;li<source.length;li++)if(trimText(source[li]))visit(JSON.parse(source[li]));\n            }catch(e){failed.push(staged[si].name+\"：\"+String(e));}\n        }\n        if(failed.length){zdjl.alert(\"预检查失败，未覆盖任何脚本：\\n\"+failed.join(\"\\n\"));return;}\n        if(!doWrite){zdjl.alert(\"检查完成｜\"+versionLabel(release)+\"\\n需要更新：\"+staged.length+\"\\n已经一致：\"+same.length);return;}\n        if(!staged.length){\n            if(skippedMain){\n                zdjl.alert(\"除正在运行的总控.zjs外，其余文件已经一致。\\n\\n关闭后本次总控直接结束；总控自身如需更新，请单独运行版本更新器。\");\n            }else{\n                zdjl.alert(\"全部文件已经一致\");\n            }\n            return;\n        }\n        \/\/ 当前更新器允许更新自己，但必须最后写。\n        \/\/ 当前JS动作已经载入内存，最后覆盖磁盘文件不会影响本次已运行代码。\n        staged.sort(function(x,y){\n            function rank(n){\n                n=String(n||\"\");\n                if(n===\"农场脚本版本更新器.zjs\")return 2;\n                if(n===\"农场脚本版本发布器.zjs\")return 1;\n                return 0;\n            }\n            var rx=rank(x.name), ry=rank(y.name);\n            if(rx!==ry)return rx-ry;\n            return 0;\n        });\n\n        var journalPath=BASE_DIR+\".farm-update-transaction.json\";\n        var journal={status:\"writing\",version:release.id,items:staged};\n        \/\/ 先完整写下恢复信息；设备重启后可以离线恢复。\n        var journalText=JSON.stringify(journal);\n        zdjl.writeFile(journalPath,journalText);\n        if(localText(journalPath)!==journalText)throw new Error(\"恢复日志写入失败，未覆盖脚本\");\n        try{\n            for(var j=0;j<staged.length;j++){\n                var item=staged[j];\n                if(item.oldText!==null){\n                    zdjl.writeFile(backupName(item.name),item.oldText);\n                    if(localText(backupName(item.name))!==item.oldText)throw new Error(item.name+\"备份失败\");\n                }\n                zdjl.writeFile(BASE_DIR+item.name,item.text);\n                if(localText(BASE_DIR+item.name)!==item.text)throw new Error(item.name+\"写入校验失败\");\n            }\n            journal.status=\"committed\";zdjl.writeFile(journalPath,JSON.stringify(journal));\n            if(JSON.parse(localText(journalPath)||\"{}\").status!==\"committed\")throw new Error(\"提交标记写入失败\");\n            for(var a=0;a<staged.length;a++)markInstalled(staged[a].name,release);\n            for(var b=0;b<same.length;b++)markInstalled(same[b],release);\n            if(fromMain){\n                zdjl.alert(\"更新完成｜\"+versionLabel(release)+\"\\n已更新：\"+staged.length+\"\\n一致：\"+same.length+(skippedMain?\"\\n已跳过：总控.zjs（正在运行）\":\"\")+\"\\n关闭后本次总控直接结束，不执行农场任务；总控自身请单独运行更新器更新。\");\n            }else{\n                zdjl.alert(\"更新完成｜\"+versionLabel(release)+\"\\n已更新：\"+staged.length+\"\\n一致：\"+same.length+\"\\n请重新启动总控。\");\n            }\n        }catch(e){\n            \/\/ 即使提交标记出现异常，也按内存中的完整旧版本恢复。\n            var rollbackFailed=[];\n            for(var ri=0;ri<staged.length;ri++){\n                var oldItem=staged[ri];if(oldItem.oldText===null)continue;\n                try{zdjl.writeFile(BASE_DIR+oldItem.name,oldItem.oldText);if(localText(BASE_DIR+oldItem.name)!==oldItem.oldText)throw new Error(\"读回不一致\");}\n                catch(re){rollbackFailed.push(oldItem.name);}\n            }\n            journal.status=rollbackFailed.length?\"writing\":\"rolledBack\";\n            try{zdjl.writeFile(journalPath,JSON.stringify(journal));}catch(ignore){}\n            zdjl.alert(\"更新失败：\"+String(e)+\"\\n\"+(rollbackFailed.length?\"以下文件未恢复，请用备份恢复后再运行：\"+rollbackFailed.join(\"、\"):\"原有文件已恢复。新增文件保留，可在下次更新时复用。\"));\n        }\n    }\n    function showVersions() {\n        var h = historyObj();\n        var arr = h.versions || [];\n        if (!arr.length) {\n            zdjl.alert(\"云端还没有版本历史\");\n            return;\n        }\n\n        var maxShow = Math.min(30, arr.length);\n        var msg = \"云端版本历史\\n\\n总版本数：\" + arr.length + \"\\n最近 \" + maxShow + \" 个：\\n\\n\";\n\n        for (var i = 0; i < maxShow; i++) {\n            var v = arr[i];\n            msg += (i + 1) + \". \" + versionLabel(v) + \"\\n\";\n            msg += \"   ID：\" + (v.id || \"\") + \"\\n\";\n            msg += \"   文件：\" + (v.fileCount == null ? \"?\" : v.fileCount);\n            msg += \"｜修改：\" + (v.changedCount == null ? \"?\" : v.changedCount);\n            msg += \"｜新增：\" + (v.addedCount == null ? \"?\" : v.addedCount);\n            msg += \"｜移出：\" + (v.removedCount == null ? \"?\" : v.removedCount);\n            msg += \"\\n\\n\";\n        }\n\n        zdjl.alert(msg);\n    }\n\n    function showLocalState() {\n        var latest = latestRelease();\n        var manifest = manifestFor(latest.snapshotSha);\n        var files = manifest.files || [];\n        var msg = \"本机脚本版本记录\\n\\n\";\n\n        for (var i = 0; i < files.length; i++) {\n            var label = trimText(zdjl.getStorage(\"installed_label_\" + files[i], NS));\n            var id = trimText(zdjl.getStorage(\"installed_\" + files[i], NS));\n\n            msg += files[i] + \"\\n\";\n            if (label) {\n                msg += \"  \" + label;\n                if (id) msg += \"｜\" + id;\n            } else if (id) {\n                msg += \"  \" + id;\n            } else {\n                msg += \"  未记录\/可能手动替换\";\n            }\n            msg += \"\\n\";\n        }\n\n        zdjl.alert(msg);\n    }\n    function rollbackBak() {\n        restoreJournal();\n        var candidates=[\"1v1.zjs\", \"55.zjs\", \"一键种植.zjs\", \"保变异收割.zjs\", \"公共初始化.zjs\", \"关广告.zjs\", \"农场脚本版本发布器.zjs\", \"农场脚本版本更新器.zjs\", \"切换账号.zjs\", \"初始化OCR.zjs\", \"升级农场.zjs\", \"升级小摊.zjs\", \"占位保存.zjs\", \"变异植物上传.zjs\", \"变异植物识别.zjs\", \"嘎嘎祝福.zjs\", \"总控.zjs\", \"换16经验.zjs\", \"换经济作物.zjs\", \"收割判定.zjs\", \"查看状态.zjs\", \"浇水领奖.zjs\", \"状态提示.zjs\", \"祝福.zjs\", \"祝福判定.zjs\", \"祝福识别收方.zjs\", \"祝福识别送方.zjs\", \"脚本更新器.zjs\", \"补传记录.zjs\", \"记录报错.zjs\", \"识别情况.zjs\", \"请求重启王者.zjs\", \"账号配置.zjs\", \"轻量状态跳转模板_V1.zjs\", \"运行参数.zjs\", \"进游戏关闭广告.zjs\", \"退出农场.zjs\", \"选择八小时作物.zjs\", \"选择英雄植物.zjs\", \"重启王者.zjs\"];\n        var available=[];\n        for(var i=0;i<candidates.length;i++)if(localText(BASE_DIR+candidates[i]+\".bak\")!==null)available.push(candidates[i]);\n        if(!available.length){zdjl.alert(\"没有可用的本地备份；未完成的批次恢复已检查。\");return;}\n        var name = selectOne(\"选择要恢复 .bak 的脚本（离线可用）\", available);\n        if (!name) return;\n        if (calledFromMainControl() && String(name) === \"总控.zjs\") {\n            zdjl.alert(\"当前更新器由总控内调用，不能在总控运行中覆盖\/回滚总控.zjs。\\n\\n如需更新或回滚总控本身，请单独运行农场脚本版本更新器.zjs。\");\n            return;\n        }\n\n        var bak = localText(BASE_DIR + name + \".bak\");\n        if (bak === null) {\n            zdjl.alert(\"没有找到备份：\\n\" + name + \".bak\");\n            return;\n        }\n\n        var now = localText(BASE_DIR + name);\n        if (now !== null) {\n            try { zdjl.writeFile(BASE_DIR + name + \".before-bak-restore.bak\", now); } catch (ignore) {}\n        }\n\n        zdjl.writeFile(BASE_DIR + name, bak);\n        zdjl.alert(\"已恢复本地备份\\n\\n\" + name);\n    }\n\n    function setReadToken() {\n        var current = getToken();\n        var ans = trimText(zdjl.prompt(\n            \"可选：设置只读Token，提高GitHub API请求额度。\\n\" +\n            \"输入 CLEAR 可清除。\\n\\n当前：\" + (current ? \"已有Token\" : \"未设置Token\"),\n            \"\"\n        ));\n\n        if (!ans) return;\n        if (ans.toUpperCase() === \"CLEAR\") {\n            zdjl.setStorage(\"github_read_token\", \"\", NS);\n            zdjl.alert(\"已清除更新器专用只读Token\");\n        } else {\n            zdjl.setStorage(\"github_read_token\", ans, NS);\n            zdjl.alert(\"已保存更新器专用只读Token\");\n        }\n    }\n\n    if(!calledFromMainControl()){try{restoreJournal();}catch(e){zdjl.alert(String(e));return;}}\n\n    \/\/ 一键下载模式：供“农场脚本下载.zjs”和总控的“更新”入口使用。\n    \/\/ 不弹菜单，直接把最新版整套加载到本地，然后返回调用者。\n    var __oneShot=\"\";\n    try{__oneShot=String(zdjl.getVar(\"云更新一键模式\",\"global\")||\"\");}catch(__oneShotErr){}\n    if(__oneShot===\"全部更新\"){\n        try{zdjl.setVar(\"云更新一键模式\",\"\",\"global\");}catch(__clearOneShotErr){}\n        try{\n            var __latest=latestRelease();\n            var __manifest=manifestFor(__latest.snapshotSha);\n            runMany(__latest,__manifest.files,true);\n        }catch(__oneShotRunErr){\n            zdjl.alert(\"一键更新异常\\n\\n\"+String(__oneShotRunErr));\n        }\n        return;\n    }\n\n    var latestForMenu = null;\n    \/\/ 菜单不访问网络，本地备份恢复不受断网影响。\n\n    var latestText = latestForMenu ? versionLabel(latestForMenu) : \"最新版\";\n\n    var menuItems = [\n        \"最新版｜\" + latestText + \"｜全部更新\",\n        \"最新版｜\" + latestText + \"｜选择一个或多个脚本\",\n        \"历史版本｜全部回退\",\n        \"历史版本｜选择一个或多个脚本\",\n        \"只检查最新版，不写文件\",\n        \"查看版本历史\",\n        \"查看本机各脚本版本记录\",\n        \"恢复某脚本的本地 .bak\",\n        \"设置\/更换只读Token\"\n    ];\n\n    var menu = selectOne(\"农场脚本云更新 V4.2\", menuItems);\n    if (!menu) return;\n\n    try {\n        if (menu === menuItems[0]) {\n            var l1 = latestForMenu || latestRelease();\n            var m1 = manifestFor(l1.snapshotSha);\n            runMany(l1, m1.files, true);\n\n        } else if (menu === menuItems[1]) {\n            var l2 = latestForMenu || latestRelease();\n            var m2 = manifestFor(l2.snapshotSha);\n            var f2 = selectMany(\"选择要更新的脚本｜\" + versionLabel(l2), m2.files);\n            if (f2) runMany(l2, f2, true);\n\n        } else if (menu === menuItems[2]) {\n            var v3 = chooseVersion();\n            if (v3) {\n                var m3 = manifestFor(v3.snapshotSha);\n                runMany(v3, m3.files, true);\n            }\n\n        } else if (menu === menuItems[3]) {\n            var v4 = chooseVersion();\n            if (v4) {\n                var m4 = manifestFor(v4.snapshotSha);\n                var f4 = selectMany(\"选择要恢复的脚本｜\" + versionLabel(v4), m4.files);\n                if (f4) runMany(v4, f4, true);\n            }\n\n        } else if (menu === menuItems[4]) {\n            var l5 = latestForMenu || latestRelease();\n            var m5 = manifestFor(l5.snapshotSha);\n            runMany(l5, m5.files, false);\n\n        } else if (menu === menuItems[5]) {\n            showVersions();\n\n        } else if (menu === menuItems[6]) {\n            showLocalState();\n\n        } else if (menu === menuItems[7]) {\n            rollbackBak();\n\n        } else if (menu === menuItems[8]) {\n            setReadToken();\n        }\n    } catch (e) {\n        zdjl.alert(\"执行异常\\n\\n\" + String(e));\n    }\n})();"}

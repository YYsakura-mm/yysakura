{"repeatCount":1,"pauseOnFail":false,"count":1,"minVerCode":2021000,"minVerName":"2.21.0","screenWidth":720,"screenHeight":1280,"screenDpi":2,"lastSaveScreenWidth":1280,"lastSaveScreenHeight":720,"lastSaveScreenDpi":2,"savedVerCode":26000050,"savedVerName":"26.5.0","delay":"0.1","delayUnit":1,"description":"农场云更新V6.1｜整套同步、历史回退、按文件选择、混合版本识别"}
{"type":"运行JS代码","delay":"0","delayUnit":1,"desc":"云更新V6.1｜最新版/历史版可指定文件，混合版本提示","jsCode":"(function(){\n\n    var OWNER=\"YYsakura-mm\",REPO=\"yysakura\",BRANCH=\"main\";\n    var BASE_DIR=\"/storage/emulated/0/自动精灵/\";\n    var V5_DIR=\".farmcloud/v5/\";\n    var NS=\"farm-cloud-v5\",TOKEN_NS=\"github-sync\";\n    var BASE_FILE=BASE_DIR+\".farm-cloud-base-v5.json\";\n    // 更新器只从本机基线和远程版本元数据读取文件名单。\n    var MANAGED=[];\n    function trimText(v){return String(v==null?\"\":v).replace(/^\\s+|\\s+$/g,\"\");}\n    function localText(path){try{return String(zdjl.readFile(path));}catch(e){return null;}}\n    function encodePath(path){var a=String(path).split(\"/\"),o=[];for(var i=0;i<a.length;i++)o.push(encodeURIComponent(a[i]));return o.join(\"/\");}\n    function looksLikeToken(v){var s=trimText(v);return !!s&&!/[^\\x21-\\x7E]/.test(s)&&!/\\s/.test(s)&&s.length>=20&&/^(github_pat_|gh[pousr]_)/.test(s);}\n    function getToken(){var t=\"\";try{t=trimText(zdjl.getStorage(\"github_read_token\",NS));}catch(e){}if(looksLikeToken(t))return t;try{t=trimText(zdjl.getStorage(\"github_token\",TOKEN_NS));}catch(e2){}if(looksLikeToken(t))return t;try{t=trimText(zdjl.getStorage(\"github_token\",NS));}catch(e3){}return looksLikeToken(t)?t:\"\";}\n    function fetchJson(path,timeout){var h=[{\"Accept\":\"application/vnd.github.raw+json\"},{\"X-GitHub-Api-Version\":\"2022-11-28\"},{\"Cache-Control\":\"no-cache\"},{\"Pragma\":\"no-cache\"}],t=getToken();if(t)h.unshift({\"Authorization\":\"Bearer \"+t});var r=zdjl.requestUrl({url:\"https://api.github.com/repos/\"+OWNER+\"/\"+REPO+\"/contents/\"+encodePath(path)+\"?ref=\"+encodeURIComponent(BRANCH),method:\"GET\",headers:h,timeout:timeout||10000,responseType:\"TEXT\"});if(!r||r.code!==200)throw new Error(\"读取 \"+path+\" 失败 HTTP \"+(r?r.code:\"?\"));return JSON.parse(String(r.body||\"\"));}\n    function loadBase(){var s=localText(BASE_FILE);if(!s)return null;try{return JSON.parse(s);}catch(e){return null;}}\n    function vid(v){return String(v&&(v.versionId||v.id)||\"\");}\n    function label(v){return v?String(v.displayName||v.displayTime||v.publishedAt||v.versionId||v.id||\"未知\"):\"未知\";}\n    function safeName(n){return typeof n===\"string\"&&n.length<=110&&/^[^\\\\/\\x00-\\x1f]+\\.zjs$/i.test(n)&&n.indexOf(\"..\")<0&&n.charAt(0)!==\".\";}\n    function managedNames(b,cloud){var a=[],seen={},list=[];\n        if(b&&Array.isArray(b.files))for(var i=0;i<b.files.length;i++)list.push(String(b.files[i].name));\n        if(cloud&&Array.isArray(cloud.managedFiles))for(var j=0;j<cloud.managedFiles.length;j++)list.push(String(cloud.managedFiles[j]));\n        for(var k=0;k<list.length;k++){var n=list[k];if(safeName(n)&&!seen[n]){seen[n]=1;a.push(n);}}\n        return a;\n    }\n    function localChanges(b,cloud){if(!b||!Array.isArray(b.files))return null;var m={},out=[];\n        for(var i=0;i<b.files.length;i++){var it=b.files[i];if(it&&it.name!=null)m[String(it.name)]=String(it.content==null?\"\":it.content);}\n        var names=managedNames(b,cloud);\n        for(i=0;i<names.length;i++){var n=names[i],cur=localText(BASE_DIR+n);\n            if(m[n]!==undefined){if(cur!==m[n])out.push(n);}\n            else if(cur!==null)out.push(n); // 云端新增文件本地同名存在，必须提示覆盖冲突\n        }\n        return out;\n    }\n\n    var TARGET_KEY=\"target_release\",SUBSET_KEY=\"target_subset_v1\";\n    function snapshot(){var b=loadBase(),c=null,err=\"\";try{c=fetchJson(V5_DIR+\"latest.json\",10000);}catch(e){err=String(e);}var ch=localChanges(b,c),same=!!(b&&c&&vid(b)&&vid(b)===vid(c));var mixed=!!(b&&b.partialFileVersions&&Object.keys(b.partialFileVersions).length);var state;if(mixed)state=\"🟠 部分文件来自不同版本\";else if(!b)state=\"⚠ 本机未建立基线\";else if(!c)state=\"⚠ 云端版本读取失败\";else if(!same)state=\"⬆ 云端有新版本\";else if(ch&&ch.length)state=\"🟡 版本ID已最新，但本地有未发布改动\";else if(ch)state=\"✅ 本机与云端完全一致\";else state=\"⚠ 版本ID已读取，但本地改动无法完整核验\";return {base:b,cloud:c,changes:ch,same:same,state:state,error:err};}\n    function brief(s){return \"本机：\"+(s.base?label(s.base):\"未建立基线\")+\"\\n云端：\"+(s.cloud?label(s.cloud):\"读取失败/离线\")+\"\\n状态：\"+s.state+\"\\n本地未发布改动：\"+(s.changes?s.changes.length:\"?\");}\n    function selectOne(title,items){try{var r=zdjl.select({title:title,items:items,multi:false});if(r===null||r===undefined||r===false||r===\"\")return null;if(typeof r===\"number\")return items[r]!==undefined?items[r]:null;if(typeof r===\"string\")return items.indexOf(r)>=0?r:null;if(r.item!=null)return String(r.item);if(r.value!=null&&items.indexOf(String(r.value))>=0)return String(r.value);if(r.index!=null)return items[Number(r.index)]!==undefined?items[Number(r.index)]:null;if(r.selectedIndex!=null)return items[Number(r.selectedIndex)]!==undefined?items[Number(r.selectedIndex)]:null;return null;}catch(e){var m=title+\"\\n\\n\";for(var i=0;i<items.length;i++)m+=(i+1)+\". \"+items[i]+\"\\n\";var n=Number(trimText(zdjl.prompt(m,\"1\")));return n>=1&&n<=items.length?items[n-1]:null;}}\n    function runDownloader(target,subset){try{zdjl.setStorage(TARGET_KEY,target||\"\",NS);zdjl.setStorage(SUBSET_KEY,subset?JSON.stringify({schema:1,versionId:target||\"\",files:subset,at:Date.now()}):\"\",NS);}catch(e){}zdjl.runAction({\"type\":\"执行脚本\",\"delay\":\"0\",\"delayUnit\":1,\"filePath\":\"农场脚本下载.zjs\",\"continueCurrentAfterFinish\":true});}\n    function syncLatest(s){if(!s.cloud){zdjl.alert(\"云端最新版读取失败，不能安全判断更新。\\n\\n\"+s.error);return;}if(!s.base){runDownloader(\"\");return;}if(!s.same){if(s.changes&&s.changes.length){var w=trimText(zdjl.prompt(\"云端有新版本，同时本机有 \"+s.changes.length+\" 个未发布改动：\\n\\n\"+s.changes.join(\"\\n\")+\"\\n\\n继续会覆盖这些文件。输入“更新”继续：\",\"\"));if(w!==\"更新\")return;}runDownloader(\"\");return;}if(s.base&&s.base.partialFileVersions&&Object.keys(s.base.partialFileVersions).length){var yes=trimText(zdjl.prompt(\"检测到混合版本：即使整套ID与最新版相同，也不能证明所有脚本均来自最新版。\\n\\n输入“整套更新”恢复最新版：\",\"\"));if(yes===\"整套更新\")runDownloader(\"\");return;}if(s.changes&&s.changes.length){var w2=trimText(zdjl.prompt(\"版本ID已经最新，但本机有 \"+s.changes.length+\" 个未发布改动：\\n\\n\"+s.changes.join(\"\\n\")+\"\\n\\n它们不是“云端更新”。如要丢弃并恢复云端版，输入“修复”：\",\"\"));if(w2===\"修复\")runDownloader(\"\");return;}zdjl.alert(\"已经是云端最新版。\\n\\n\"+brief(s));}\n    function showStatus(s){var msg=\"版本状态\\n\\n\"+brief(s)+\"\\n本机ID：\"+(s.base?vid(s.base):\"无\")+\"\\n云端ID：\"+(s.cloud?vid(s.cloud):\"未知\");if(s.changes&&s.changes.length)msg+=\"\\n\\n【本地未发布改动】\\n\"+s.changes.join(\"\\n\");if(s.base&&s.base.partialFileVersions){var mix=s.base.partialFileVersions,keys=Object.keys(mix);if(keys.length)msg+=\"\\n\\n【混合版本文件】\\n\"+keys.map(function(n){return n+\" ← \"+mix[n];}).join(\"\\n\");}if(s.error)msg+=\"\\n\\n云端错误：\"+s.error;zdjl.alert(msg);}\n    function choosePagedHistory(title,items,refs){\n      var page=0,per=15,max=Math.ceil(items.length/per);\n      for(var guard=0;guard<250;guard++){\n        var start=page*per,shown=items.slice(start,start+per),prev='◀ 上一页',next='下一页 ▶',cancel='取消';\n        if(page>0)shown.push(prev);\n        if(start+per<items.length)shown.push(next);\n        shown.push(cancel);\n        var chosen=selectOne(title+'（'+(page+1)+'/'+max+'）',shown);\n        if(!chosen||chosen===cancel)return null;\n        if(chosen===prev){page=Math.max(0,page-1);continue;}\n        if(chosen===next){page=Math.min(max-1,page+1);continue;}\n        var ix=shown.indexOf(chosen);return ix>=0&&ix<Math.min(per,items.length-start)?refs[start+ix]:null;\n      }\n      return null;\n    }\n    function history(rollback){var h=fetchJson(V5_DIR+\"versions.json\",20000),a=h.versions||[],items=[],refs=[];for(var i=0;i<a.length&&items.length<150;i++){var v=a[i];items.push((v.displayName||v.id||\"\")+\"｜改\"+(v.changedCount==null?\"?\":v.changedCount));refs.push(v);}if(!items.length){zdjl.alert(\"没有 V5 历史版本\");return;}if(!rollback){zdjl.alert(\"最近云端版本\\n\\n\"+items.slice(0,30).join(\"\\n\"));return;}var v=choosePagedHistory(\"选择完整回退版本\",items,refs);if(!v)return;var ok=trimText(zdjl.prompt(\"准备安装历史版本：\\n\"+label(v)+\"\\n\\n输入“回退”继续：\",\"\"));if(ok===\"回退\")runDownloader(vid(v));}\n    function selectFileNumbers(rel){\n      if(!Array.isArray(rel.managedFiles)||!rel.managedFiles.length){zdjl.alert('目标版本缺少完整文件清单，拒绝部分更新。');return null;}\n      var names=[],seen={};for(var i=0;i<rel.managedFiles.length;i++){\n        var n=String(rel.managedFiles[i]);if(!safeName(n))throw Error('目标版本含不安全文件名：'+n);\n        if(!seen[n]){seen[n]=1;names.push(n);}}\n      var q='目标版本：'+label(rel)+'\\n输入要更新的文件编号，例如 2,5,9。取消请留空。\\n\\n';\n      for(i=0;i<names.length;i++)q+=(i+1)+'. '+names[i]+'\\n';\n      var input=trimText(zdjl.prompt(q,''));if(!input)return null;\n      if(!/^\\d+(?:[\\s,，、;；]+\\d+)*$/.test(input)){zdjl.alert('只能输入编号，比如 2,5,9。');return null;}\n      var chunks=input.split(/[\\s,，、;；]+/),out=[],used={};\n      for(i=0;i<chunks.length;i++){\n        var id=Number(chunks[i]);if(!isFinite(id)||id<1||id>names.length||id!==Math.floor(id))throw Error('文件编号超出范围：'+chunks[i]);\n        var f=names[id-1];if(!used[f]){used[f]=1;out.push(f);}}\n      return out;\n    }\n    function selective(rel){\n      var b=loadBase();if(!b||!Array.isArray(b.files)||!vid(b)){zdjl.alert('部分更新需要本机存在完整的同步基线；请先整套同步一次。');return;}\n      if(!rel||!vid(rel)||!rel.tagName){zdjl.alert('目标版本缺少版本ID或Tag，拒绝。');return;}\n      var selected=selectFileNumbers(rel);if(!selected||!selected.length)return;\n      var uu=selected.indexOf('农场脚本版本更新器.zjs')>=0,dd=selected.indexOf('农场脚本下载.zjs')>=0;\n      if(uu!==dd){zdjl.alert('更新云工具需要同时选择“版本更新器”与“下载器”，以免接口不兼容。');return;}\n      var changed=localChanges(b,rel)||[],over=[];\n      for(var i=0;i<selected.length;i++)if(changed.indexOf(selected[i])>=0)over.push(selected[i]);\n      var warn=over.length?'\\n\\n其中 '+over.length+' 个文件本机有未发布改动：\\n'+over.join('\\n'):'';\n      var value=trimText(zdjl.prompt('仅覆盖以下 '+selected.length+' 个脚本：\\n'+selected.join('\\n')+'\\n来源：'+label(rel)+'\\n其他脚本和数据保持不变。'+warn+'\\n\\n输入“确认部分更新”执行：',''));\n      if(value==='确认部分更新')runDownloader(vid(rel),selected);\n    }\n    function selectiveHistory(){\n      var h=fetchJson(V5_DIR+'versions.json',20000),arr=h.versions||[],items=[],refs=[];\n      for(var i=0;i<arr.length&&items.length<150;i++){var v=arr[i];if(!vid(v)||!v.tagName)continue;items.push(label(v)+'｜改'+(v.changedCount==null?'?':v.changedCount));refs.push(v);}\n      if(!items.length){zdjl.alert('未找到可用历史版本');return;}\n      var selected=choosePagedHistory('选择部分更新的历史版本',items,refs);if(selected)selective(selected);\n    }\n    function restoreBak(){var a=[],m=managedNames(loadBase(),null);for(var i=0;i<m.length;i++)if(localText(BASE_DIR+m[i]+\".bak\")!==null)a.push(m[i]);if(!a.length){zdjl.alert(\"没有可用 .bak\");return;}var n=selectOne(\"选择恢复 .bak\",a);if(!n)return;var bak=localText(BASE_DIR+n+\".bak\"),now=localText(BASE_DIR+n);if(now!==null)zdjl.writeFile(BASE_DIR+n+\".before-bak-restore.bak\",now);zdjl.writeFile(BASE_DIR+n,bak);if(localText(BASE_DIR+n)!==bak)throw new Error(\"恢复读回不一致\");zdjl.alert(\"已恢复：\"+n+\"\\n\\n它会显示为本地未发布改动，不会改变版本ID。\");}\n    try{var s=snapshot(),menu=[\"同步最新版｜按版本ID判断\",\"仅更新指定文件｜最新版\",\"仅更新指定文件｜历史版本\",\"查看完整版本状态\",\"查看最近云端版本\",\"历史版本｜整套回退\",\"恢复某脚本本地 .bak\"],m=selectOne(\"农场脚本云同步 V6.0\\n\\n\"+brief(s),menu);if(!m)return;if(m===menu[0])syncLatest(s);else if(m===menu[1])selective(s.cloud);else if(m===menu[2])selectiveHistory();else if(m===menu[3])showStatus(s);else if(m===menu[4])history(false);else if(m===menu[5])history(true);else if(m===menu[6])restoreBak();}catch(e){zdjl.alert(\"V6.0 更新器异常\\n\\n\"+String(e));}\n})();"}

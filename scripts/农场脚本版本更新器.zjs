{"repeatCount":1,"pauseOnFail":false,"count":1,"minVerCode":2021000,"minVerName":"2.21.0","screenWidth":720,"screenHeight":1280,"screenDpi":2,"lastSaveScreenWidth":1280,"lastSaveScreenHeight":720,"lastSaveScreenDpi":2,"savedVerCode":26000050,"savedVerName":"26.5.0","delay":"0.1","delayUnit":1,"description":"农场脚本云同步 V5.5｜版本ID判断更新｜本机/云端/本地改动同屏"}
{"type":"运行JS代码","delay":"0","delayUnit":1,"desc":"V5.5 更新管理器｜版本ID决定更新，本地文件差异只作提示","jsCode":"(function(){\n\n    var OWNER=\"YYsakura-mm\",REPO=\"yysakura\",BRANCH=\"main\";\n    var BASE_DIR=\"/storage/emulated/0/自动精灵/\";\n    var V5_DIR=\".farmcloud/v5/\";\n    var NS=\"farm-cloud-v5\",TOKEN_NS=\"github-sync\";\n    var BASE_FILE=BASE_DIR+\".farm-cloud-base-v5.json\";\n    var MANAGED=[\"1v1.zjs\",\"55.zjs\",\"一键种植.zjs\",\"保变异收割.zjs\",\"关广告.zjs\",\"农场脚本下载.zjs\",\"农场脚本版本发布器.zjs\",\"农场脚本版本更新器.zjs\",\"切换账号.zjs\",\"初始化OCR.zjs\",\"占位保存.zjs\",\"变异植物上传.zjs\",\"变异植物识别.zjs\",\"总控.zjs\",\"换16经验.zjs\",\"换经济作物.zjs\",\"收割判定.zjs\",\"查看状态.zjs\",\"浇水领奖.zjs\",\"状态提示.zjs\",\"祝福.zjs\",\"祝福判定.zjs\",\"祝福识别收方.zjs\",\"祝福识别送方.zjs\",\"进游戏关闭广告.zjs\",\"退出农场.zjs\",\"选择八小时作物.zjs\",\"选择英雄植物.zjs\",\"重启王者.zjs\"];\n    function trimText(v){return String(v==null?\"\":v).replace(/^\\s+|\\s+$/g,\"\");}\n    function localText(path){try{return String(zdjl.readFile(path));}catch(e){return null;}}\n    function encodePath(path){var a=String(path).split(\"/\"),o=[];for(var i=0;i<a.length;i++)o.push(encodeURIComponent(a[i]));return o.join(\"/\");}\n    function looksLikeToken(v){var s=trimText(v);return !!s&&!/[^\\x21-\\x7E]/.test(s)&&!/\\s/.test(s)&&s.length>=20&&/^(github_pat_|gh[pousr]_)/.test(s);}\n    function getToken(){var t=\"\";try{t=trimText(zdjl.getStorage(\"github_read_token\",NS));}catch(e){}if(looksLikeToken(t))return t;try{t=trimText(zdjl.getStorage(\"github_token\",TOKEN_NS));}catch(e2){}if(looksLikeToken(t))return t;try{t=trimText(zdjl.getStorage(\"github_token\",NS));}catch(e3){}return looksLikeToken(t)?t:\"\";}\n    function fetchJson(path,timeout){var h=[{\"Accept\":\"application/vnd.github.raw+json\"},{\"X-GitHub-Api-Version\":\"2022-11-28\"},{\"Cache-Control\":\"no-cache\"},{\"Pragma\":\"no-cache\"}],t=getToken();if(t)h.unshift({\"Authorization\":\"Bearer \"+t});var r=zdjl.requestUrl({url:\"https://api.github.com/repos/\"+OWNER+\"/\"+REPO+\"/contents/\"+encodePath(path)+\"?ref=\"+encodeURIComponent(BRANCH),method:\"GET\",headers:h,timeout:timeout||10000,responseType:\"TEXT\"});if(!r||r.code!==200)throw new Error(\"读取 \"+path+\" 失败 HTTP \"+(r?r.code:\"?\"));return JSON.parse(String(r.body||\"\"));}\n    function loadBase(){var s=localText(BASE_FILE);if(!s)return null;try{return JSON.parse(s);}catch(e){return null;}}\n    function vid(v){return String(v&&(v.versionId||v.id)||\"\");}\n    function label(v){return v?String(v.displayName||v.displayTime||v.publishedAt||v.versionId||v.id||\"未知\"):\"未知\";}\n    function localChanges(b){if(!b||!Array.isArray(b.files))return null;var m={},out=[];for(var i=0;i<b.files.length;i++){var it=b.files[i];if(it&&it.name!=null)m[String(it.name)]=String(it.content==null?\"\":it.content);}for(i=0;i<MANAGED.length;i++){var n=MANAGED[i];if(m[n]===undefined)return null;if(localText(BASE_DIR+n)!==m[n])out.push(n);}return out;}\n\n    var TARGET_KEY=\"target_release\";\n    function snapshot(){var b=loadBase(),c=null,err=\"\";try{c=fetchJson(V5_DIR+\"latest.json\",10000);}catch(e){err=String(e);}var ch=localChanges(b),same=!!(b&&c&&vid(b)&&vid(b)===vid(c));var state;if(!b)state=\"⚠ 本机未建立基线\";else if(!c)state=\"⚠ 云端版本读取失败\";else if(!same)state=\"⬆ 云端有新版本\";else if(ch&&ch.length)state=\"🟡 版本ID已最新，但本地有未发布改动\";else if(ch)state=\"✅ 本机与云端完全一致\";else state=\"⚠ 版本ID已读取，但本地改动无法完整核验\";return {base:b,cloud:c,changes:ch,same:same,state:state,error:err};}\n    function brief(s){return \"本机：\"+(s.base?label(s.base):\"未建立基线\")+\"\\n云端：\"+(s.cloud?label(s.cloud):\"读取失败/离线\")+\"\\n状态：\"+s.state+\"\\n本地未发布改动：\"+(s.changes?s.changes.length:\"?\");}\n    function selectOne(title,items){try{var r=zdjl.select({title:title,items:items,multi:false});if(r===null||r===undefined||r===false||r===\"\")return null;if(typeof r===\"number\")return items[r]!==undefined?items[r]:null;if(typeof r===\"string\")return items.indexOf(r)>=0?r:null;if(r.item!=null)return String(r.item);if(r.value!=null&&items.indexOf(String(r.value))>=0)return String(r.value);if(r.index!=null)return items[Number(r.index)]!==undefined?items[Number(r.index)]:null;if(r.selectedIndex!=null)return items[Number(r.selectedIndex)]!==undefined?items[Number(r.selectedIndex)]:null;return null;}catch(e){var m=title+\"\\n\\n\";for(var i=0;i<items.length;i++)m+=(i+1)+\". \"+items[i]+\"\\n\";var n=Number(trimText(zdjl.prompt(m,\"1\")));return n>=1&&n<=items.length?items[n-1]:null;}}\n    function runDownloader(target){try{zdjl.setStorage(TARGET_KEY,target||\"\",NS);}catch(e){}zdjl.runAction({\"type\":\"执行脚本\",\"delay\":\"0\",\"delayUnit\":1,\"filePath\":\"农场脚本下载.zjs\",\"continueCurrentAfterFinish\":true});}\n    function syncLatest(s){if(!s.cloud){zdjl.alert(\"云端最新版读取失败，不能安全判断更新。\\n\\n\"+s.error);return;}if(!s.base){runDownloader(\"\");return;}if(!s.same){if(s.changes&&s.changes.length){var w=trimText(zdjl.prompt(\"云端有新版本，同时本机有 \"+s.changes.length+\" 个未发布改动：\\n\\n\"+s.changes.join(\"\\n\")+\"\\n\\n继续会覆盖这些文件。输入“更新”继续：\",\"\"));if(w!==\"更新\")return;}runDownloader(\"\");return;}if(s.changes&&s.changes.length){var w2=trimText(zdjl.prompt(\"版本ID已经最新，但本机有 \"+s.changes.length+\" 个未发布改动：\\n\\n\"+s.changes.join(\"\\n\")+\"\\n\\n它们不是“云端更新”。如要丢弃并恢复云端版，输入“修复”：\",\"\"));if(w2===\"修复\")runDownloader(\"\");return;}zdjl.alert(\"已经是云端最新版。\\n\\n\"+brief(s));}\n    function showStatus(s){var msg=\"版本状态\\n\\n\"+brief(s)+\"\\n本机ID：\"+(s.base?vid(s.base):\"无\")+\"\\n云端ID：\"+(s.cloud?vid(s.cloud):\"未知\");if(s.changes&&s.changes.length)msg+=\"\\n\\n【本地未发布改动】\\n\"+s.changes.join(\"\\n\");if(s.error)msg+=\"\\n\\n云端错误：\"+s.error;zdjl.alert(msg);}\n    function history(rollback){var h=fetchJson(V5_DIR+\"versions.json\",20000),a=h.versions||[],items=[],refs=[];for(var i=0;i<a.length&&items.length<30;i++){var v=a[i];items.push((v.displayName||v.id||\"\")+\"｜改\"+(v.changedCount==null?\"?\":v.changedCount));refs.push(v);}if(!items.length){zdjl.alert(\"没有 V5 历史版本\");return;}if(!rollback){zdjl.alert(\"最近云端版本\\n\\n\"+items.join(\"\\n\"));return;}var p=selectOne(\"选择完整回退版本\",items);if(!p)return;var idx=items.indexOf(p),v=refs[idx],ok=trimText(zdjl.prompt(\"准备安装历史版本：\\n\"+label(v)+\"\\n\\n输入“回退”继续：\",\"\"));if(ok===\"回退\")runDownloader(vid(v));}\n    function restoreBak(){var a=[];for(var i=0;i<MANAGED.length;i++)if(localText(BASE_DIR+MANAGED[i]+\".bak\")!==null)a.push(MANAGED[i]);if(!a.length){zdjl.alert(\"没有可用 .bak\");return;}var n=selectOne(\"选择恢复 .bak\",a);if(!n)return;var bak=localText(BASE_DIR+n+\".bak\"),now=localText(BASE_DIR+n);if(now!==null)zdjl.writeFile(BASE_DIR+n+\".before-bak-restore.bak\",now);zdjl.writeFile(BASE_DIR+n,bak);if(localText(BASE_DIR+n)!==bak)throw new Error(\"恢复读回不一致\");zdjl.alert(\"已恢复：\"+n+\"\\n\\n它会显示为本地未发布改动，不会改变版本ID。\");}\n    try{var s=snapshot(),menu=[\"同步最新版｜按版本ID判断\",\"查看完整版本状态\",\"查看最近云端版本\",\"历史版本｜整套回退\",\"恢复某脚本本地 .bak\"],m=selectOne(\"农场脚本云同步 V5.5\\n\\n\"+brief(s),menu);if(!m)return;if(m===menu[0])syncLatest(s);else if(m===menu[1])showStatus(s);else if(m===menu[2])history(false);else if(m===menu[3])history(true);else if(m===menu[4])restoreBak();}catch(e){zdjl.alert(\"V5.5 更新器异常\\n\\n\"+String(e));}\n})();"}

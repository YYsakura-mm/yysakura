{"type":"运行JS代码","delay":0,"delayUnit":1,"desc":"仅切换中转服务器地址，备份后更新，不改待上传队列","jsCode":"\n(function(){\nvar oldOrigin='http://38.207.187.183:8787',newOrigin='http://43.142.110.56';\nvar names=[\"M030885F.zjs\", \"M220D805.zjs\", \"M27ABA8F.zjs\", \"M2EB0292.zjs\", \"M44D8DEC.zjs\", \"M5D09B4D.zjs\", \"M635A8B7.zjs\", \"M668A536.zjs\", \"M7746A84.zjs\", \"M8DA9911.zjs\", \"M9014D36.zjs\", \"MA7B77EB.zjs\", \"MB4AF6E6.zjs\", \"MC13624C.zjs\", \"MC40117C.zjs\", \"MD39BE1F.zjs\", \"MDADBD65.zjs\", \"ME78668E.zjs\", \"MEFF8F15.zjs\", \"NX7A1.zjs\", \"NX7A2.zjs\", \"云更新.zjs\", \"云端更新.zjs\", \"农场云更新.zjs\", \"农场补传.zjs\", \"变异植物上传.zjs\", \"总控.zjs\", \"查看状态.zjs\", \"祝福.zjs\", \"祝福结果上传.zjs\"],roots=['/sdcard/自动精灵/','/storage/emulated/0/自动精灵/','/sdcard/Download/',''];\nvar stamp=new Date().getTime(),changed=[],failed=[],read=0,health=false,skipped=0;\nfor(var a=0;a<roots.length;a++)for(var b=0;b<names.length;b++){\n var path=roots[a]+names[b],raw='',next='',backup='';\n try{raw=String(zdjl.readFile(path)||'');}catch(noFile){continue;}\n if(!raw)continue;read++;if(raw.indexOf(oldOrigin)<0){skipped++;continue;}\n next=raw.split(oldOrigin).join(newOrigin);\n backup='/sdcard/Download/中转地址迁移备份_'+stamp+'_'+a+'_'+b+'_'+names[b]+'.bak';\n try{\n  zdjl.writeFile(backup,raw);\n  if(String(zdjl.readFile(backup)||'')!==raw)throw new Error('原文件备份校验失败');\n  zdjl.writeFile(path,next);\n  if(String(zdjl.readFile(path)||'')!==next){zdjl.writeFile(path,raw);throw new Error('更新校验失败，已尝试恢复原文件');}\n  changed.push(path);\n }catch(error){failed.push(path+'：'+String(error));}\n}\ntry{var r=zdjl.requestUrl({url:newOrigin+'/health',method:'GET',timeout:6000,requestType:'TEXT',responseType:'TEXT'});var o=JSON.parse(r.body||'{}');health=Number(r.code)===200&&o.ok===true;}catch(netError){}\nvar report='新服务器地址：'+newOrigin+'\\r\\n已更新文件：'+changed.length+'\\r\\n写入失败：'+failed.length+'\\r\\n当前云手机直接连接：'+(health?'成功':'未成功')+'\\r\\n';\nreport+='\\r\\n'+changed.join('\\r\\n')+'\\r\\n'+failed.join('\\r\\n');\nreport+='\\r\\n原脚本已在Download文件夹备份；待上传队列没有修改。请重新启动原来的扫描任务，使新地址生效。\\r\\n';\nif(!changed.length)report+='若之前未迁移且更新数为0，请导出这台云手机正在使用的上传脚本，再单独更换地址。\\r\\n';\ntry{zdjl.writeFile('/sdcard/Download/新服务器切换结果.txt',report);}catch(ignore){}\nzdjl.toast('新服务器：'+(health?'连接成功':'连接未成功')+'；已更新'+changed.length+'个脚本；失败'+failed.length+'。结果在Download/新服务器切换结果.txt',8000);\n})();\n"}

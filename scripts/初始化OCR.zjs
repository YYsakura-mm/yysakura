{"repeatCount":1,"pauseOnFail":false,"count":3,"minVerCode":2026000,"minVerName":"2.26.0","screenWidth":720,"screenHeight":1280,"screenDpi":2,"lastSaveScreenWidth":720,"lastSaveScreenHeight":1280,"lastSaveScreenDpi":2,"savedVerCode":26000050,"savedVerName":"26.5.0","description":"OCR初始化｜SDK/服务/固定三区域｜总控启动时执行一次","delay":"0"}
{"type":"运行JS代码","delayUnit":1,"desc":"OCR SDK初始化（全局仅缺失时执行）","jsCode":"/**\n * 自动精灵 OCR SDK\n * 对接 OcrServer HTTP 服务 (127.0.0.1:9530)\n *\n * 维度说明:\n *   type  = 精度档位: high(高精度/慢) / low(低精度/快)\n *   model = 模型档位: tiny(默认/最快) / small(更准) / medium(最高精度,速度略慢)\n *   两者正交，可自由组合，例如 {type:'high', model:'medium'} 取最高精度\n *   后端接受 model 取值: tiny | small | medium (small 可写 s/v6_small/v6small；medium 可写 m/v6_medium/v6medium)\n *   后端响应会回显 \"model\" 字段，可用 result.model 读取实际使用的档位\n *\n * 多模型常驻 + 单模型精度（element 写 'model' 或 'model,type' 简写）:\n *   init({ models: ['tiny','small','medium'] })                          // 全部用默认精度 this.type\n *   init({ models: ['tiny','small,high','medium,high'] })                // 用逗号简写单独指定精度\n *   init({ models: [{model:'medium',type:'high'}] })                     // 也兼容完整对象写法\n *   之后用序号/模型名调用即自动带上该模型配置的精度:\n *     ocr(area, 1)            用 models[0] 及其配置的精度\n *     ocr(area, 2)            用 models[1] 及其配置的精度\n *     ocr(area, 'medium')     同效；未单独配置精度则走默认 this.type\n *     ocr(area, {model:'medium', type:'low'})  直接传对象覆盖\n *   序号对所有文字方法同样有效: hasText(area, '开始', 2)\n *\n * 方法说明:\n *   ocr(area, arg)           - OCR识别，返回 {data, timeout, model}\n *   hasText(area, text, arg) - 是否出现指定文字\n *   clickText(area, text, arg) - 点击指定文字\n *   clickMultiText(area, textList, arg) - 多关键词点击\n *   findText(area, text, arg)  - 查找文字位置\n *   getPoint(area, text, arg)  - 获取文字坐标 {x, y}\n *   getPoints(area, text, arg) - 获取所有匹配坐标数组\n *   setModel(model)          - 切换当前模型档位(tiny/small/medium)\n *   loadModels(list)         - 预加载多个模型并常驻，返回加载结果数组\n *   getModels()              - 查看已登记的模型数组(序号即下标+1)\n *   setReleaseOthers(on)     - 单模型模式开关(默认 true=只保留当前模型,省内存；false=允许多模型常驻)，走 HTTP /config 接口\n *   getReleaseOthers()       - 读取单模型模式开关状态\n *   ping()                   - 检查服务是否可用\n *   appOps(pkg, op, mode)    - 跨应用 AppOps 读写（省略 mode=读当前模式；否则=设模式 allow/ignore/deny/default）\n *   grantPermission(pkg, perm) - 授予某包运行时权限（pm grant）\n *   revokePermission(pkg, perm) - 吊销某包运行时权限（pm revoke）\n *   setAppOp(pkg, op, mode)  - 设置某包 AppOps 模式\n *   getAppOp(pkg, op)        - 读取某包 AppOps 当前模式（返回对象含 .mode）\n *   listAppOps()             - 列出全部可控 AppOps 与通道/可用模式\n *\n */\n\n// ==================== 配置区域 ====================\nconst host = '127.0.0.1';  // 地址: 一般填这个就行\nconst port = 9530;         // 端口\nconst type = 'high';       // 精度: high(高精度) / low(低精度)\nconst model = 'tiny';      // 当前模型档位: tiny(最快,默认) / small(更准) / medium(最高精度)\nconst models = ['tiny', 'small', 'medium,low']; // 序号映射: 1=第一个 2=第二个 3=第三个；元素写 'model' 或 'model,type' 简写精度，如 'medium,low'\nconst releaseOthers = true; // 卸载模型开关（单模型模式）: true=切换模型时自动卸载其它模型、只保留当前(默认,省内存) / false=允许多模型同时常驻\n\n// 卸载开关（单模型模式）：默认开启 true=只保留当前模型，false=允许多模型常驻\n// 主通道走 HTTP /config 接口的 single_model 字段；sd 卡标记文件仅作旧版兜底（只能强制开启）\nconst REL_FLAG = '/sdcard/.ocr_release_others';\n// 1x1 预热图，仅用于触发引擎加载\nconst WARM_IMG = 'iVBORw0KGgoAAAANSUhEUgAAAAEAAAABCAYAAAAfFcSJAAAADUlEQVR42mP8z8BQDwAEhQGAhKmMIQAAAABJRU5ErkJggg==';\n\n// ==================== SDK 实现 ====================\nconst OcrSdk = {\n  host: host,\n  port: port,\n  type: type,\n  model: model,\n  models: models,\n\n  /**\n   * 初始化配置\n   * @param {object} config - {host, port, type, model, models, releaseOthers}\n   *        models 传数组(元素写 'model' 或 'model,type' 简写，或完整 {model,type} 对象) 时自动预加载并常驻，例如 {models:['tiny','small','medium,low']} 或 {models:['tiny','small',{model:'medium',type:'high'}]}\n   */\n  init: function(config) {\n    if (config && config.host) this.host = config.host;\n    if (config && config.port) this.port = config.port;\n    if (config && config.type) this.type = config.type;\n    if (config && config.model) this.model = this.normModel(config.model); // 当前模型档位\n    // 卸载模型开关（单模型模式）：优先用 init 传入，否则用配置区域默认 releaseOthers\n    let releaseFlag = (typeof (config && config.releaseOthers) === 'boolean') ? config.releaseOthers : releaseOthers;\n    this.setReleaseOthers(releaseFlag);\n    // 归一化 models（支持字符串数组 或 {model,type} 数组），每个元素登记为 {model, type}\n    if (config && config.models && config.models.length) {\n      this.loadModels(config.models); // 传入模型数组 → 预加载多个模型\n    } else {\n      this.models = [];\n      for (let i = 0; i < models.length; i++) this.models.push(this.normModelEntry(models[i]));\n    }\n    return this;\n  },\n\n  /** 获取OCR服务地址 */\n  getUrl: function() {\n    return 'http://' + this.host + ':' + this.port + '/ocr';\n  },\n\n  /**\n   * 模型名归一化\n   * @param {string} m\n   * @returns {string} 'tiny' | 'small' | 'medium'\n   */\n  normModel: function(m) {\n    return (m === 'medium' || m === 'm' || m === 'v6_medium' || m === 'v6medium') ? 'medium'\n         : (m === 'small' || m === 's' || m === 'v6_small' || m === 'v6small') ? 'small'\n         : 'tiny';\n  },\n\n  /**\n   * 把 models 的单个元素归一化为 {model, type}\n   * 支持三种写法（自动解析）:\n   *   字符串 'tiny'                    → { model:'tiny', type: undefined }（精度走默认 this.type）\n   *   简写   'tiny,low'                → { model:'tiny', type:'low' }（逗号后=精度，自动拆分）\n   *   对象   {model:'tiny',type:'low'} → { model:'tiny', type:'low' }（完整写法）\n   * @param {string|object} entry\n   * @returns {{model:string, type:?string}}\n   */\n  normModelEntry: function(entry) {\n    if (entry && typeof entry === 'object') {\n      return { model: this.normModel(entry.model), type: entry.type ? entry.type : undefined };\n    }\n    // 字符串支持 'model' 或 'model,type' 简写，逗号后=精度，例如 'medium,low'\n    if (typeof entry === 'string') {\n      let parts = entry.split(',');\n      let m = parts[0].trim();\n      let t = (parts.length > 1 && parts[1].trim()) ? parts[1].trim() : undefined;\n      return { model: this.normModel(m), type: t };\n    }\n    return { model: this.normModel(entry), type: undefined };\n  },\n\n  /**\n   * 把第二个参数归一化成 options 对象\n   * 支持: 数字序号(1/2/3) | 模型名字符串 | options对象 | 不传\n   */\n  normOptions: function(arg) {\n    if (arg === undefined || arg === null) return null;\n    if (typeof arg === 'number') {\n      let entry = this.models[Math.floor(arg) - 1];  // 1 → 第一个模型\n      return entry ? { model: entry.model, type: entry.type } : null; // 带上该模型配置的精度；未配置则 undefined→走默认 this.type\n    }\n    if (typeof arg === 'string') {\n      let mm = this.normModel(arg);\n      let entry = null;\n      for (let i = 0; i < this.models.length; i++) {\n        if (this.models[i].model === mm) { entry = this.models[i]; break; }\n      }\n      return { model: mm, type: entry ? entry.type : undefined }; // 命中 models 中已配置精度则带上\n    }\n    return arg; // 已是 options 对象，原样透传\n  },\n\n  /**\n   * 切换当前模型档位（全局生效）\n   * @param {string|number} m - 'tiny'|'small'|'medium'，或模型数组序号\n   * @returns {object} this\n   */\n  setModel: function(m) {\n    if (typeof m === 'number') {\n      let entry = this.models[Math.floor(m) - 1];\n      if (entry) this.model = entry.model;\n      return this;\n    }\n    this.model = this.normModel(m);\n    return this;\n  },\n\n  /**\n   * 预加载多个模型并常驻内存\n   * @param {Array<string|object>} list - 元素为字符串或 {model,type}，例如 ['tiny','small','medium'] 或 [{model:'medium',type:'high'}]，不传则用当前 models\n   * @returns {Array<{index:number, model:string, ok:boolean}>} 各模型加载结果\n   */\n  loadModels: function(list) {\n    let src = (list && list.length) ? list : models;\n    let entries = [];\n    for (let i = 0; i < src.length; i++) entries.push(this.normModelEntry(src[i]));\n    this.models = entries;\n    this.setReleaseOthers(false); // 多模型常驻与\"卸载其他引擎\"互斥，这里强制关闭\n    let res = [];\n    for (let i = 0; i < this.models.length; i++) {\n      let e = this.models[i];\n      res.push({ index: i + 1, model: e.model, type: e.type || this.type, ok: this.warmUp(e.model) });\n    }\n    return res;\n  },\n\n  /** 查看已登记的模型数组（序号 = 下标 + 1），元素为 {model, type}（type 缺省表示该模型走默认精度 this.type） */\n  getModels: function() {\n    return this.models;\n  },\n\n  /**\n   * 预热单个模型（发一张 1x1 图触发引擎加载）\n   * @param {string} m\n   * @returns {boolean}\n   */\n  warmUp: function(m) {\n    try {\n      let r = zdjl.requestUrl({\n        url: this.getUrl(),\n        method: 'POST',\n        headers: [{ 'Content-Type': 'application/json' }],\n        requestBody: JSON.stringify({ image: WARM_IMG, model: this.normModel(m), type: 'low' }),\n        requestType: 'TEXT',\n        responseType: 'TEXT'\n      });\n      return r.code === 200;\n    } catch (e) {\n      return false;\n    }\n  },\n\n  /**\n   * 单模型模式开关\n   * @param {boolean} on - true=切换模型时自动卸载其它模型、只保留当前模型(默认,省内存) / false=允许多模型同时常驻\n   * @returns {boolean} 是否设置成功\n   */\n  setReleaseOthers: function(on) {\n    try {\n      let r = zdjl.requestUrl({\n        url: 'http://' + this.host + ':' + this.port + '/config',\n        method: 'POST',\n        headers: [{ 'Content-Type': 'application/json' }],\n        requestBody: JSON.stringify({ single_model: !!on }),\n        requestType: 'TEXT',\n        responseType: 'TEXT'\n      });\n      if (r.code === 200) return true;\n    } catch (e) {}\n    try {\n      let f = new java.io.File(REL_FLAG);\n      if (on) {\n        if (!f.exists()) {\n          let os = new java.io.FileOutputStream(f);\n          os.write(49); // 写入字符 '1'\n          os.close();\n        }\n      } else if (f.exists()) {\n        f['delete']();\n      }\n      return true;\n    } catch (e) {\n      return false;\n    }\n  },\n\n  /** 读取单模型模式开关当前状态 */\n  getReleaseOthers: function() {\n    try {\n      let r = zdjl.requestUrl({\n        url: 'http://' + this.host + ':' + this.port + '/config',\n        method: 'GET',\n        headers: [],\n        requestBody: '',\n        requestType: 'TEXT',\n        responseType: 'TEXT'\n      });\n      if (r.code === 200) {\n        let json = JSON.parse(r.body);\n        if (typeof json.single_model === 'boolean') return json.single_model;\n      }\n    } catch (e) {}\n    try {\n      return new java.io.File(REL_FLAG).exists();\n    } catch (e) {\n      return false;\n    }\n  },\n\n  /** 截取屏幕区域 */\n  captureScreen: function(area) {\n    return zdjl.recognitionScreen({\n      recognitionArea: area,\n      recognitionMode: 'get_image_data',\n      ocrResultType: 'text',\n      humanRecMaxPositionCount: 1\n    });\n  },\n\n  /**\n   * OCR识别\n   * @param {屏幕区域|string} area - 屏幕区域对象或Base64字符串\n   * @param {number|string|object} arg - 模型序号(1/2/3) | 模型名 | {whitelist, boxes, color, type, model}\n   *        不传则使用当前模型 this.model\n   * @returns {{data: Array<{text: string, point: {x: number, y: number}, box: Array}>, timeout: number, model: string}}\n   */\n  ocr: function(area, arg) {\n    let options = this.normOptions(arg);\n    let startTime = Date.now();\n    let base64;\n    let offsetX = 0, offsetY = 0;\n\n    if (typeof area === 'string') {\n      base64 = area;\n    } else {\n      let screen = this.captureScreen(area);\n      base64 = screen.base64;\n      // 记录区域左上角偏移量\n      offsetX = area.left || 0;\n      offsetY = area.top || 0;\n    }\n\n    let body = { image: base64 };\n    body.type = (options && options.type) || this.type;\n    body.model = (options && options.model) || this.model; // 模型档位透传\n    if (options && options.whitelist) body.whitelist = options.whitelist;\n    if (options && options.boxes) body.boxes = options.boxes;\n    if (options && options.color) body.color = options.color;\n\n    let result = zdjl.requestUrl({\n      url: this.getUrl(),\n      method: 'POST',\n      headers: [{ 'Content-Type': 'application/json' }],\n      requestBody: JSON.stringify(body),\n      requestType: 'TEXT',\n      responseType: 'TEXT'\n    });\n\n    let timeout = Date.now() - startTime;\n\n    if (result.code === 200) {\n      try {\n        let json = JSON.parse(result.body);\n        let lines = json.data || json.lines || [];\n        let data = [];\n        for (let i = 0; i < lines.length; i++) {\n          let line = lines[i];\n          let box = line.box || [];\n          let x = 0, y = 0;\n          if (box.length >= 4) {\n            if (Array.isArray(box[0])) {\n              x = Math.round((box[0][0] + box[2][0]) / 2);\n              y = Math.round((box[0][1] + box[2][1]) / 2);\n            } else {\n              x = Math.round((box[0] + box[2]) / 2);\n              y = Math.round((box[1] + box[3]) / 2);\n            }\n          }\n          // 加上区域左上角偏移，转换为屏幕绝对坐标\n          data.push({\n            text: line.text || '',\n            point: { x: x + offsetX, y: y + offsetY },\n            box: box,\n            offset: { x: offsetX, y: offsetY }\n          });\n        }\n        return {\n          data: data,\n          timeout: timeout,\n          model: json.model || body.model,\n          offset: { x: offsetX, y: offsetY }\n        };\n      } catch (e) {\n        return { data: [], timeout: timeout, model: body.model, offset: { x: offsetX, y: offsetY } };\n      }\n    }\n    return { data: [], timeout: timeout, model: body.model, offset: { x: offsetX, y: offsetY } };\n  },\n\n  /**\n   * 是否出现文字\n   * @param {屏幕区域|string} area - 屏幕区域对象或Base64字符串\n   * @param {string} text - 要查找的文字\n   * @param {number|string|object} arg - 模型序号 / 模型名 / 可选参数\n   * @returns {boolean}\n   */\n  hasText: function(area, text, arg) {\n    let result = this.ocr(area, arg);\n    for (let i = 0; i < result.data.length; i++) {\n      if (result.data[i].text.indexOf(text) !== -1) {\n        return true;\n      }\n    }\n    return false;\n  },\n\n  /**\n   * 计算子字符串在文字框中的精确位置\n   * @param {object} item - OCR结果项 {text, box}\n   * @param {string} subText - 要查找的子字符串\n   * @returns {{x: number, y: number}|null}\n   */\n  calcSubTextPoint: function(item, subText) {\n    let fullText = item.text || '';\n    let box = item.box || [];\n    let offset = item.offset || { x: 0, y: 0 };\n    let index = fullText.indexOf(subText);\n    if (index === -1) return null;\n\n    let totalLen = fullText.length;\n    if (totalLen === 0) return null;\n\n    // 计算子字符串的起始和结束位置比例\n    let startRatio = index / totalLen;\n    let endRatio = (index + subText.length) / totalLen;\n    let centerRatio = (startRatio + endRatio) / 2;\n\n    let left, right, top, bottom;\n\n    if (box.length >= 4) {\n      if (Array.isArray(box[0])) {\n        // [[x1,y1], [x2,y2], [x3,y3], [x4,y4]] 格式\n        left = box[0][0];\n        right = box[2][0];\n        top = box[0][1];\n        bottom = box[2][1];\n      } else {\n        // [left, top, right, bottom] 格式\n        left = box[0];\n        top = box[1];\n        right = box[2];\n        bottom = box[3];\n      }\n\n      // 按比例计算X坐标，加上区域偏移\n      let x = Math.round(left + (right - left) * centerRatio) + offset.x;\n      let y = Math.round((top + bottom) / 2) + offset.y;\n\n      return { x: x, y: y };\n    }\n\n    return item.point;\n  },\n\n  /**\n   * 查找文字位置（精确到子字符串位置）\n   * @param {屏幕区域|string} area - 屏幕区域对象或Base64字符串\n   * @param {string} text - 要查找的文字\n   * @param {number|string|object} arg - 模型序号 / 模型名 / 可选参数\n   * @returns {{x: number, y: number}|null}\n   */\n  findText: function(area, text, arg) {\n    let result = this.ocr(area, arg);\n    for (let i = 0; i < result.data.length; i++) {\n      let item = result.data[i];\n      if (item.text.indexOf(text) !== -1) {\n        // 计算子字符串的精确位置\n        return this.calcSubTextPoint(item, text);\n      }\n    }\n    return null;\n  },\n\n  /**\n   * 获取文字坐标\n   * @param {屏幕区域|string} area - 屏幕区域对象或Base64字符串\n   * @param {string} text - 要查找的文字\n   * @param {number|string|object} arg - 模型序号 / 模型名 / 可选参数\n   * @returns {{x: number, y: number}} 未找到返回 {x: -1, y: -1}\n   */\n  getPoint: function(area, text, arg) {\n    let point = this.findText(area, text, arg);\n    return point || { x: -1, y: -1 };\n  },\n\n  /**\n   * 获取所有匹配文字的坐标数组\n   * @param {屏幕区域|string} area - 屏幕区域对象或Base64字符串\n   * @param {string} text - 要查找的文字\n   * @param {number|string|object} arg - 模型序号 / 模型名 / 可选参数\n   * @returns {Array<{x: number, y: number}>}\n   */\n  getPoints: function(area, text, arg) {\n    let result = this.ocr(area, arg);\n    let points = [];\n    for (let i = 0; i < result.data.length; i++) {\n      let item = result.data[i];\n      if (item.text.indexOf(text) !== -1) {\n        let point = this.calcSubTextPoint(item, text);\n        if (point) {\n          points.push(point);\n        }\n      }\n    }\n    return points;\n  },\n\n  /**\n   * 点击文字（精确到子字符串位置）\n   * @param {屏幕区域|string} area - 屏幕区域对象或Base64字符串\n   * @param {string} text - 要点击的文字\n   * @param {number|string|object} arg - 模型序号 / 模型名 / 可选参数\n   * @returns {boolean} 是否点击成功\n   */\n  clickText: function(area, text, arg) {\n    let point = this.findText(area, text, arg);\n    if (point && point.x > 0 && point.y > 0) {\n      zdjl.click(point.x, point.y);\n      return true;\n    }\n    return false;\n  },\n\n  /**\n   * 多关键词点击，仅单次OCR识别\n   * @param {屏幕区域|string} area - 识别区域\n   * @param {Array<string>} textList - 关键词数组 [\"X\",\"x\",\"×\"]\n   * @param {number|string|object} arg - 模型序号 / 模型名 / 可选参数\n   * @returns {boolean} 是否成功点击\n   */\n  clickMultiText: function(area, textList, arg) {\n    let result = this.ocr(area, arg);\n    for (let i = 0; i < result.data.length; i++) {\n      let item = result.data[i];\n      for (let keyword of textList) {\n        if (item.text.indexOf(keyword) !== -1) {\n          let point = this.calcSubTextPoint(item, keyword);\n          if (point && point.x > 0 && point.y > 0) {\n            zdjl.click(point.x, point.y);\n            return true;\n          }\n        }\n      }\n    }\n    return false;\n  },\n\n  /**\n   * 阻塞睡眠（同步，会卡死自动精灵单线程 JS 引擎）。\n   * ★ 除非你完全确定知道后果，否则不要在主链路调用！轮询请用 zdjl.sleepAsync + await。\n   * 仅在某些初始化等不需要响应其他事件的场景里偶尔可用。\n   */\n  sleep: function(ms) {\n    try { if (typeof zdjl.sleep === 'function') { zdjl.sleep(ms); return; } } catch (e) {}\n    try { java.lang.Thread.sleep(ms); } catch (e) {}\n  },\n\n  /** 内部：通用 HTTP POST（Web 窗口用）。返回原始响应对象 r（含 code/body），失败 null。 */\n  _httpPost: function(path, body) {\n    try {\n      return zdjl.requestUrl({\n        url: 'http://' + this.host + ':' + this.port + path,\n        method: 'POST',\n        headers: [{ 'Content-Type': 'application/json' }],\n        requestBody: JSON.stringify(body || {}),\n        requestType: 'TEXT',\n        responseType: 'TEXT'\n      });\n    } catch (e) { return null; }\n  },\n\n  /** 内部：把 HTTP 原始响应解析为 JSON 对象；非 200 / 无 body / 解析失败返回 null。 */\n  _parse: function(r) {\n    if (r && r.code === 200 && r.body) { try { return JSON.parse(r.body); } catch (e) {} }\n    return null;\n  },\n\n  /** 检查OCR服务是否可用 */\n  ping: function() {\n    try {\n      let result = zdjl.requestUrl({\n        url: 'http://' + this.host + ':' + this.port + '/',\n        method: 'GET',\n        headers: [],\n        requestBody: '',\n        requestType: 'TEXT',\n        responseType: 'TEXT'\n      });\n      return result.code === 200;\n    } catch (e) {\n      return false;\n    }\n  },\n\n  // ==================== 跨应用权限管理（对接 /manage_permission + /list_appops） ====================\n  // 前置：设备已授予本插件 root 或 Shizuku 通道（权限页手动「请求」）。仅管理「其他应用」权限。\n\n  /** 列出全部可控 AppOps（{op, perm, desc}）+ 当前通道/可用模式。返回 /list_appops 解析对象；失败 null。 */\n  listAppOps: function() {\n    try {\n      let r = zdjl.requestUrl({\n        url: 'http://' + this.host + ':' + this.port + '/list_appops',\n        method: 'GET', headers: [], requestBody: '', requestType: 'TEXT', responseType: 'TEXT'\n      });\n      if (r && r.code === 200 && r.body) return JSON.parse(r.body);\n    } catch (e) {}\n    return null;\n  },\n\n  /** 内部：POST /manage_permission。body={action,pkg,perm?,op?,mode?}。返回解析响应对象；失败 null。 */\n  _manage: function(action, pkg, perm, op, mode) {\n    let body = { action: action, pkg: pkg };\n    if (perm) body.perm = perm;\n    if (op) body.op = op;\n    if (mode) body.mode = mode;\n    return this._parse(this._httpPost('/manage_permission', body));\n  },\n\n  /** 授予某包运行时权限（pm grant）。perm=权限全名如 'android.permission.READ_CONTACTS'。返回 {success,channel,code,stdout,stderr,message}；失败 null。 */\n  grantPermission: function(pkg, perm) {\n    return this._manage('grant', pkg, perm, null, null);\n  },\n\n  /** 吊销某包运行时权限（pm revoke）。返回同上结构。 */\n  revokePermission: function(pkg, perm) {\n    return this._manage('revoke', pkg, perm, null, null);\n  },\n\n  /** 设置某包某 AppOps 模式（appops set）。op=AppOps 名如 'READ_CONTACTS'；mode∈allow|ignore|deny|default。返回同上结构。 */\n  setAppOp: function(pkg, op, mode) {\n    return this._manage('set_appop', pkg, op, null, mode);\n  },\n\n  /** 读取某包某 AppOps 当前模式（appops get）。op=AppOps 名。返回解析对象并额外补 .mode 字段；失败 null。 */\n  getAppOp: function(pkg, op) {\n    let r = this._manage('get_appop', pkg, null, op, null);\n    if (r && r.stdout) {\n      // stdout ≈ \"READ_CONTACTS: allow\" 或 \"Uid mode: READ_CONTACTS: allow\"\n      let idx = r.stdout.lastIndexOf(':');\n      if (idx > 0) r.mode = r.stdout.substring(idx + 1).split(';')[0].trim();\n    }\n    return r;\n  },\n\n  /**\n   * 统一 AppOps 读写入口（对应 /manage_permission）：\n   *   appOps(pkg, op)        → 读当前模式（等价 getAppOp，返回对象含 .mode）\n   *   appOps(pkg, op, mode)  → 设模式（等价 setAppOp，mode∈allow|ignore|deny|default）\n   * @returns {object|null} /manage_permission 响应（success/channel/code/stdout/stderr/message；getter 多一个 .mode）\n   */\n  appOps: function(pkg, op, mode) {\n    if (mode === undefined || mode === null || mode === '') return this.getAppOp(pkg, op);\n    return this.setAppOp(pkg, op, mode);\n  }\n};\n\n// ==================== 初始化并导出 ====================\n// 只用单个模型: OcrSdk.init()\n// 多模型常驻(简写精度):   OcrSdk.init({ models: ['tiny', 'small', 'medium,low'] })\nOcrSdk.init();  // 写入字段到 OcrSdk 自身\n\n// 导出为自动精灵「全局变量」（与 ocr 原导出方式一致），后续步骤/变量面板均可访问。\nzdjl.setVar(\"ocr\", OcrSdk, \"global\");\n\n// ==================== 简洁调用：按OCR行原样返回 ====================\nfunction OcrTextOnly(area, modelName) {\n  try {\n    var r = OcrSdk.ocr(area, {model: modelName || \"small\", type: \"high\"});\n    if (!r || !r.data) return \"\";\n    var arr = [];\n    for (var i = 0; i < r.data.length; i++) {\n      if (r.data[i] && r.data[i].text) arr.push(String(r.data[i].text).trim());\n    }\n    return arr.join(\"\\r\\n\").trim();\n  } catch (e) {\n    return \"\";\n  }\n}\nzdjl.setVar(\"ocrText\", OcrTextOnly, \"global\");","condition":{"type":"jsExpression","expression":"typeof ocr==\"undefined\" || typeof ocrText!=\"function\"","desc":"全局OCR对象不存在时才初始化"}}
{"type":"打开链接","delayUnit":1,"condition":{"type":"jsExpression","expression":"typeof ocr!=\"undefined\" && ocr.ping()==false","desc":"SGOCR未运行时才启动"},"desc":"总控启动时检查一次SGOCR；离线才广播启动","link":"intent:#Intent;action=com.sgocr.ncnn.action.START_SERVICE;component=com.sgocr.ncnn/.OcrServiceStartReceiver;end","openAsSystemBroadcast":true}
{"type":"设置变量","delay":"0","delayUnit":1,"desc":"固定OCR区域：每次总控启动设置一次","vars":[{"name":"植物状态","value":{"varType":"screen_area","varScope":"global","showInputInObjectSubVar":false,"mustInput":false,"showInputContentAlign":"left","screenArea":"2.1% 0% 35% 47.6%","showInput":false}},{"name":"每日任务","value":{"varType":"screen_area","varScope":"global","showInputInObjectSubVar":false,"mustInput":false,"showInputContentAlign":"left","screenArea":"19.9% 63.2% 56.9% 73.2%","showInput":false}},{"name":"等级经钱","value":{"varType":"screen_area","varScope":"global","showInputInObjectSubVar":false,"mustInput":false,"showInputContentAlign":"left","screenArea":"50.8% 3.9% 89.3% 22.3%","showInput":false}}]}

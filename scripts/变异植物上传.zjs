{"repeatCount":-1,"pauseOnFail":false,"count":1,"minVerCode":2020000,"minVerName":"2.20.0","screenWidth":720,"screenHeight":1280,"screenDpi":2,"lastSaveScreenWidth":1280,"lastSaveScreenHeight":720,"lastSaveScreenDpi":2,"savedVerCode":26000050,"savedVerName":"26.5.0","delay":"0","delayUnit":1,"description":"变异植物上传｜真实自己农场OCR归属｜无效区号保护｜统一记录+专项记录+待上传队列"}
{"type":"运行JS代码","delay":"0","delayUnit":1,"repeatCount":1,"desc":"变异汇总｜保留OCR身份及区数保护、原格式；改用统一稳健续传日志","jsCode":"var FARM_API=\"http://38.207.187.183:8787/api/farm-records\";\nvar FARM_TOKEN=\"1f217af4efb810576fec17e1c974f9436f84e72b6cfdbb5120a75a2bdcb0cd43\";\nvar FARM_TXT=\"/sdcard/Download/农场记录.txt\";\nvar FARM_QUEUE=\"/sdcard/Download/农场待上传.jsonl\";\nvar MUT_TXT=\"/sdcard/Download/变异植物记录.txt\";\nvar TIMEOUT=5000;\nvar BATCH=20;\n\nfunction G(k,d){\n    try{\n        var v=zdjl.getVar(k,\"global\");\n        return (v===undefined || v===null || v===\"\") ? d : v;\n    }catch(e){return d;}\n}\nfunction P(n){return (\"0\"+n).slice(-2);}\n\nvar d=new Date();\nvar time=d.getFullYear()+\"-\"+P(d.getMonth()+1)+\"-\"+P(d.getDate())+\" \"+P(d.getHours())+\":\"+P(d.getMinutes())+\":\"+P(d.getSeconds());\n\n// 软件账号归属只看脚本OCR得到的原始文字。脚本不生成账号名/身份键，也不使用HUD名称猜测。\nvar farmOcr=String(G(\"自己农场OCR原文\",\"\")).replace(/\\r\\n?/g,\"\\n\").trim();\n\nvar area=Number(G(\"当前区\",0))||0;\nvar total=Number(G(\"总数区\",0))||0;\nvar cnt=Number(G(\"变异本区数量\",0))||0;\nvar details=String(G(\"变异本区记录\",\"\")).trim();\n\n// 只保留可直接验证的数据检查：有效农场名与当前账号配置区数。\n// 切号脚本已经清空上一账号的OCR缓存，收割脚本负责在新账号重新读取。\n// HUD启动时间、身份锁运行标记只是缓存优化，不能成为上传资格的硬条件。\n// 账号区数读取总控已加载的 账号1区数~账号8区数，不硬编码昵称/区数。\nvar __slot=Number(G(\"当前第几个号\",0))||0;\nvar __configured=(__slot>=1&&__slot<=8)?Number(G(\"账号\"+__slot+\"区数\",0))||0:0;\nvar __identityText=farmOcr.replace(/\\s+/g,\"\");\nvar __identityOk=/[^\\s]{1,35}的农场/.test(__identityText);\nvar __issues=[];\nif(!__identityOk) __issues.push(\"当前农场OCR未识别出完整农场名\");\nif(__slot>=1&&__slot<=8){\n    if(!__configured) __issues.push(\"当前账号配置区数缺失\");\n    else if(total!==__configured) __issues.push(\"实际总区数\"+total+\"与当前账号配置区数\"+__configured+\"不符\");\n}\nif(__issues.length){\n    var __invalid=[\n        \"===== 变异记录待确认（没有上传） =====\",\n        \"时间：\"+time,\"原因：\"+__issues.join(\"；\"),\n        \"执行账号序号：\"+__slot,\"执行账号配置区数：\"+__configured,\n        \"扫描区：\"+area+\"/\"+total,\n        \"【自己农场OCR】\",farmOcr||\"未识别\",\"数量：\"+cnt,\n        \"明细：\",details||\"无\",\"==============================\",\"\"\n    ].join(\"\\r\\n\");\n    try{zdjl.appendFile(\"/sdcard/Download/变异归属隔离.txt\",__invalid);}catch(e){}\n    try{zdjl.appendFile(MUT_TXT,\"[拒绝上传：身份或区数冲突] \"+time+\" | \"+__issues.join(\"；\")+\"\\r\\n\");}catch(e){}\n    try{zdjl.toast(\"变异归属异常｜已隔离，不上传\",2000);}catch(e){}\n    return;\n}\n\n\n// 无效区号只写专项调试记录，不进入统一农场记录，也不上云。\n// 例如手动测试子脚本时遗留的 11/10。\nif(area<1 || total<1 || area>total){\n    var bad=\"[变异汇总跳过正式上传] \"+time+\"｜区号=\"+area+\"/\"+total+\"｜数量=\"+cnt+\"\\r\\n\";\n    try{zdjl.appendFile(MUT_TXT,bad);}catch(e){}\n    try{zdjl.toast(\"变异记录区号无效 \"+area+\"/\"+total+\"｜未上传\",1800);}catch(e){}\n    return;\n}\n\nvar record=\n    \"===== 变异植物汇总 =====\\r\\n\"+\n    \"记录类型：变异植物汇总\\r\\n\"+\n    \"记录时间：\"+time+\"\\r\\n\"+\n    \"【自己农场OCR】\\r\\n\"+(farmOcr||\"未识别\")+\"\\r\\n\\r\\n\"+\n    \"区：\"+area+\"/\"+total+\"\\r\\n\"+\n    \"数量：\"+cnt+\"\\r\\n\"+\n    \"明细：\\r\\n\"+(details||\"无\")+\"\\r\\n\"+\n    \"==============================\\r\\n\\r\\n\";\n\n// 主数据源统一进入农场记录；变异专用TXT只保留调试备份。\ntry{zdjl.appendFile(FARM_TXT,record);}catch(e){}\ntry{zdjl.appendFile(MUT_TXT,record);}catch(e){}\ntry{zdjl.appendFile(FARM_QUEUE,JSON.stringify({record:record})+\"\\n\");}catch(e){}\n\n// ===== 共享队列稳健续传：兼容旧格式 {\"record\":\"...\"}，不改变服务器接口 =====\n(function(){\n  var Q=FARM_QUEUE, API=FARM_API, KEY=FARM_TOKEN;\n  var LOG=\"/sdcard/Download/农场上传日志.txt\";\n  var BAD=\"/sdcard/Download/农场待上传_无效隔离.jsonl\";\n  var FROM=\"变异收割上传\", LIMIT=50, BUDGET=12000;\n  var began=Date.now(), attempts=0, sent=0, isolated=0, reason=\"\", http=0;\n  function note(s){try{zdjl.appendFile(LOG,new Date().toISOString()+\" [\"+FROM+\"] \"+s+\"\\r\\n\");}catch(e){}}\n  function isolate(raw, why){\n    // 只有确认成功备份到隔离文件后才从主队列移除，避免坏数据被静默丢弃。\n    try{zdjl.appendFile(BAD,JSON.stringify({time:new Date().toISOString(),source:FROM,error:why,line:raw})+\"\\n\");isolated++;return true;}\n    catch(e){reason=\"隔离文件写入失败:\"+String(e);return false;}\n  }\n  try{\n    var snapshot=String(zdjl.readFile(Q)||\"\");\n    if(!snapshot)return;\n    var rawLines=snapshot.split(/\\r?\\n/), pending=[];\n    for(var i=0;i<rawLines.length;i++)if(rawLines[i])pending.push(rawLines[i]);\n    if(!pending.length)return;\n    var keep=[], stopped=false, changed=false;\n    for(var j=0;j<pending.length;j++){\n      var raw=pending[j];\n      if(stopped || attempts>=LIMIT || Date.now()-began>=BUDGET){keep.push(raw);continue;}\n      attempts++;\n      var item=null;\n      try{item=JSON.parse(raw);if(!item||typeof item.record!==\"string\"||!item.record.length)throw new Error(\"record字段无效\");}\n      catch(badJson){\n        if(isolate(raw,\"JSON格式错误:\"+String(badJson))){changed=true;continue;}\n        keep.push(raw);stopped=true;continue;\n      }\n      var rsp=null;\n      try{\n        rsp=zdjl.requestUrl({url:API,method:\"POST\",timeout:6000,\n          headers:[{\"Content-Type\":\"application/json\"},{\"X-Farm-Token\":KEY}],\n          requestBody:JSON.stringify({record:item.record}),requestType:\"TEXT\",responseType:\"TEXT\"});\n      }catch(reqErr){reason=\"网络请求异常:\"+String(reqErr);keep.push(raw);stopped=true;continue;}\n      http=rsp?Number(rsp.code)||0:0;\n      var obj=null;\n      try{obj=JSON.parse((rsp&&rsp.body)||\"\");}catch(parseRsp){}\n      if(http>=200&&http<300&&obj&&obj.ok===true){sent++;changed=true;continue;}\n      // 400/413/422 仅隔离+完整保留原文，防止一条永远无效的数据堵住全部队列。\n      if(http===400||http===413||http===422){\n        if(isolate(raw,\"HTTP \"+http+\" \"+String((obj&&obj.error)||\"服务器拒收\"))){changed=true;continue;}\n        keep.push(raw);stopped=true;continue;\n      }\n      reason=\"HTTP \"+http+(obj&&obj.error?\" \"+String(obj.error):\" 或响应缺少ok=true\");\n      keep.push(raw);stopped=true;\n    }\n    if(changed){\n      // 在覆盖队列前再次读取，保留本次HTTP发送期间其他动作新追加的尾部。\n      var live=String(zdjl.readFile(Q)||\"\");\n      if(live.substr(0,snapshot.length)!==snapshot){\n        // 其他上传动作改写过队列：放弃覆盖，宁可下轮重复，也不冒险丢数据。\n        note(\"队列被其他动作改写，取消本轮清理；可能重复补传 已发送=\"+sent+\" 隔离=\"+isolated);\n        return;\n      }\n      var tail=live.substr(snapshot.length);\n      var remain=keep.join(\"\\n\")+(keep.length?\"\\n\":\"\");\n      zdjl.writeFile(Q,remain+tail);\n    }\n    if(reason||isolated||sent>0){\n      note(\"尝试=\"+attempts+\" 成功=\"+sent+\" 隔离=\"+isolated+\" 剩余至少=\"+keep.length+\" 状态=\"+(reason||\"完成\")+\" HTTP=\"+http);\n    }\n  }catch(allErr){note(\"队列处理异常:\"+String(allErr)+\" 已发送=\"+sent+\"；原始队列保留，可能重复补传\");}\n})();\n"}

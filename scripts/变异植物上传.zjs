{"repeatCount":-1,"pauseOnFail":false,"count":1,"minVerCode":2020000,"minVerName":"2.20.0","screenWidth":720,"screenHeight":1280,"screenDpi":2,"lastSaveScreenWidth":1280,"lastSaveScreenHeight":720,"lastSaveScreenDpi":2,"savedVerCode":26000050,"savedVerName":"26.5.0","delay":"0","delayUnit":1,"description":"变异植物上传｜真实自己农场OCR归属｜无效区号保护｜统一记录+专项记录+待上传队列"}
{"type":"运行JS代码","delay":"0","delayUnit":1,"repeatCount":1,"desc":"统一农场记录TXT + 共用待传队列 + 自己农场OCR原文上传","jsCode":"var FARM_API=\"http://38.207.187.183:8787/api/farm-records\";\nvar FARM_TOKEN=\"1f217af4efb810576fec17e1c974f9436f84e72b6cfdbb5120a75a2bdcb0cd43\";\nvar FARM_TXT=\"/sdcard/Download/农场记录.txt\";\nvar FARM_QUEUE=\"/sdcard/Download/农场待上传.jsonl\";\nvar MUT_TXT=\"/sdcard/Download/变异植物记录.txt\";\nvar TIMEOUT=5000;\nvar BATCH=20;\n\nfunction G(k,d){\n    try{\n        var v=zdjl.getVar(k,\"global\");\n        return (v===undefined || v===null || v===\"\") ? d : v;\n    }catch(e){return d;}\n}\nfunction P(n){return (\"0\"+n).slice(-2);}\n\nvar d=new Date();\nvar time=d.getFullYear()+\"-\"+P(d.getMonth()+1)+\"-\"+P(d.getDate())+\" \"+P(d.getHours())+\":\"+P(d.getMinutes())+\":\"+P(d.getSeconds());\n\n// 软件账号归属只看脚本OCR得到的原始文字。脚本不生成账号名/身份键，也不使用HUD名称猜测。\nvar farmOcr=String(G(\"自己农场OCR原文\",\"\")).replace(/\\r\\n?/g,\"\\n\").trim();\n\nvar area=Number(G(\"当前区\",0))||0;\nvar total=Number(G(\"总数区\",0))||0;\nvar cnt=Number(G(\"变异本区数量\",0))||0;\nvar details=String(G(\"变异本区记录\",\"\")).trim();\n\n// 无效区号只写专项调试记录，不进入统一农场记录，也不上云。\n// 例如手动测试子脚本时遗留的 11/10。\nif(area<1 || total<1 || area>total){\n    var bad=\"[变异汇总跳过正式上传] \"+time+\"｜区号=\"+area+\"/\"+total+\"｜数量=\"+cnt+\"\\r\\n\";\n    try{zdjl.appendFile(MUT_TXT,bad);}catch(e){}\n    try{zdjl.toast(\"变异记录区号无效 \"+area+\"/\"+total+\"｜未上传\",1800);}catch(e){}\n    return;\n}\n\nvar record=\n    \"===== 变异植物汇总 =====\\r\\n\"+\n    \"记录类型：变异植物汇总\\r\\n\"+\n    \"记录时间：\"+time+\"\\r\\n\"+\n    \"【自己农场OCR】\\r\\n\"+(farmOcr||\"未识别\")+\"\\r\\n\\r\\n\"+\n    \"区：\"+area+\"/\"+total+\"\\r\\n\"+\n    \"数量：\"+cnt+\"\\r\\n\"+\n    \"明细：\\r\\n\"+(details||\"无\")+\"\\r\\n\"+\n    \"==============================\\r\\n\\r\\n\";\n\n// 主数据源统一进入农场记录；变异专用TXT只保留调试备份。\ntry{zdjl.appendFile(FARM_TXT,record);}catch(e){}\ntry{zdjl.appendFile(MUT_TXT,record);}catch(e){}\ntry{zdjl.appendFile(FARM_QUEUE,JSON.stringify({record:record})+\"\\n\");}catch(e){}\n\ntry{\n    var lines=String(zdjl.readFile(FARM_QUEUE)||\"\").split(/\\r?\\n/);\n    var pending=[];\n    for(var i=0;i<lines.length;i++) if(lines[i]) pending.push(lines[i]);\n\n    var done=0;\n    while(done<pending.length && done<BATCH){\n        var item;\n        try{ item=JSON.parse(pending[done]); }\n        catch(e){ done++; continue; }\n\n        var resp;\n        try{\n            resp=zdjl.requestUrl({\n                url:FARM_API,\n                method:\"POST\",\n                timeout:TIMEOUT,\n                headers:[\n                    {\"Content-Type\":\"application/json\"},\n                    {\"X-Farm-Token\":FARM_TOKEN}\n                ],\n                requestBody:JSON.stringify({record:item.record}),\n                requestType:\"TEXT\",\n                responseType:\"TEXT\"\n            });\n        }catch(e){ break; }\n\n        if(!resp || resp.code!==200) break;\n        var ok=false;\n        try{ok=!!JSON.parse(resp.body||\"{}\").ok;}catch(e){ok=false;}\n        if(!ok) break;\n        done++;\n    }\n\n    if(done){\n        var remain=pending.slice(done).join(\"\\n\");\n        zdjl.writeFile(FARM_QUEUE,remain+(remain?\"\\n\":\"\"));\n    }\n}catch(e){}"}

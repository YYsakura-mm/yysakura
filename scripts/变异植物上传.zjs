{"repeatCount":-1,"pauseOnFail":false,"count":1,"minVerCode":2020000,"minVerName":"2.20.0","screenWidth":720,"screenHeight":1280,"screenDpi":2,"lastSaveScreenWidth":1280,"lastSaveScreenHeight":720,"lastSaveScreenDpi":2,"savedVerCode":26000050,"savedVerName":"26.5.0","delay":"0","delayUnit":1,"description":"变异植物上传｜每区24格结束上传一次文字汇总｜0条也上传清旧状态"}
{"type":"运行JS代码","delay":"0","delayUnit":1,"repeatCount":1,"desc":"本地保存文字 + 共用待传队列 + 尝试上传","jsCode":"var FARM_API=\"http://38.207.187.183:8787/api/farm-records\";\nvar FARM_TOKEN=\"1f217af4efb810576fec17e1c974f9436f84e72b6cfdbb5120a75a2bdcb0cd43\";\nvar FARM_QUEUE=\"/sdcard/Download/农场待上传.jsonl\";\nvar MUT_TXT=\"/sdcard/Download/变异植物记录.txt\";\nvar TIMEOUT=5000;\nvar BATCH=20;\n\nfunction G(k,d){\n    try{\n        var v=zdjl.getVar(k,\"global\");\n        return (v===undefined || v===null || v===\"\") ? d : v;\n    }catch(e){return d;}\n}\nfunction P(n){return (\"0\"+n).slice(-2);}\n\nvar d=new Date();\nvar time=d.getFullYear()+\"-\"+P(d.getMonth()+1)+\"-\"+P(d.getDate())+\" \"+P(d.getHours())+\":\"+P(d.getMinutes())+\":\"+P(d.getSeconds());\n\nvar account=String(G(\"HUD当前账号\",\"\")).trim();\nif(!account || account==\"?\") account=String(G(\"临时账号名称\",\"\")).trim();\nif(!account){\n    var idx=Number(G(\"当前第几个号\",0))||0;\n    account=idx>0 ? (\"账号\"+idx) : \"当前账号\";\n}\n\nvar area=Number(G(\"当前区\",0))||0;\nvar total=Number(G(\"总数区\",0))||0;\nvar cnt=Number(G(\"变异本区数量\",0))||0;\nvar details=String(G(\"变异本区记录\",\"\")).trim();\n\nvar record=\n    \"===== 变异植物汇总 =====\\r\\n\"+\n    \"记录类型：变异植物汇总\\r\\n\"+\n    \"记录时间：\"+time+\"\\r\\n\"+\n    \"账号：\"+account+\"\\r\\n\"+\n    \"区：\"+area+\"/\"+total+\"\\r\\n\"+\n    \"数量：\"+cnt+\"\\r\\n\"+\n    \"明细：\\r\\n\"+(details||\"无\")+\"\\r\\n\"+\n    \"==============================\\r\\n\\r\\n\";\n\ntry{zdjl.appendFile(MUT_TXT,record);}catch(e){}\ntry{zdjl.appendFile(FARM_QUEUE,JSON.stringify({record:record})+\"\\n\");}catch(e){}\n\n/* 复用现有农场记录待传队列。 */\ntry{\n    var lines=String(zdjl.readFile(FARM_QUEUE)||\"\").split(/\\r?\\n/);\n    var pending=[];\n    for(var i=0;i<lines.length;i++) if(lines[i]) pending.push(lines[i]);\n\n    var done=0;\n    while(done<pending.length && done<BATCH){\n        var item;\n        try{\n            item=JSON.parse(pending[done]);\n        }catch(e){\n            done++;\n            continue;\n        }\n\n        var resp;\n        try{\n            resp=zdjl.requestUrl({\n                url:FARM_API,\n                method:\"POST\",\n                timeout:TIMEOUT,\n                headers:[\n                    {\"Content-Type\":\"application/json\"},\n                    {\"X-Farm-Token\":FARM_TOKEN}\n                ],\n                requestBody:JSON.stringify({record:item.record}),\n                requestType:\"TEXT\",\n                responseType:\"TEXT\"\n            });\n        }catch(e){\n            break;\n        }\n\n        if(!resp || resp.code!==200) break;\n\n        var ok=false;\n        try{ok=!!JSON.parse(resp.body||\"{}\").ok;}catch(e){ok=false;}\n        if(!ok) break;\n        done++;\n    }\n\n    if(done){\n        var remain=pending.slice(done).join(\"\\n\");\n        zdjl.writeFile(FARM_QUEUE,remain+(remain?\"\\n\":\"\"));\n    }\n}catch(e){}"}

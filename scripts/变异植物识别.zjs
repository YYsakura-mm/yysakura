{"type":"设置变量","delay":"0","delayUnit":1,"desc":"蓝紫找色98%｜新增植物名称区域+完整左侧卡片OCR","vars":[{"name":"蓝色判定","value":{"varType":"script_condition","varScope":"script","showInput":false,"mustInput":false,"condition":{"type":"colorFound","runWhenFalse":false,"checkBeforeDelay":true,"repeatWhenFalse":false,"desc":"蓝色变异｜只在指定范围内找色｜98%","colorData":{"type":"color","x":"6.3%","y":"47.5%","color":"#4cb2f9","limitArea":"2.6% 46.6% 16.2% 50.3%","similarPercent":98}}}},{"name":"紫色判定","value":{"varType":"script_condition","varScope":"script","showInput":false,"mustInput":false,"condition":{"type":"colorFound","runWhenFalse":false,"checkBeforeDelay":true,"repeatWhenFalse":false,"desc":"紫色变异｜只在指定范围内找色｜98%","colorData":{"type":"color","x":"6.2%","y":"47.4%","color":"#b673ea","limitArea":"2.6% 46.6% 16.2% 50.3%","similarPercent":98}}}},{"name":"变异信息区域","value":{"varType":"screen_area","varScope":"script","showInput":false,"mustInput":false,"showInputInObjectSubVar":false,"showInputContentAlign":"left","screenArea":"2.7% 37.4% 33.5% 49.2%"}},{"name":"植物名称区域","value":{"varType":"screen_area","varScope":"script","showInput":false,"mustInput":false,"showInputInObjectSubVar":false,"showInputContentAlign":"left","screenArea":"7.0% 15.0% 16.2% 24.0%"}},{"name":"植物卡片区域","value":{"varType":"screen_area","varScope":"script","showInput":false,"mustInput":false,"showInputInObjectSubVar":false,"showInputContentAlign":"left","screenArea":"2.0% 14.5% 17.2% 50.8%"}}]}
{"type":"执行脚本","delay":"0","delayUnit":1,"repeatCount":1,"condition":{"type":"jsExpression","expression":"(function(){try{return typeof zdjl.getVar(\"ocrText\",\"global\")!=\"function\";}catch(e){return true;}})()","checkBeforeDelay":true,"repeatWhenFalse":false,"desc":"仅在全局OCR函数尚未初始化时补调用"},"desc":"OCR函数缺失时补初始化（从global变量明确检查）","filePath":"初始化OCR.zjs","runArgs":"","continueCurrentAfterFinish":true,"useCurrentGestureMatrix":false}
{"type":"运行JS代码","delay":"0","delayUnit":1,"repeatCount":1,"desc":"金色详细识别：植物名称 + 完整卡片OCR + 金蓝紫词条 + 成熟/剩余，并加入TXT汇总","jsCode":"function G(k,d){\n    try{\n        var v=zdjl.getVar(k,\"global\");\n        return (v===undefined || v===null || v===\"\") ? d : v;\n    }catch(e){ return d; }\n}\nfunction S(k,v){ try{ zdjl.setVar(k,v,\"global\"); }catch(e){} }\n\n// 金色刚命中后只等待极短时间，让植物状态卡文字稳定；仅金色格产生这点延迟。\ntry{ zdjl.sleep(200); }catch(__waitErr){}\n\n// 蓝、紫完全独立判断，因此正式存在四种：金 / 金蓝 / 金紫 / 金蓝紫。\nvar hasBlue=false;\nvar hasPurple=false;\ntry{ hasBlue=!!zdjl.check(蓝色判定); }catch(e){ hasBlue=false; }\ntry{ hasPurple=!!zdjl.check(紫色判定); }catch(e){ hasPurple=false; }\n\nvar level=\"金色\";\nif(hasBlue && hasPurple) level=\"金色+蓝色+紫色\";\nelse if(hasBlue) level=\"金色+蓝色\";\nelse if(hasPurple) level=\"金色+紫色\";\n\n// 金色本身固定算1个词条；蓝、紫各自命中再+1。脚本直接把判断结果写成文字，不让软件二次猜测。\nvar entryCount=1+(hasBlue?1:0)+(hasPurple?1:0);\nvar blueText=hasBlue?\"是\":\"否\";\nvar purpleText=hasPurple?\"是\":\"否\";\n\n// 明确从global变量取得OCR函数，不依赖脚本引擎是否把变量自动注入成同名JS符号。\nvar ocrFn=null;\ntry{ ocrFn=zdjl.getVar(\"ocrText\",\"global\"); }catch(__getOcrErr){ ocrFn=null; }\nfunction normOcr(v){\n    return String(v==null?\"\":v).replace(/\\r\\n?/g,\"\\n\").trim();\n}\nfunction oneLine(v){\n    return normOcr(v)\n        .replace(/\\|/g,\"／\")\n        .replace(/\\n+/g,\" / \")\n        .replace(/\\s+/g,\" \")\n        .trim();\n}\nfunction pickPlantName(v){\n    var src=normOcr(v);\n    if(!src) return \"未识别\";\n\n    // 名称区域里通常只有“樱桃 6”一类内容。\n    // 不使用固定植物名单，避免以后新增植物时又要改代码。\n    var banned={\n        \"变异\":1,\"可收获\":1,\"已成熟\":1,\"巨大化\":1,\"育玉\":1,\"幽蓝\":1,\n        \"收益\":1,\"提升\":1,\"成熟\":1,\"浇水\":1,\"祝福\":1,\"园艺\":1\n    };\n    var lines=src.split(/\\n+/);\n    for(var i=0;i<lines.length;i++){\n        var ms=String(lines[i]||\"\").match(/[\\u4e00-\\u9fff]{2,8}/g);\n        if(!ms) continue;\n        for(var j=0;j<ms.length;j++){\n            var x=ms[j];\n            if(banned[x]) continue;\n            if(x.indexOf(\"可收获\")>=0 || x.indexOf(\"变异\")>=0 || x.indexOf(\"成熟\")>=0) continue;\n            return x;\n        }\n    }\n    return \"未识别\";\n}\n\nvar nameRaw=\"\", cardRaw=\"\", raw=\"\";\ntry{\n    if(typeof ocrFn==\"function\"){\n        nameRaw=String(ocrFn(植物名称区域,\"medium\")||\"\");\n        cardRaw=String(ocrFn(植物卡片区域,\"medium\")||\"\");\n        raw=String(ocrFn(变异信息区域,\"medium\")||\"\");\n    }\n}catch(e){\n    nameRaw=\"\"; cardRaw=\"\"; raw=\"\";\n}\nnameRaw=normOcr(nameRaw);\ncardRaw=normOcr(cardRaw);\nraw=normOcr(raw);\n\nvar plantName=pickPlantName(nameRaw);\n// 名称小区域偶尔漏字时，用整张植物卡再兜底一次。\nif(plantName===\"未识别\") plantName=pickPlantName(cardRaw);\nvar cardText=oneLine(cardRaw);\n\n// 状态优先识别“已成熟”，其次识别“XX后成熟”，最后保留任意含“成熟”的原始行。\nvar status=\"未识别\";\nvar futureStatus=\"\";\nvar otherMatureStatus=\"\";\nvar harvestStatus=\"\";\nvar statusRaw=(raw+\"\\n\"+cardRaw).trim();\nvar lines=statusRaw ? statusRaw.split(/\\n+/) : [];\nfor(var i=0;i<lines.length;i++){\n    var line=String(lines[i]||\"\").replace(/\\s+/g,\" \").trim();\n    if(!line) continue;\n    if(line.indexOf(\"已成熟\")>=0){\n        status=line;\n        break;\n    }\n    if(!harvestStatus && line.indexOf(\"可收获\")>=0) harvestStatus=line;\n    if(!futureStatus && line.indexOf(\"后成熟\")>=0) futureStatus=line;\n    if(!otherMatureStatus && line.indexOf(\"成熟\")>=0) otherMatureStatus=line;\n}\nif(status===\"未识别\"){\n    if(harvestStatus) status=harvestStatus;\n    else if(futureStatus) status=futureStatus;\n    else if(otherMatureStatus) status=otherMatureStatus;\n}\n\n// 成熟后的剩余量通常为 230/240、80/100 等。\n// 只接受分母>10的整数比值，明确排除0/3、1/3、2/3、3/3祝福次数。\nvar remain=\"-\";\nvar ratioRe=/(\\d{1,4})\\s*\\/\\s*(\\d{1,4})/g;\nvar m;\nvar ratioRaw=(raw+\"\\n\"+cardRaw);\nwhile((m=ratioRe.exec(ratioRaw))!==null){\n    var numerator=Number(m[1]);\n    var denominator=Number(m[2]);\n    if(denominator>10 && numerator>=0 && numerator<=denominator){\n        remain=numerator+\"/\"+denominator;\n        break;\n    }\n}\n\nvar scan=Number(G(\"收割扫描序号\",0))||0;\nvar detail=\n    \"扫描位=\"+scan+\n    \"|植物=\"+plantName+\n    \"|变异=\"+level+\n    \"|词条数=\"+entryCount+\n    \"|蓝色=\"+blueText+\n    \"|紫色=\"+purpleText+\n    \"|状态=\"+status+\n    \"|剩余=\"+remain+\n    \"|名称OCR=\"+(oneLine(nameRaw)||\"-\")+\n    \"|卡片OCR=\"+(cardText||\"-\");\n\nvar old=String(G(\"变异本区记录\",\"\")).trim();\nvar cnt=Number(G(\"变异本区数量\",0))||0;\nS(\"变异本区记录\", old ? (old+\"\\n\"+detail) : detail);\nS(\"变异本区数量\", cnt+1);"}

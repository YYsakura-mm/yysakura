{"type":"运行JS代码","delay":"0","delayUnit":1,"desc":"读取启动取证，生成独立报告","jsCode":"(function(){var z=zdjl,raw=String(z.readFile('/sdcard/Download/总控_启动来源取证.jsonl')||''),lines=raw.split(/\\r?\\n/),rows=[],bad=0;for(var i=0;i<lines.length;i++){if(!lines[i])continue;try{rows.push(JSON.parse(lines[i]));}catch(e){bad++;}}var text=['启动来源取证汇总','有效事件='+rows.length+'；解析失败='+bad,'以下按文件顺序列出关键事件；时间重叠不等于多引擎并发。'];var found=0;for(var i=0;i<rows.length;i++){var x=rows[i];if(x.event==='ENGINE_BOOT'||x.event.indexOf('PROGRESS_WRITE_')===0||(x.event==='ACTION_ENTER'&&x.source.indexOf('/vars/5/')>=0)){var before=x.file||{};text.push(new Date(x.t).toISOString()+' '+x.event+' source='+x.source+' boot='+x.boot+' sid='+x.sid+' local='+x.localRun+' global='+x.globalRun+' file='+before.run+' order='+JSON.stringify(before.order)+' phase='+before.phase+' status='+before.status+' intent='+x.intent);found++;}}if(!found)text.push('没有关键事件，检查是否运行了取证增强版。');text.push('完整证据仍在总控_启动来源取证.jsonl。不要仅凭汇总认定人为点击或异常停止。');z.writeFile('/sdcard/Download/总控_启动来源诊断.txt',text.join('\\n'));})();"}

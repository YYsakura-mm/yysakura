{"type":"运行JS代码","delay":"0","delayUnit":1,"repeatCount":1,"desc":"保存巡田24格金色数量/成熟/剩余，附加到TXT及断网待传队列","jsCode":"(function(){\n var BASE=\"/sdcard/Download/\", SRC=\"巡田24格\", TXT=BASE+\"巡田扫描记录.txt\";\n var FARM_TXT=BASE+\"农场记录.txt\", Q=BASE+\"农场待上传.jsonl\";\n function G(n,d){try{var v=zdjl.getVar(n,\"global\");return v==null?d:v;}catch(e){return d;}}\n function P(n){return (\"0\"+n).slice(-2);}\n var d=new Date(),t=d.getFullYear()+\"-\"+P(d.getMonth()+1)+\"-\"+P(d.getDate())+\" \"+P(d.getHours())+\":\"+P(d.getMinutes())+\":\"+P(d.getSeconds());\n var seen=Number(G(\"收割扫描序号\",0))||0, gold=Number(G(\"变异本区数量\",0))||0;\n var detail=String(G(\"变异本区记录\",\"\")||\"\").trim();\n var farm=String(G(\"巡田农场OCR\",\"\")||\"\").replace(/\\r\\n?/g,\"\\n\").trim();\n var n=Number(G(\"当前区\",0))||0,total=Number(G(\"总数区\",0))||0;\n var started=Number(G(\"巡田开始时间\",0))||0,seconds=started?Math.max(0,Math.round((Date.now()-started)/1000)):0;\n var complete=seen===24, valid=gold>=0&&gold<=seen;\n var area=n>0&&total>=n?n+\"/\"+total:\"独立巡田（区号未绑定）\";\n var record=\"===== 变异植物汇总 =====\\r\\n\"+\n   \"记录类型：变异植物汇总\\r\\n\"+\n   \"扫描模式：纯巡田检测（未浇水、未收获）\\r\\n\"+\n   \"记录时间：\"+t+\"\\r\\n\"+\n   \"【自己农场OCR】\\r\\n\"+(farm||\"未识别\")+\"\\r\\n\\r\\n\"+\n   \"区：\"+area+\"\\r\\n\"+\n   \"扫描完成：\"+(complete&&valid?\"是\":\"否\")+\"\\r\\n\"+\n   \"扫描格数：\"+seen+\"/24\\r\\n\"+\n   \"金色数量：\"+gold+\"\\r\\n\"+\n   \"非金色格数：\"+Math.max(0,seen-gold)+\"\\r\\n\"+\n   \"耗时秒数：\"+seconds+\"\\r\\n\"+\n   \"数量：\"+gold+\"\\r\\n\"+\n   \"明细：\\r\\n\"+(detail||\"无金色植物\")+\"\\r\\n\"+\n   \"==============================\\r\\n\\r\\n\";\n try{zdjl.appendFile(TXT,record);}catch(e){}\n try{zdjl.appendFile(FARM_TXT,record);}catch(e){}\n // Existing server protocol: one JSON line with string field 'record'.\n // Do not discard incomplete/unknown-farm records: Windows can review raw OCR.\n var queued=false;\n try{zdjl.appendFile(Q,JSON.stringify({record:record})+\"\\n\");queued=true;}catch(e){}\n try{zdjl.setVar(\"巡田本轮结果\",(complete?\"完成\":\"未完成\")+\"｜\"+seen+\"/24｜金色\"+gold+\"｜耗时\"+seconds+\"秒｜\"+(queued?\"入队\":\"待传写入失败\"),\"global\");}catch(e){}\n try{zdjl.toast(\"巡田\"+(complete?\"完成\":\"未满24格\")+\"｜金色\"+gold+\"｜\"+seconds+\"秒｜\"+(queued?\"已存待传\":\"队列写入失败\"),3500);}catch(e){}\n})();"}
{"type":"执行脚本","delay":"0","delayUnit":1,"repeatCount":1,"desc":"完成巡田后独立补传积压记录（不操作游戏）","filePath":"农场补传.zjs","continueCurrentAfterFinish":true}

{"type":"运行JS代码","delay":"0","delayUnit":1,"repeatCount":1,"desc":"巡田初始化｜清空上一区统计并读取当前农场原文","jsCode":"(function(){\n function S(k,v){try{zdjl.setVar(k,v,\"global\");}catch(e){}}\n S(\"收割扫描序号\",0);S(\"变异本区数量\",0);S(\"变异本区记录\",\"\");S(\"收割60提示\",\"\");\n S(\"巡田模式\",\"只扫描不收割\");S(\"巡田开始时间\",new Date().getTime());\n S(\"巡田农场OCR\",\"\");\n try{var f=zdjl.getVar(\"ocrText\",\"global\"),a=zdjl.getVar(\"植物状态\",\"global\");\n     if(typeof f===\"function\"&&a) S(\"巡田农场OCR\",String(f(a,\"medium\")||\"\"));\n }catch(e){}\n})();"}

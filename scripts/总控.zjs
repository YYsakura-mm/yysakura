{"type":"运行JS代码","delay":"0","delayUnit":1,"desc":"当前区 + 1","jsCode":"当前区=当前区+1;\ntry{\n    zdjl.writeFile(\"\/sdcard\/Download\/农场8账号断点.txt\",\n        \"V5|\"+\"有效\"+\"|\"+当前第几个号+\"|\"+当前区+\"|\"+任务1+\"|\"+任务2+\"|\"+任务3+\"|\"+任务4+\"|\"+任务5+\"|\"+任务6+\"|\"+当前任务序号+\"|\"+账号序列+\"|\"+序列位置+\"|\"+总数区+\"|\"+(Number(浇祝间隔)||0)+\"|\"+(Number(任务4延迟)||0)+\"|\"+(Number(任务5延迟)||0)+\"|\"+(Number(任务6延迟)||0)+\"|\"+特殊模式\n    );\n}catch(e){}"}
{"type":"运行JS代码","delay":"0","delayUnit":1,"repeatCount":1,"desc":"区数成功+1后持久化进度","jsCode":"(function(){\n var P='\/sdcard\/Download\/双王者V3_进度.json';\n try{\n  var d=JSON.parse(String(zdjl.readFile(P)||'')),id=Number(zdjl.getVar('双王者当前端','global'));\n  if(d.schema!==3||d.runId!==String(zdjl.getVar('双王者运行ID','global'))||d.current!==id||d.status==='全部完成')return;\n  var s={client:id,zone:Number(当前区)||0,total:Number(总数区)||0,taskIndex:Number(当前任务序号)||0,task:String(做啥||''),account:Number(当前第几个号)||0,accountSeq:String(账号序列||''),sequencePos:Number(序列位置)||0,tempMode:String(临时模式||''),tempName:String(临时账号名称||''),time:Date.now()};\n  if(s.zone>0&&s.zone<=36&&s.taskIndex>0&&s.taskIndex<=6){d.snapshot=s;d.phaseStarted=true;}\n  var __realLabel=String(zdjl.getVar('双王者直接当前','global'))==='是'?'当前':'王者'+id;\n  d.status=__realLabel+' 执行中';d.updatedAt=Date.now();delete d.bindingTask;\n  zdjl.writeFile(P,JSON.stringify(d));\n  var hud=String(zdjl.getVar('HUD文本','global')||'');\n  if(hud){hud=hud.replace(\/^(?:王者[12]|当前)·\/,'');zdjl.setVar('HUD文本',__realLabel+'·'+hud,'global');}\n }catch(e){try{zdjl.appendFile('\/sdcard\/Download\/双王者V3_日志.txt','HEARTBEAT ERROR '+e+'\\r\\n');}catch(z){}}\n})();\n"}
{"type":"控制执行","delay":"0","delayUnit":1,"condition":{"type":"jsExpression","expression":"当前区<=总数区","desc":"还有下一地区时继续"},"desc":"还有下一地区：回到选区","controlRunType":"jumpTo","jumpToPosition":":循环入口","ContinueParentExecute":false}
{"type":"运行JS代码","delay":"0","delayUnit":1,"desc":"任务队列阶段切换：任务1→任务2→任务3→延迟→任务4→延迟→任务5→延迟→任务6","jumpId":"阶段收尾","jsCode":"阶段已切换=\"否\";\n阶段需等待=\"否\";\n阶段等待分钟=0;\n\nfunction __槽任务(i){\n    if(i==1) return String(任务1||\"无\");\n    if(i==2) return String(任务2||\"无\");\n    if(i==3) return String(任务3||\"无\");\n    if(i==4) return String(任务4||\"无\");\n    if(i==5) return String(任务5||\"无\");\n    if(i==6) return String(任务6||\"无\");\n    return \"无\";\n}\nfunction __任务转做啥(t){\n    if(t==\"浇水\") return \"只浇水\";\n    if(t==\"祝福\") return \"祝福\";\n    if(t==\"收割\") return \"收割\";\n    if(t==\"稳收24田\") return \"稳收24\";\n    if(t==\"巡田24田\") return \"巡田24\";\n    if(t==\"十田经济\") return \"十钱\";\n    if(t==\"1V1\") return \"打11\";\n    if(t==\"55\") return \"打55\";\n    return \"\";\n}\nfunction __下一任务(i){\n    for(var n=Number(i)+1;n<=6;n++) if(__槽任务(n)!=\"无\") return n;\n    return 0;\n}\nfunction __任务前延迟(i){\n    if(i==4) return Math.max(0,Number(任务4延迟)||0);\n    if(i==5) return Math.max(0,Number(任务5延迟)||0);\n    if(i==6) return Math.max(0,Number(任务6延迟)||0);\n    return 0;\n}\n\nif(当前区>总数区){\n    var __prev=__槽任务(当前任务序号);\n    var __nextIndex=__下一任务(当前任务序号);\n\n    if(__nextIndex>0){\n        var __next=__槽任务(__nextIndex);\n        var __wait=__任务前延迟(__nextIndex);\n\n        \/\/ 原有“浇水→祝福”间隔继续生效；若同时设置了4\/5\/6前延迟，取更长的那个，不重复等待。\n        if(__prev==\"浇水\" && __next==\"祝福\"){\n            __wait=Math.max(__wait,Math.max(0,Number(浇祝间隔)||0));\n        }\n        if(__wait>0){\n            阶段需等待=\"是\";\n            阶段等待分钟=__wait;\n        }\n\n        当前任务序号=__nextIndex;\n        做啥=__任务转做啥(__next);\n        阶段已切换=\"是\";\n        当前区=Math.max(1,Number(开始区)||1);\n        当前格=1;\n        需要回顶=\"是\";\n        还有账号=\"否\";\n        目标账号=0;\n\n        try{\n            zdjl.writeFile(\"\/sdcard\/Download\/农场8账号断点.txt\",\n                \"V5|\"+\"有效\"+\"|\"+当前第几个号+\"|\"+当前区+\"|\"+任务1+\"|\"+任务2+\"|\"+任务3+\"|\"+任务4+\"|\"+任务5+\"|\"+任务6+\"|\"+当前任务序号+\"|\"+账号序列+\"|\"+序列位置+\"|\"+总数区+\"|\"+(Number(浇祝间隔)||0)+\"|\"+(Number(任务4延迟)||0)+\"|\"+(Number(任务5延迟)||0)+\"|\"+(Number(任务6延迟)||0)+\"|\"+特殊模式\n            );\n        }catch(e){}\n    }\n}"}
{"type":"运行JS代码","delay":"0","delayUnit":1,"repeatCount":1,"desc":"任务阶段切换后持久化进度","jsCode":"(function(){\n var P='\/sdcard\/Download\/双王者V3_进度.json';\n try{\n  var d=JSON.parse(String(zdjl.readFile(P)||'')),id=Number(zdjl.getVar('双王者当前端','global'));\n  if(d.schema!==3||d.runId!==String(zdjl.getVar('双王者运行ID','global'))||d.current!==id||d.status==='全部完成')return;\n  var s={client:id,zone:Number(当前区)||0,total:Number(总数区)||0,taskIndex:Number(当前任务序号)||0,task:String(做啥||''),account:Number(当前第几个号)||0,accountSeq:String(账号序列||''),sequencePos:Number(序列位置)||0,tempMode:String(临时模式||''),tempName:String(临时账号名称||''),time:Date.now()};\n  if(s.zone>0&&s.zone<=36&&s.taskIndex>0&&s.taskIndex<=6){d.snapshot=s;d.phaseStarted=true;}\n  var __realLabel=String(zdjl.getVar('双王者直接当前','global'))==='是'?'当前':'王者'+id;\n  d.status=__realLabel+' 执行中';d.updatedAt=Date.now();delete d.bindingTask;\n  zdjl.writeFile(P,JSON.stringify(d));\n  var hud=String(zdjl.getVar('HUD文本','global')||'');\n  if(hud){hud=hud.replace(\/^(?:王者[12]|当前)·\/,'');zdjl.setVar('HUD文本',__realLabel+'·'+hud,'global');}\n }catch(e){try{zdjl.appendFile('\/sdcard\/Download\/双王者V3_日志.txt','HEARTBEAT ERROR '+e+'\\r\\n');}catch(z){}}\n})();\n"}
{"type":"控制执行","delayUnit":1,"repeatCount":1,"condition":{"type":"jsExpression","expression":"阶段已切换==\"是\" && 阶段需等待==\"是\" && Number(阶段等待分钟)>0","desc":"切换到下一任务且该任务需要等待"},"desc":"任务切换延迟（分钟）｜任务4\/5\/6前延迟；浇水→祝福保留原间隔","controlRunType":"waitDelay","jumpToPosition":"","ContinueParentExecute":false,"__vars":{"delay":{"varType":"expression","varScope":"global","mustInput":false,"valueExp":"阶段等待分钟"}}}
{"type":"控制执行","delay":"0","delayUnit":1,"condition":{"type":"jsExpression","expression":"阶段已切换==\"是\"","desc":"已进入下一阶段则重新从循环入口执行"},"desc":"已进入下一任务：回到循环入口","controlRunType":"jumpTo","jumpToPosition":":循环入口","ContinueParentExecute":false}
{"type":"运行JS代码","delay":"0","delayUnit":1,"condition":{"type":"jsExpression","expression":"阶段已切换!=\"是\"","desc":"只有完整任务链已经结束，才允许准备下一个账号"},"desc":"按指定顺序准备下一个账号","jsCode":"还有账号=\"否\";\n目标账号=0;\nvar sq=String(账号序列||\"\").split(\"-\");\nif(序列位置+1<sq.length){\n    序列位置=序列位置+1;\n    var nx=Number(sq[序列位置]);\n    if(nx>=1 && nx<=8){\n        目标账号=nx;\n        还有账号=\"是\";\n    }\n}\n\n\/\/ 只有真的还有下一个账号才显示“切号”；最后一个账号进入明确收尾状态。\nHUD任务=(还有账号==\"是\") ? \"切号\" : \"收尾\";\n\n\/\/ HUD轻量刷新：紧凑单行；性能统计只写文件，不占屏幕。\ntry{\n    function __hf2(n){n=Number(n)||0;return n<10?(\"0\"+n):String(n);}\n    var __hms=Math.max(0,Date.now()-(Number(HUD启动时间)||Date.now()));\n    var __hsec=Math.floor(__hms\/1000);\n    var __hh=Math.floor(__hsec\/3600), __hm=Math.floor((__hsec%3600)\/60), __hs=__hsec%60;\n    var __htime=__hh>0 ? (__hh+\":\"+__hf2(__hm)+\":\"+__hf2(__hs)) : (__hf2(__hm)+\":\"+__hf2(__hs));\n    var __hname=String(HUD当前账号||\"\").trim()||\"?\";\n    __hname=__hname.replace(\/安卓$\/i,\"安\").replace(\/ios$\/i,\"i\").replace(\/vx$\/i,\"V\").replace(\/^当前账号$\/,\"当\");\n    if(__hname.length>6) __hname=__hname.slice(0,6);\n    var __harea=(Number(当前区)||0)+\"\/\"+(Number(总数区)||0);\n    var __htask=String(HUD任务||\"\").trim()||\"运行\";\n    if(__htask==\"打11\") __htask=\"11\";\n    else if(__htask==\"打55\") __htask=\"55\";\n    else if(__htask==\"祝福\") __htask=\"福\";\n    else if(__htask==\"收割\") __htask=\"收\";\n    else if(__htask==\"巡田24\" || __htask==\"巡田24田\") __htask=\"巡\";\n    else if(__htask==\"十田\") __htask=\"十\";\n    else if(__htask==\"浇水\") __htask=\"水\";\n    else if(__htask==\"换英\") __htask=\"英\";\n    else if(__htask==\"换经\") __htask=\"经\";\n    else if(__htask==\"选区\") __htask=\"选\";\n    else if(__htask==\"切号\") __htask=\"切\";\n    else if(__htask==\"收尾\") __htask=\"尾\";\n    else if(__htask==\"准备\") __htask=\"备\";\n    HUD文本=__htime+\"·\"+__hname+\"·\"+__harea+\"·\"+__htask;\n    zdjl.setVar(\"HUD文本\",HUD文本,\"global\");\n}catch(__hudLiteErr){}\n\ntry{\n var __dc=Number(zdjl.getVar('双王者当前端','global'));\n var __hh=String(zdjl.getVar('HUD文本','global')||'');\n if((__dc===1||__dc===2)&&String(zdjl.getVar('双王者可运行','global'))==='是'&&__hh){\n  __hh=__hh.replace(\/^(?:王者[12]|当前)·\/,'');\n  zdjl.setVar('HUD文本',(String(zdjl.getVar('双王者直接当前','global'))==='是'?'当前':'王者'+__dc)+'·'+__hh,'global');\n }\n}catch(__huderr){}\n"}
{"type":"执行脚本","delay":"0","delayUnit":1,"condition":{"type":"jsExpression","expression":"阶段已切换!=\"是\" && 还有账号==\"是\"","desc":"完整任务链结束且指定序列里还有下一个账号"},"scriptCallbacks":{"afterExecSuc":{"type":"运行JS代码","delay":"0","delayUnit":1,"desc":"新账号：载入区数\/跳11并从六任务队列首任务开始","jsCode":"当前区=Math.max(1,Number(开始区)||1);\n当前格=1;\n需要回顶=\"是\";\n\nif(当前第几个号==1) 总数区=账号1区数;\nelse if(当前第几个号==2) 总数区=账号2区数;\nelse if(当前第几个号==3) 总数区=账号3区数;\nelse if(当前第几个号==4) 总数区=账号4区数;\nelse if(当前第几个号==5) 总数区=账号5区数;\nelse if(当前第几个号==6) 总数区=账号6区数;\nelse if(当前第几个号==7) 总数区=账号7区数;\nelse 总数区=账号8区数;\n\n跳过11区吗=(跳11号>0 && 当前第几个号==跳11号) ? \"跳过\" : \"不跳\";\n\nfunction __新号槽(i){\n    if(i==1) return String(任务1||\"无\");\n    if(i==2) return String(任务2||\"无\");\n    if(i==3) return String(任务3||\"无\");\n    if(i==4) return String(任务4||\"无\");\n    if(i==5) return String(任务5||\"无\");\n    if(i==6) return String(任务6||\"无\");\n    return \"无\";\n}\nfunction __新号做啥(t){\n    if(t==\"浇水\") return \"只浇水\";\n    if(t==\"祝福\") return \"祝福\";\n    if(t==\"收割\") return \"收割\";\n    if(t==\"稳收24田\") return \"稳收24\";\n    if(t==\"巡田24田\") return \"巡田24\";\n    if(t==\"十田经济\") return \"十钱\";\n    if(t==\"1V1\") return \"打11\";\n    if(t==\"55\") return \"打55\";\n    return \"\";\n}\n当前任务序号=1;\nwhile(当前任务序号<=6 && __新号槽(当前任务序号)==\"无\") 当前任务序号++;\n做啥=__新号做啥(__新号槽(当前任务序号));\n\ntry{\n    zdjl.writeFile(\"\/sdcard\/Download\/农场8账号断点.txt\",\n        \"V5|\"+\"有效\"+\"|\"+当前第几个号+\"|\"+当前区+\"|\"+任务1+\"|\"+任务2+\"|\"+任务3+\"|\"+任务4+\"|\"+任务5+\"|\"+任务6+\"|\"+当前任务序号+\"|\"+账号序列+\"|\"+序列位置+\"|\"+总数区+\"|\"+(Number(浇祝间隔)||0)+\"|\"+(Number(任务4延迟)||0)+\"|\"+(Number(任务5延迟)||0)+\"|\"+(Number(任务6延迟)||0)+\"|\"+特殊模式\n    );\n}catch(e){}"}},"filePath":"切换账号.zjs","continueCurrentAfterFinish":true}
{"type":"运行JS代码","delay":"0","delayUnit":1,"repeatCount":1,"desc":"QQ账号切换完成后保存新账号的本王者上下文","jsCode":"(function(){\n var P='\/sdcard\/Download\/双王者V3_进度.json';\n try{\n  var d=JSON.parse(String(zdjl.readFile(P)||'')),id=Number(zdjl.getVar('双王者当前端','global'));\n  if(d.schema!==3||d.runId!==String(zdjl.getVar('双王者运行ID','global'))||d.current!==id||d.status==='全部完成')return;\n  var s={client:id,zone:Number(当前区)||0,total:Number(总数区)||0,taskIndex:Number(当前任务序号)||0,task:String(做啥||''),account:Number(当前第几个号)||0,accountSeq:String(账号序列||''),sequencePos:Number(序列位置)||0,tempMode:String(临时模式||''),tempName:String(临时账号名称||''),time:Date.now()};\n  if(s.zone>0&&s.zone<=36&&s.taskIndex>0&&s.taskIndex<=6){d.snapshot=s;d.phaseStarted=true;}\n  var __realLabel=String(zdjl.getVar('双王者直接当前','global'))==='是'?'当前':'王者'+id;\n  d.status=__realLabel+' 执行中';d.updatedAt=Date.now();delete d.bindingTask;\n  zdjl.writeFile(P,JSON.stringify(d));\n  var hud=String(zdjl.getVar('HUD文本','global')||'');\n  if(hud){hud=hud.replace(\/^(?:王者[12]|当前)·\/,'');zdjl.setVar('HUD文本',__realLabel+'·'+hud,'global');}\n }catch(e){try{zdjl.appendFile('\/sdcard\/Download\/双王者V3_日志.txt','HEARTBEAT ERROR '+e+'\\r\\n');}catch(z){}}\n})();\n"}
{"type":"控制执行","delay":"0","delayUnit":1,"condition":{"type":"jsExpression","expression":"当前区<=总数区","desc":"还有下一地区时继续"},"desc":"还有下一地区：回到选区","controlRunType":"jumpTo","jumpToPosition":":循环入口","ContinueParentExecute":false}
{"type":"运行JS代码","delay":"0","delayUnit":1,"repeatCount":1,"desc":"本王者全部任务结束：保存完成阶段并切换另一端","jsCode":"(function(){\n var P='\/sdcard\/Download\/双王者V3_进度.json',L='\/sdcard\/Download\/双王者V3_日志.txt';\n function S(n,v){zdjl.setVar(n,v,'global');}\n try{\n  S('双王者下一端','否');\n  var d=JSON.parse(String(zdjl.readFile(P)||'')),id=Number(zdjl.getVar('双王者当前端','global'));\n  if(d.schema!==3||d.current!==id||d.order[d.phase]!==id)throw Error('阶段结束时客户端状态错位');\n  \/\/ 仅切换客户端状态，不再发Root解绑请求。\n  d.completed.push(id);d.snapshot=null;d.phaseStarted=false;\n  if(d.phase+1<d.order.length){d.phase+=1;d.current=d.order[d.phase];d.status='待切换王者'+d.current;S('双王者下一端','是');S('双王者内部换端','是');}\n  else{d.status='全部完成';S('双王者内部换端','否');}\n  d.updatedAt=Date.now();var tx=JSON.stringify(d);zdjl.writeFile(P,tx);if(String(zdjl.readFile(P)||'')!==tx)throw Error('阶段落盘校验失败');\n  zdjl.appendFile(L,new Date().toISOString()+' PHASE_COMPLETE 王者'+id+' -> '+d.status+'\\r\\n');\n  S('双王者运行结果',d.status);\n }catch(e){S('双王者可运行','否');S('双王者下一端','否');try{zdjl.toast('双王者阶段错误：'+e,6000);}catch(z){}}\n})();\n"}
{"type":"控制执行","delay":"0","delayUnit":1,"condition":{"type":"jsExpression","expression":"String(zdjl.getVar(\"双王者可运行\",\"global\"))!==\"是\"","desc":""},"desc":"阶段提交失败，停止","controlRunType":"stop","jumpToPosition":"","ContinueParentExecute":false}
{"type":"控制执行","delay":"0","delayUnit":1,"condition":{"type":"jsExpression","expression":"String(zdjl.getVar(\"双王者下一端\",\"global\"))===\"是\"","desc":""},"desc":"本端结束，重新加载下一王者任务队列","controlRunType":"jumpTo","jumpToPosition":":双王者入口","ContinueParentExecute":false}
{"type":"运行JS代码","delay":"0","delayUnit":1,"desc":"全部完成：标记断点完成","jsCode":"try{\n    HUD完成耗时=String(Math.max(0,Date.now()-(Number(HUD启动时间)||Date.now())));\n    HUD任务=\"完成\";\n    HUD完成=\"是\";\n    var __sec=Math.floor((Number(HUD完成耗时)||0)\/1000);\n    var __hh=Math.floor(__sec\/3600);\n    var __mm=Math.floor((__sec%3600)\/60);\n    var __ss=__sec%60;\n    function __p(n){return n<10?(\"0\"+n):String(n);}\n    var __seq=String(账号序列||\"\").replace(\/[^1-8]\/g,\"\");\n    var __beh=String(HUD本次行为||\"任务\");\n    HUD文本=\"✅ 完成｜\"+(__hh>0?(__hh+\":\"+__p(__mm)+\":\"+__p(__ss)):(__p(__mm)+\":\"+__p(__ss)));\n    zdjl.setVar(\"HUD文本\",HUD文本,\"global\");\n}catch(__hudEndErr){}\ntry{\n    zdjl.writeFile(\"\/sdcard\/Download\/农场8账号断点.txt\",\n        \"V5|\"+\"完成\"+\"|\"+当前第几个号+\"|\"+当前区+\"|\"+任务1+\"|\"+任务2+\"|\"+任务3+\"|\"+任务4+\"|\"+任务5+\"|\"+任务6+\"|\"+当前任务序号+\"|\"+账号序列+\"|\"+序列位置+\"|\"+总数区+\"|\"+(Number(浇祝间隔)||0)+\"|\"+(Number(任务4延迟)||0)+\"|\"+(Number(任务5延迟)||0)+\"|\"+(Number(任务6延迟)||0)+\"|\"+特殊模式\n    );\n}catch(e){}\ntry{\n    var __doneMs=Number(HUD完成耗时)||0;\n    var __doneSec=Math.floor(__doneMs\/1000);\n    var __doneH=Math.floor(__doneSec\/3600);\n    var __doneM=Math.floor((__doneSec%3600)\/60);\n    var __doneS=__doneSec%60;\n    function __doneP(n){return n<10?(\"0\"+n):String(n);}\n    var __doneTime=__doneH>0?(__doneH+\":\"+__doneP(__doneM)+\":\"+__doneP(__doneS)):(__doneP(__doneM)+\":\"+__doneP(__doneS));\n\n    function __doneName(n){\n        if(n==1) return String(账号1名称||\"1号\");\n        if(n==2) return String(账号2名称||\"2号\");\n        if(n==3) return String(账号3名称||\"3号\");\n        if(n==4) return String(账号4名称||\"4号\");\n        if(n==5) return String(账号5名称||\"5号\");\n        if(n==6) return String(账号6名称||\"6号\");\n        if(n==7) return String(账号7名称||\"7号\");\n        if(n==8) return String(账号8名称||\"8号\");\n        return \"?\";\n    }\n    function __doneAreas(n){\n        if(n==1) return Number(账号1区数)||0;\n        if(n==2) return Number(账号2区数)||0;\n        if(n==3) return Number(账号3区数)||0;\n        if(n==4) return Number(账号4区数)||0;\n        if(n==5) return Number(账号5区数)||0;\n        if(n==6) return Number(账号6区数)||0;\n        if(n==7) return Number(账号7区数)||0;\n        if(n==8) return Number(账号8区数)||0;\n        return 0;\n    }\n\n    var __doneAccounts=[];\n    if(String(临时模式||\"\")==\"是\"){\n        __doneAccounts.push(String(临时账号名称||\"?\")+\"(\"+(Number(总数区)||0)+\"区)\");\n    }else{\n        var __seqText=String(账号序列||\"\");\n        var __seqArr=__seqText.match(\/[1-8]\/g)||[];\n        if(__seqArr.length<1){\n            var __curNo=Number(当前第几个号)||0;\n            if(__curNo>=1 && __curNo<=8) __seqArr=[String(__curNo)];\n        }\n        for(var __di=0;__di<__seqArr.length;__di++){\n            var __dn=Number(__seqArr[__di])||0;\n            if(__dn>=1 && __dn<=8){\n                __doneAccounts.push(__doneName(__dn)+\"(\"+__doneAreas(__dn)+\"区)\");\n            }\n        }\n    }\n\n    var __doneTask=String(HUD本次行为||\"任务\").trim()||\"任务\";\nvar __doneText=\"✅ 农场任务全部完成｜耗时 \"+__doneTime+\n        \"\\n任务：\"+__doneTask+\n        \"\\n账号：\"+(__doneAccounts.length?__doneAccounts.join(\"｜\"):\"?\");\n    var __doneStart=Number(开始区)||1;\n    if(__doneStart>1){\n        __doneText+=\"\\n起始：首阶段第\"+__doneStart+\"区\";\n    }\n    zdjl.setVar(\"完成通知文本\",__doneText,\"global\");\n}catch(__doneNotifyErr){}\n\/\/ 无需解绑Root\/Android用户实例。\n\ntry{\n var __dc=Number(zdjl.getVar('双王者当前端','global'));\n var __hh=String(zdjl.getVar('HUD文本','global')||'');\n if((__dc===1||__dc===2)&&String(zdjl.getVar('双王者可运行','global'))==='是'&&__hh){\n  __hh=__hh.replace(\/^(?:王者[12]|当前)·\/,'');\n  zdjl.setVar('HUD文本',(String(zdjl.getVar('双王者直接当前','global'))==='是'?'当前':'王者'+__dc)+'·'+__hh,'global');\n }\n}catch(__huderr){}\n"}
{"type":"系统提示","delay":"0","delayUnit":1,"repeatCount":1,"desc":"全部完成：原生通知栏结果（与收尾JS分离，避免同步动作卡住）","promptType":"notification","promptTitle":"农场任务完成","showPosition":"default","playAudio":"false","useVibrator":false,"__vars":{"promptText":{"varType":"expression","varScope":"global","mustInput":false,"valueExp":"完成通知文本"}}}
{"type":"运行多个动作","delay":"0","delayUnit":1,"repeatCount":1,"desc":"全部任务完成：显示农场详情→清状态→正常停止","scriptSet":[{"type":"运行JS代码","delay":"0","delayUnit":1,"repeatCount":1,"desc":"全部任务结束：打开农场详情（只读，不重新OCR）","jsCode":"try{zdjl.appendFile(\"\/sdcard\/Download\/农场总控_页面诊断.log\",new Date().toISOString()+\" OCR_OPEN\\n\");}catch(e){}\n(function(){\nvar raw=\"\",P=\"\/sdcard\/Download\/农场记录.txt\",marks=[],rx=\/={4,}\\s*记录时间[：:]\\s*([^=\\r\\n]+?)\\s*={4,}\/g;\ntry{raw=String(zdjl.readFile(P)||\"\");}catch(e){raw=\"\";}\nvar m;\nwhile((m=rx.exec(raw))!==null){marks.push({start:m.index,end:rx.lastIndex,time:String(m[1]||\"\").trim(),seq:marks.length});}\nfunction makeDate(s){\n var x=String(s||\"\").match(\/(\\d{4})[-\\\/](\\d{1,2})[-\\\/](\\d{1,2})\\s+(\\d{1,2}):(\\d{2})(?::(\\d{2}))?\/);\n if(!x)return null;\n var d=new Date(+x[1],+x[2]-1,+x[3],+x[4],+x[5],+(x[6]||0));\n return isFinite(d.getTime())?d:null;\n}\nfunction hhmm(d){if(!d)return \"—\";function z(n){return n<10?\"0\"+n:String(n);}return z(d.getHours())+\":\"+z(d.getMinutes());}\nfunction part(s,n){var p=s.indexOf(\"【\"+n+\"】\");if(p<0)return \"\";var t=s.slice(p+n.length+2),e=t.indexOf(\"【\");return(e>=0?t.slice(0,e):t).replace(\/\\r\/g,\"\").trim();}\nfunction clean(s){return String(s||\"\").replace(\/\\s+\/g,\" \").trim();}\nfunction escape(s){return String(s).replace(\/&\/g,\"&amp;\").replace(\/<\/g,\"&lt;\").replace(\/>\/g,\"&gt;\");}\nfunction cut(s,n){s=String(s||\"—\");return s.length>n?s.slice(0,n-1)+\"…\":s;}\nfunction farmId(text){\n var x=String(text||\"\").match(\/([^\\s|｜【】,，:：]{1,32})的农场\/);\n if(!x)return \"\";\n var v=clean(x[1]).replace(\/^[\\[【(（]+|[\\]】)）]+$\/g,\"\");\n return v.length>=1?v:\"\";\n}\nfunction plantName(st){\n \/\/ Read the crop field by line position; do not assume a fixed crop whitelist.\n var lines=String(st||\"\").replace(\/\\r\/g,\"\").split(\/\\n+\/),head=-1,i;\n for(i=0;i<lines.length;i++){if(\/的农场\/.test(lines[i])){head=i;break;}}\n if(head>=0){\n  var lim=Math.min(lines.length,head+12),pastLevel=false;\n  for(i=head+1;i<lim;i++){\n   var s=String(lines[i]||\"\").trim().replace(\/^[：:•·\\-\\s]+|[：:•·\\-\\s]+$\/g,\"\");\n   if(!s)continue;\n   if(!pastLevel && \/^\\d{1,3}$\/.test(s)){pastLevel=true;continue;}\n   if(\/^变异(?:植物|作物)?$\/.test(s) || \/^(?:金色|幽蓝|桃霞|紫色|巨大化|可升级|满级|普通|植物|作物|已经成熟|已成熟|未成熟|可收获|可收割|成熟)$\/.test(s))continue;\n   if(\/^\\d+\\s*\\\/\\s*\\d+$\/.test(s) || \/^\\d+$\/.test(s) || \/^[?？]$\/.test(s) || \/(?:小时|分钟|秒|水分|成熟|词条|祝福|剩余|金币|等级|XP)\/.test(s))continue;\n   s=s.replace(\/^(?:变异植物|变异作物|变异|植物名称|植物名|作物名称|作物名)\\s*[：:]?\\s*\/,\"\");\n   if(\/^[\\u3400-\\u9fff]{2,8}$\/.test(s))return s;\n  }\n }\n \/\/ Secondary extraction for inline OCR or unusual line layouts.\n var known=st.match(\/牛油果|灯笼果|麒麟果|火龙果|龙胆花|枇杷|百合|莲花|樱桃|辣椒|柠檬|杨桃|山竹|石榴|芒果|梨子|灯笼花|百香果|桃子|草莓|苹果|西瓜|香梨|葡萄|向日葵|玫瑰|小麦|玉米|南瓜|土豆|胡萝卜|茄子|仙人掌|棉花|杏子|葫芦|卷心菜|白萝卜\/);\n if(known)return known[0];\n var inline=st.match(\/(?:变异(?:作物|植物)?|植物[名：:]|作物[名：:])\\s*([\\u3400-\\u9fff]{2,8})\/);\n return inline?inline[1]:\"—\";\n}\nfunction ripeAt(st,scan){\n if(\/(?:已经成熟|已成熟|可收获|成熟可收)\/.test(st))return \"已熟\";\n var t=st.match(\/(\\d{1,3})\\s*小时\\s*(\\d{1,2})\\s*分(?:钟)?(?:后|左右)?成熟\/);\n var minutes=-1;\n if(t)minutes=Number(t[1])*60+Number(t[2]);\n if(minutes<0){t=st.match(\/(\\d{1,3})\\s*小时(?:后|左右)?成熟\/);if(t)minutes=Number(t[1])*60;}\n if(minutes<0){t=st.match(\/(\\d{1,4})\\s*分(?:钟)?(?:后|左右)?成熟\/);if(t)minutes=Number(t[1]);}\n \/\/ OCR sometimes prints \"后成熟\" rather than \"成熟\" immediately after the countdown.\n if(minutes<0){t=st.match(\/(\\d{1,3})\\s*小时\\s*(\\d{1,2})\\s*分(?:钟)?\\s*后成熟\/);if(t)minutes=Number(t[1])*60+Number(t[2]);}\n if(minutes>=0&&minutes<=60*240&&scan)return hhmm(new Date(scan.getTime()+minutes*60000));\n \/\/ Explicit wall-clock maturity time requires no conversion.\n t=st.match(\/(?:预计|将于|成熟时间[：:]?\\s*)(\\d{1,2}):(\\d{2})\\s*成熟?\/);\n if(t&&Number(t[1])<24&&Number(t[2])<60)return (Number(t[1])<10?\"0\":\"\")+Number(t[1])+\":\"+t[2];\n return \/未成熟\/.test(st)?\"未熟\":\"—\";\n}\nfunction dryAt(st,scan){\n if(\/(?:已干涸|已经干涸|水分耗尽|水分已耗尽|水分不足|已缺水)\/.test(st))return \"已干\";\n if(!scan)return \"—\";\n var t=String(st||\"\").match(\/水分\\s*还能维持\\s*(\\d{1,3})\\s*小时(?:\\s*(\\d{1,2})\\s*分(?:钟)?)?(?:\\s*(\\d{1,2})\\s*秒)?\/);\n var seconds=-1;\n if(t)seconds=Number(t[1])*3600+Number(t[2]||0)*60+Number(t[3]||0);\n if(seconds<0){\n  t=String(st||\"\").match(\/水分\\s*还能维持\\s*(\\d{1,4})\\s*分(?:钟)?(?:\\s*(\\d{1,2})\\s*秒)?\/);\n  if(t)seconds=Number(t[1])*60+Number(t[2]||0);\n }\n if(seconds<0){\n  t=String(st||\"\").match(\/水分\\s*还能维持\\s*(\\d{1,5})\\s*秒\/);\n  if(t)seconds=Number(t[1]);\n }\n if(seconds<0||seconds>240*3600)return \"—\";\n return hhmm(new Date(scan.getTime()+seconds*1000));\n}\nfunction dailyState(s){\n s=clean(s);\n \/\/ Only explicit completion is completed; claimable rewards are unfinished.\n if(!s||\/^(?:[?？—\\-]+|未知|识别失败|无法识别)$\/.test(s))return \"未知\";\n \/\/ Negated completion must win over the positive completion substring.\n if(\/(?:未完成|尚未完成|未做完|待完成|没有完成)\/.test(s))return \"未完\";\n if(\/(?:已完成|全部完成|任务完成|已领完|已全部领取|全部领取)\/.test(s))return \"完成\";\n \/\/ 前往、领取奖励、待领取、计数、其它可读状态都尚未完成。\n return \"未完\";\n}\nfunction moneyText(s){\n s=clean(s);\n var x=s.match(\/([\\d,]+(?:\\.\\d+)?)\\s*(万|亿)(?:\\s|$)\/);\n if(!x)x=s.match(\/(?:金币|金钱|资金)\\s*[:：]?\\s*([\\d,]+(?:\\.\\d+)?)\/);\n if(!x)return \"—\";\n var n=Number(x[1].replace(\/,\/g,\"\")),u=x[2]||\"万\";\n if(!isFinite(n)||n<0)return \"—\";\n var wan=(u===\"亿\"?n*10000:n);\n if(wan>=9999.5)return (wan\/10000).toFixed(1)+\"亿\";\n return String(Math.round(wan))+\"万\";\n}\nfunction rowFor(record){\n var st=part(record.body,\"植物状态\"),daily=part(record.body,\"每日任务\"),money=part(record.body,\"等级经钱\");\n var id=farmId(st);if(!id)return null;\n var lv=\"\", ix=st.indexOf(\"的农场\");\n if(ix>=0){var x=st.slice(ix+3).match(\/^\\s*(\\d{1,3})(?:\\s|$)\/);if(x)lv=x[1];}\n if(!lv){var y=(money+\" \"+st).match(\/(?:当前等级|农场等级|等级)\\s*[:：]?\\s*(\\d{1,3})\/);if(y)lv=y[1];}\n var date=makeDate(record.time),crop=plantName(st),ripe=ripeAt(st,date),dry=dryAt(st,date),task=dailyState(daily);\n return {id:id,key:id.toLowerCase(),time:hhmm(date),farm:cut(id,18),level:lv||\"—\",plant:cut(crop,13),ripe:ripe,dry:dry,daily:task,money:moneyText(money),ts:date?date.getTime():0,seq:record.seq};\n}\n\/\/ Find the most recent record for each farm ID, then stop at 40 DIFFERENT farms.\nvar originalOrder=marks.slice();\nmarks.sort(function(a,b){var da=makeDate(a.time),db=makeDate(b.time);return (db?db.getTime():0)-(da?da.getTime():0)||b.seq-a.seq;});\nvar chosen=[],seen={},skipped=0;\nfor(var i=0;i<marks.length&&chosen.length<40;i++){\n var s=marks[i];\n \/\/ Boundaries are based on file order, not chronological sort order.\n \/\/ The original indices are preserved separately below.\n var idx=s.seq,end=idx+1<originalOrder.length?originalOrder[idx+1].start:raw.length;\n var row=rowFor({time:s.time,body:raw.slice(s.end,end),seq:s.seq});\n if(!row){skipped++;continue;}\n if(Object.prototype.hasOwnProperty.call(seen,row.key))continue;\n seen[row.key]=true;chosen.push(row);\n}\nvar cols=[],headerBg=\"#3C4945\";\nfunction cell(name,s,width,bg,color,size){\n \/\/ One physical line per record; if needed reduce font and truncate only the long cell.\n var txt=String(s==null?\"—\":s),w=parseInt(width,10)||12;\n function units(t){var z=0;for(var i=0;i<t.length;i++)z+=t.charCodeAt(i)>255?1.75:1;return z;}\n function clip(t,max){var out=\"\",z=0;for(var i=0;i<t.length;i++){var q=t.charCodeAt(i)>255?1.75:1;if(z+q>max)break;out+=t.charAt(i);z+=q;}return out;}\n \/\/ Fit short numerical fields at 9px; farm names alone can step down to 8px.\n var sz=(name.indexOf(\"_F\")>=0&&units(txt)>w*0.74)?8:9;\n var cap=Math.max(5,Math.floor(w*0.83*(9\/sz)));\n if(units(txt)>cap){txt=clip(txt,Math.max(2,cap-1.5))+\"…\";}\n cols.push({name:name,value:{varType:\"ui_text\",varScope:\"script\",showInput:true,mustInput:false,\n  showInputHiddenLabel:true,showInputWidthBasis:width,showInputWidthGrow:0,\n  showInputContentAlign:\"left\",backgroundColor:bg,textSize:sz,\n  textContent:\"#MD\\n<font color=\"+color+\" size=1>\"+escape(txt)+\"<\/font>\"}});\n}\nif(chosen.length===0){cols.push({name:\"OCR_EMPTY\",value:{varType:\"ui_text\",varScope:\"script\",showInput:true,mustInput:false,\n showInputWidthBasis:\"100%\",textContent:\"暂无可识别农场ID的OCR记录；原始记录未删除。\"}});}\nelse{\n cell(\"H_T\",\"扫描\",\"9%\",headerBg,\"#9EE9BE\",10);\n cell(\"H_F\",\"农场\",\"18%\",headerBg,\"#9EE9BE\",10);\n cell(\"H_L\",\"等级\",\"5%\",headerBg,\"#9EE9BE\",10);\n cell(\"H_P\",\"植物\",\"14%\",headerBg,\"#9EE9BE\",10);\n cell(\"H_R\",\"成熟\",\"10%\",headerBg,\"#9EE9BE\",10);\n cell(\"H_W\",\"干涸\",\"10%\",headerBg,\"#9EE9BE\",10);\n cell(\"H_D\",\"任务\",\"10%\",headerBg,\"#9EE9BE\",10);\n cell(\"H_M\",\"金币\",\"17%\",headerBg,\"#9EE9BE\",10);\n for(var j=0;j<chosen.length;j++){\n  var v=chosen[j],bg=j%2?\"#30363A\":\"#292F33\",n=\"R\"+(j+1)+\"_\";\n  cell(n+\"T\",v.time,\"9%\",bg,\"#BAC8CC\",10);\n  cell(n+\"F\",v.farm,\"18%\",bg,\"#EEF4F0\",10);\n  cell(n+\"L\",v.level,\"5%\",bg,\"#EEF4F0\",10);\n  cell(n+\"P\",v.plant,\"14%\",bg,\"#AFE8C2\",10);\n  cell(n+\"R\",v.ripe,\"10%\",bg,\"#9DE5BE\",10);\n  cell(n+\"W\",v.dry,\"10%\",bg,v.dry===\"已干\"?\"#F0B58F\":\"#BCE0DF\",10);\n  cell(n+\"D\",v.daily,\"10%\",bg,v.daily===\"完成\"?\"#9DDDAB\":\"#F2CB89\",10);\n  cell(n+\"M\",v.money,\"17%\",bg,\"#DBE4E0\",10);\n }\n}\ntry{zdjl.runAction({type:\"设置变量\",delay:\"0\",delayUnit:1,\n dialogTitle:\"#MD\\n<font color=#9BE8B9 size=3><b>农场详情 · \"+chosen.length+\" \/ 40<\/b><\/font>\",\n dialogOKText:\"返回\",dialogCancelText:\"none\",vars:cols});}\ncatch(e){try{zdjl.toast(\"OCR列表打开失败：\"+e,3500);}catch(z){}}\n})();"},{"type":"运行JS代码","delay":"0","delayUnit":1,"repeatCount":1,"desc":"V31：结束标记清理（不再重载引擎）","jsCode":"(function(){\n try{zdjl.appendFile(\"\/sdcard\/Download\/农场总控_退出诊断.log\",new Date().toISOString()+\" V31 FINISH_STOP_REQUESTED\\n\");}catch(e){}\n try{zdjl.setVar(\"FC_V6_RUN_OK\",\"\",\"global\");zdjl.setVar(\"FC_V19_STARTED\",\"\",\"global\");zdjl.setVar(\"FC_V31_EXPLICIT_LAUNCH\",\"\",\"global\");}catch(e){}\n})();"},{"type":"控制执行","delay":"0","delayUnit":1,"repeatCount":1,"desc":"V31：全部任务完成后原生停止，不重载引擎","controlRunType":"stop","jumpToPosition":"","ContinueParentExecute":false}]}

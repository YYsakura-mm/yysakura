{"type":"运行JS代码","delay":"0","delayUnit":1,"condition":{"type":"jsExpression","expression":"特殊模式!=\"只识别状态\"","desc":"账号初始化（无王者模块绑定）"},"desc":"正常任务：保持人工真实总区数 + 首次红绿点校验 + V5六任务队列","scriptCallbacks":{"afterExecSuc":{"type":"运行多个动作","delay":"0","delayUnit":1,"repeatCount":1,"desc":"启动后创建HUD与容错统计通知","scriptSet":[{"type":"系统提示","delay":"0","delayUnit":1,"desc":"统一HUD：更短更窄纯文本提示","promptType":"toast","promptTitle":"","showPosition":"bottom_left","playAudio":"false","useVibrator":false,"showDuration":99999999,"__vars":{"promptText":{"varType":"expression","varScope":"global","mustInput":true,"valueExp":"HUD文本"}}}],"runMode":"normal"}},"jsCode":"\/\/ 双王者V4：不再建立Root模块绑定，本轮仅使用独立王者编号与持久化调度。\nHUD启动时间=String(Date.now());\n\/\/ 新任务必须清理上一次异常退出可能遗留的强制视觉校正标志。\ntry{zdjl.setVar(\"SEL_强制校正\",\"否\",\"global\");}catch(__selInitErr){}\n\/\/ 每次启动新的总控任务清理一次性扫描缓存，不能复用上次任务\/上个账号结果。\ntry{\n    zdjl.setVar(\"选区总数扫描账号键\",\"\",\"global\");\n    zdjl.setVar(\"选区总数扫描结果\",0,\"global\");\n    zdjl.setVar(\"选区总数扫描起点异常\",\"否\",\"global\");\n}catch(__scanInitErr){}\n\/\/ ===== 性能仪表：每次主任务启动清零 =====\nHUD任务=\"准备\";\nHUD当前账号=\"\";\nHUD统一模式=\"是\";\nHUD完成=\"否\";\nHUD完成耗时=\"0\";\nHUD文本=\"\";\nHUD本次行为=\"\";\n临时账号名称=\"\";\n临时模式=\"否\";\n\n当前格=1;\n目标账号=0;\n断点有效=\"是\";\n启动需切号=\"否\";\n还有账号=\"否\";\n账号序列=\"\";\n序列位置=0;\n\nvar 配置名称=[\"1号\", \"2号\", \"3号\", \"4号\", \"5号\", \"6号\", \"7号\", \"8号\"];\nvar 配置区数=[9, 31, 12, 11, 11, 11, 11, 19];\nvar 配置跳11=3;\n\ntry{\n    var 配置原文=String(zdjl.readFile(\"\/sdcard\/Download\/农场8账号配置.json\")||\"\").trim();\n    if(配置原文){\n        var 配置=JSON.parse(配置原文);\n        if(配置 && 配置.names && 配置.names.length==8 &&\n           配置.counts && 配置.counts.length==8){\n            var 名称可用=true;\n            var 区数可用=true;\n            for(var ci=0;ci<8;ci++){\n                if(!String(配置.names[ci]||\"\").trim()) 名称可用=false;\n                var cn=Number(配置.counts[ci]);\n                if(!(cn>=1 && cn<=36)) 区数可用=false;\n            }\n            if(名称可用) 配置名称=配置.names;\n            if(区数可用) 配置区数=配置.counts;\n            var sj=Number(配置.skip);\n            if(sj>=0 && sj<=8) 配置跳11=sj;\n        }\n    }\n}catch(e){}\n\n账号1名称=String(配置名称[0]||\"1号\");\n账号2名称=String(配置名称[1]||\"2号\");\n账号3名称=String(配置名称[2]||\"3号\");\n账号4名称=String(配置名称[3]||\"4号\");\n账号5名称=String(配置名称[4]||\"5号\");\n账号6名称=String(配置名称[5]||\"6号\");\n账号7名称=String(配置名称[6]||\"7号\");\n账号8名称=String(配置名称[7]||\"8号\");\n\n账号1区数=Number(配置区数[0]);\n账号2区数=Number(配置区数[1]);\n账号3区数=Number(配置区数[2]);\n账号4区数=Number(配置区数[3]);\n账号5区数=Number(配置区数[4]);\n账号6区数=Number(配置区数[5]);\n账号7区数=Number(配置区数[6]);\n账号8区数=Number(配置区数[7]);\n跳11号=Number(配置跳11)||0;\n\nfunction 取账号区数(n){\n    if(n==1) return 账号1区数;\n    if(n==2) return 账号2区数;\n    if(n==3) return 账号3区数;\n    if(n==4) return 账号4区数;\n    if(n==5) return 账号5区数;\n    if(n==6) return 账号6区数;\n    if(n==7) return 账号7区数;\n    return 账号8区数;\n}\n\nfunction 账号编号(token){\n    var s=String(token||\"\").trim();\n    if(!s) return 0;\n    var m=s.match(\/^(?:账号)?([1-8])(?:号)?$\/);\n    if(m) return Number(m[1]);\n    for(var i=0;i<8;i++){\n        if(s==String(配置名称[i]||\"\").trim()) return i+1;\n    }\n    return 0;\n}\n\nfunction 解析账号序列(text){\n    var s=String(text||\"\").trim();\n    var out=[];\n\n    \/\/ 最快输入：236 = 2→3→6；47 = 4→7；632 = 6→3→2\n    if(\/^[1-8]+$\/.test(s)){\n        for(var k=0;k<s.length;k++){\n            var d=Number(s.charAt(k));\n            var 已有=false;\n            for(var z=0;z<out.length;z++) if(out[z]==d) 已有=true;\n            if(!已有) out.push(d);\n        }\n        return out;\n    }\n\n    \/\/ 兼容原写法：2-3-6 \/ 2,3,6 \/ 羊羊-木木\n    var parts=s.split(\/[\\s,，、;；\\-—>＞]+\/);\n    for(var i=0;i<parts.length;i++){\n        if(!parts[i]) continue;\n        var n=账号编号(parts[i]);\n        if(!n) return [];\n        var 重复=false;\n        for(var j=0;j<out.length;j++) if(out[j]==n) 重复=true;\n        if(!重复) out.push(n);\n    }\n    return out;\n}\n\nfunction 应用跳11(){\n    跳过11区吗=(跳11号>0 && 当前第几个号==跳11号) ? \"跳过\" : \"不跳\";\n}\n\n\nfunction 槽任务(i){\n    if(i==1) return String(任务1||\"无\");\n    if(i==2) return String(任务2||\"无\");\n    if(i==3) return String(任务3||\"无\");\n    if(i==4) return String(任务4||\"无\");\n    if(i==5) return String(任务5||\"无\");\n    if(i==6) return String(任务6||\"无\");\n    return \"无\";\n}\nfunction 任务转做啥(t){\n    t=String(t||\"\");\n    if(t==\"浇水\") return \"只浇水\";\n    if(t==\"祝福\") return \"祝福\";\n    if(t==\"收割\") return \"收割\";\n    if(t==\"稳收24田\") return \"稳收24\";\n    if(t==\"巡田24田\") return \"巡田24\";\n    if(t==\"十田经济\") return \"十钱\";\n    if(t==\"1V1\") return \"打11\";\n    if(t==\"55\") return \"打55\";\n    return \"\";\n}\nfunction 做啥转任务(t){\n    t=String(t||\"\");\n    if(t==\"只浇水\") return \"浇水\";\n    if(t==\"祝福\" || t==\"嘎嘎祝福\" || t==\"祝福右边\") return \"祝福\";\n    if(t==\"收割\") return \"收割\";\n    if(t==\"稳收24田\") return \"稳收24\";\n    if(t==\"稳收24\") return \"稳收24田\";\n    if(t==\"巡田24\") return \"巡田24田\";\n    if(t==\"十钱\") return \"十田经济\";\n    if(t==\"打11\") return \"1V1\";\n    if(t==\"打55\") return \"55\";\n    return \"无\";\n}\nfunction 首任务序号(){\n    for(var i=1;i<=6;i++) if(槽任务(i)!=\"无\") return i;\n    return 0;\n}\nfunction 应用当前任务(){\n    if(String(特殊模式||\"\")==\"只识别状态\"){\n        当前任务序号=0;\n        做啥=\"状态识别\";\n        return;\n    }\n    var i=Number(当前任务序号)||首任务序号();\n    if(i<1 || i>6 || 槽任务(i)==\"无\") i=首任务序号();\n    当前任务序号=i;\n    做啥=任务转做啥(槽任务(i));\n}\nfunction 旧任务转槽(oldTask, oldMulti){\n    任务1=\"无\";任务2=\"无\";任务3=\"无\";任务4=\"无\";任务5=\"无\";任务6=\"无\";当前任务序号=1;特殊模式=\"正常任务\";浇祝间隔=0;任务4延迟=0;任务5延迟=0;任务6延迟=0;\n    if(oldTask==\"状态识别\"){\n        任务1=\"浇水\";特殊模式=\"只识别状态\";当前任务序号=0;做啥=\"状态识别\";return;\n    }\n    if(oldMulti==\"浇水完了去祝福完了去11\"){\n        任务1=\"浇水\";任务2=\"祝福\";任务3=\"1V1\";\n    }else if(oldMulti==\"浇水完了去祝福\"){\n        任务1=\"浇水\";任务2=\"祝福\";\n    }else if(oldMulti==\"祝福完了去11\"){\n        任务1=\"祝福\";任务2=\"1V1\";\n    }else{\n        任务1=做啥转任务(oldTask);\n        if(任务1==\"无\") 任务1=\"浇水\";\n    }\n    var ot=做啥转任务(oldTask);\n    if(ot==任务2) 当前任务序号=2;\n    else if(ot==任务3) 当前任务序号=3;\n    else 当前任务序号=1;\n    应用当前任务();\n}\nfunction 保存断点(状态){\n    try{\n        zdjl.writeFile(\"\/sdcard\/Download\/农场8账号断点.txt\",\n            \"V5|\"+状态+\"|\"+当前第几个号+\"|\"+当前区+\"|\"+任务1+\"|\"+任务2+\"|\"+任务3+\"|\"+任务4+\"|\"+任务5+\"|\"+任务6+\"|\"+当前任务序号+\"|\"+账号序列+\"|\"+序列位置+\"|\"+总数区+\"|\"+(Number(浇祝间隔)||0)+\"|\"+(Number(任务4延迟)||0)+\"|\"+(Number(任务5延迟)||0)+\"|\"+(Number(任务6延迟)||0)+\"|\"+特殊模式\n        );\n    }catch(e){}\n}\n\n当前任务序号=1;\n阶段需等待=\"否\";\n阶段等待分钟=0;\n\nif(运行方式==\"继续上次\"){\n    try{\n        var t=String(zdjl.readFile(\"\/sdcard\/Download\/农场8账号断点.txt\")||\"\").trim().split(\"|\");\n\n        if(t.length>=19 && t[0]==\"V5\" && t[1]==\"有效\"){\n            当前第几个号=Number(t[2]);\n            当前区=Number(t[3]);\n            任务1=t[4]||\"浇水\";\n            任务2=t[5]||\"无\";\n            任务3=t[6]||\"无\";\n            任务4=t[7]||\"无\";\n            任务5=t[8]||\"无\";\n            任务6=t[9]||\"无\";\n            当前任务序号=Number(t[10])||1;\n            账号序列=t[11]||\"\";\n            序列位置=Number(t[12])||0;\n            总数区=Number(t[13])||0;\n            浇祝间隔=Math.max(0,Number(t[14])||0);\n            任务4延迟=Math.max(0,Number(t[15])||0);\n            任务5延迟=Math.max(0,Number(t[16])||0);\n            任务6延迟=Math.max(0,Number(t[17])||0);\n            特殊模式=t[18]||\"正常任务\";\n            var rr=解析账号序列(账号序列);\n\n            if(!当前第几个号 || 当前第几个号<1 || 当前第几个号>8 ||\n               !当前区 || 当前区<1 || rr.length<1 ||\n               序列位置<0 || 序列位置>=rr.length ||\n               rr[序列位置]!=当前第几个号){\n                断点有效=\"否\";\n            }else{\n                if(!(总数区>=1 && 总数区<=36)) 总数区=取账号区数(当前第几个号);\n                应用跳11();\n                所有账号一轮=(rr.length>1) ? \"是的\" : \"不用\";\n                目标账号=当前第几个号;\n                启动需切号=\"是\";\n                应用当前任务();\n            }\n\n        }else if(t.length>=13 && t[0]==\"V4\" && t[1]==\"有效\"){\n            当前第几个号=Number(t[2]);\n            当前区=Number(t[3]);\n            任务1=t[4]||\"浇水\";\n            任务2=t[5]||\"无\";\n            任务3=t[6]||\"无\";\n            任务4=\"无\";任务5=\"无\";任务6=\"无\";\n            任务4延迟=0;任务5延迟=0;任务6延迟=0;\n            当前任务序号=Number(t[7])||1;\n            账号序列=t[8]||\"\";\n            序列位置=Number(t[9])||0;\n            浇祝间隔=Math.max(0,Number(t[11])||0);\n            特殊模式=t[12]||\"正常任务\";\n            var rr=解析账号序列(账号序列);\n\n            if(!当前第几个号 || 当前第几个号<1 || 当前第几个号>8 ||\n               !当前区 || 当前区<1 || rr.length<1 ||\n               序列位置<0 || 序列位置>=rr.length ||\n               rr[序列位置]!=当前第几个号){\n                断点有效=\"否\";\n            }else{\n                总数区=取账号区数(当前第几个号);\n                应用跳11();\n                所有账号一轮=(rr.length>1) ? \"是的\" : \"不用\";\n                目标账号=当前第几个号;\n                启动需切号=\"是\";\n                应用当前任务();\n            }\n\n        }else if(t.length>=9 && t[0]==\"V3\" && t[1]==\"有效\"){\n            当前第几个号=Number(t[2]);\n            当前区=Number(t[3]);\n            var oldTask=t[4];\n            var oldMulti=t[5];\n            账号序列=t[6];\n            序列位置=Number(t[7]);\n            var rr3=解析账号序列(账号序列);\n            旧任务转槽(oldTask,oldMulti);\n\n            if(!当前第几个号 || 当前第几个号<1 || 当前第几个号>8 ||\n               !当前区 || 当前区<1 || rr3.length<1 ||\n               序列位置<0 || 序列位置>=rr3.length ||\n               rr3[序列位置]!=当前第几个号){\n                断点有效=\"否\";\n            }else{\n                总数区=取账号区数(当前第几个号);\n                应用跳11();\n                所有账号一轮=(rr3.length>1) ? \"是的\" : \"不用\";\n                目标账号=当前第几个号;\n                启动需切号=\"是\";\n            }\n\n        }else if(t.length>=9 && t[0]==\"V2\" && t[1]==\"有效\"){\n            当前第几个号=Number(t[2]);\n            当前区=Number(t[3]);\n            var oldTask2=t[4];\n            var oldEnd=Number(t[5]);\n            var oldMulti2=t[7];\n            var oldSeq=[];\n            if(t[6]==\"是的\" && oldEnd>=当前第几个号 && oldEnd<=8){\n                for(var oi=当前第几个号;oi<=oldEnd;oi++) oldSeq.push(oi);\n            }else{\n                oldSeq.push(当前第几个号);\n            }\n            账号序列=oldSeq.join(\"-\");\n            序列位置=0;\n            旧任务转槽(oldTask2,oldMulti2);\n            if(!当前第几个号 || 当前第几个号<1 || 当前第几个号>8 || !当前区 || 当前区<1){\n                断点有效=\"否\";\n            }else{\n                总数区=取账号区数(当前第几个号);\n                应用跳11();\n                所有账号一轮=(oldSeq.length>1) ? \"是的\" : \"不用\";\n                目标账号=当前第几个号;\n                启动需切号=\"是\";\n            }\n        }else{\n            断点有效=\"否\";\n        }\n    }catch(e){\n        断点有效=\"否\";\n    }\n\n}else{\n    当前任务序号=首任务序号();\n    应用当前任务();\n\n    if(运行方式==\"当前账号\"){\n        var 临时文本=String(临时账号||\"\").trim();\n        var 临时匹配=临时文本.match(\/^(\\d+)区$\/);\n\n        \/\/ 自动≤12：\n        \/\/ 不再要求人工填写真实区数。先把12当作安全上限，\n        \/\/ 每个已存在区仍走原来的固定坐标+蓝十字确认。\n        \/\/ 当“上一地区已经成功”而下一地区连续3次没有蓝十字时，\n        \/\/ 自动把上一地区认定为最后一区。\n        自动区数模式=\"否\";\n        自动区数失败区=0;\n        自动区数失败次数=0;\n        自动区数最高成功区=0;\n        自动区数判定结束=\"否\";\n智能区数人工上限=0;\n\n        if(临时文本==\"自动≤12\"){\n            临时模式=\"是\";\n            临时账号名称=\"当前账号\";\n            总数区=12;\n            当前区=开始区;\n            账号序列=\"\";\n            序列位置=0;\n            所有账号一轮=\"不用\";\n            启动需切号=\"否\";\n            目标账号=0;\n            当前第几个号=0;\n            跳过11区吗=\"不跳\";\n            自动区数模式=\"是\";\n        }else if(临时文本==\"9077安卓\"){\n            \/\/ 已知存在内部缺区的特殊账号继续走专用规则，\n            \/\/ 避免“缺区”被误当成“已经到末区”。\n            临时模式=\"是\";\n            临时账号名称=\"9077安卓\";\n            总数区=12;\n            当前区=开始区;\n            账号序列=\"\";\n            序列位置=0;\n            所有账号一轮=\"不用\";\n            启动需切号=\"否\";\n            目标账号=0;\n            当前第几个号=0;\n            跳过11区吗=\"跳过\";\n        }else if(临时匹配){\n            临时模式=\"是\";\n            临时账号名称=\"当前账号\";\n            var __manualZones=Number(临时匹配[1])||0;\n            \/\/ 大区智能探测只适合从前12区开始：先验证前12区，再恢复真实人工总数。\n            \/\/ 若用户指定第13区及之后作为起点，必须直接使用真实总数，\n            \/\/ 否则总数=12会被下方 当前区>总数区 截断成12区。\n            var __startZone=Number(开始区)||1;\n            \/\/ 真正总区数始终保持人工输入值；不再临时写12，避免HUD显示 x\/12。\n            \/\/ 首次打开选区列表时统一执行一次红绿点去重统计，再决定是否缩减。\n            智能区数人工上限=0;\n            总数区=__manualZones;\n            自动区数模式=\"否\";\n            当前区=开始区;\n            账号序列=\"\";\n            序列位置=0;\n            所有账号一轮=\"不用\";\n            启动需切号=\"否\";\n            目标账号=0;\n            当前第几个号=0;\n            跳过11区吗=\"不跳\";\n        }else{\n            断点有效=\"当前账号区数无效\";\n        }\n\n    }else{\n        自动区数模式=\"否\";\n        自动区数失败区=0;\n        自动区数失败次数=0;\n        自动区数最高成功区=0;\n        自动区数判定结束=\"否\";\n        var seq=解析账号序列(执行账号);\n        if(seq.length<1){\n            断点有效=\"账号无效\";\n        }else{\n            启动需切号=\"是\";\n            账号序列=seq.join(\"-\");\n            序列位置=0;\n            当前第几个号=seq[0];\n            当前区=开始区;\n            总数区=取账号区数(当前第几个号);\n            所有账号一轮=(seq.length>1) ? \"是的\" : \"不用\";\n            应用跳11();\n            目标账号=当前第几个号;\n        }\n    }\n}\n\nif(总数区<=0){\n    当前区=1;\n}else if(当前区>总数区){\n    当前区=总数区;\n}\n\n\/\/ V32: a fresh run must begin at the configured zone and the configured first nonempty task.\ntry{\n var _d=JSON.parse(String(zdjl.readFile('\/sdcard\/Download\/双王者V3_进度.json')||'{}'));\n var _id=Number(zdjl.getVar('双王者当前端','global'));\n if(_d.schema===3 && _d.config && _d.config[_id-1] && String(zdjl.getVar('双王者本次续区','global'))!=='是'){\n  var _c=_d.config[_id-1], _ts=_c.tasks||[], _fst='';\n  for(var _j=0;_j<_ts.length;_j++)if(_ts[_j]!=='无'){_fst=_ts[_j];break;}\n  var _expect={'浇水':'只浇水','祝福':'祝福','收割':'收割','稳收24田':'稳收24','巡田24田':'巡田24','十田经济':'十钱','1V1':'打11','55':'打55'}[_fst];\n  if(Number(当前区)!==Number(_c.start) || String(做啥)!==String(_expect)){\n   断点有效='V32任务初始化与保存配置不一致';\n   try{zdjl.appendFile('\/sdcard\/Download\/农场总控_配置链路.log',new Date().toISOString()+' INIT_MISMATCH expected='+_c.start+'\/'+_fst+' actual='+当前区+'\/'+做啥+'\\n');}catch(e){}\n  } else {\n   try{zdjl.appendFile('\/sdcard\/Download\/农场总控_配置链路.log',new Date().toISOString()+' INIT_OK '+当前区+'区 '+_fst+' => '+做啥+'\\n');}catch(e){}\n  }\n }\n}catch(_v32e){try{zdjl.appendFile('\/sdcard\/Download\/农场总控_配置链路.log','INIT_VERIFY_ERROR '+_v32e+'\\n');}catch(e){}}\nif(断点有效==\"是\" && String(特殊模式||\"\")!=\"只识别状态\") 保存断点(\"有效\");\n\n\/\/ ===== 统一HUD：紧凑单行；不创建后台定时器 =====\nfunction __hud2(n){\n    n=Number(n)||0;\n    return n<10 ? (\"0\"+n) : String(n);\n}\nfunction __hudTime(ms){\n    ms=Math.max(0,Number(ms)||0);\n    var sec=Math.floor(ms\/1000);\n    var h=Math.floor(sec\/3600);\n    var m=Math.floor((sec%3600)\/60);\n    var s=sec%60;\n    return h>0 ? (h+\":\"+__hud2(m)+\":\"+__hud2(s)) : (__hud2(m)+\":\"+__hud2(s));\n}\nfunction __hudBehavior(){\n    if(String(特殊模式||\"\")==\"只识别状态\") return \"状态识别\";\n    var arr=[];\n    if(String(任务1||\"\")!=\"无\") arr.push(String(任务1));\n    if(String(任务2||\"\")!=\"无\") arr.push(String(任务2));\n    if(String(任务3||\"\")!=\"无\") arr.push(String(任务3));\n    if(String(任务4||\"\")!=\"无\") arr.push(String(任务4));\n    if(String(任务5||\"\")!=\"无\") arr.push(String(任务5));\n    if(String(任务6||\"\")!=\"无\") arr.push(String(任务6));\n    return arr.length ? arr.join(\"→\") : \"任务\";\n}\nfunction __hudName(){\n    if(String(临时模式||\"\")==\"是\") return String(临时账号名称||\"?\");\n    var n=Number(当前第几个号)||0;\n    if(n==1) return String(账号1名称||\"1号\");\n    if(n==2) return String(账号2名称||\"2号\");\n    if(n==3) return String(账号3名称||\"3号\");\n    if(n==4) return String(账号4名称||\"4号\");\n    if(n==5) return String(账号5名称||\"5号\");\n    if(n==6) return String(账号6名称||\"6号\");\n    if(n==7) return String(账号7名称||\"7号\");\n    if(n==8) return String(账号8名称||\"8号\");\n    return \"?\";\n}\nfunction __hudCompactName(name){\n    var s=String(name||\"?\").trim();\n    \/\/ 只压缩常见平台后缀，保留账号主体，避免HUD换行。\n    s=s.replace(\/安卓$\/i,\"安\").replace(\/ios$\/i,\"i\").replace(\/vx$\/i,\"V\").replace(\/^当前账号$\/,\"当\");\n    return s||\"?\";\n}\n\nfunction __hudTaskShort(t){\n    t=String(t||\"\").trim()||\"运行\";\n    if(t==\"打11\") return \"11\";\n    if(t==\"打55\") return \"55\";\n    if(t==\"祝福\") return \"福\";\n    if(t==\"收割\") return \"收\";\n    if(t==\"稳收24\") return \"稳\";\n    if(t==\"巡田24\") return \"巡\";\n    if(t==\"十田\") return \"十\";\n    if(t==\"浇水\") return \"水\";\n    if(t==\"换英\") return \"英\";\n    if(t==\"换经\") return \"经\";\n    if(t==\"选区\") return \"选\";\n    if(t==\"切号\") return \"切\";\n    if(t==\"准备\") return \"备\";\n    return t;\n}\nfunction __hudRefresh(){\n    var start=Number(HUD启动时间)||Date.now();\n    var elapsed=Math.max(0,Date.now()-start);\n    var name=__hudCompactName(__hudName());\n    var area=(Number(当前区)||0)+\"\/\"+(Number(总数区)||0);\n    var task=__hudTaskShort(HUD任务);\n    var txt=\"\";\n    if(String(HUD完成||\"\")==\"是\"){\n        var finalMs=Number(HUD完成耗时)||elapsed;\n        txt=\"✅ 完成｜\"+__hudTime(finalMs);\n    }else{\n        txt=__hudTime(elapsed)+\"｜\"+name+\"｜\"+area+\"｜\"+task;\n    }\n    zdjl.setVar(\"HUD文本\",txt,\"global\");\n}\nHUD本次行为=__hudBehavior();\nHUD当前账号=__hudName();\n__hudRefresh();\n\/\/ 每次启动总控都重新创建“本轮HUD”。\n\/\/ 不再依据旧的全局标记判断窗口是否存在：标记可能残留，但真实HUD已经消失。\nHUD需要创建=\"是\";\ntry{\n    zdjl.setVar(\"HUD需要创建\",\"是\",\"global\");\n    \/\/ 旧版标记只做清理，不再参与本轮是否创建HUD的判断。\n    zdjl.setVar(\"HUD提示已创建\",\"否\",\"global\");\n    zdjl.setVar(\"HUD提示创建时间\",\"0\",\"global\");\n}catch(__hudGateErr){}\n\ntry{\n var __dc=Number(zdjl.getVar('双王者当前端','global'));\n var __hh=String(zdjl.getVar('HUD文本','global')||'');\n if((__dc===1||__dc===2)&&String(zdjl.getVar('双王者可运行','global'))==='是'&&__hh){\n  __hh=__hh.replace(\/^(?:王者[12]|当前)·\/,'');\n  zdjl.setVar('HUD文本',(String(zdjl.getVar('双王者直接当前','global'))==='是'?'当前':'王者'+__dc)+'·'+__hh,'global');\n }\n}catch(__huderr){}\n"}
{"type":"运行JS代码","delay":"0","delayUnit":1,"repeatCount":1,"desc":"恢复独立断点：任务槽+账号+区数","jsCode":"(function(){\n var P='\/sdcard\/Download\/双王者V3_进度.json';\n function G(n,d){try{var x=zdjl.getVar(n,'global');return x===null||x===undefined||x===''?d:x;}catch(e){return d;}}\n function S(n,v){zdjl.setVar(n,v,'global');}\n try{\n  if(String(G('双王者本次续区','否'))!=='是')return;\n  var d=JSON.parse(String(zdjl.readFile(P)||'')),s=d.snapshot;\n  if(d.schema!==3||!s||s.client!==d.current||s.zone<1||s.zone>36)throw Error('断点不匹配，拒绝跨端恢复');\n  if(Number(s.taskIndex)<1||Number(s.taskIndex)>6)throw Error('任务序号非法');\n  当前区=Number(s.zone);当前格=1;需要回顶='是';\n  当前任务序号=Number(s.taskIndex);\n  var keys=[任务1,任务2,任务3,任务4,任务5,任务6],t=String(keys[当前任务序号-1]||'无');\n  var conv={'浇水':'只浇水','祝福':'祝福','收割':'收割','稳收24田':'稳收24','巡田24田':'巡田24','十田经济':'十钱','1V1':'打11','55':'打55'};\n  if(!conv[t])throw Error('恢复任务槽为空');\n  做啥=conv[t];\n  if(String(G('运行方式',''))==='指定顺序'){\n    var order=String(s.accountSeq||''),pos=Number(s.sequencePos),ac=Number(s.account);\n    var parts=order.split('-');\n    if(!order||pos<0||pos>=parts.length||Number(parts[pos])!==ac)throw Error('账号断点与账号序列不一致');\n    账号序列=order;序列位置=pos;当前第几个号=ac;目标账号=ac;启动需切号='是';\n    总数区=Number(s.total)||总数区;\n    所有账号一轮=parts.length>1?'是的':'不用';\n    跳过11区吗=(Number(跳11号)>0&&ac===Number(跳11号))?'跳过':'不跳';\n    S('双王者恢复切号后区',当前区);S('双王者恢复切号后槽',当前任务序号);\n  }else{\n    if(s.tempMode!=='是')throw Error('恢复模式与当前账号临时模式不一致');\n    临时模式='是';临时账号名称=String(s.tempName||'当前账号');\n    总数区=Number(s.total)||总数区;启动需切号='否';目标账号=0;\n  }\n  S('双王者本次续区','否');\n  try{zdjl.appendFile('\/sdcard\/Download\/双王者V3_日志.txt',new Date().toISOString()+' RESTORED client='+d.current+' account='+s.account+' taskSlot='+s.taskIndex+' zone='+s.zone+'\\r\\n');}catch(e){}\n }catch(e){S('双王者可运行','否');try{zdjl.toast('双王者断点恢复失败：'+e,6000);}catch(x){}}\n})();\n"}
{"type":"控制执行","delay":"0","delayUnit":1,"condition":{"type":"jsExpression","expression":"String(zdjl.getVar(\"双王者可运行\",\"global\"))!==\"是\"","desc":""},"desc":"独立断点恢复失败｜停止","controlRunType":"stop","jumpToPosition":"","ContinueParentExecute":false}
{"type":"系统提示","delay":"0","delayUnit":1,"condition":{"type":"jsExpression","expression":"特殊模式!=\"只识别状态\" && (断点有效!=\"是\")","desc":"账号输入或断点无效"},"desc":"账号\/断点无效提示","promptType":"toast","promptText":"账号输入无效，或没有可继续的有效断点","promptTitle":"","showPosition":"bottom","playAudio":"false","useVibrator":false}
{"type":"运行多个动作","delay":"0","delayUnit":1,"condition":{"type":"jsExpression","expression":"特殊模式!=\"只识别状态\" && (断点有效!=\"是\")","desc":"账号输入或断点无效则停止"},"desc":"账号\/断点无效：停止（无需模块解绑）","scriptSet":[{"type":"控制执行","delay":"0","delayUnit":1,"desc":"账号\/断点无效：停止总控","controlRunType":"stop","jumpToPosition":"","ContinueParentExecute":false}],"runMode":"normal"}
{"type":"执行脚本","delay":"0","delayUnit":1,"condition":{"type":"jsExpression","expression":"特殊模式!=\"只识别状态\" && (启动需切号==\"是\"&&断点有效==\"是\")","desc":"需要主动定位第一个目标账号时执行"},"desc":"指定顺序\/继续上次：直接切到目标账号","scriptCallbacks":{"afterExecSuc":{"type":"运行JS代码","delay":"0","delayUnit":1,"desc":"新账号：载入区数\/跳11并从任务队列首任务开始","jsCode":"当前区=Math.max(1,Number(开始区)||1);\n当前格=1;\n需要回顶=\"是\";\n\nif(当前第几个号==1) 总数区=账号1区数;\nelse if(当前第几个号==2) 总数区=账号2区数;\nelse if(当前第几个号==3) 总数区=账号3区数;\nelse if(当前第几个号==4) 总数区=账号4区数;\nelse if(当前第几个号==5) 总数区=账号5区数;\nelse if(当前第几个号==6) 总数区=账号6区数;\nelse if(当前第几个号==7) 总数区=账号7区数;\nelse 总数区=账号8区数;\n\n跳过11区吗=(跳11号>0 && 当前第几个号==跳11号) ? \"跳过\" : \"不跳\";\n\nfunction __新号槽(i){\n    if(i==1) return String(任务1||\"无\");\n    if(i==2) return String(任务2||\"无\");\n    if(i==3) return String(任务3||\"无\");\n    if(i==4) return String(任务4||\"无\");\n    if(i==5) return String(任务5||\"无\");\n    if(i==6) return String(任务6||\"无\");\n    return \"无\";\n}\nfunction __新号做啥(t){\n    if(t==\"浇水\") return \"只浇水\";\n    if(t==\"祝福\") return \"祝福\";\n    if(t==\"收割\") return \"收割\";\n    if(t==\"稳收24田\") return \"稳收24\";\n    if(t==\"巡田24田\") return \"巡田24\";\n    if(t==\"十田经济\") return \"十钱\";\n    if(t==\"1V1\") return \"打11\";\n    if(t==\"55\") return \"打55\";\n    return \"\";\n}\n当前任务序号=1;\nwhile(当前任务序号<=6 && __新号槽(当前任务序号)==\"无\") 当前任务序号++;\n做啥=__新号做啥(__新号槽(当前任务序号));\n\ntry{\n    zdjl.writeFile(\"\/sdcard\/Download\/农场8账号断点.txt\",\n        \"V5|\"+\"有效\"+\"|\"+当前第几个号+\"|\"+当前区+\"|\"+任务1+\"|\"+任务2+\"|\"+任务3+\"|\"+任务4+\"|\"+任务5+\"|\"+任务6+\"|\"+当前任务序号+\"|\"+账号序列+\"|\"+序列位置+\"|\"+总数区+\"|\"+(Number(浇祝间隔)||0)+\"|\"+(Number(任务4延迟)||0)+\"|\"+(Number(任务5延迟)||0)+\"|\"+(Number(任务6延迟)||0)+\"|\"+特殊模式\n    );\n}catch(e){}\n\/\/ Only on resume, QQ switch callback normally resets zone=1; recover stored target zone & slot.\ntry{\n var __rz=Number(zdjl.getVar('双王者恢复切号后区','global'))||0;\n var __rs=Number(zdjl.getVar('双王者恢复切号后槽','global'))||0;\n if(__rz>=1&&__rz<=36&&__rs>=1&&__rs<=6){\n  当前区=__rz;当前任务序号=__rs;当前格=1;需要回顶='是';\n  var __tt=[任务1,任务2,任务3,任务4,任务5,任务6][__rs-1];\n  var __conv={'浇水':'只浇水','祝福':'祝福','收割':'收割','稳收24田':'稳收24','十田经济':'十钱','1V1':'打11','55':'打55'};\n  做啥=__conv[__tt]||做啥;\n  zdjl.setVar('双王者恢复切号后区',0,'global');zdjl.setVar('双王者恢复切号后槽',0,'global');\n }\n}catch(__re){try{zdjl.appendFile('\/sdcard\/Download\/双王者V3_日志.txt','QQ SWITCH RESTORE ERROR '+__re+'\\r\\n');}catch(z){}}\n"}},"filePath":"切换账号.zjs","continueCurrentAfterFinish":true}
{"type":"执行脚本","delay":"0","delayUnit":1,"condition":{"type":"jsExpression","expression":"String(zdjl.getVar(\"FC_V21_STATUS_ONLY\",\"global\")||\"\")===\"YES\" || (String(特殊模式)==='只识别状态'||String(特殊模式)==='开')","desc":"特殊模式=只识别状态时执行"},"desc":"单次识别：只运行查看状态.zjs一次｜不绑定｜无状态提示","jumpId":"单次识别入口","filePath":"查看状态.zjs","continueCurrentAfterFinish":true}
{"type":"控制执行","delay":"0","delayUnit":1,"condition":{"type":"jsExpression","expression":"String(zdjl.getVar(\"FC_V21_STATUS_ONLY\",\"global\")||\"\")===\"YES\" || (String(特殊模式)==='只识别状态'||String(特殊模式)==='开')","desc":"查看状态完成后直接结束"},"desc":"单次识别完成：立即结束","controlRunType":"stop","jumpToPosition":"","ContinueParentExecute":false}
{"type":"运行JS代码","delay":"0","delayUnit":1,"desc":"循环入口：王者状态显示 + 跳11 + HUD刷新","jumpId":"循环入口","jsCode":"\/\/ 双王者V4：原绑定轮询已删除。\nHUD任务=\"选区\";\n阶段已切换=\"否\";\n阶段需等待=\"否\";\n阶段等待分钟=0;\n\nif(总数区>0 && 跳过11区吗==\"跳过\" && 当前区==11){\n    当前区=12;\n    try{\n        zdjl.writeFile(\"\/sdcard\/Download\/农场8账号断点.txt\",\n            \"V5|\"+\"有效\"+\"|\"+当前第几个号+\"|\"+当前区+\"|\"+任务1+\"|\"+任务2+\"|\"+任务3+\"|\"+任务4+\"|\"+任务5+\"|\"+任务6+\"|\"+当前任务序号+\"|\"+账号序列+\"|\"+序列位置+\"|\"+总数区+\"|\"+(Number(浇祝间隔)||0)+\"|\"+(Number(任务4延迟)||0)+\"|\"+(Number(任务5延迟)||0)+\"|\"+(Number(任务6延迟)||0)+\"|\"+特殊模式\n        );\n    }catch(e){}\n}\n\ntry{\n    function __hf2(n){n=Number(n)||0;return n<10?(\"0\"+n):String(n);}\n    var __hms=Math.max(0,Date.now()-(Number(HUD启动时间)||Date.now()));\n    var __hsec=Math.floor(__hms\/1000);\n    var __hh=Math.floor(__hsec\/3600), __hm=Math.floor((__hsec%3600)\/60), __hs=__hsec%60;\n    var __htime=__hh>0 ? (__hh+\":\"+__hf2(__hm)+\":\"+__hf2(__hs)) : (__hf2(__hm)+\":\"+__hf2(__hs));\n    var __hname=String(HUD当前账号||\"\").trim()||\"?\";\n    __hname=__hname.replace(\/安卓$\/i,\"安\").replace(\/ios$\/i,\"i\").replace(\/vx$\/i,\"V\").replace(\/^当前账号$\/,\"当\");\n    if(__hname.length>6) __hname=__hname.slice(0,6);\n    var __harea=(Number(当前区)||0)+\"\/\"+(Number(总数区)||0);\n    var __htask=String(HUD任务||\"\").trim()||\"运行\";\n    if(__htask==\"打11\") __htask=\"11\";\n    else if(__htask==\"打55\") __htask=\"55\";\n    else if(__htask==\"祝福\") __htask=\"福\";\n    else if(__htask==\"收割\") __htask=\"收\";\n    else if(__htask==\"巡田24\" || __htask==\"巡田24田\") __htask=\"巡\";\n    else if(__htask==\"稳收24\" || __htask==\"稳收24田\") __htask=\"稳\";\n    else if(__htask==\"十田\") __htask=\"十\";\n    else if(__htask==\"浇水\") __htask=\"水\";\n    else if(__htask==\"换英\") __htask=\"英\";\n    else if(__htask==\"换经\") __htask=\"经\";\n    else if(__htask==\"选区\") __htask=\"选\";\n    else if(__htask==\"切号\") __htask=\"切\";\n    else if(__htask==\"准备\") __htask=\"备\";\n    HUD文本=__htime+\"·\"+__hname+\"·\"+__harea+\"·\"+__htask;\n    zdjl.setVar(\"HUD文本\",HUD文本,\"global\");\n}catch(__hudLiteErr){}\ntry{\n var __dc=Number(zdjl.getVar('双王者当前端','global'));\n var __hh=String(zdjl.getVar('HUD文本','global')||'');\n if((__dc===1||__dc===2)&&String(zdjl.getVar('双王者可运行','global'))==='是'&&__hh){\n  __hh=__hh.replace(\/^(?:王者[12]|当前)·\/,'');\n  zdjl.setVar('HUD文本',(String(zdjl.getVar('双王者直接当前','global'))==='是'?'当前':'王者'+__dc)+'·'+__hh,'global');\n }\n}catch(__huderr){}\n"}
{"type":"运行JS代码","delay":"0","delayUnit":1,"repeatCount":1,"desc":"进入每区时写当前王者、账号、任务、区号和HUD","jsCode":"(function(){\n var P='\/sdcard\/Download\/双王者V3_进度.json';\n try{\n  var d=JSON.parse(String(zdjl.readFile(P)||'')),id=Number(zdjl.getVar('双王者当前端','global'));\n  if(d.schema!==3||d.runId!==String(zdjl.getVar('双王者运行ID','global'))||d.current!==id||d.status==='全部完成')return;\n  \/\/ 还原当前王者设置：防止上一区收割脚本临时调整浇水\/一键，串到下一地区或下一任务。\n  var cfg=d.config&&d.config[id-1];\n  if(cfg){\n   if(cfg.crop)zdjl.setVar('换作物吗',String(cfg.crop),'global');\n   if(cfg.water)zdjl.setVar('浇水吗',String(cfg.water),'global');\n   if(cfg.oneKey)zdjl.setVar('一键设置',String(cfg.oneKey),'global');\n  }\n  var s={client:id,zone:Number(当前区)||0,total:Number(总数区)||0,taskIndex:Number(当前任务序号)||0,task:String(做啥||''),account:Number(当前第几个号)||0,accountSeq:String(账号序列||''),sequencePos:Number(序列位置)||0,tempMode:String(临时模式||''),tempName:String(临时账号名称||''),time:Date.now()};\n  if(s.zone>0&&s.zone<=36&&s.taskIndex>0&&s.taskIndex<=6){d.snapshot=s;d.phaseStarted=true;}\n  var __realLabel=String(zdjl.getVar('双王者直接当前','global'))==='是'?'当前':'王者'+id;\n  d.status=__realLabel+' 执行中';d.updatedAt=Date.now();delete d.bindingTask;\n  zdjl.writeFile(P,JSON.stringify(d));\n  var hud=String(zdjl.getVar('HUD文本','global')||'');\n  if(hud){hud=hud.replace(\/^(?:王者[12]|当前)·\/,'');zdjl.setVar('HUD文本',__realLabel+'·'+hud,'global');}\n }catch(e){try{zdjl.appendFile('\/sdcard\/Download\/双王者V3_日志.txt','HEARTBEAT ERROR '+e+'\\r\\n');}catch(z){}}\n})();\n\ntry{zdjl.appendFile('\/sdcard\/Download\/农场总控_配置链路.log',new Date().toISOString()+' ZONE client='+String(zdjl.getVar('双王者当前端','global')||'?')+' zone='+String(当前区)+' taskIndex='+String(当前任务序号)+' action='+String(做啥)+' crop='+String(zdjl.getVar('换作物吗','global')||'')+'\\n');}catch(__v32_trace){}\n"}
{"type":"控制执行","delay":"0","delayUnit":1,"condition":{"type":"jsExpression","expression":"当前区>总数区","desc":"当前区超过总数区时转到本账号收尾"},"desc":"当前阶段完成：进入任务队列阶段收尾","controlRunType":"jumpTo","jumpToPosition":":阶段收尾","ContinueParentExecute":false}
{"type":"运行JS代码","delay":"0","delayUnit":1,"desc":"选区V7：首次红绿点去重计数(11% 19% 100% 100%)｜12个保留人工总数｜少于12按实测","jumpId":"选区V6","jsCode":"\/\/ 视觉选区 V6：顶部12区直点 + 尾页固定大滑到底 + 仅中间区恢复多次微滑视觉追踪。\n\/\/ 核心：不OCR区号，不再猜“是否到底”；尾页靠重复大滑硬顶到底，中间少数区才付出逐行视觉追踪成本。\nvar __target=Number(当前区);\nvar __total=Number(总数区);\nvar __targetRow=Math.ceil(__target\/2);\nvar __totalRows=Math.ceil(__total\/2);\nvar __wantRight=(__target%2===0);\nvar __bottomFirstRow=Math.max(1,__totalRows-5);\nvar __clicked=false;\nvar __stuck=0;\nvar __maxSteps=60;\n\n\/\/ 消费旧版失败标志，但V6不再让它把顶部\/尾页强制切进重型校正。\ntry{if(String(zdjl.getVar(\"SEL_强制校正\",\"global\")||\"\")==\"是\") zdjl.setVar(\"SEL_强制校正\",\"否\",\"global\");}catch(__sf){}\n\n\/\/ 已实测的12格卡片内部点击点。顶部和真正到底后的最后一屏共用。\nvar __FX=[\"25.2%\",\"63.4%\",\"23.6%\",\"61.2%\",\"22.4%\",\"62.4%\",\"21%\",\"61.8%\",\"23.4%\",\"65.1%\",\"22.9%\",\"62%\"];\nvar __FY=[\"27.1%\",\"26.4%\",\"39%\",\"38.6%\",\"51.6%\",\"51.4%\",\"64.2%\",\"64.4%\",\"76.9%\",\"78.1%\",\"90.6%\",\"89.7%\"];\nfunction __fastSlot(slot,label){\n    slot=Number(slot);\n    if(slot<1||slot>12) return false;\n    try{\n        zdjl.click(__FX[slot-1],__FY[slot-1],100);\n        __clicked=true;\n        try{zdjl.toast(\"选区：\"+__target+\"区｜\"+label,700);}catch(e0){}\n        return true;\n    }catch(e){return false;}\n}\nfunction __bigToBottomSwipe(){\n    \/\/ 保留已经实测“一次大约推进6行”的手势参数；不再通过小探针提前判断到底。\n    try{\n        zdjl.touchDown(\"58.2%\",\"90%\");\n        zdjl.touchMove(\"58.2%\",\"10%\",720);\n        zdjl.sleep(100);\n        zdjl.touchUp();\n    }catch(e){\n        try{zdjl.touchUp();}catch(e2){}\n        zdjl.swipe(\"58.2%\",\"90%\",\"58.2%\",\"10%\",900);\n    }\n    zdjl.sleep(180);\n}\nfunction __forceBottom(){\n    \/\/ 当前实测每次大滑约6行。按5行\/次保守估算需要次数，宁可到底后再多滑一次，也绝不提前停。\n    var needRows=Math.max(0,__totalRows-6);\n    var n=Math.max(1,Math.ceil(needRows\/5));\n    if(n>4)n=4;\n    for(var i=0;i<n;i++) __bigToBottomSwipe();\n}\n\n\/\/ ===== 只有中间区才恢复旧版多次微滑视觉行追踪 =====\nvar __RED={\"type\":\"image\",\"imageData\":{\"data\":\"iVBORw0KGgoAAAANSUhEUgAAABAAAAAQCAYAAAAf8\/9hAAAAAXNSR0IArs4c6QAAAARzQklUCAgICHwIZIgAAAJ\/SURBVDiNfZHLbltVGIW\/\/Z99jm\/JwYlj4pCLUi5SO0rSFlUwYIDKACExQLxAeQCegRdjiMigEhFCDaWXOG3tuHVqx5dj+xyfvX8GcQSlqJ+0hmstaS1z55sfNfQOq0qgikFRA1EUsbfzPlYMIp5CFHL8pE1\/PCMHFIMTwUbesZJPCVS5ohJaGo0qxuWMOq\/xyZh4c51P60X+dCn9JMOrggO77FLEK3AZUI5Cbm7VeD1NsMMBX56dcGM+4Jdhm\/NPbnB7q8b9Fz3OkxleFfmn2VCOQg5217GqLLXb3DprspUmrOUZ3w9bjJvPGSYpex+sUqsUESPIwkspshzsrqMKvdMWn12ccXvS51qWEKoH4N5Fk8nJKYNktggpIF6gHAXc3K3jUR6dtvhw0mcvG1D3GYEBjFkIfhg2SZqnTMcT9jdriCuW2d9cQ+eO42abu6MO32UvqVqwBYstWCSySGixNsDagHvjFvHJU7J0juzv1LFiOG51+XrU4e6kS1kdGN4i4PJqi\/JV8orCw4fYYhAw7l3w7bjDF5MuJXVXm74VEvscgKIDr3Bn2kP+eN6l1u3w+b\/Nyju5yl71GVIVw++lVUYmJEO4fDX4j97EKoQLSX0pYqO6xKPyCg+imMwIWHu5+jtIjfA4qmCn6ZzrH23zW2ipPzthI5+y9L+9b5qPCu9xGDeQJ90hg2TK1s4G4+WYnyvrdCUiAxzgAVVQVWYIU4SjYpXDuEFld5vg+scHP73sdHHeQbXKyHl6LsepI9Q5Do+kOTr3HIUxfwVl7q9sULq2TSqCqDF4DE9b50xmGdJo8Cxe47BUp2VL5IsvE7FMJODB8hrlnU1yI\/za6vM3ov0iF5Y14ncAAAAASUVORK5CYII=\",\"imageWidth\":16,\"imageHeight\":16,\"imageLeft\":730,\"imageTop\":296,\"screenWidth\":1280,\"screenHeight\":720,\"screenDpi\":2},\"limitArea\":\"11% 19% 100% 100%\",\"searchMode\":\"color_2.21\",\"minSimilarPercent\":88,\"quickSearch\":false,\"codeVersion\":\"V1_7\",\"imageScaleType\":\"dpi\"};\nvar __GREEN={\"type\":\"image\",\"imageData\":{\"data\":\"iVBORw0KGgoAAAANSUhEUgAAABAAAAAQCAYAAAAf8\/9hAAAAAXNSR0IArs4c6QAAAARzQklUCAgICHwIZIgAAAKMSURBVDiNTZD9bhpHHADntx\/3zTlQUxzHNSitFPkB+kR9lr4ksSI7iuvYxYAxB7d3t7v5I6jqPMCMNPLnX3\/HoIWoFRGQAEll+fVDzXhc4vqB56c3dpsjvgsQQEJEIhAiJlohagERRIEpDeOLinqc0IoDgcksJxhoXlpCGxAgRhDAxEQQEbRSmJElmWXYd4Irn5ByjW8tNFPytCBmmn7lGA49fojECCYYhRIhqROy8wxVCKHYYC+XVNMHepeze\/iE7BZkNkVbxWEtDLseuoAREfSprAvB5FtGV7eM57ekxZbgLViPv7O44RLzLiUzOQGh33YYW1jqaYHKI8q+Uc2X1Isl2dkKpQd0aKnfLwk+YRMEvzknryoYchoXMfV5SZqC12uy2SPj6yVF\/YzoligeNIxUJJ19I1KyCgO8XFKVNerMY\/KxYfAvFLM76sU3ynqNMS1eBiIRAIsmSR3j6TOdF3bBIGvLaJJh4i8bVPGF8fwz9fkaYzqICjD8RxQAksQxma1pgAYoVteYfvoVe7UkP3sgTY8ABIQY9akPAxFkwCuHyT36wuN6hawqjO8MxkZiEgjysxREiETCSdDSg+wIsSOEFCUGQ0AYMPphjpSOzgq2WiPKAwNBHJwUAwGRFkLH4CbEpzPyxw+kTDC8VPDlE69BEX77SjFeofQe6Pg\/MSi6Q0Xz+J54v6DaXxP7DHM89Mi2ZPd5jtunlH8I+XlLZgUtpwd9Tn\/Iab5\/ZH+\/QO+uCV3B7t89pnk9ErVgXI1rFHsXqG5aprOG1A4AuHbE\/p\/fOd7d4F9n+LbgbdtwWB0xQ9NxIJKPCpTL6W8v0MbRpXvs5DvBJxyf5xzub\/DbK2Kbst+0NK8tsff8AC67PQCuYzMRAAAAAElFTkSuQmCC\",\"imageWidth\":16,\"imageHeight\":16,\"imageLeft\":178,\"imageTop\":528,\"screenWidth\":1280,\"screenHeight\":720,\"screenDpi\":2},\"limitArea\":\"11% 19% 100% 100%\",\"searchMode\":\"color_2.21\",\"minSimilarPercent\":88,\"quickSearch\":false,\"codeVersion\":\"V1_7\",\"imageScaleType\":\"dpi\"};\nvar __GRAY={\"type\":\"image\",\"imageData\":{\"data\":\"iVBORw0KGgoAAAANSUhEUgAAABAAAAAQCAIAAACQkWg2AAAClElEQVR4nE3QbWubVRjA8eu6zjn3Q5Iumtkl2jTprHXSVi2TiQ5B8Y0gTObDp5RRRBlsgtIXc24qCLayzth1bZM2W7qyPNxP59znunwl+v8CP\/jjypWvUGlUhpBEJIzixc5SrRoHSkbP0\/5gUNpc2At79haYtQpiJAVIpAwRtjqv6ciY2nlErMMEdDh8MnI2E196m7LNNaoAkADABNHSyiVl4uZ848Mra47Vra2fjZPFpeV+f8BlAQDsCi0CRFopXFl9Uxtdb9S\/\/Oxqu\/WC8+L1xo1vtiqhf\/Xi\/N7+EImADAFAGFeWVze0MdW56vVP3+8sNEyo41i\/td794tp7eeG1Up12WwcRkiYTRhdebkdxdK4+9\/FHly8unidCAADAKAzeWF3+\/NpV50QRvtJshXFFd5e6jeZ8s9X85IO1F89VQwHxXhgRQCPW5ypvb1yKomjz2\/tRHCx229qYwDO8e3l9bWFeUHIWAAJEACACo5XRan19WSS4dfunKFcURoqBHSMSaEXw\/xARARG11tVaDISAqL0ribKdP3cr2H7n9S4QASAAAgAKgIBnORyc3fz+l8l44rJEHxwcNl5q9nqPszStV2vddvM\/QYBL3j883fzuzunoeZJkx4\/2aDoZP3t2ZjSejkY3f\/ztoP\/EsK8pqKBMxtO7v\/719Y0fxmdjZ+3T\/pFnT8yczqa9BzultSfDp5u37\/3x9wCZSXg8Tu\/c3U6SzJf24OG2K1LxVouzXiSZ+t7DB52V1ePjk\/u\/10JtZtPJ1r2ddJrY3D7a3Xa2EPYiokFY2CNzniT9vd0LrYXHh4PhycjajNHMZsnRfs\/aAkBEWNhrEBEuvcsQVTqD0fBEvKvX4rwoXMn9o6Miz\/59wML+HzCBXI8aVlaIAAAAAElFTkSuQmCC\",\"imageWidth\":16,\"imageHeight\":16,\"imageLeft\":1194,\"imageTop\":34,\"screenWidth\":1280,\"screenHeight\":720,\"screenDpi\":2},\"limitArea\":\"12% 20% 99% 98%\",\"searchMode\":\"color_2.21\",\"minSimilarPercent\":84,\"quickSearch\":false,\"codeVersion\":\"V1_7\",\"imageScaleType\":\"dpi\"};\n\n\nfunction __arr(r){\n    if(!r) return [];\n    if(Object.prototype.toString.call(r)==='[object Array]') return r;\n    return [r];\n}\nfunction __all(tpl){\n    var out=[];\n    try{\n        var r=zdjl.findLocation(tpl,true);\n        out=__arr(r);\n        if(out.length>1) return out;\n    }catch(e){}\n    \/\/ 兼容部分版本：若 findLocation(..., true) 没有返回多结果，\n    \/\/ 再用 indexNum 逐个取第1～20个匹配。\n    var seen=[];\n    for(var i=1;i<=20;i++){\n        try{\n            var q={};\n            for(var k in tpl) q[k]=tpl[k];\n            q.indexNum=String(i);\n            var one=zdjl.findLocation(q);\n            if(!one) break;\n            var p=__xy(one);\n            if(!p) break;\n            var dup=false;\n            for(var d=0;d<seen.length;d++){\n                if(Math.abs(seen[d].x-p.x)<5 && Math.abs(seen[d].y-p.y)<5){dup=true;break;}\n            }\n            if(dup){\n                if(i>=2) break;\n            }else{\n                seen.push(p);\n            }\n        }catch(e2){break;}\n    }\n    if(seen.length>out.length) return seen;\n    return out;\n}\nfunction __xy(p){\n    if(!p) return null;\n    var x=Number(p.x), y=Number(p.y);\n    if(!isFinite(x) || !isFinite(y)) return null;\n    return {x:x,y:y};\n}\nfunction __detectRows(){\n    var raw=[];\n    var a=__all(__RED), b=__all(__GREEN), c=__all(__GRAY);\n    var src=[a,b,c];\n    for(var si=0;si<src.length;si++){\n        for(var i=0;i<src[si].length;i++){\n            var q=__xy(src[si][i]);\n            if(!q) continue;\n            \/\/ 只取右侧服务器列表；排除顶部“上次登录”和右上角状态图例。\n            if(q.x<145 || q.x>1270 || q.y<140 || q.y>710) continue;\n            var dup=false;\n            for(var d=0;d<raw.length;d++){\n                if(Math.abs(raw[d].x-q.x)<14 && Math.abs(raw[d].y-q.y)<14){dup=true;break;}\n            }\n            if(!dup) raw.push(q);\n        }\n    }\n    raw.sort(function(p1,p2){return p1.y-p2.y || p1.x-p2.x;});\n    var rows=[];\n    for(var r=0;r<raw.length;r++){\n        var p=raw[r], row=null;\n        for(var k=0;k<rows.length;k++){\n            if(Math.abs(rows[k].y-p.y)<=18){row=rows[k];break;}\n        }\n        if(!row){\n            row={y:p.y,pts:[]};\n            rows.push(row);\n        }\n        row.pts.push(p);\n        var sum=0;\n        for(var z=0;z<row.pts.length;z++) sum+=row.pts[z].y;\n        row.y=sum\/row.pts.length;\n    }\n    rows.sort(function(r1,r2){return r1.y-r2.y;});\n    for(var m=0;m<rows.length;m++){\n        rows[m].pts.sort(function(p1,p2){return p1.x-p2.x;});\n    }\n    \/\/ 网格合理性：相邻行中心距正常约92px，允许滚动中有轻微透视\/裁切。\n    if(rows.length>=2){\n        for(var n=1;n<rows.length;n++){\n            var gap=rows[n].y-rows[n-1].y;\n            if(gap<65 || gap>120){\n                return [];\n            }\n        }\n    }\n    return rows;\n}\nfunction __detectStable(){\n    var best=[];\n    for(var t=0;t<4;t++){\n        var r=__detectRows();\n        if(r.length>best.length) best=r;\n        if(r.length>=3) return r;\n        zdjl.sleep(120);\n    }\n    return best;\n}\nfunction __pickPoint(row,right){\n    if(!row || !row.pts) return null;\n    var mid=640;\n    var best=null;\n    for(var i=0;i<row.pts.length;i++){\n        var p=row.pts[i];\n        if(right){\n            if(p.x>mid && (!best || p.x<best.x)) best=p;\n        }else{\n            if(p.x<mid && (!best || p.x>best.x)) best=p;\n        }\n    }\n    return best;\n}\nfunction __microUp(){\n    \/\/ 只移动约6%屏高（约43px），小于一行92px的一半。\n    \/\/ touchMove 后停住再抬手，尽量消除惯性，保证一次最多跨过一行。\n    try{\n        zdjl.touchDown('58.2%','78%');\n        zdjl.touchMove('58.2%','72%',520);\n        zdjl.sleep(140);\n        zdjl.touchUp();\n    }catch(e){\n        try{zdjl.touchUp();}catch(e2){}\n        zdjl.swipe('58.2%','78%','58.2%','72%',700);\n    }\n    zdjl.sleep(180);\n}\n\nfunction __clickTrackedPoint(pt){\n    if(!pt) return false;\n    var w=1280;\n    try{var d=zdjl.getDeviceInfo();var a=Number(d.width)||1280,b=Number(d.height)||720;w=Math.max(a,b);}catch(e){}\n    try{zdjl.click(pt.x+w*0.02,pt.y,100);__clicked=true;return true;}catch(e2){return false;}\n}\n\n\/\/ ===== 一次性红绿点计数：每个账号首次进入选区列表，始终先于任何点击\/滑动 =====\n\/\/ 识别范围：X 11%~100%，Y 19%~100%。只数红+绿，不把灰点计为可用区。\n\/\/ 找色可能返回同一点的多个命中，必须先跨颜色去重再计数。\nfunction __scanVisibleZonesOnce(){\n    var w=1280,h=720;\n    try{\n        var d=zdjl.getDeviceInfo(), a=Number(d.width)||1280, b=Number(d.height)||720;\n        w=Math.max(a,b);h=Math.min(a,b);\n    }catch(e){}\n    var raw=[], seen=[__all(__RED),__all(__GREEN)], threshold=20*w\/1280;\n    for(var c=0;c<seen.length;c++){\n        for(var i=0;i<seen[c].length;i++){\n            var p=__xy(seen[c][i]);\n            if(!p || p.x<w*0.11 || p.x>w || p.y<h*0.19 || p.y>h)continue;\n            var duplicate=false;\n            for(var j=0;j<raw.length;j++){\n                \/\/ 同一点红+绿双命中、同一模板的重复命中只能计为1个区。\n                if(Math.abs(p.x-raw[j].x)<=threshold && Math.abs(p.y-raw[j].y)<=threshold){duplicate=true;break;}\n            }\n            if(!duplicate)raw.push(p);\n        }\n    }\n    if(raw.length<1||raw.length>12)return 0;\n    raw.sort(function(a,b){return a.y-b.y||a.x-b.x;});\n    var rows=[],rowTol=20*h\/720;\n    for(var k=0;k<raw.length;k++){\n        var p=raw[k],row=null;\n        for(var j=0;j<rows.length;j++)if(Math.abs(rows[j].y-p.y)<=rowTol){row=rows[j];break;}\n        if(!row){row={y:p.y,pts:[]};rows.push(row);}\n        row.pts.push(p);\n        var sum=0;for(var q=0;q<row.pts.length;q++)sum+=row.pts[q].y;\n        row.y=sum\/row.pts.length;\n    }\n    rows.sort(function(a,b){return a.y-b.y;});\n    \/\/ 若首排已不在顶部、每排多出第3点或上下行间距异常，属于错页\/误识别。\n    if(rows.length<1||rows.length>6||rows[0].y>h*0.37)return 0;\n    var count=0;\n    for(var r=0;r<rows.length;r++){\n        var pts=rows[r].pts;\n        if(pts.length<1||pts.length>2)return 0;\n        if(r>0){\n            var gap=rows[r].y-rows[r-1].y;\n            if(gap<65*h\/720||gap>120*h\/720)return 0;\n        }\n        if(pts.length===2){\n            if(!((pts[0].x<w\/2)!=(pts[1].x<w\/2)))return 0;\n        }else{\n            \/\/ 正常列表仅末行可单点，且应在左列，防止漏识别误判11区。\n            if(r!==rows.length-1||pts[0].x>=w\/2)return 0;\n        }\n        count+=pts.length;\n    }\n    return count>=1&&count<=12?count:0;\n}\nvar __zoneKey=String(临时模式||\"\")===\"是\" ? \"当前\/\"+String(临时账号名称||\"当前账号\") : \"编号\/\"+String(当前第几个号||0);\nvar __oldKey=\"\";\ntry{__oldKey=String(zdjl.getVar(\"选区总数扫描账号键\",\"global\")||\"\");}catch(e){}\nvar __zoneScanInvalid=false;\nif(__zoneKey!==__oldKey){\n    \/\/ 先保存账号键：同账号即使有后续六任务或多区切换也不重复统计或累加。\n    try{zdjl.setVar(\"选区总数扫描账号键\",__zoneKey,\"global\");}catch(e){}\n    var __detected=__scanVisibleZonesOnce();\n    try{zdjl.setVar(\"选区总数扫描结果\",__detected,\"global\");}catch(e){}\n    if(__detected>=1&&__detected<12){\n        总数区=__detected;\n        自动区数模式=\"否\";\n        智能区数人工上限=0;\n        try{zdjl.setVar(\"总数区\",__detected,\"global\");}catch(e){}\n        try{zdjl.toast(\"选区首次扫描：\"+__detected+\"个红绿点，本次按\"+__detected+\"区运行\",1600);}catch(e){}\n    }else if(__detected===12){\n        \/\/ 12个是当前屏的可见容量，不是实际账号总数，保留用户输入的20\/28\/36等。\n        自动区数模式=\"否\";\n        智能区数人工上限=0;\n        try{zdjl.toast(\"选区首次扫描：12个，按原设定\"+总数区+\"区运行\",1300);}catch(e){}\n    }else{\n        \/\/ 无法可靠数清时禁止据此把人工20区误改成0或11，保留原值。\n        try{zdjl.toast(\"红绿点扫描不可靠，保留原设定\"+总数区+\"区\",1800);}catch(e){}\n    }\n    if(__detected>=1&&__detected<12 && Number(当前区)>Number(总数区)){\n        __zoneScanInvalid=true;\n        try{zdjl.setVar(\"选区总数扫描起点异常\",\"是\",\"global\");}catch(e){}\n        try{zdjl.toast(\"起始\"+当前区+\"区超出检测的\"+总数区+\"区，停止避免误选\",3000);}catch(e){}\n    }\n}\n\/\/ 总数有可能从人工20区缩减成实测8区，按新的有效总数重算坐标与尾页。\n__total=Number(总数区);\n__totalRows=Math.ceil(__total\/2);\n__bottomFirstRow=Math.max(1,__totalRows-5);\nif(!__zoneScanInvalid){\n\/\/ ===== 快速两端 =====\nif(__target>=1&&__target<=__total){\n    if(__target<=12){\n        \/\/ 前12区：列表默认顶部，完全不滚动、不找图。\n        __fastSlot(__target,\"顶部直点\");\n    }else if(__targetRow>=__bottomFirstRow){\n        \/\/ 最后一屏：适用于任意总区数。19\/24\/31\/36都会自动套用，不写死31区。\n        __forceBottom();\n        \/\/ 大下拉全部完成后，额外等待1秒，等列表稳定后再点击目标区。\n        zdjl.sleep(1000);\n        var __lastSlot=(__total%2===0)?12:11;\n        var __tailSlot=__lastSlot-(__total-__target);\n        __fastSlot(__tailSlot,\"尾页到底\");\n    }\n}\n\nif(!__clicked&&__target>12&&__targetRow<__bottomFirstRow&&__target<=__total){\n    var __firstLogicalRow=1;\n    var __rows=__detectStable();\n    if(__rows.length>0){\n        var __prevTop=__rows[0].y;\n        for(var __step=0;__step<__maxSteps;__step++){\n            var __idx=__targetRow-__firstLogicalRow;\n            if(__idx>=0&&__idx<__rows.length){\n                var __row=__rows[__idx];\n                if(__row.y>=150&&__row.y<=685){\n                    var __pt=__pickPoint(__row,__wantRight);\n                    if(__pt&&__clickTrackedPoint(__pt)){\n                        try{zdjl.toast(\"选区：\"+__target+\"区｜中段微滑\",900);}catch(e3){}\n                        break;\n                    }\n                }\n            }\n            __microUp();\n            var __newRows=__detectStable();\n            if(__newRows.length===0){\n                __stuck++;\n                if(__stuck>=4) break;\n                continue;\n            }\n            var __newTop=__newRows[0].y;\n            if(__newTop>__prevTop+10){\n                __firstLogicalRow++;\n                __stuck=0;\n            }else if(Math.abs(__newTop-__prevTop)<5){\n                __stuck++;\n            }else{\n                __stuck=0;\n            }\n            __prevTop=__newTop;\n            __rows=__newRows;\n            if(__firstLogicalRow>__targetRow||__stuck>=6) break;\n        }\n    }\n}\n\nif(!__clicked){\n    try{zdjl.toast(\"选区未可靠定位第\"+__target+\"区，蓝十字失败后自动归顶重试\",1800);}catch(e){}\n}\n}\n"}

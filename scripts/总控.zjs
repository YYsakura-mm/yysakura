{"type":"执行脚本","delay":"0","delayUnit":1,"condition":{"type":"jsExpression","expression":"做啥==\"十钱\"","desc":"当前任务=十田经济"},"desc":"十田经济：前10块固定种16经济，完成后切16经验并浇水领奖","scriptCallbacks":{"beforeStartExec":{"type":"运行JS代码","delay":"0","delayUnit":1,"desc":"更新HUD账号与主任务","jsCode":"\/\/ 当前账号名称\nif(临时模式==\"是\"){\n    HUD当前账号=String(临时账号名称||\"\");\n}else{\n    if(当前第几个号==1) HUD当前账号=String(账号1名称||\"1号\");\n    else if(当前第几个号==2) HUD当前账号=String(账号2名称||\"2号\");\n    else if(当前第几个号==3) HUD当前账号=String(账号3名称||\"3号\");\n    else if(当前第几个号==4) HUD当前账号=String(账号4名称||\"4号\");\n    else if(当前第几个号==5) HUD当前账号=String(账号5名称||\"5号\");\n    else if(当前第几个号==6) HUD当前账号=String(账号6名称||\"6号\");\n    else if(当前第几个号==7) HUD当前账号=String(账号7名称||\"7号\");\n    else if(当前第几个号==8) HUD当前账号=String(账号8名称||\"8号\");\n    else HUD当前账号=\"?\";\n}\n\n\/\/ HUD只显示“主任务”，不显示后续扫描识别。\n\/\/ 打11\/打55进入子脚本后仍一直保持打11\/打55。\nif(做啥==\"打11\"){\n    HUD任务=\"打11\";\n}else if(做啥==\"打55\"){\n    HUD任务=\"打55\";\n}else if(做啥==\"祝福\" || 做啥==\"嘎嘎祝福\" || 做啥==\"祝福右边\"){\n    HUD任务=\"祝福\";\n}else if(做啥==\"收割\"){\n    HUD任务=\"收割\";\n}else if(做啥==\"十钱\"){\n    HUD任务=\"十田\";\n}else if(做啥==\"只浇水\"){\n    if(换作物吗==\"换英雄\") HUD任务=\"换英\";\n    else if(换作物吗==\"换经济\") HUD任务=\"换经\";\n    else HUD任务=\"浇水\";\n}else{\n    HUD任务=\"\";\n}\n\n\/\/ HUD轻量刷新：紧凑单行；性能统计只写文件，不占屏幕。\ntry{\n    function __hf2(n){n=Number(n)||0;return n<10?(\"0\"+n):String(n);}\n    var __hms=Math.max(0,Date.now()-(Number(HUD启动时间)||Date.now()));\n    var __hsec=Math.floor(__hms\/1000);\n    var __hh=Math.floor(__hsec\/3600), __hm=Math.floor((__hsec%3600)\/60), __hs=__hsec%60;\n    var __htime=__hh>0 ? (__hh+\":\"+__hf2(__hm)+\":\"+__hf2(__hs)) : (__hf2(__hm)+\":\"+__hf2(__hs));\n    var __hname=String(HUD当前账号||\"\").trim()||\"?\";\n    __hname=__hname.replace(\/安卓$\/i,\"安\").replace(\/ios$\/i,\"i\").replace(\/vx$\/i,\"V\").replace(\/^当前账号$\/,\"当\");\n    if(__hname.length>6) __hname=__hname.slice(0,6);\n    var __harea=(Number(当前区)||0)+\"\/\"+(Number(总数区)||0);\n    var __htask=String(HUD任务||\"\").trim()||\"运行\";\n    if(__htask==\"打11\") __htask=\"11\";\n    else if(__htask==\"打55\") __htask=\"55\";\n    else if(__htask==\"祝福\") __htask=\"福\";\n    else if(__htask==\"收割\") __htask=\"收\";\n    else if(__htask==\"十田\") __htask=\"十\";\n    else if(__htask==\"浇水\") __htask=\"水\";\n    else if(__htask==\"换英\") __htask=\"英\";\n    else if(__htask==\"换经\") __htask=\"经\";\n    else if(__htask==\"选区\") __htask=\"选\";\n    else if(__htask==\"切号\") __htask=\"切\";\n    else if(__htask==\"准备\") __htask=\"备\";\n    HUD文本=__htime+\"·\"+__hname+\"·\"+__harea+\"·\"+__htask;\n    zdjl.setVar(\"HUD文本\",HUD文本,\"global\");\n}catch(__hudLiteErr){}\n\ntry{\n var __dc=Number(zdjl.getVar('双王者当前端','global'));\n var __hh=String(zdjl.getVar('HUD文本','global')||'');\n if((__dc===1||__dc===2)&&String(zdjl.getVar('双王者可运行','global'))==='是'&&__hh){\n  __hh=__hh.replace(\/^王者[12]·\/,'');\n  zdjl.setVar('HUD文本','王者'+__dc+'·'+__hh,'global');\n }\n}catch(__huderr){}\n"}},"filePath":"十田经济种植.zjs","continueCurrentAfterFinish":true}

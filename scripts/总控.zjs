{"type":"运行多个动作","delay":"0","delayUnit":1,"repeatCount":1,"desc":"正式执行时才初始化OCR（主界面浏览与退出不连接OCR）｜记录耗时｜沿用原启动清理","scriptSet":[{"type":"运行JS代码","delay":"0","delayUnit":1,"repeatCount":1,"desc":"OCR实际启动时计时","jsCode":"(function(){\nvar n=Date.now();\ntry{zdjl.setVar(\"FC_OCR_BOOT_T0\",String(n),\"global\");}catch(e){}\ntry{zdjl.appendFile(\"\/sdcard\/Download\/总控OCR初始化耗时.txt\",new Date(n).toISOString()+\"  开始：正式执行任务，准备初始化OCR\\r\\n\");}catch(e){}\n})();"},{"type":"执行脚本","delay":"0","delayUnit":1,"repeatCount":1,"desc":"沿用原OCR初始化","filePath":"初始化OCR.zjs","continueCurrentAfterFinish":true},{"type":"运行JS代码","delay":"0","delayUnit":1,"repeatCount":1,"desc":"OCR初始化结束记时","jsCode":"(function(){\nvar n=Date.now(),p=0,ok=false;\ntry{p=Number(zdjl.getVar(\"FC_OCR_BOOT_T0\",\"global\")||0);}catch(e){}\ntry{ok=typeof zdjl.getVar(\"ocrText\",\"global\")===\"function\";}catch(e){}\ntry{zdjl.appendFile(\"\/sdcard\/Download\/总控OCR初始化耗时.txt\",new Date(n).toISOString()+\"  完成：OCR初始化=\"+(ok?\"函数已注册\":\"函数不可用\")+\"，耗时=\"+(p>0?n-p:\"未知\")+\"ms\\r\\n\");}catch(e){}\n})();"},{"type":"运行JS代码","delay":"0","delayUnit":1,"repeatCount":1,"desc":"新运行首次清理旧的换端标记；同轮跳转会跳过此步骤","jsCode":"try{zdjl.setVar('双王者内部换端','否','global');zdjl.setVar('双王者恢复切号后区',0,'global');zdjl.setVar('双王者恢复切号后槽',0,'global');zdjl.setVar('双王者启动操作','switch','global');}catch(e){}"}]}
{"type":"运行JS代码","delay":"0","delayUnit":1,"repeatCount":1,"desc":"双王者调度｜原生桌面图标参数，独立任务与断点","jumpId":"双王者入口","jsCode":"(function(){\n var P='\/sdcard\/Download\/双王者V3_进度.json',LOG='\/sdcard\/Download\/双王者V3_日志.txt';\n function G(n,d){try{var v=zdjl.getVar(n,'global');return v===null||v===undefined||v===''?d:v;}catch(e){return d;}}\n function S(n,v){zdjl.setVar(n,v,'global');}\n function read(){return JSON.parse(String(zdjl.readFile(P)||''));}\n function write(d){d.updatedAt=Date.now();var t=JSON.stringify(d);zdjl.writeFile(P,t);if(String(zdjl.readFile(P)||'')!==t)throw Error('独立进度写入后校验失败');}\n function log(t){try{zdjl.appendFile(LOG,new Date().toISOString()+' INIT '+t+'\\r\\n');}catch(e){}}\n function arr(s){return s==='当前王者'?[1]:s==='仅王者1'?[1]:s==='仅王者2'?[2]:s==='王者1→王者2'?[1,2]:s==='王者2→王者1'?[2,1]:null;}\n var v32=null;\n function J(t){try{zdjl.appendFile('\/sdcard\/Download\/农场总控_配置链路.log',new Date().toISOString()+' '+t+'\\n');}catch(e){}}\n function F(k,d){if(v32&&Object.prototype.hasOwnProperty.call(v32,k))return v32[k];return G(k,d);}\n\n try{\n  S('双王者可运行','否');S('双王者启动成功','否');\n  var internal=String(G('双王者内部换端','否'))==='是';\n  var mode=String(G('双王者启动选择','新任务'));\n  var d,order,client,config=[],restoring=false,allowed={'无':1,'浇水':1,'祝福':1,'收割':1,'稳收24田':1,'巡田24田':1,'十田经济':1,'1V1':1,'55':1};\n  if(internal||mode==='恢复断点'){\n    d=read();if(d.schema!==3||d.status==='全部完成'||!Array.isArray(d.order)||!Array.isArray(d.config)||d.phase<0||d.phase>=d.order.length)throw Error('不存在有效的双王者断点');\n    order=d.order;config=d.config;restoring=(!internal&&d.phaseStarted===true&&!!d.snapshot);\n    S('双王者内部换端','否');log('读取断点 phase='+d.phase+' 内部换端='+internal+' 从旧位置恢复='+restoring);\n  }else if(mode==='新任务'){\n    var item=JSON.parse(String(G('FC_V32_LAUNCH_JSON','')));\n    if(!item||item.schema!==32||!item.config||item.when<Date.now()-7200000 || String(G('FC_V32_PREFLIGHT_OK',''))!=='YES')throw Error('V32启动配置未确认，拒绝使用默认浇水\/1区');\n    v32=item.config;\n    var orderName=String(F('双王者运行顺序','当前王者'));\n    order=arr(orderName);if(!order)throw Error('运行顺序无效');\n    var directCurrent=orderName==='当前王者';\n    for(var i=1;i<=2;i++){\n      var c={id:i,mode:String(F('王者'+i+'账号模式','当前账号')),zones:String(F('王者'+i+'区数','自动≤12')),accounts:String(F('王者'+i+'执行账号','1')),start:Number(F('王者'+i+'开始区',1)),tasks:[],delays:[],waterBless:Number(F('王者'+i+'浇祝间隔',0)),crop:String(F('王者'+i+'换作物吗','不换')),water:String(F('王者'+i+'浇水吗','浇水')),oneKey:String(F('王者'+i+'一键设置','不动'))};\n      if(c.mode!=='当前账号'&&c.mode!=='指定顺序')throw Error('王者'+i+'账号模式错误');\n      if(!(c.start>=1&&c.start<=36&&c.start===Math.floor(c.start)))throw Error('王者'+i+'开始区应为1～36');\n      for(var k=1;k<=6;k++){var t=String(F('王者'+i+'任务'+k,k===1?'浇水':'无'));if(!allowed[t])throw Error('王者'+i+'任务'+k+'无效');c.tasks.push(t);}\n      for(k=4;k<=6;k++){var delay=Number(F('王者'+i+'任务'+k+'延迟',0));if(!(delay>=0&&delay<=10080))throw Error('王者'+i+'任务'+k+'延迟错误');c.delays.push(delay);}\n      if(!(c.waterBless>=0&&c.waterBless<=10080))throw Error('王者'+i+'浇祝间隔错误');\n      config.push(c);\n    }\n    \/\/ 当前王者只借用第一套任务配置，不代表王者1客户端，不切换QQ账号。\n    if(directCurrent){config[0].mode='当前账号';config[0].accounts='1';}\n    d={schema:3,status:'待启动',phase:0,phaseStarted:false,order:order,config:config,completed:[],snapshot:null,runId:String(Date.now())+'-'+Math.floor(Math.random()*9999),updatedAt:0,directCurrent:directCurrent};\n    write(d);J('DISPATCH_NEW order='+orderName+' 首端='+order[0]+' start='+config[order[0]-1].start+' task1='+config[order[0]-1].tasks[0]+' tasks='+config[order[0]-1].tasks.join('→'));\n    S('FC_V32_LAUNCH_JSON',''); S('FC_V32_PREFLIGHT_OK','NO');\n    log('开始全新双王者调度 order='+order.join('→'));\n  }else throw Error('启动选择不支持：'+mode);\n  var directly=!!d.directCurrent;\n  client=Number(order[d.phase]);var now=config[client-1];\n  if(!now||now.id!==client)throw Error('双端配置与当前阶段不符');\n  \/\/ 启动图标由原生找图动作定位，无需填写百分比坐标。\n  if(now.tasks.filter(function(t){return t!=='无';}).length<1)throw Error('王者'+client+'没有配置实际任务');\n  \/\/ 动作前持久化当前端；脚本崩溃后不再猜测当前客户端。\n  d.current=client;d.status=directly?'当前王者直接运行':'启动王者'+client;d.updatedAt=Date.now();write(d);\n  S('双王者直接当前',directly?'是':'否');\n  S('双王者当前端',client);S('双王者运行ID',d.runId);S('双王者本次续区',restoring?'是':'否');S('双王者阶段编号',d.phase);S('双王者下一端','否');S('双王者可运行','是');S('双王者启动成功','否');\n  S('运行方式',now.mode);S('临时账号',now.zones);S('执行账号',now.accounts);S('开始区',now.start);\n  for(k=1;k<=6;k++)S('任务'+k,now.tasks[k-1]);\n  for(k=4;k<=6;k++)S('任务'+k+'延迟',Number(now.delays[k-4])||0);\n  S('浇祝间隔',Number(now.waterBless)||0);\n  \/\/ 两个分身各自的农场操作选项，传入子脚本原本读取的三项全局变量。\n  \/\/ 老断点缺少新字段时，回退到当前界面配置；不修改断点结构。\n  S('换作物吗',String(now.crop||G('王者'+client+'换作物吗','不换')));\n  S('浇水吗',String(now.water||G('王者'+client+'浇水吗','浇水')));\n  S('一键设置',String(now.oneKey||G('王者'+client+'一键设置','不动')));\n  S('双王者提示',directly?'当前王者选区中':'王者'+client+' 启动中');\n  log('V30_CROP_SNAPSHOT client='+client+' mode='+mode+' crop='+now.crop+' global='+String(G('换作物吗','?'))+' runId='+d.runId);\n  try{zdjl.appendFile('\/sdcard\/Download\/农场总控_变量核对.log',new Date().toISOString()+' DISPATCH client='+client+' crop='+now.crop+' global='+String(G('换作物吗','?'))+' runId='+d.runId+'\\n');}catch(__v30log){}\n  log((directly?'当前王者直跑':'即将进入王者'+client)+' 顺序'+(d.phase+1)+'\/'+order.length+' 新阶段='+(!restoring));\n }catch(e){S('双王者可运行','否');log('ERROR '+String(e));try{zdjl.toast('双王者停止：'+e,5000);}catch(x){}}\n})();\n"}

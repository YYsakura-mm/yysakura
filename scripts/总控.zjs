+source+\" slot=\"+slot+\" crop1=\"+G(\"王者1换作物吗\")+\" crop2=\"+G(\"王者2换作物吗\")+\" order=\"+G(\"双王者运行顺序\")+\" task1=\"+G(\"王者1任务1\"));\n try{zdjl.setVar(\"FC_V30_TEMP_JSON\",\"\",\"global\");}catch(e){}\n})();\ntry{zdjl.setVar(\"王者1账号模式\",\"当前账号\",\"global\");zdjl.setVar(\"王者2账号模式\",\"当前账号\",\"global\");}catch(e){}\n})();\ntry{特殊模式=zdjl.getVar(\"特殊模式\",\"global\");}catch(e){}\ntry{双王者运行顺序=zdjl.getVar(\"双王者运行顺序\",\"global\");}catch(e){}\ntry{王者1账号模式=zdjl.getVar(\"王者1账号模式\",\"global\");}catch(e){}\ntry{王者2账号模式=zdjl.getVar(\"王者2账号模式\",\"global\");}catch(e){}\ntry{王者1区数=zdjl.getVar(\"王者1区数\",\"global\");}catch(e){}\ntry{王者2区数=zdjl.getVar(\"王者2区数\",\"global\");}catch(e){}\ntry{王者1开始区=zdjl.getVar(\"王者1开始区\",\"global\");}catch(e){}\ntry{王者2开始区=zdjl.getVar(\"王者2开始区\",\"global\");}catch(e){}\ntry{王者1任务1=zdjl.getVar(\"王者1任务1\",\"global\");}catch(e){}\ntry{王者1任务2=zdjl.getVar(\"王者1任务2\",\"global\");}catch(e){}\ntry{王者1任务3=zdjl.getVar(\"王者1任务3\",\"global\");}catch(e){}\ntry{王者1任务4=zdjl.getVar(\"王者1任务4\",\"global\");}catch(e){}\ntry{王者1任务5=zdjl.getVar(\"王者1任务5\",\"global\");}catch(e){}\ntry{王者1任务6=zdjl.getVar(\"王者1任务6\",\"global\");}catch(e){}\ntry{王者2任务1=zdjl.getVar(\"王者2任务1\",\"global\");}catch(e){}\ntry{王者2任务2=zdjl.getVar(\"王者2任务2\",\"global\");}catch(e){}\ntry{王者2任务3=zdjl.getVar(\"王者2任务3\",\"global\");}catch(e){}\ntry{王者2任务4=zdjl.getVar(\"王者2任务4\",\"global\");}catch(e){}\ntry{王者2任务5=zdjl.getVar(\"王者2任务5\",\"global\");}catch(e){}\ntry{王者2任务6=zdjl.getVar(\"王者2任务6\",\"global\");}catch(e){}\ntry{王者1任务4延迟=zdjl.getVar(\"王者1任务4延迟\",\"global\");}catch(e){}\ntry{王者1任务5延迟=zdjl.getVar(\"王者1任务5延迟\",\"global\");}catch(e){}\ntry{王者1任务6延迟=zdjl.getVar(\"王者1任务6延迟\",\"global\");}catch(e){}\ntry{王者2任务4延迟=zdjl.getVar(\"王者2任务4延迟\",\"global\");}catch(e){}\ntry{王者2任务5延迟=zdjl.getVar(\"王者2任务5延迟\",\"global\");}catch(e){}\ntry{王者2任务6延迟=zdjl.getVar(\"王者2任务6延迟\",\"global\");}catch(e){}\ntry{王者1换作物吗=zdjl.getVar(\"王者1换作物吗\",\"global\");}catch(e){}\ntry{王者1浇水吗=zdjl.getVar(\"王者1浇水吗\",\"global\");}catch(e){}\ntry{王者1一键设置=zdjl.getVar(\"王者1一键设置\",\"global\");}catch(e){}\ntry{王者2换作物吗=zdjl.getVar(\"王者2换作物吗\",\"global\");}catch(e){}\ntry{王者2浇水吗=zdjl.getVar(\"王者2浇水吗\",\"global\");}catch(e){}\ntry{王者2一键设置=zdjl.getVar(\"王者2一键设置\",\"global\");}catch(e){}\ntry{启动方式=zdjl.getVar(\"启动方式\",\"global\");}catch(e){}\ntry{定时开始时间=zdjl.getVar(\"定时开始时间\",\"global\");}catch(e){}\ntry{跳过11区吗=zdjl.getVar(\"跳过11区吗\",\"global\");}catch(e){}\ntry{浇祝间隔=zdjl.getVar(\"浇祝间隔\",\"global\");}catch(e){}\n\/\/ V8.1: 界面固定项；每次人工开始都是新任务，不读取旧的隐藏输入。\n双王者启动选择=\"新任务\";\n王者1账号模式=\"当前账号\";王者2账号模式=\"当前账号\";\n王者1执行账号=\"1\";王者2执行账号=\"1\";\ntry{\n    zdjl.setVar(\"双王者启动选择\",\"新任务\",\"global\");\n    zdjl.setVar(\"王者1账号模式\",\"当前账号\",\"global\");\n    zdjl.setVar(\"王者2账号模式\",\"当前账号\",\"global\");\n    zdjl.setVar(\"王者1执行账号\",\"1\",\"global\");\n    zdjl.setVar(\"王者2执行账号\",\"1\",\"global\");\n}catch(__uiDefaultError){}\n\n\/\/ ===== UI短文案映射：只改显示，不改后续业务协议 =====\nif(String(特殊模式||\"关\")===\"开\") 特殊模式=\"只识别状态\";\nelse 特殊模式=\"正常任务\";\n\nif(String(启动方式||\"立即\")===\"定时\") 启动方式=\"定时开始\";\nelse 启动方式=\"立即开始\";\n\n(function(){\n    if(String(启动方式||\"立即开始\")!==\"定时开始\") return;\n\n    var s=String(定时开始时间||\"\").replace(\/^\\s+|\\s+$\/g,\"\");\n    var m=\/^(?:([01]?\\d|2[0-3])):([0-5]\\d)$\/.exec(s);\n    if(!m){\n        try{zdjl.toast(\"定时时间格式错误，请填写 HH:mm，例如 00:20\",5000);}catch(e){}\n        try{zdjl.runAction({\"type\":\"控制执行\",\"delay\":\"0\",\"delayUnit\":1,\"controlRunType\":\"stop\",\"jumpToPosition\":\"\",\"ContinueParentExecute\":false});}catch(e2){}\n        return;\n    }\n\n    var hh=Number(m[1]);\n    var mm=Number(m[2]);\n    var now=new Date();\n    var target=new Date(now.getFullYear(),now.getMonth(),now.getDate(),hh,mm,0,0);\n\n    \/\/ 如果确认启动时已经处于目标分钟，直接开始；只有目标分钟已经完整过去，才排到第二天。\n    var sameMinute=(now.getHours()===hh && now.getMinutes()===mm);\n    if(sameMinute){\n        target=new Date(now.getTime());\n    }else if(target.getTime()<now.getTime()){\n        target.setDate(target.getDate()+1);\n    }\n\n    function p2(n){return n<10?\"0\"+n:String(n);}\n    function hms(ms){\n        ms=Math.max(0,Number(ms)||0);\n        var sec=Math.ceil(ms\/1000);\n        var h=Math.floor(sec\/3600);\n        var mi=Math.floor((sec%3600)\/60);\n        var se=sec%60;\n        return h>0?(h+\":\"+p2(mi)+\":\"+p2(se)):(p2(mi)+\":\"+p2(se));\n    }\n    function clock(d){return p2(d.getHours())+\":\"+p2(d.getMinutes())+\":\"+p2(d.getSeconds());}\n    function targetText(d){return p2(d.getMonth()+1)+\"-\"+p2(d.getDate())+\" \"+p2(d.getHours())+\":\"+p2(d.getMinutes());}\n    function refreshWait(){\n        var n=new Date();\n        var left=Math.max(0,target.getTime()-n.getTime());\n        var txt=\"⏰ \"+targetText(target)+\"｜现\"+clock(n)+\"｜剩\"+hms(left);\n        zdjl.setVar(\"定时等待文本\",txt,\"global\");\n        return left;\n    }\n\n    var firstLeft=refreshWait();\n\n    \/\/ 定时阶段单独创建一个长时HUD；文本每秒更新，到点后自动过期。\n    try{\n        zdjl.runAction({\n            \"type\":\"系统提示\",\n            \"delay\":\"0\",\n            \"delayUnit\":1,\n            \"repeatCount\":1,\n            \"desc\":\"定时等待：持续显示目标时间\/当前时间\/倒计时\",\n            \"promptType\":\"toast\",\n            \"promptTitle\":\"\",\n            \"showPosition\":\"bottom_left\",\n            \"playAudio\":\"false\",\n            \"useVibrator\":false,\n            \"showDuration\":Math.max(1500,firstLeft+1500),\n            \"__vars\":{\n                \"promptText\":{\n                    \"varType\":\"expression\",\n                    \"varScope\":\"global\",\n                    \"mustInput\":false,\n                    \"valueExp\":\"定时等待文本\"\n                }\n            }\n        });\n    }catch(__timerHudErr){}\n\n    while(true){\n        var left=refreshWait();\n        if(left<=0) break;\n        zdjl.sleep(Math.min(1000,left));\n    }\n\n    try{\n        zdjl.setVar(\"定时等待文本\",\"⏰ \"+p2(hh)+\":\"+p2(mm)+\" 到点，开始运行\",\"global\");\n    }catch(e3){}\n    zdjl.sleep(700);\n})();\n(function(){\n var P='\/sdcard\/Download\/农场总控_配置链路.log';\n function L(s){try{zdjl.appendFile(P,new Date().toISOString()+' '+s+'\\n');}catch(e){}}\n function G(n){try{var v=zdjl.getVar(n,'global');return v===undefined||v===null?'':String(v);}catch(e){return '';}}\n var names=[\"双王者运行顺序\", \"启动方式\", \"定时开始时间\", \"特殊模式\", \"王者1账号模式\", \"王者1区数\", \"王者1开始区\", \"王者1执行账号\", \"王者1浇祝间隔\", \"王者1换作物吗\", \"王者1浇水吗\", \"王者1一键设置\", \"王者1任务1\", \"王者1任务2\", \"王者1任务3\", \"王者1任务4\", \"王者1任务5\", \"王者1任务6\", \"王者1任务4延迟\", \"王者1任务5延迟\", \"王者1任务6延迟\", \"王者2账号模式\", \"王者2区数\", \"王者2开始区\", \"王者2执行账号\", \"王者2浇祝间隔\", \"王者2换作物吗\", \"王者2浇水吗\", \"王者2一键设置\", \"王者2任务1\", \"王者2任务2\", \"王者2任务3\", \"王者2任务4\", \"王者2任务5\", \"王者2任务6\", \"王者2任务4延迟\", \"王者2任务5延迟\", \"王者2任务6延迟\"],cfg={},bad=[];\n for(var i=0;i<names.length;i++){var k=names[i],v=G(k);if(v!=='')cfg[k]=v;}\n \/\/ When a saved older preset lacks start zones, its documented default is 1, never 0 or NaN.\n for(var side=1;side<=2;side++){\n  var k='王者'+side+'开始区',v=cfg[k];\n  if(v===undefined||v==='')cfg[k]='1';\n  var n=Number(cfg[k]);if(!(n>=1&&n<=36&&n===Math.floor(n)))bad.push(k+'='+cfg[k]);\n  var ts=[];for(var t=1;t<=6;t++){\n   var key='王者'+side+'任务'+t,task=cfg[key];\n   if(!task) {bad.push(key+'为空');continue;}\n   if(['无','浇水','祝福','收割','稳收24田','巡田24田','十田经济','1V1','55'].indexOf(task)<0)bad.push(key+'='+task);\n   if(task!=='无')ts.push(task);\n  }\n  \/\/ Do not overwrite an empty task queue with watering.\n  var order=cfg['双王者运行顺序'];\n  var required=(side===1&&order!=='仅王者2')||(side===2&&['仅王者2','王者1→王者2','王者2→王者1'].indexOf(order)>=0);\n  if(!ts.length&&required)bad.push('王者'+side+'全部任务为空');\n }\n if(['当前王者','仅王者1','仅王者2','王者1→王者2','王者2→王者1'].indexOf(cfg['双王者运行顺序'])<0)bad.push('运行顺序无效');\n if(bad.length){\n  try{zdjl.setVar('FC_V32_PREFLIGHT_OK','NO','global');zdjl.setVar('FC_V32_LAUNCH_JSON','','global');}catch(e){}\n  L('PREPARE_FAILED '+bad.join(';'));\n  try{zdjl.toast('配置错误，已取消启动：'+bad.join(';'),4500);}catch(e){}\n  return;\n }\n var item={schema:32,source:'home',when
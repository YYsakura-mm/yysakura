{"repeatCount":-1,"pauseOnFail":false,"count":84,"minVerCode":2026000,"minVerName":"2.26.0","screenWidth":720,"screenHeight":1280,"screenDpi":2,"lastSaveScreenWidth":720,"lastSaveScreenHeight":1280,"lastSaveScreenDpi":2,"savedVerCode":26000050,"savedVerName":"26.5.0","delay":"100","delayUnit":0,"description":"","desc":"总控｜云版本为准｜一次性红绿点选区校验｜实际总数与HUD同步｜六任务","globalCallbacks":{"beforeFirstLoop":{"type":"执行脚本","delay":"0","delayUnit":1,"repeatCount":1,"desc":"总控启动：统一初始化OCR/检查SGOCR一次","filePath":"初始化OCR.zjs","continueCurrentAfterFinish":true}}}
{"type":"设置变量","delay":"0","delayUnit":1,"scriptCallbacks":{"afterExecSuc":{"type":"运行JS代码","delay":"0","delayUnit":1,"repeatCount":1,"desc":"定时启动：持续HUD倒计时，到点后继续","jsCode":"// ===== UI短文案映射：只改显示，不改后续业务协议 =====\nif(String(特殊模式||\"关\")===\"开\") 特殊模式=\"只识别状态\";\nelse 特殊模式=\"正常任务\";\n\nif(String(启动方式||\"立即\")===\"定时\") 启动方式=\"定时开始\";\nelse 启动方式=\"立即开始\";\n\n(function(){\n    if(String(启动方式||\"立即开始\")!==\"定时开始\") return;\n\n    var s=String(定时开始时间||\"\").replace(/^\\s+|\\s+$/g,\"\");\n    var m=/^(?:([01]?\\d|2[0-3])):([0-5]\\d)$/.exec(s);\n    if(!m){\n        try{zdjl.toast(\"定时时间格式错误，请填写 HH:mm，例如 00:20\",5000);}catch(e){}\n        try{zdjl.runAction({\"type\":\"控制执行\",\"delay\":\"0\",\"delayUnit\":1,\"controlRunType\":\"stop\",\"jumpToPosition\":\"\",\"ContinueParentExecute\":false});}catch(e2){}\n        return;\n    }\n\n    var hh=Number(m[1]);\n    var mm=Number(m[2]);\n    var now=new Date();\n    var target=new Date(now.getFullYear(),now.getMonth(),now.getDate(),hh,mm,0,0);\n\n    // 如果确认启动时已经处于目标分钟，直接开始；只有目标分钟已经完整过去，才排到第二天。\n    var sameMinute=(now.getHours()===hh && now.getMinutes()===mm);\n    if(sameMinute){\n        target=new Date(now.getTime());\n    }else if(target.getTime()<now.getTime()){\n        target.setDate(target.getDate()+1);\n    }\n\n    function p2(n){return n<10?\"0\"+n:String(n);}\n    function hms(ms){\n        ms=Math.max(0,Number(ms)||0);\n        var sec=Math.ceil(ms/1000);\n        var h=Math.floor(sec/3600);\n        var mi=Math.floor((sec%3600)/60);\n        var se=sec%60;\n        return h>0?(h+\":\"+p2(mi)+\":\"+p2(se)):(p2(mi)+\":\"+p2(se));\n    }\n    function clock(d){return p2(d.getHours())+\":\"+p2(d.getMinutes())+\":\"+p2(d.getSeconds());}\n    function targetText(d){return p2(d.getMonth()+1)+\"-\"+p2(d.getDate())+\" \"+p2(d.getHours())+\":\"+p2(d.getMinutes());}\n    function refreshWait(){\n        var n=new Date();\n        var left=Math.max(0,target.getTime()-n.getTime());\n        var txt=\"⏰ \"+targetText(target)+\"｜现\"+clock(n)+\"｜剩\"+hms(left);\n        zdjl.setVar(\"定时等待文本\",txt,\"global\");\n        return left;\n    }\n\n    var firstLeft=refreshWait();\n\n    // 定时阶段单独创建一个长时HUD；文本每秒更新，到点后自动过期。\n    try{\n        zdjl.runAction({\n            \"type\":\"系统提示\",\n            \"delay\":\"0\",\n            \"delayUnit\":1,\n            \"repeatCount\":1,\n            \"desc\":\"定时等待：持续显示目标时间/当前时间/倒计时\",\n            \"promptType\":\"toast\",\n            \"promptTitle\":\"\",\n            \"showPosition\":\"bottom_left\",\n            \"playAudio\":\"false\",\n            \"useVibrator\":false,\n            \"showDuration\":Math.max(1500,firstLeft+1500),\n            \"__vars\":{\n                \"promptText\":{\n                    \"varType\":\"expression\",\n                    \"varScope\":\"global\",\n                    \"mustInput\":false,\n                    \"valueExp\":\"定时等待文本\"\n                }\n            }\n        });\n    }catch(__timerHudErr){}\n\n    while(true){\n        var left=refreshWait();\n        if(left<=0) break;\n        zdjl.sleep(Math.min(1000,left));\n    }\n\n    try{\n        zdjl.setVar(\"定时等待文本\",\"⏰ \"+p2(hh)+\":\"+p2(mm)+\" 到点，开始运行\",\"global\");\n    }catch(e3){}\n    zdjl.sleep(700);\n})();"}},"vars":[{"name":"运行方式","value":{"varType":"string","varScope":"global","showInput":true,"showInputLabel":"方式","mustInput":true,"textLineBefore":"#MD\n<font color=#F5C451 size=3>⚙ 账号</font>","showInputWidthBasis":"auto","showInputContentAlign":"left","value":"当前账号","stringItems":["当前账号","指定顺序","继续上次"]}},{"name":"临时账号","value":{"varType":"string","varScope":"global","showInput":true,"showInputLabel":"区数","mustInput":true,"rememberInputValue":true,"showInputWidthBasis":"auto","showInputContentAlign":"left","value":"自动≤12","stringItems":["自动≤12","9077安卓","14区","15区","16区","17区","18区","19区","20区","21区","22区","23区","24区","25区","26区","27区","28区","29区","30区","31区","32区","33区","34区","35区","36区"]}},{"name":"执行账号","value":{"varType":"string","varScope":"g
{"type":"运行JS代码","delay":"0","delayUnit":1,"desc":"任务队列阶段切换：任务1→任务2→任务3→延迟→任务4→延迟→任务5→延迟→任务6","jumpId":"阶段收尾","jsCode":"阶段已切换=\"否\";\n阶段需等待=\"否\";\n阶段等待分钟=0;\n\nfunction __槽任务(i){\n    if(i==1) return String(任务1||\"无\");\n    if(i==2) return String(任务2||\"无\");\n    if(i==3) return String(任务3||\"无\");\n    if(i==4) return String(任务4||\"无\");\n    if(i==5) return String(任务5||\"无\");\n    if(i==6) return String(任务6||\"无\");\n    return \"无\";\n}\nfunction __任务转做啥(t){\n    if(t==\"浇水\") return \"只浇水\";\n    if(t==\"祝福\") return \"祝福\";\n    if(t==\"收割\") return \"收割\";\n    if(t==\"十田经济\") return \"十钱\";\n    if(t==\"1V1\") return \"打11\";\n    if(t==\"55\") return \"打55\";\n    return \"\";\n}\nfunction __下一任务(i){\n    for(var n=Number(i)+1;n<=6;n++) if(__槽任务(n)!=\"无\") return n;\n    return 0;\n}\nfunction __任务前延迟(i){\n    if(i==4) return Math.max(0,Number(任务4延迟)||0);\n    if(i==5) return Math.max(0,Number(任务5延迟)||0);\n    if(i==6) return Math.max(0,Number(任务6延迟)||0);\n    return 0;\n}\n\nif(当前区>总数区){\n    var __prev=__槽任务(当前任务序号);\n    var __nextIndex=__下一任务(当前任务序号);\n\n    if(__nextIndex>0){\n        var __next=__槽任务(__nextIndex);\n        var __wait=__任务前延迟(__nextIndex);\n\n        // 原有“浇水→祝福”间隔继续生效；若同时设置了4/5/6前延迟，取更长的那个，不重复等待。\n        if(__prev==\"浇水\" && __next==\"祝福\"){\n            __wait=Math.max(__wait,Math.max(0,Number(浇祝间隔)||0));\n        }\n        if(__wait>0){\n            阶段需等待=\"是\";\n            阶段等待分钟=__wait;\n        }\n\n        当前任务序号=__nextIndex;\n        做啥=__任务转做啥(__next);\n        阶段已切换=\"是\";\n        当前区=1;\n        当前格=1;\n        需要回顶=\"是\";\n        还有账号=\"否\";\n        目标账号=0;\n\n        try{\n            zdjl.writeFile(\"/sdcard/Download/农场8账号断点.txt\",\n                \"V5|\"+\"有效\"+\"|\"+当前第几个号+\"|\"+当前区+\"|\"+任务1+\"|\"+任务2+\"|\"+任务3+\"|\"+任务4+\"|\"+任务5+\"|\"+任务6+\"|\"+当前任务序号+\"|\"+账号序列+\"|\"+序列位置+\"|\"+总数区+\"|\"+(Number(浇祝间隔)||0)+\"|\"+(Number(任务4延迟)||0)+\"|\"+(Number(任务5延迟)||0)+\"|\"+(Number(任务6延迟)||0)+\"|\"+特殊模式\n            );\n        }catch(e){}\n    }\n}"}
{"type":"控制执行","delayUnit":2,"repeatCount":1,"condition":{"type":"jsExpression","expression":"阶段已切换==\"是\" && 阶段需等待==\"是\" && Number(阶段等待分钟)>0","desc":"切换到下一任务且该任务需要等待"},"desc":"任务切换延迟（分钟）｜任务4/5/6前延迟；浇水→祝福保留原间隔","controlRunType":"waitDelay","jumpToPosition":"","ContinueParentExecute":false,"__vars":{"delay":{"varType":"expression","varScope":"global","mustInput":false,"valueExp":"阶段等待分钟"}}}
{"type":"控制执行","delay":"0","delayUnit":1,"condition":{"type":"jsExpression","expression":"阶段已切换==\"是\"","desc":"已进入下一阶段则重新从循环入口执行"},"desc":"已进入下一任务：回到循环入口","controlRunType":"jumpTo","jumpToPosition":":循环入口","ContinueParentExecute":false}
{"type":"运行JS代码","delay":"0","delayUnit":1,"condition":{"type":"jsExpression","expression":"阶段已切换!=\"是\"","desc":"只有完整任务链已经结束，才允许准备下一个账号"},"desc":"按指定顺序准备下一个账号","jsCode":"还有账号=\"否\";\n目标账号=0;\nvar sq=String(账号序列||\"\").split(\"-\");\nif(序列位置+1<sq.length){\n    序列位置=序列位置+1;\n    var nx=Number(sq[序列位置]);\n    if(nx>=1 && nx<=8){\n        目标账号=nx;\n        还有账号=\"是\";\n    }\n}\n\n// 只有真的还有下一个账号才显示“切号”；最后一个账号进入明确收尾状态。\nHUD任务=(还有账号==\"是\") ? \"切号\" : \"收尾\";\n\n// HUD轻量刷新：紧凑单行；性能统计只写文件，不占屏幕。\ntry{\n    function __hf2(n){n=Number(n)||0;return n<10?(\"0\"+n):String(n);}\n    var __hms=Math.max(0,Date.now()-(Number(HUD启动时间)||Date.now()));\n    var __hsec=Math.floor(__hms/1000);\n    var __hh=Math.floor(__hsec/3600), __hm=Math.floor((__hsec%3600)/60), __hs=__hsec%60;\n    var __htime=__hh>0 ? (__hh+\":\"+__hf2(__hm)+\":\"+__hf2(__hs)) : (__hf2(__hm)+\":\"+__hf2(__hs));\n    var __hname=String(HUD当前账号||\"\").trim()||\"?\";\n    __hname=__hname.replace(/安卓$/i,\"安\").replace(/ios$/i,\"i\").replace(/vx$/i,\"V\").replace(/^当前账号$/,\"当\");\n    if(__hname.length>6) __hname=__hname.slice(0,6);\n    var __harea=(Number(当前区)||0)+\"/\"+(Number(总数区)||0);\n    var __htask=String(HUD任务||\"\").trim()||\"运行\";\n    if(__htask==\"打11\") __htask=\"11\";\n    else if(__htask==\"打55\") __htask=\"55\";\n    else if(__htask==\"祝福\") __htask=\"福\";\n    else if(__htask==\"收割\") __htask=\"收\";\n    else if(__htask==\"十田\") __htask=\"十\";\n    else if(__htask==\"浇水\") __htask=\"水\";\n    else if(__htask==\"换英\") __htask=\"英\";\n    else if(__htask==\"换经\") __htask=\"经\";\n    else if(__htask==\"选区\") __htask=\"选\";\n    else if(__htask==\"切号\") __htask=\"切\";\n    else if(__htask==\"收尾\") __htask=\"尾\";\n    else if(__htask==\"准备\") __htask=\"备\";\n    HUD文本=__htime+\"·\"+__hname+\"·\"+__harea+\"·\"+__htask;\n    zdjl.setVar(\"HUD文本\",HUD文本,\"global\");\n}catch(__hudLiteErr){}\n"}
{"type":"执行脚本","delay":"0","delayUnit":1,"condition":{"type":"jsExpression","expression":"阶段已切换!=\"是\" && 还有账号==\"是\"","desc":"完整任务链结束且指定序列里还有下一个账号"},"scriptCallbacks":{"afterExecSuc":{"type":"运行JS代码","delay":"0","delayUnit":1,"desc":"新账号：载入区数/跳11并从六任务队列首任务开始","jsCode":"当前区=1;\n当前格=1;\n需要回顶=\"是\";\n\nif(当前第几个号==1) 总数区=账号1区数;\nelse if(当前第几个号==2) 总数区=账号2区数;\nelse if(当前第几个号==3) 总数区=账号3区数;\nelse if(当前第几个号==4) 总数区=账号4区数;\nelse if(当前第几个号==5) 总数区=账号5区数;\nelse if(当前第几个号==6) 总数区=账号6区数;\nelse if(当前第几个号==7) 总数区=账号7区数;\nelse 总数区=账号8区数;\n\n跳过11区吗=(跳11号>0 && 当前第几个号==跳11号) ? \"跳过\" : \"不跳\";\n\nfunction __新号槽(i){\n    if(i==1) return String(任务1||\"无\");\n    if(i==2) return String(任务2||\"无\");\n    if(i==3) return String(任务3||\"无\");\n    if(i==4) return String(任务4||\"无\");\n    if(i==5) return String(任务5||\"无\");\n    if(i==6) return String(任务6||\"无\");\n    return \"无\";\n}\nfunction __新号做啥(t){\n    if(t==\"浇水\") return \"只浇水\";\n    if(t==\"祝福\") return \"祝福\";\n    if(t==\"收割\") return \"收割\";\n    if(t==\"十田经济\") return \"十钱\";\n    if(t==\"1V1\") return \"打11\";\n    if(t==\"55\") return \"打55\";\n    return \"\";\n}\n当前任务序号=1;\nwhile(当前任务序号<=6 && __新号槽(当前任务序号)==\"无\") 当前任务序号++;\n做啥=__新号做啥(__新号槽(当前任务序号));\n\ntry{\n    zdjl.writeFile(\"/sdcard/Download/农场8账号断点.txt\",\n        \"V5|\"+\"有效\"+\"|\"+当前第几个号+\"|\"+当前区+\"|\"+任务1+\"|\"+任务2+\"|\"+任务3+\"|\"+任务4+\"|\"+任务5+\"|\"+任务6+\"|\"+当前任务序号+\"|\"+账号序列+\"|\"+序列位置+\"|\"+总数区+\"|\"+(Number(浇祝间隔)||0)+\"|\"+(Number(任务4延迟)||0)+\"|\"+(Number(任务5延迟)||0)+\"|\"+(Number(任务6延迟)||0)+\"|\"+特殊模式\n    );\n}catch(e){}"}},"filePath":"切换账号.zjs","continueCurrentAfterFinish":true}
{"type":"控制执行","delay":"0","delayUnit":1,"condition":{"type":"jsExpression","expression":"当前区<=总数区","desc":"还有下一地区时继续"},"desc":"还有下一地区：回到选区","controlRunType":"jumpTo","jumpToPosition":":循环入口","ContinueParentExecute":false}
{"type":"运行JS代码","delay":"0","delayUnit":1,"desc":"全部完成：标记断点完成","jsCode":"try{\n    HUD完成耗时=String(Math.max(0,Date.now()-(Number(HUD启动时间)||Date.now())));\n    HUD任务=\"完成\";\n    HUD完成=\"是\";\n    var __sec=Math.floor((Number(HUD完成耗时)||0)/1000);\n    var __hh=Math.floor(__sec/3600);\n    var __mm=Math.floor((__sec%3600)/60);\n    var __ss=__sec%60;\n    function __p(n){return n<10?(\"0\"+n):String(n);}\n    var __seq=String(账号序列||\"\").replace(/[^1-8]/g,\"\");\n    var __beh=String(HUD本次行为||\"任务\");\n    HUD文本=\"✅ 完成｜\"+(__hh>0?(__hh+\":\"+__p(__mm)+\":\"+__p(__ss)):(__p(__mm)+\":\"+__p(__ss)));\n    zdjl.setVar(\"HUD文本\",HUD文本,\"global\");\n}catch(__hudEndErr){}\ntry{\n    zdjl.writeFile(\"/sdcard/Download/农场8账号断点.txt\",\n        \"V5|\"+\"完成\"+\"|\"+当前第几个号+\"|\"+当前区+\"|\"+任务1+\"|\"+任务2+\"|\"+任务3+\"|\"+任务4+\"|\"+任务5+\"|\"+任务6+\"|\"+当前任务序号+\"|\"+账号序列+\"|\"+序列位置+\"|\"+总数区+\"|\"+(Number(浇祝间隔)||0)+\"|\"+(Number(任务4延迟)||0)+\"|\"+(Number(任务5延迟)||0)+\"|\"+(Number(任务6延迟)||0)+\"|\"+特殊模式\n    );\n}catch(e){}\ntry{\n    var __doneMs=Number(HUD完成耗时)||0;\n    var __doneSec=Math.floor(__doneMs/1000);\n    var __doneH=Math.floor(__doneSec/3600);\n    var __doneM=Math.floor((__doneSec%3600)/60);\n    var __doneS=__doneSec%60;\n    function __doneP(n){return n<10?(\"0\"+n):String(n);}\n    var __doneTime=__doneH>0?(__doneH+\":\"+__doneP(__doneM)+\":\"+__doneP(__doneS)):(__doneP(__doneM)+\":\"+__doneP(__doneS));\n\n    function __doneName(n){\n        if(n==1) return String(账号1名称||\"1号\");\n        if(n==2) return String(账号2名称||\"2号\");\n        if(n==3) return String(账号3名称||\"3号\");\n        if(n==4) return String(账号4名称||\"4号\");\n        if(n==5) return String(账号5名称||\"5号\");\n        if(n==6) return String(账号6名称||\"6号\");\n        if(n==7) return String(账号7名称||\"7号\");\n        if(n==8) return String(账号8名称||\"8号\");\n        return \"?\";\n    }\n    function __doneAreas(n){\n        if(n==1) return Number(账号1区数)||0;\n        if(n==2) return Number(账号2区数)||0;\n        if(n==3) return Number(账号3区数)||0;\n        if(n==4) return Number(账号4区数)||0;\n        if(n==5) return Number(账号5区数)||0;\n        if(n==6) return Number(账号6区数)||0;\n        if(n==7) return Number(账号7区数)||0;\n        if(n==8) return Number(账号8区数)||0;\n        return 0;\n    }\n\n    var __doneAccounts=[];\n    if(String(临时模式||\"\")==\"是\"){\n        __doneAccounts.push(String(临时账号名称||\"?\")+\"(\"+(Number(总数区)||0)+\"区)\");\n    }else{\n        var __seqText=String(账号序列||\"\");\n        var __seqArr=__seqText.match(/[1-8]/g)||[];\n        if(__seqArr.length<1){\n            var __curNo=Number(当前第几个号)||0;\n            if(__curNo>=1 && __curNo<=8) __seqArr=[String(__curNo)];\n        }\n        for(var __di=0;__di<__seqArr.length;__di++){\n            var __dn=Number(__seqArr[__di])||0;\n            if(__dn>=1 && __dn<=8){\n                __doneAccounts.push(__doneName(__dn)+\"(\"+__doneAreas(__dn)+\"区)\");\n            }\n        }\n    }\n\n    var __doneTask=String(HUD本次行为||\"任务\").trim()||\"任务\";\nvar __doneText=\"✅ 农场任务全部完成｜耗时 \"+__doneTime+\n        \"\\n任务：\"+__doneTask+\n        \"\\n账号：\"+(__doneAccounts.length?__doneAccounts.join(\"｜\"):\"?\");\n    var __doneStart=Number(开始区)||1;\n    if(__doneStart>1){\n        __doneText+=\"\\n起始：首阶段第\"+__doneStart+\"区\";\n    }\n    zdjl.setVar(\"完成通知文本\",__doneText,\"global\");\n}catch(__doneNotifyErr){}\ntry{\n    var __unbindTask=String(zdjl.getVar(\"王者绑定任务ID\",\"global\")||\"\");\n    if(__unbindTask) zdjl.writeFile(\"/sdcard/Download/王者解绑请求.txt\",\"task=\"+__unbindTask+\"\\nrequest_epoch=\"+Date.now()+\"\\n\");\n}catch(__unbindErr){}\n"}
{"type":"系统提示","delay":"0","delayUnit":1,"repeatCount":1,"desc":"全部完成：原生通知栏结果（与收尾JS分离，避免同步动作卡住）","promptType":"notification","promptTitle":"农场任务完成","showPosition":"default","playAudio":"false","useVibrator":false,"__vars":{"promptText":{"varType":"expression","varScope":"global","mustInput":false,"valueExp":"完成通知文本"}}}

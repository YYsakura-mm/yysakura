重试\/推断末区，其余走原重型校正","scriptSet":[{"type":"运行JS代码","delay":"0","delayUnit":1,"desc":"自动≤12：记录本区蓝十字失败次数并判断是否已经到末区","jsCode":"自动区数判定结束=\"否\";\nif(String(自动区数模式||\"\")==\"是\"){\n    var __z=Number(当前区)||0;\n    if(Number(自动区数失败区||0)==__z){\n        自动区数失败次数=Number(自动区数失败次数||0)+1;\n    }else{\n        自动区数失败区=__z;\n        自动区数失败次数=1;\n    }\n\n    \/\/ 只有“上一地区已经真实成功进入过”时，才能把当前失败理解为末区。\n    \/\/ 这样开始区填错、页面没准备好、第一次就失败时都不会误判总区数。\n    var __prevConfirmed=(Number(自动区数最高成功区||0)>=__z-1);\n    if(__z>1 && __z<=12 && __prevConfirmed && Number(自动区数失败次数||0)>=3){\n        总数区=__z-1;\n        当前区=__z; \/\/ 保持 > 总数区，回循环入口后自然进入阶段收尾\n        自动区数判定结束=\"是\";\n        智能区数人工上限=0;\n        自动区数失败区=0;\n        自动区数失败次数=0;\n        try{zdjl.toast(\"自动区数：确认共\"+总数区+\"区\",1800);}catch(e){}\n    }\n}"},{"type":"控制执行","delay":"0","delayUnit":1,"condition":{"type":"jsExpression","expression":"自动区数模式==\"是\" && 自动区数判定结束==\"是\"","desc":"自动区数已经确认末区"},"desc":"自动≤12：末区确认后回循环入口进入阶段收尾","controlRunType":"jumpTo","jumpToPosition":":循环入口","ContinueParentExecute":false},{"type":"控制执行","delay":"0.2","delayUnit":1,"condition":{"type":"jsExpression","expression":"自动区数模式==\"是\" && 自动区数判定结束!=\"是\" && Number(自动区数失败次数||0)<3","desc":"自动≤12尚未达到3次失败"},"desc":"自动≤12：短等待后直接重点同一区，不做重型归顶","controlRunType":"jumpTo","jumpToPosition":":选区V6","ContinueParentExecute":false},{"type":"设置变量","delay":"0","delayUnit":1,"condition":{"type":"jsExpression","expression":"(自动区数模式!=\"是\" || Number(自动区数失败次数||0)>=3)","desc":"非自动模式，或自动模式无法安全推断时才做重型校正"},"desc":"下一轮启用重型视觉校正","vars":[{"name":"SEL_强制校正","value":{"varType":"string","varScope":"global","showInputInObjectSubVar":false,"mustInput":false,"showInputContentAlign":"left","value":"是"}}]},{"type":"滑动","duration":"1200","delay":"0.15","delayUnit":1,"repeatCount":1,"condition":{"type":"jsExpression","expression":"(自动区数模式!=\"是\" || Number(自动区数失败次数||0)>=3)","desc":"非自动模式，或自动模式无法安全推断时才做重型校正"},"desc":"选区失败重试：向下拉回顶部第1次","startPos":{"type":"location","x":"58.2%","y":"18%"},"endPos":{"type":"location","x":"58.2%","y":"90%"}},{"type":"滑动","duration":"1200","delay":"0.15","delayUnit":1,"repeatCount":1,"condition":{"type":"jsExpression","expression":"(自动区数模式!=\"是\" || Number(自动区数失败次数||0)>=3)","desc":"非自动模式，或自动模式无法安全推断时才做重型校正"},"desc":"选区失败重试：向下拉回顶部第2次","startPos":{"type":"location","x":"58.2%","y":"18%"},"endPos":{"type":"location","x":"58.2%","y":"90%"}},{"type":"滑动","duration":"1200","delay":"0.15","delayUnit":1,"repeatCount":1,"condition":{"type":"jsExpression","expression":"(自动区数模式!=\"是\" || Number(自动区数失败次数||0)>=3)","desc":"非自动模式，或自动模式无法安全推断时才做重型校正"},"desc":"选区失败重试：向下拉回顶部第3次","startPos":{"type":"location","x":"58.2%","y":"18%"},"endPos":{"type":"location","x":"58.2%","y":"90%"}},{"type":"控制执行","delay":"0.2","delayUnit":1,"condition":{"type":"jsExpression","expression":"(自动区数模式!=\"是\" || Number(自动区数失败次数||0)>=3)","desc":"非自动模式，或自动模式无法安全推断时才做重型校正"},"desc":"归顶后重新执行视觉行追踪选区","controlRunType":"jumpTo","jumpToPosition":":选区V6","ContinueParentExecute":false}],"runMode":"normal"}},"controlRunType":"waitDelay","jumpToPosition":"","ContinueParentExecute":false}
{"type":"运行JS代码","delay":"0","delayUnit":1,"repeatCount":1,"desc":"进农场前保存位置，脚本卡死仍可确认当前王者","jsCode":"(function(){\n var P='\/sdcard\/Download\/双王者V3_进度.json';\n try{\n  var d=JSON.parse(String(zdjl.readFile(P)||'')),id=Number(zdjl.getVar('双王者当前端','global'));\n  if(d.schema!==3||d.runId!==String(zdjl.getVar('双王者运行ID','global'))||d.current!==id||d.status==='全部完成')return;\n  var s={client:id,zone:Number(当前区)||0,total:Number(总数区)||0,taskIndex:Number(当前任务序号)||0,task:String(做啥||''),account:Number(当前第几个号)||0,accountSeq:String(账号序列||''),sequencePos:Number(序列位置)||0,tempMode:String(临时模式||''),tempName:String(临时账号名称||''),time:Date.now()};\n  if(s.zone>0&&s.zone<=36&&s.taskIndex>0&&s.taskIndex<=6){d.snapshot=s;d.phaseStarted=true;}\n  var __realLabel=String(zdjl.getVar('双王者直接当前','global'))==='是'?'当前':'王者'+id;\n  d.status=__realLabel+' 执行中';d.updatedAt=Date.now();delete d.bindingTask;\n  zdjl.writeFile(P,JSON.stringify(d));\n  var hud=String(zdjl.getVar('HUD文本','global')||'');\n  if(hud){hud=hud.replace(\/^(?:王者[12]|当前)·\/,'');zdjl.setVar('HUD文本',__realLabel+'·'+hud,'global');}\n }catch(e){try{zdjl.appendFile('\/sdcard\/Download\/双王者V3_日志.txt','HEARTBEAT ERROR '+e+'\\r\\n');}catch(z){}}\n})();\n"}
{"type":"执行脚本","delay":"0","delayUnit":1,"scriptCallbacks":{"beforeStartExec":{"type":"运行JS代码","delay":"0","delayUnit":1,"desc":"更新HUD账号与主任务","jsCode":"\/\/ 当前账号名称\nif(临时模式==\"是\"){\n    HUD当前账号=String(临时账号名称||\"\");\n}else{\n    if(当前第几个号==1) HUD当前账号=String(账号1名称||\"1号\");\n    else if(当前第几个号==2) HUD当前账号=String(账号2名称||\"2号\");\n    else if(当前第几个号==3) HUD当前账号=String(账号3名称||\"3号\");\n    else if(当前第几个号==4) HUD当前账号=String(账号4名称||\"4号\");\n    else if(当前第几个号==5) HUD当前账号=String(账号5名称||\"5号\");\n    else if(当前第几个号==6) HUD当前账号=String(账号6名称||\"6号\");\n    else if(当前第几个号==7) HUD当前账号=String(账号7名称||\"7号\");\n    else if(当前第几个号==8) HUD当前账号=String(账号8名称||\"8号\");\n    else HUD当前账号=\"?\";\n}\n\n\/\/ HUD只显示“主任务”，不显示后续扫描识别。\n\/\/ 打11\/打55进入子脚本后仍一直保持打11\/打55。\nif(做啥==\"打11\"){\n    HUD任务=\"打11\";\n}else if(做啥==\"打55\"){\n    HUD任务=\"打55\";\n}else if(做啥==\"祝福\" || 做啥==\"嘎嘎祝福\" || 做啥==\"祝福右边\"){\n    HUD任务=\"祝福\";\n}else if(做啥==\"收割\"){\n    HUD任务=\"收割\";\n}else if(做啥==\"十钱\"){\n    HUD任务=\"十田\";\n}else if(做啥==\"只浇水\"){\n    if(换作物吗==\"换英雄\") HUD任务=\"换英\";\n    else if(换作物吗==\"换经济\") HUD任务=\"换经\";\n    else HUD任务=\"浇水\";\n}else{\n    HUD任务=\"\";\n}\n\n\/\/ HUD轻量刷新：紧凑单行；性能统计只写文件，不占屏幕。\ntry{\n    function __hf2(n){n=Number(n)||0;return n<10?(\"0\"+n):String(n);}\n    var __hms=Math.max(0,Date.now()-(Number(HUD启动时间)||Date.now()));\n    var __hsec=Math.floor(__hms\/1000);\n    var __hh=Math.floor(__hsec\/3600), __hm=Math.floor((__hsec%3600)\/60), __hs=__hsec%60;\n    var __htime=__hh>0 ? (__hh+\":\"+__hf2(__hm)+\":\"+__hf2(__hs)) : (__hf2(__hm)+\":\"+__hf2(__hs));\n    var __hname=String(HUD当前账号||\"\").trim()||\"?\";\n    __hname=__hname.replace(\/安卓$\/i,\"安\").replace(\/ios$\/i,\"i\").replace(\/vx$\/i,\"V\").replace(\/^当前账号$\/,\"当\");\n    if(__hname.length>6) __hname=__hname.slice(0,6);\n    var __harea=(Number(当前区)||0)+\"\/\"+(Number(总数区)||0);\n    var __htask=String(HUD任务||\"\").trim()||\"运行\";\n    if(__htask==\"打11\") __htask=\"11\";\n    else if(__htask==\"打55\") __htask=\"55\";\n    else if(__htask==\"祝福\") __htask=\"福\";\n    else if(__htask==\"收割\") __htask=\"收\";\n    else if(__htask==\"十田\") __htask=\"十\";\n    else if(__htask==\"浇水\") __htask=\"水\";\n    else if(__htask==\"换英\") __htask=\"英\";\n    else if(__htask==\"换经\") __htask=\"经\";\n    else if(__htask==\"选区\") __htask=\"选\";\n    else if(__htask==\"切号\") __htask=\"切\";\n    else if(__htask==\"准备\") __htask=\"备\";\n    HUD文本=__htime+\"·\"+__hname+\"·\"+__harea+\"·\"+__htask;\n    zdjl.setVar(\"HUD文本\",HUD文本,\"global\");\n}catch(__hudLiteErr){}\n\ntry{\n var __dc=Number(zdjl.getVar('双王者当前端','global'));\n var __hh=String(zdjl.getVar('HUD文本','global')||'');\n if((__dc===1||__dc===2)&&String(zdjl.getVar('双王者可运行','global'))==='是'&&__hh){\n  __hh=__hh.replace(\/^王者[12]·\/,'');\n  zdjl.setVar('HUD文本','王者'+__dc+'·'+__hh,'global');\n }\n}catch(__huderr){}\n"}},"filePath":"进游戏关闭广告.zjs","continueCurrentAfterFinish":true}
{"type":"执行脚本","delay":"0","delayUnit":1,"condition":{"type":"jsExpression","expression":"做啥==\"祝福\"","desc":""},"scriptCallbacks":{"beforeStartExec":{"type":"运行JS代码","delay":"0","delayUnit":1,"desc":"更新HUD账号与主任务","jsCode":"\/\/ 当前账号名称\nif(临时模式==\"是\"){\n    HUD当前账号=String(临时账号名称||\"\");\n}else{\n    if(当前第几个号==1) HUD当前账号=String(账号1名称||\"1号\");\n    else if(当前第几个号==2) HUD当前账号=String(账号2名称||\"2号\");\n    else if(当前第几个号==3) HUD当前账号=String(账号3名称||\"3号\");\n    else if(当前第几个号==4) HUD当前账号=String(账号4名称||\"4号\");\n    else if(当前第几个号==5) HUD当前账号=String(账号5名称||\"5号\");\n    else if(当前第几个号==6) HUD当前账号=String(账号6名称||\"6号\");\n    else if(当前第几个号==7) HUD当前账号=String(账号7名称||\"7号\");\n    else if(当前第几个号==8) HUD当前账号=String(账号8名称||\"8号\");\n    else HUD当前账号=\"?\";\n}\n\n\/\/ HUD只显示“主任务”，不显示后续扫描识别。\n\/\/ 打11\/打55进入子脚本后仍一直保持打11\/打55。\nif(做啥==\"打11\"){\n    HUD任务=\"打11\";\n}else if(做啥==\"打55\"){\n    HUD任务=\"打55\";\n}else if(做啥==\"祝福\" || 做啥==\"嘎嘎祝福\" || 做啥==\"祝福右边\"){\n    HUD任务=\"祝福\";\n}else if(做啥==\"收割\"){\n    HUD任务=\"收割\";\n}else if(做啥==\"十钱\"){\n    HUD任务=\"十田\";\n}else if(做啥==\"只浇水\"){\n    if(换作物吗==\"换英雄\") HUD任务=\"换英\";\n    else if(换作物吗==\"换经济\") HUD任务=\"换经\";\n    else HUD任务=\"浇水\";\n}else{\n    HUD任务=\"\";\n}\n\n\/\/ HUD轻量刷新：紧凑单行；性能统计只写文件，不占屏幕。\ntry{\n    function __hf2(n){n=Number(n)||0;return n<10?(\"0\"+n):String(n);}\n    var __hms=Math.max(0,Date.now()-(Number(HUD启动时间)||Date.now()));\n    var __hsec=Math.floor(__hms\/1000);\n    var __hh=Math.floor(__hsec\/3600), __hm=Math.floor((__hsec%3600)\/60), __hs=__hsec%60;\n    var __htime=__hh>0 ? (__hh+\":\"+__hf2(__hm)+\":\"+__hf2(__hs)) : (__hf2(__hm)+\":\"+__hf2(__hs));\n    var __hname=String(HUD当前账号||\"\").trim()||\"?\";\n    __hname=__hname.replace(\/安卓$\/i,\"安\").replace(\/ios$\/i,\"i\").replace(\/vx$\/i,\"V\").replace(\/^当前账号$\/,\"当\");\n    if(__hname.length>6) __hname=__hname.slice(0,6);\n    var __harea=(Number(当前区)||0)+\"\/\"+(Number(总数区)||0);\n    var __htask=String(HUD任务||\"\").trim()||\"运行\";\n    if(__htask==\"打11\") __htask=\"11\";\n    else if(__htask==\"打55\") __htask=\"55\";\n    else if(__htask==\"祝福\") __htask=\"福\";\n    else if(__htask==\"收割\") __htask=\"收\";\n    else if(__htask==\"十田\") __htask=\"十\";\n    else if(__htask==\"浇水\") __htask=\"水\";\n    else if(__htask==\"换英\") __htask=\"英\";\n    else if(__htask==\"换经\") __htask=\"经\";\n    else if(__htask==\"选区\") __htask=\"选\";\n    else if(__htask==\"切号\") __htask=\"切\";\n    else if(__htask==\"准备\") __htask=\"备\";\n    HUD文本=__htime+\"·\"+__hname+\"·\"+__harea+\"·\"+__htask;\n    zdjl.setVar(\"HUD文本\",HUD文本,\"global\");\n}catch(__hudLiteErr){}\n\ntry{\n var __dc=Number(zdjl.getVar('双王者当前端','global'));\n var __hh=String(zdjl.getVar('HUD文本','global')||'');\n if((__dc===1||__dc===2)&&String(zdjl.getVar('双王者可运行','global'))==='是'&&__hh){\n  __hh=__hh.replace(\/^王者[12]·\/,'');\n  zdjl.setVar('HUD文本','王者'+__dc+'·'+__hh,'global');\n }\n}catch(__huderr){}\n"}},"filePath":"祝福.zjs","continueCurrentAfterFinish":true}

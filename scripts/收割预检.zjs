{"repeatCount": -1, "pauseOnFail": false, "count": 1, "minVerCode": 2026000, "minVerName": "2.26.0", "screenWidth": 720, "screenHeight": 1280, "screenDpi": 2, "lastSaveScreenWidth": 1280, "lastSaveScreenHeight": 720, "lastSaveScreenDpi": 2, "savedVerCode": 26000050, "savedVerName": "26.5.0", "description": "由 保变异收割 调用：读【预检序号】执行第1/2格 OCR 并综合判定，写回结论变量。白名单读【白名单植物】。", "delay": "0", "delayUnit": 1, "globalCallbacks": {}, "desc": "收割预检｜OCR+判定公共子脚本"}
{"type": "运行JS代码", "delay": "0", "delayUnit": 1, "repeatCount": 1, "desc": "第1/2格通用：SGOCR取字 + 白名单成熟判定", "jsCode": "(function(){\n// 收割预检：一次完成 OCR + 判定。预检序号=1 走第一格，=2 走第二格复核\nvar K=String(zdjl.getVar(\"预检序号\",\"global\")||\"1\"),k=(K===\"2\")?2:1;\nfunction N(v){return String(v==null?\"\":v).replace(/\\r\\n?/g,\"\\n\").trim();}\nfunction G(k,d){try{var v=zdjl.getVar(k,\"global\");return v==null?d:v;}catch(e){return d;}}\nfunction S(k,v){try{zdjl.setVar(k,v,\"global\");}catch(e){}}\nfunction C(v){var s=N(v).replace(/\\s+/g,\"\").replace(/[0-9０-９]/g,\"\").replace(/(?:Lv|LV|lv|等级|级)/g,\"\");var m=s.match(/[\\u4e00-\\u9fff]{2,6}/g);return m?m.join(\"\"):\"\";}\n// >>> 白名单：改脚本开头【★白名单植物】原生变量即可\nvar ALIAS={\"樱桃\":[\"樱桃\",\"樱挑\",\"櫻桃\",\"樱祧\"],\"灯笼果\":[\"灯笼果\",\"灯龙果\",\"灯笼杲\",\"燈籠果\"],\"莲花\":[\"莲花\",\"连花\",\"蓮花\"],\"枇杷\":[\"枇杷\",\"枇把\",\"批杷\",\"枇粑\"],\"牛油果\":[\"牛油果\",\"牛油杲\"]};\nvar _WL=String(G(\"白名单植物\",\"樱桃,灯笼果,莲花,枇杷,牛油果\")).split(/[,，;；|｜\\s]+/);\nvar variants=[];\nfor(var _wi=0;_wi<_WL.length;_wi++){var _wn=_WL[_wi].replace(/\\s/g,\"\");if(_wn)variants.push([_wn,ALIAS[_wn]||[_wn]]);}\nfunction W(s){s=C(s);for(var i=0;i<variants.length;i++)for(var j=0;j<variants[i][1].length;j++)if(s.indexOf(variants[i][1][j])>=0)return variants[i][0];return \"\";}\nfunction D(a,b){if(!a||!b)return 99;if(a===b)return 0;if(Math.abs(a.length-b.length)>1)return 99;var p=[],i,j;for(i=0;i<=a.length;i++)p[i]=[i];for(j=1;j<=b.length;j++)p[0][j]=j;for(i=1;i<=a.length;i++)for(j=1;j<=b.length;j++)p[i][j]=Math.min(p[i-1][j]+1,p[i][j-1]+1,p[i-1][j-1]+(a.charAt(i-1)===b.charAt(j-1)?0:1));return p[a.length][b.length];}\nfunction nearWhitelist(s){s=C(s);if(s.length<2||s.length>5)return false;for(var i=0;i<variants.length;i++)for(var j=0;j<variants[i][1].length;j++)if(D(s,variants[i][1][j])<=1)return true;return false;}\nfunction Status(v){\n  var s=N(v).replace(/\\s+/g,\"\");\n  if(!s)return \"未知\";\n  if(/(?:后|あと)(?:才)?成[熟热]/.test(s)||/未成熟|尚未成熟|暂未成熟|正在生长/.test(s)||/(?:\\d+|[一二三四五六七八九十半]+)(?:天|小时|时|分钟|分|秒).*?后?成[熟热]/.test(s))return \"未成熟\";\n  if(/已成[熟热]|已经成[熟热]|成熟了|成熟啦|完全成熟|可收获|可以收获|可收割|可以收割|立即收获|立即收割/.test(s)||/(?:^|[|｜。；;\\n])成熟(?:$|[|｜。；;\\n])/.test(N(v)))return \"成熟\";\n  if(/后干[涸固]/.test(s)||/(?:\\d+|[一二三四五六七八九十半]+)(?:天|小时|时|分钟|分|秒).*?干[涸固]/.test(s))return \"未成熟\";\n  return \"未知\";\n}\n// ---- 第三方 SGOCR 取字\nfunction R(area){\n  var fn=null,raw=\"\";\n  try{fn=zdjl.getVar(\"ocrText\",\"global\");}catch(e){}\n  if(typeof fn!=\"function\"){try{if(typeof ocrText===\"function\")fn=ocrText;}catch(e){}}\n  if(typeof fn!=\"function\"||!area)return \"\";\n  for(var i=0;i<3;i++){\n    try{raw=N(fn(area,\"medium\"));}catch(e){raw=\"\";}\n    if(raw.replace(/\\s/g,\"\").length>=2)break;\n    if(i<2)try{zdjl.sleep(220);}catch(e){}\n  }\n  return raw;\n}\nvar farm=G(\"植物状态\",null),nameArea=null;\ntry{nameArea=收割预检名称区域;}catch(e){}\nif(!nameArea)try{nameArea=zdjl.getVar(\"收割预检名称区域\",\"global\");}catch(e){}\nvar st=R(farm),nm=R(nameArea);\nS(\"收割预检状态\"+k,st);\nS(\"收割预检名称\"+k,nm);\ntry{zdjl.toast(\"预检\"+k+\"｜状态:\"+(st?st.replace(/\\s+/g,\" \").slice(0,48):\"OCR空\")+\"｜植物:\"+(nm?nm.replace(/\\s+/g,\" \").slice(0,18):\"OCR空\"),1900);}catch(e){}\n// ---- 综合判定\nvar st1=N(G(\"收割预检状态1\",\"\")),st2=N(G(\"收割预检状态2\",\"\"));\nvar raw1=N(G(\"收割预检名称1\",\"\")),raw2=N(G(\"收割预检名称2\",\"\"));\nvar n1=C(raw1),n2=C(raw2),w1=W(raw1)||W(st1),w2=W(raw2)||W(st2);\nvar plant=\"未知\",p=\"\";\nif(w1||w2){plant=\"白名单\";p=w1||w2;}\nelse if(n1&&n2&&D(n1,n2)<=1&&!nearWhitelist(n1)&&!nearWhitelist(n2)) {plant=\"非白名单\";p=n1===n2?n1:n1+\"/\"+n2;}\nvar m1=Status(st1),m2=Status(st2),m=\"未知\";\nif(m1===\"未成熟\"||m2===\"未成熟\")m=\"未成熟\";\nelse if(m1===\"成熟\"||m2===\"成熟\")m=\"成熟\";\nS(\"收割预检植物结论\",plant);S(\"收割预检植物\",p);\nS(\"收割预检成熟结论\",m);S(\"收割预检未成熟\",m===\"未成熟\"?\"是\":\"否\");\nvar passed=(plant===\"白名单\"&&m===\"成熟\");\nvar verdict=(plant===\"白名单\"&&m===\"成熟\")?\"进入24田\":(plant===\"非白名单\"?\"其他作物→一键收获\":\"不开一键收获→浇水\");\nif(k===1){try{zdjl.toast(\"首格预检｜\"+plant+\"(\"+p+\")｜\"+m+(passed?\"｜直接进24田\":\"｜转查第二格\"),1800);}catch(e){}}\nelse{try{zdjl.toast(\"收割预检｜\"+plant+(p?\"(\"+p+\")\":\"\")+\"｜\"+m+\"｜\"+verdict,2200);}catch(e){}}\n})();"}

{"type":"运行JS代码","delay":"0","delayUnit":1,"desc":"收割后状态OCR复核入口：仅首次识别14小时39分钟附近触发","jsCode":"(function(){\n function G(k){try{var v=zdjl.getVar(k,'global');return v===undefined||v===null?'':String(v);}catch(e){return '';}}\n function S(k,v){try{zdjl.setVar(k,String(v),'global');}catch(e){}}\n function parse(s){\n  var t=String(s||'').replace(\/\\s+\/g,'').replace(\/[ＯＯ]\/g,'0').replace(\/[Oo]\/g,'0').replace(\/[Il|]\/g,'1');\n  if(\/(?:已经成熟|已成熟|可收获|成熟可收)\/.test(t))return 0;\n  var m=t.match(\/(\\d{1,3})\\s*(?:小时|小時|时|時|h)\\s*(\\d{1,2})\\s*(?:分钟|分鐘|分|m)\/i);\n  if(m)return Number(m[1])*60+Number(m[2]);\n  m=t.match(\/(\\d{1,3})\\s*(?:小时|小時|h)\/i);if(m)return Number(m[1])*60;\n  m=t.match(\/(\\d{1,4})\\s*(?:分钟|分鐘|分|m)\/i);if(m)return Number(m[1]);\n  return -1;\n }\n var flag=G('FC_POST_HARVEST_STATUS_CHECK')==='YES';\n var at=Number(G('FC_POST_HARVEST_STATUS_CHECK_AT'))||0;\n var fresh=at>0&&Date.now()>=at&&Date.now()-at<=300000;\n var first=(typeof 植物状态内容==='undefined'?'':String(植物状态内容||'')),mins=parse(first);\n S('FC_POST_HARVEST_STATUS_CHECK','');S('FC_POST_HARVEST_STATUS_CHECK_AT','');\n var hit=flag&&fresh&&mins>=877&&mins<=881;\n S('FC_HARVEST_TIME_VERIFY',hit?'YES':'NO');\n try{zdjl.appendFile('\/sdcard\/Download\/农场总控日志\/收割后OCR复核.log',new Date().toISOString()+' FIRST flag='+flag+' fresh='+fresh+' minutes='+mins+' trigger='+hit+'\\n');}catch(e){}\n})();"}
{"type":"运行多个动作","delay":"0","delayUnit":1,"condition":{"type":"jsExpression","expression":"String(zdjl.getVar('FC_HARVEST_TIME_VERIFY','global')||'NO')==='YES'","desc":"仅收割后首次OCR为14小时39分钟附近时复核"},"desc":"14:39疑似误识别：向左移动一块土地复核","scriptSet":[{"type":"点击","delay":"0.1","delayUnit":1,"desc":"关闭当前土地状态卡，准备左移","posData":{"type":"location","x":"39.6%","y":"70.3%"}},{"type":"滑动","duration":"750","delay":"0.1","delayUnit":1,"desc":"向左移动一块土地","startPos":{"type":"location","x":"25%","y":"75%"},"endPos":{"type":"location","x":"5%","y":"75%"}},{"type":"点击","delay":"0.1","delayUnit":1,"desc":"左移后打开相邻土地状态卡","posData":{"type":"location","x":"14.3%","y":"40.4%"}}],"runMode":"normal"}
{"type":"设置变量","delay":"0","delayUnit":1,"condition":{"type":"jsExpression","expression":"String(zdjl.getVar('FC_HARVEST_TIME_VERIFY','global')||'NO')==='YES'","desc":"仅收割后首次OCR为14小时39分钟附近时复核"},"desc":"收割后相邻土地：第二次成熟时间OCR","vars":[{"name":"植物状态复核内容","value":{"varType":"expression","varScope":"script","showInputInObjectSubVar":false,"mustInput":true,"showInputContentAlign":"left","valueExp":"(function(){try{return ocrText(植物状态, \"medium\") || \"\";}catch(e){return \"\";}})()"}}]}
{"type":"运行JS代码","delay":"0","delayUnit":1,"condition":{"type":"jsExpression","expression":"String(zdjl.getVar('FC_HARVEST_TIME_VERIFY','global')||'NO')==='YES'","desc":"仅收割后首次OCR为14小时39分钟附近时复核"},"desc":"两次成熟时间比较：差≤1分钟保留原值，否则采用较小时间对应的整块OCR数据","jsCode":"(function(){\n function parse(s){\n  var t=String(s||'').replace(\/\\s+\/g,'').replace(\/[ＯＯ]\/g,'0').replace(\/[Oo]\/g,'0').replace(\/[Il|]\/g,'1');\n  if(\/(?:已经成熟|已成熟|可收获|成熟可收)\/.test(t))return 0;\n  var m=t.match(\/(\\d{1,3})\\s*(?:小时|小時|时|時|h)\\s*(\\d{1,2})\\s*(?:分钟|分鐘|分|m)\/i);\n  if(m)return Number(m[1])*60+Number(m[2]);\n  m=t.match(\/(\\d{1,3})\\s*(?:小时|小時|h)\/i);if(m)return Number(m[1])*60;\n  m=t.match(\/(\\d{1,4})\\s*(?:分钟|分鐘|分|m)\/i);if(m)return Number(m[1]);\n  return -1;\n }\n var first=(typeof 植物状态内容==='undefined'?'':String(植物状态内容||''));\n var second=(typeof 植物状态复核内容==='undefined'?'':String(植物状态复核内容||''));\n var a=parse(first),b=parse(second),chosen='first';\n if(a>=0&&b>=0){\n  var diff=Math.abs(a-b);\n  if(diff<=1)chosen='first';\n  else if(b<a){植物状态内容=second;chosen='left-smaller';}\n  else chosen='first-smaller';\n }\n try{zdjl.appendFile('\/sdcard\/Download\/农场总控日志\/收割后OCR复核.log',new Date().toISOString()+' COMPARE first='+a+' second='+b+' chosen='+chosen+'\\n');}catch(e){}\n try{zdjl.setVar('FC_HARVEST_TIME_VERIFY','NO','global');}catch(e){}\n})();"}

ilarPercent":95,"quickSearch":true,"codeVersion":"V1_7","imageScaleType":"dpi"},"desc":""},"desc":"⑥ 打开后识别等级经钱区域","vars":[{"name":"等级经钱内容","value":{"varType":"expression","varScope":"script","showInputInObjectSubVar":false,"mustInput":true,"showInputContentAlign":"left","valueExp":"ocrText(等级经钱, \"medium\")"}}]}

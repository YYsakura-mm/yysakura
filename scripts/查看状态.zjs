{"type":"运行JS代码","delay":"0","delayUnit":1,"desc":"⑧ 写入农场TXT并续传云端单条记录","jsCode":"// 与网页同步共用服务器和密钥；断网时待传记录保存在 /sdcard/Download/农场待上传.jsonl。\nvar FARM_API = \"http://38.207.187.183:8787/api/farm-records\";\nvar FARM_TOKEN = \"1f217af4efb810576fec17e1c974f9436f84e72b6cfdbb5120a75a2bdcb0cd43\";\nvar FARM_TXT = \"/sdcard/Download/农场记录.txt\";\nvar FARM_QUEUE = \"/sdcard/Download/农场待上传.jsonl\";\nvar d = new Date();\nvar p = function(n){ return (\"0\" + n).slice(-2); };\nvar time = d.getFullYear() + \"-\" + p(d.getMonth()+1) + \"-\" + p(d.getDate()) + \" \" + p(d.getHours()) + \":\" + p(d.getMinutes()) + \":\" + p(d.getSeconds());\nvar record = \"===== 记录时间：\" + time + \" =====\\r\\n\" +\n  \"【植物状态】\\r\\n\" + (植物状态内容 || \"\") + \"\\r\\n\\r\\n\" +\n  \"【每日任务】\\r\\n\" + (每日任务内容 || \"\") + \"\\r\\n\\r\\n\" +\n  \"【等级经钱】\\r\\n\" + (等级经钱内容 || \"\") + \"\\r\\n\" +\n  \"==============================\\r\\n\\r\\n\";\nzdjl.appendFile(FARM_TXT, record);\nzdjl.appendFile(FARM_QUEUE, JSON.stringify({record:record}) + \"\\n\");\ntry {\n  var lines = String(zdjl.readFile(FARM_QUEUE) || \"\").split(/\\r?\\n/);\n  var pending = [];\n  for (var i=0; i<lines.length; i++) if (lines[i]) pending.push(lines[i]);\n  var done = 0;\n  while (done < pending.length && done < 20) {\n    var item = JSON.parse(pending[done]);\n    var response = zdjl.requestUrl({\n      url:FARM_API, method:\"POST\",\n      headers:[{\"Content-Type\":\"application/json\"},{\"X-Farm-Token\":FARM_TOKEN}],\n      requestBody:JSON.stringify({record:item.record}),\n      requestType:\"TEXT\", responseType:\"TEXT\"\n    });\n    if (!response || response.code !== 200 || !JSON.parse(response.body || \"{}\").ok) break;\n    done++;\n  }\n  if (done) zdjl.writeFile(FARM_QUEUE, pending.slice(done).join(\"\\n\") + (done < pending.length ? \"\\n\" : \"\"));\n} catch (farmSyncError) {\n  // 本地 TXT 与待传队列均已写入；下次扫描自动重试。\n}\n"}

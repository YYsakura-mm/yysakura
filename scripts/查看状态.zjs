{"type":"运行JS代码","delay":"0","delayUnit":1,"desc":"⑧ 写入农场TXT并续传云端单条记录","jsCode":"\/\/ 与网页同步共用服务器和密钥；断网时待传记录保存在 \/sdcard\/Download\/农场待上传.jsonl。\nvar FARM_API = \"http:\/\/43.142.110.56\/api\/farm-records\";\nvar FARM_TOKEN = \"1f217af4efb810576fec17e1c974f9436f84e72b6cfdbb5120a75a2bdcb0cd43\";\nvar FARM_TXT = \"\/sdcard\/Download\/农场记录.txt\";\nvar FARM_QUEUE = \"\/sdcard\/Download\/农场待上传.jsonl\";\nvar FARM_REJECT = \"\/sdcard\/Download\/农场待上传_无效隔离.jsonl\";\nvar d = new Date();\nvar p = function(n){ return (\"0\" + n).slice(-2); };\nvar time = d.getFullYear() + \"-\" + p(d.getMonth()+1) + \"-\" + p(d.getDate()) + \" \" + p(d.getHours()) + \":\" + p(d.getMinutes()) + \":\" + p(d.getSeconds());\nvar record = \"===== 记录时间：\" + time + \" =====\\r\\n\" +\n  \"【植物状态】\\r\\n\" + (typeof 植物状态内容 === \"undefined\" ? \"\" : String(植物状态内容 || \"\")) + \"\\r\\n\\r\\n\" +\n  \"【每日任务】\\r\\n\" + (typeof 每日任务内容 === \"undefined\" ? \"\" : String(每日任务内容 || \"\")) + \"\\r\\n\\r\\n\" +\n  \"【等级经钱】\\r\\n\" + (typeof 等级经钱内容 === \"undefined\" ? \"\" : String(等级经钱内容 || \"\")) + \"\\r\\n\" +\n  \"==============================\\r\\n\\r\\n\";\ntry{zdjl.appendFile(FARM_TXT,record);}catch(saveErr){\n  try{zdjl.appendFile(\"\/sdcard\/Download\/农场上传日志.txt\",new Date().toISOString()+\" [状态识别] 本地TXT写入失败:\"+String(saveErr)+\"\\r\\n\");}catch(e){}\n}\nvar recordQueued=false;\ntry{zdjl.appendFile(FARM_QUEUE,JSON.stringify({record:record})+\"\\n\");recordQueued=true;}\ncatch(queueErr){\n  try{zdjl.appendFile(\"\/sdcard\/Download\/农场上传日志.txt\",new Date().toISOString()+\" [状态识别] 待传队列写入失败:\"+String(queueErr)+\"\\r\\n\");}catch(e){}\n}\nif(recordQueued){\n\n\/\/ ===== 共享队列稳健续传：兼容旧格式 {\"record\":\"...\"}，不改变服务器接口 =====\n(function(){\n  var Q=FARM_QUEUE, API=FARM_API, KEY=FARM_TOKEN;\n  var LOG=\"\/sdcard\/Download\/农场上传日志.txt\";\n  var BAD=\"\/sdcard\/Download\/农场待上传_无效隔离.jsonl\";\n  var FROM=\"状态识别\", LIMIT=50, BUDGET=12000;\n  var began=Date.now(), attempts=0, sent=0, isolated=0, reason=\"\", http=0;\n  function note(s){try{zdjl.appendFile(LOG,new Date().toISOString()+\" [\"+FROM+\"] \"+s+\"\\r\\n\");}catch(e){}}\n  function isolate(raw, why){\n    \/\/ 只有确认成功备份到隔离文件后才从主队列移除，避免坏数据被静默丢弃。\n    try{zdjl.appendFile(BAD,JSON.stringify({time:new Date().toISOString(),source:FROM,error:why,line:raw})+\"\\n\");isolated++;return true;}\n    catch(e){reason=\"隔离文件写入失败:\"+String(e);return false;}\n  }\n  try{\n    var snapshot=String(zdjl.readFile(Q)||\"\");\n    if(!snapshot)return;\n    var rawLines=snapshot.split(\/\\r?\\n\/), pending=[];\n    for(var i=0;i<rawLines.length;i++)if(rawLines[i])pending.push(rawLines[i]);\n    if(!pending.length)return;\n    var keep=[], stopped=false, changed=false;\n    for(var j=0;j<pending.length;j++){\n      var raw=pending[j];\n      if(stopped || attempts>=LIMIT || Date.now()-began>=BUDGET){keep.push(raw);continue;}\n      attempts++;\n      var item=null;\n      try{item=JSON.parse(raw);if(!item||typeof item.record!==\"string\"||!item.record.length)throw new Error(\"record字段无效\");}\n      catch(badJson){\n        if(isolate(raw,\"JSON格式错误:\"+String(badJson))){changed=true;continue;}\n        keep.push(raw);stopped=true;continue;\n      }\n      var rsp=null;\n      try{\n        rsp=zdjl.requestUrl({url:API,method:\"POST\",timeout:6000,\n          headers:[{\"Content-Type\":\"application\/json\"},{\"X-Farm-Token\":KEY}],\n          requestBody:JSON.stringify({record:item.record}),requestType:\"TEXT\",responseType:\"TEXT\"});\n      }catch(reqErr){reason=\"网络请求异常:\"+String(reqErr);keep.push(raw);stopped=true;continue;}\n      http=rsp?Number(rsp.code)||0:0;\n      var obj=null;\n      try{obj=JSON.parse((rsp&&rsp.body)||\"\");}catch(parseRsp){}\n      if(http>=200&&http<300&&obj&&obj.ok===true){sent++;changed=true;continue;}\n      \/\/ 400\/413\/422 仅隔离+完整保留原文，防止一条永远无效的数据堵住全部队列。\n      if(http===400||http===413||http===422){\n        if(isolate(raw,\"HTTP \"+http+\" \"+String((obj&&obj.error)||\"服务器拒收\"))){changed=true;continue;}\n        keep.push(raw);stopped=true;continue;\n      }\n      reason=\"HTTP \"+http+(obj&&obj.error?\" \"+String(obj.error):\" 或响应缺少ok=true\");\n      keep.push(raw);stopped=true;\n    }\n    if(changed){\n      \/\/ 在覆盖队列前再次读取，保留本次HTTP发送期间其他动作新追加的尾部。\n      var live=String(zdjl.readFile(Q)||\"\");\n      if(live.substr(0,snapshot.length)!==snapshot){\n        \/\/ 其他上传动作改写过队列：放弃覆盖，宁可下轮重复，也不冒险丢数据。\n        note(\"队列被其他动作改写，取消本轮清理；可能重复补传 已发送=\"+sent+\" 隔离=\"+isolated);\n        return;\n      }\n      var tail=live.substr(snapshot.length);\n      var remain=keep.join(\"\\n\")+(keep.length?\"\\n\":\"\");\n      zdjl.writeFile(Q,remain+tail);\n    }\n    if(reason||isolated||sent>0){\n      note(\"尝试=\"+attempts+\" 成功=\"+sent+\" 隔离=\"+isolated+\" 剩余至少=\"+keep.length+\" 状态=\"+(reason||\"完成\")+\" HTTP=\"+http);\n    }\n  }catch(allErr){note(\"队列处理异常:\"+String(allErr)+\" 已发送=\"+sent+\"；原始队列保留，可能重复补传\");}\n})();\n}\n"}

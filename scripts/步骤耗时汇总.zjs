{"type":"运行JS代码","delay":"0","delayUnit":1,"desc":"汇总最近运行耗时，不改变运行进度","jsCode":"(function(){var z=zdjl,s=String(z.readFile('/sdcard/Download/总控_步骤耗时.jsonl')||''),ls=s.split(/\\r?\\n/),rows=[],bad=0;for(var i=0;i<ls.length;i++){if(!ls[i])continue;try{rows.push(JSON.parse(ls[i]));}catch(e){bad++;}}var run='';for(var i=rows.length-1;i>=0;i--)if(rows[i].run){run=rows[i].run;break;}var stats={},open={},events=[],tokens={};for(var i=0;i<rows.length;i++){var e=rows[i];if(run&&e.run!==run)continue;events.push(e);var key=e.sid+'|'+e.action+'|'+e.token;if(e.event==='begin'){open[key]=e;continue;}if(tokens[key])continue;tokens[key]=true;delete open[key];if(e.elapsedMs===null)continue;var st=stats[e.action]||(stats[e.action]={action:e.action,desc:e.desc,type:e.type,child:e.child,n:0,sum:0,max:0,fail:0,values:[]});st.n++;st.sum+=Number(e.elapsedMs);st.max=Math.max(st.max,Number(e.elapsedMs));st.values.push(Number(e.elapsedMs));if(e.event==='failure')st.fail++;}var arr=[];for(var k in stats){var a=stats[k];a.values.sort(function(a,b){return a-b;});a.p95=a.values[Math.max(0,Math.ceil(a.values.length*.95)-1)];arr.push(a);}arr.sort(function(a,b){return b.sum-a.sum;});var text=['总控步骤耗时报告','生成：'+new Date().toISOString(),'运行编号：'+run,'解析失败行：'+bad,'统计范围：最近有运行编号的任务；不混合其他运行。','耗时为开始到成功/失败回调进入，不含原回调内部耗时。','总控动作与子脚本可能嵌套，累计耗时不能相加当作总运行时间。','','【累计耗时排行】'];for(var i=0;i<Math.min(25,arr.length);i++){var a=arr[i];text.push(a.action+' '+(a.desc||a.type)+(a.child?' '+a.child:'')+' 次数='+a.n+' 合计='+a.sum+'ms 均值='+Math.round(a.sum/a.n)+'ms 最大='+a.max+'ms P95='+a.p95+'ms 失败='+a.fail);}text.push('','【有开始但未见结束】');var n=0;for(var k in open){var e=open[k];if(n++>=25)break;text.push(e.action+' '+(e.desc||e.type)+' 子脚本='+e.child+' 王者='+e.king+' 区='+e.zone+' 开始='+new Date(e.t).toISOString());}if(!n)text.push('无。');text.push('跳转、停止、回调未返回、采集时仍执行、引擎终止都可能造成未配对；不能直接认定卡死。','条件未命中可能不触发开始回调，不作为耗时样本。','','【近期原始事件】');events=events.slice(-300);for(var i=0;i<events.length;i++)text.push(JSON.stringify(events[i]));z.writeFile('/sdcard/Download/农场总控_步骤耗时报告.txt',text.join('\\n'));})();"}

{"type":"运行JS代码","delay":"0","delayUnit":1,"repeatCount":1,"desc":"V54 沙漏开关读取（独立运行也安全）","jsCode":"(function(){\n var f='\/sdcard\/Download\/农场总控_沙漏设置.json', cfg={buy:'不购买',use:'不使用',count:1,useCount:1},raw='';\n try{raw=String(zdjl.readFile(f)||'');if(raw){var v=JSON.parse(raw);if(v&&(v.schema===54||v.schema===55)){\n  cfg.buy=v.buy==='购买'?'购买':'不购买';cfg.use=v.use==='使用'?'使用':'不使用';\n  cfg.count=Math.min(3,Math.max(1,Math.floor(Number(v.count)||1)));\n  cfg.useCount=Math.min(3,Math.max(1,Math.floor(Number(v.useCount)||1)));}}\n }catch(e){try{zdjl.appendFile('\/sdcard\/Download\/FarmControl_Hourglass_Fallback.log',new Date().toISOString()+' CONFIG_READ_FAIL '+String(e)+'\\n');}catch(x){}}\n try{zdjl.setVar('沙漏购买模式',cfg.buy,'global');zdjl.setVar('沙漏使用模式',cfg.use,'global');zdjl.setVar('沙漏购买数量',String(cfg.count),'global');zdjl.setVar('沙漏使用数量',String(cfg.useCount),'global');\n      zdjl.setVar('FC_HG_BUY',cfg.buy==='购买'?'是':'否','global');\n      zdjl.setVar('FC_HG_USE',cfg.use==='使用'?'是':'否','global');\n      zdjl.setVar('FC_HG_COUNT',cfg.count,'global');zdjl.setVar('FC_HG_USE_COUNT',cfg.useCount,'global');}catch(e){}\n})();\n(function(){\n var b=String(zdjl.getVar('FC_HG_BUY','global')||''),u=String(zdjl.getVar('FC_HG_USE','global')||'');\n var q=Number(zdjl.getVar('FC_HG_COUNT','global'))||1;\n var s=new Date().toISOString()+' HG_DECISION buy='+b+' use='+u+' buyCount='+q+' useCount='+String(zdjl.getVar('FC_HG_USE_COUNT','global')||1)+' zone='+String(zdjl.getVar('当前区','global')||'?')+'\\n';\n try{zdjl.appendFile('\/sdcard\/Download\/农场总控日志\/沙漏执行.log',s);}catch(e){try{zdjl.appendFile('\/sdcard\/Download\/FarmControl_Hourglass_Fallback.log',s);}catch(x){}}\n})();"}

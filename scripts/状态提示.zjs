{"repeatCount":-1,"pauseOnFail":false,"count":3,"minVerCode":2021000,"minVerName":"2.21.0","screenWidth":720,"screenHeight":1280,"screenDpi":2,"lastSaveScreenWidth":1280,"lastSaveScreenHeight":720,"lastSaveScreenDpi":2,"description":"兼容HUD桥接：主脚本统一HUD时不重复创建提示；旧脚本仍可独立显示","delay":""}
{"type":"设置变量","delay":"0","delayUnit":1,"vars":[{"name":"HUD文本","value":{"varType":"string","varScope":"script","showInputInObjectSubVar":false,"mustInput":false,"value":""}}]}
{"type":"运行JS代码","delay":"0","delayUnit":1,"desc":"生成HUD文字","jsCode":"function 补2(n){\n    n=Number(n)||0;\n    return n<10 ? (\"0\"+n) : String(n);\n}\n\nvar 起点=0;\ntry{起点=Number(HUD启动时间)||0;}catch(e){}\nif(!(起点>0)) 起点=Date.now();\n\nvar 已过=Math.max(0, Date.now()-起点);\nvar 总分钟=Math.floor(已过/60000);\nvar 小时=Math.floor(总分钟/60);\nvar 分钟=总分钟%60;\nvar 时间=补2(小时)+\":\"+补2(分钟);\n\nvar 名称=\"\";\ntry{名称=String(HUD当前账号||\"\").trim();}catch(e){}\nif(!名称) 名称=\"?\";\n\nvar 区=0, 总区=0;\ntry{区=Number(当前区)||0;}catch(e){}\ntry{总区=Number(总数区)||0;}catch(e){}\n\nvar 任务=\"\";\ntry{任务=String(HUD任务||\"\").trim();}catch(e){}\n\nvar 是临时=false;\ntry{是临时=(临时模式==\"是\");}catch(e){}\n\nif(是临时){\n    HUD文本=时间+\"｜\"+名称+\" \"+区+\"/\"+总区;\n}else{\n    var 序列=\"\";\n    try{序列=String(账号序列||\"\").replace(/[^1-8]/g,\"\");}catch(e){}\n    if(!序列){\n        try{序列=String(当前第几个号||\"\");}catch(e){}\n    }\n    HUD文本=时间+\"｜\"+序列+\"｜\"+名称+\" \"+区+\"/\"+总区;\n}\n\nif(任务) HUD文本=HUD文本+\"｜\"+任务;"}
{"type":"系统提示","delay":"0","delayUnit":1,"desc":"旧式HUD（统一HUD模式下自动跳过，防止提示叠加）","promptType":"toast","promptTitle":"","showPosition":"bottom_left","playAudio":"false","useVibrator":false,"showDuration":600000,"__vars":{"promptText":{"varType":"expression","varScope":"script","mustInput":true,"valueExp":"HUD文本"}},"condition":{"type":"jsExpression","expression":"typeof HUD统一模式==\"undefined\" || HUD统一模式!=\"是\"","desc":"仅非统一HUD模式创建旧式提示，避免重复常驻窗口叠加"}}

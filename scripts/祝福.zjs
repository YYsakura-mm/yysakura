{"repeatCount":-1,"pauseOnFail":false,"count":111,"minVerCode":2026000,"minVerName":"2.26.0","screenWidth":720,"screenHeight":1280,"screenDpi":2,"lastSaveScreenWidth":1280,"lastSaveScreenHeight":720,"lastSaveScreenDpi":2,"savedVerCode":26000050,"savedVerName":"26.5.0","description":"祝福｜好友农场短轮询｜回主页自动重走第一步｜2/3连续祝福链保留","delay":"0.2","delayUnit":1,"globalCallbacks":{"afterEveryScriptSuc":{"type":"运行JS代码","delay":"0","delayUnit":1,"repeatCount":1,"condition":{"type":"colorFound","colorData":{"type":"color","x":"86.6%","y":"63.4%","color":"#d84040","limitArea":"544dp 216dp 554dp 224dp","similarPercent":99},"desc":""},"desc":"红色耗尽：记录送方/收方OCR与10次祝福结果后结束","jsCode":"var __jumpEnd=function(){\n    try{zdjl.runAction({\"type\":\"控制执行\",\"delay\":\"0\",\"delayUnit\":1,\"controlRunType\":\"jumpTo\",\"jumpToPosition\":\"55\",\"ContinueParentExecute\":false});}catch(__jumpErr){}\n};\ntry{\n    var __already=String(zdjl.getVar(\"祝福结果已记录\",\"global\")||\"否\");\n    if(__already!=\"是\"){\n        var __sender=String(zdjl.getVar(\"祝福送方OCR原文\",\"global\")||\"\").replace(/\\r\\n?/g,\"\\n\").trim();\n        var __receiver=String(zdjl.getVar(\"祝福收方OCR原文\",\"global\")||\"\").replace(/\\r\\n?/g,\"\\n\").trim();\n        var __friend=String(zdjl.getVar(\"祝福好友位置记录\",\"global\")||\"未记录\");\n        var __d=new Date();\n        var __p=function(n){return (\"0\"+n).slice(-2);};\n        var __time=__d.getFullYear()+\"-\"+__p(__d.getMonth()+1)+\"-\"+__p(__d.getDate())+\" \"+__p(__d.getHours())+\":\"+__p(__d.getMinutes())+\":\"+__p(__d.getSeconds());\n        var __record=\"===== 祝福汇总 =====\\r\\n\"+\n            \"记录类型：祝福汇总\\r\\n\"+\n            \"记录时间：\"+__time+\"\\r\\n\"+\n            \"【祝福送方OCR】\\r\\n\"+(__sender||\"未识别\")+\"\\r\\n\\r\\n\"+\n            \"【祝福收方OCR】\\r\\n\"+(__receiver||\"未识别\")+\"\\r\\n\\r\\n\"+\n            \"好友位置：\"+(__friend||\"未记录\")+\"\\r\\n\"+\n            \"祝福结果：今日次数已用完\\r\\n\"+\n            \"成功祝福：10\\r\\n\"+\n            \"==============================\\r\\n\\r\\n\";\n        var __FARM_API=\"http://43.142.110.56/api/farm-records\";\n        var __FARM_TOKEN=\"1f217af4efb810576fec17e1c974f9436f84e72b6cfdbb5120a75a2bdcb0cd43\";\n        var __FARM_TXT=\"/sdcard/Download/农场记录.txt\";\n        var __BLESS_TXT=\"/sdcard/Download/祝福记录.txt\";\n        var __QUEUE=\"/sdcard/Download/农场待上传.jsonl\";\n        try{zdjl.appendFile(__FARM_TXT,__record);}catch(__e1){try{zdjl.appendFile(\"/sdcard/Download/农场上传日志.txt\",new Date().toISOString()+\" [祝福] 农场TXT写入失败:\"+String(__e1)+\"\\r\\n\");}catch(__z){}}\n        try{zdjl.appendFile(__BLESS_TXT,__record);}catch(__e2){try{zdjl.appendFile(\"/sdcard/Download/农场上传日志.txt\",new Date().toISOString()+\" [祝福] 祝福TXT写入失败:\"+String(__e2)+\"\\r\\n\");}catch(__z){}}\n        var __queued=false;\n        try{zdjl.appendFile(__QUEUE,JSON.stringify({record:__record})+\"\\n\");__queued=true;}\n        catch(__e3){try{zdjl.appendFile(\"/sdcard/Download/农场上传日志.txt\",new Date().toISOString()+\" [祝福] 队列写入失败:\"+String(__e3)+\"\\r\\n\");}catch(__z){}}\n        // 本地落盘成功后立刻置已记录，避免红色回调重复追加同一事件。\n        try{zdjl.setVar(\"祝福结果已记录\",\"是\",\"global\");}catch(__e4){}\n        // 与状态识别共用完全一致的FIFO上传规则。\n        if(__queued){\n\n// ===== 共享队列稳健续传：兼容旧格式 {\"record\":\"...\"}，不改变服务器接口 =====\n(function(){\n  var Q=__QUEUE, API=__FARM_API, KEY=__FARM_TOKEN;\n  var LOG=\"/sdcard/Download/农场上传日志.txt\";\n  var BAD=\"/sdcard/Download/农场待上传_无效隔离.jsonl\";\n  var FROM=\"祝福\", LIMIT=20, BUDGET=8000;\n  var began=Date.now(), attempts=0, sent=0, isolated=0, reason=\"\", http=0;\n  function note(s){try{zdjl.appendFile(LOG,new Date().toISOString()+\" [\"+FROM+\"] \"+s+\"\\r\\n\");}catch(e){}}\n  function isolate(raw, why){\n    // 只有确认成功备份到隔离文件后才从主队列移除，避免坏数据被静默丢弃。\n    try{zdjl.appendFile(BAD,JSON.stringify({time:new Date().toISOString(),source:FROM,error:why,line:raw})+\"\\n\");isolated++;return true;}\n    catch(e){reason=\"隔离文件写入失败:\"+String(e);return false;}\n  }\n  try{\n    var snapshot=String(zdjl.readFile(Q)||\"\");\n    if(!snapshot)return;\n    var rawLines=snapshot.split(/\\r?\\n/), pending=[];\n    for(var i=0;i<rawLines.length;i++)if(rawLines[i])pending.push(rawLines[i]);\n    if(!pending.length)return;\n    var keep=[], stopped=false, changed=false;\n    for(var j=0;j<pending.length;j++){\n      var raw=pending[j];\n      if(stopped || attempts>=LIMIT || Date.now()-began>=BUDGET){keep.push(raw);continue;}\n      attempts++;\n      var item=null;\n      try{item=JSON.parse(raw);if(!item||typeof item.record!==\"string\"||!item.record.length)throw new Error(\"record字段无效\");}\n      catch(badJson){\n        if(isolate(raw,\"JSON格式错误:\"+String(badJson))){changed=true;continue;}\n        keep.push(raw);stopped=true;continue;\n      }\n      var rsp=null;\n      try{\n        rsp=zdjl.requestUrl({url:API,method:\"POST\",timeout:6000,\n          headers:[{\"Content-Type\":\"application/json\"},{\"X-Farm-Token\":KEY}],\n          requestBody:JSON.stringify({record:item.record}),requestType:\"TEXT\",responseType:\"TEXT\"});\n      }catch(reqErr){reason=\"网络请求异常:\"+String(reqErr);keep.push(raw);stopped=true;continue;}\n      http=rsp?Number(rsp.code)||0:0;\n      var obj=null;\n      try{obj=JSON.parse((rsp&&rsp.body)||\"\");}catch(parseRsp){}\n      if(http>=200&&http<300&&obj&&obj.ok===true){sent++;changed=true;continue;}\n      // 400/413/422 仅隔离+完整保留原文，防止一条永远无效的数据堵住全部队列。\n      if(http===400||http===413||http===422){\n        if(isolate(raw,\"HTTP \"+http+\" \"+String((obj&&obj.error)||\"服务器拒收\"))){changed=true;continue;}\n        keep.push(raw);stopped=true;continue;\n      }\n      reason=\"HTTP \"+http+(obj&&obj.error?\" \"+String(obj.error):\" 或响应缺少ok=true\");\n      keep.push(raw);stopped=true;\n    }\n    if(changed){\n      // 在覆盖队列前再次读取，保留本次HTTP发送期间其他动作新追加的尾部。\n      var live=String(zdjl.readFile(Q)||\"\");\n      if(live.substr(0,snapshot.length)!==snapshot){\n        // 其他上传动作改写过队列：放弃覆盖，宁可下轮重复，也不冒险丢数据。\n        note(\"队列被其他动作改写，取消本轮清理；可能重复补传 已发送=\"+sent+\" 隔离=\"+isolated);\n        return;\n      }\n      var tail=live.substr(snapshot.length);\n      var remain=keep.join(\"\\n\")+(keep.length?\"\\n\":\"\");\n      zdjl.writeFile(Q,remain+tail);\n    }\n    if(reason||isolated||sent>0){\n      note(\"尝试=\"+attempts+\" 成功=\"+sent+\" 隔离=\"+isolated+\" 剩余至少=\"+keep.length+\" 状态=\"+(reason||\"完成\")+\" HTTP=\"+http);\n    }\n  }catch(allErr){note(\"队列处理异常:\"+String(allErr)+\" 已发送=\"+sent+\"；原始队列保留，可能重复补传\");}\n})();\n        }\n        try{zdjl.toast(\"祝福10/10｜送\"+(__sender?\"√\":\"×\")+\" 收\"+(__receiver?\"√\":\"×\")+\"｜记录已保存\",2200);}catch(__toastErr){}\n    }\n}catch(__blessRecordErr){}\n__jumpEnd();"},"beforeFirstLoop":{"type":"运行JS代码","delay":"0","delayUnit":1,"desc":"祝福移动修正 + 送收方身份记录初始化","jsCode":"try{var __祝福修正=Number(zdjl.getVar(\"祝福移动修正\",\"global\"));if(!isFinite(__祝福修正))__祝福修正=0;if(__祝福修正>300)__祝福修正=300;if(__祝福修正<-300)__祝福修正=-300;zdjl.setVar(\"祝福移动修正\",__祝福修正,\"global\");}catch(__祝福修正Err){try{zdjl.setVar(\"祝福移动修正\",0,\"global\");}catch(__e){}}\ntry{\n    zdjl.setVar(\"祝福结果已记录\",\"否\",\"global\");\n    zdjl.setVar(\"祝福送方OCR原文\",\"\",\"global\");\n    zdjl.setVar(\"祝福收方OCR原文\",\"\",\"global\");\n    zdjl.setVar(\"祝福好友位置记录\",\"第一个\",\"global\");\n}catch(__resetErr){}\ntry{zdjl.setVar(\"continuousBless\",0,\"global\");}catch(__continuousBlessInitErr){}"}}}

{"repeatCount":-1,"pauseOnFail":false,"count":111,"minVerCode":2021000,"minVerName":"2.21.0","screenWidth":720,"screenHeight":1280,"screenDpi":2,"lastSaveScreenWidth":1280,"lastSaveScreenHeight":720,"lastSaveScreenDpi":2,"savedVerCode":26000050,"savedVerName":"26.5.0","description":"祝福｜55步稳定路线｜送/收方使用原识别情况原生OCR动作｜红色耗尽记录10次并上传","delay":"0.2","delayUnit":1,"globalCallbacks":{"afterEveryScriptSuc":{"type":"运行JS代码","delay":"0","delayUnit":1,"repeatCount":1,"condition":{"type":"colorFound","colorData":{"type":"color","x":"86.6%","y":"63.4%","color":"#d84040","limitArea":"544dp 216dp 554dp 224dp","similarPercent":99},"desc":""},"desc":"红色耗尽：记录送方/收方OCR与10次祝福结果后结束","jsCode":"var __jumpEnd=function(){\n    try{zdjl.runAction({\"type\":\"控制执行\",\"delay\":\"0\",\"delayUnit\":1,\"controlRunType\":\"jumpTo\",\"jumpToPosition\":\"55\",\"ContinueParentExecute\":false});}catch(__jumpErr){}\n};\ntry{\n    var __already=String(zdjl.getVar(\"祝福结果已记录\",\"global\")||\"否\");\n    if(__already!=\"是\"){\n        var __sender=String(zdjl.getVar(\"祝福送方OCR原文\",\"global\")||\"\").replace(/\\r\\n?/g,\"\\n\").trim();\n        var __receiver=String(zdjl.getVar(\"祝福收方OCR原文\",\"global\")||\"\").replace(/\\r\\n?/g,\"\\n\").trim();\n        var __friend=String(zdjl.getVar(\"祝福好友位置记录\",\"global\")||\"未记录\");\n        var __d=new Date();\n        var __p=function(n){return (\"0\"+n).slice(-2);};\n        var __time=__d.getFullYear()+\"-\"+__p(__d.getMonth()+1)+\"-\"+__p(__d.getDate())+\" \"+__p(__d.getHours())+\":\"+__p(__d.getMinutes())+\":\"+__p(__d.getSeconds());\n        var __record=\"===== 祝福汇总 =====\\r\\n\"+\n            \"记录类型：祝福汇总\\r\\n\"+\n            \"记录时间：\"+__time+\"\\r\\n\"+\n            \"【祝福送方OCR】\\r\\n\"+(__sender||\"未识别\")+\"\\r\\n\\r\\n\"+\n            \"【祝福收方OCR】\\r\\n\"+(__receiver||\"未识别\")+\"\\r\\n\\r\\n\"+\n            \"好友位置：\"+(__friend||\"未记录\")+\"\\r\\n\"+\n            \"祝福结果：今日次数已用完\\r\\n\"+\n            \"成功祝福：10\\r\\n\"+\n            \"==============================\\r\\n\\r\\n\";\n        var __FARM_API=\"http://38.207.187.183:8787/api/farm-records\";\n        var __FARM_TOKEN=\"1f217af4efb810576fec17e1c974f9436f84e72b6cfdbb5120a75a2bdcb0cd43\";\n        var __FARM_TXT=\"/sdcard/Download/农场记录.txt\";\n        var __BLESS_TXT=\"/sdcard/Download/祝福记录.txt\";\n        var __QUEUE=\"/sdcard/Download/农场待上传.jsonl\";\n        try{zdjl.appendFile(__FARM_TXT,__record);}catch(__e1){}\n        try{zdjl.appendFile(__BLESS_TXT,__record);}catch(__e2){}\n        try{zdjl.appendFile(__QUEUE,JSON.stringify({record:__record})+\"\\n\");}catch(__e3){}\n        // 本地落盘成功后立刻置已记录，避免红色回调重复追加同一事件。\n        try{zdjl.setVar(\"祝福结果已记录\",\"是\",\"global\");}catch(__e4){}\n        // 与普通农场记录共用同一待传队列；本次尽量续传，失败留给后续记录继续重试。\n        try{\n            var __lines=String(zdjl.readFile(__QUEUE)||\"\").split(/\\r?\\n/),__pending=[];\n            for(var __i=0;__i<__lines.length;__i++) if(__lines[__i]) __pending.push(__lines[__i]);\n            var __done=0;\n            while(__done<__pending.length && __done<20){\n                var __item; try{__item=JSON.parse(__pending[__done]);}catch(__pe){__done++;continue;}\n                var __resp;\n                try{__resp=zdjl.requestUrl({url:__FARM_API,method:\"POST\",timeout:5000,headers:[{\"Content-Type\":\"application/json\"},{\"X-Farm-Token\":__FARM_TOKEN}],requestBody:JSON.stringify({record:__item.record}),requestType:\"TEXT\",responseType:\"TEXT\"});}catch(__re){break;}\n                if(!__resp || __resp.code!==200) break;\n                var __ok=false; try{__ok=!!JSON.parse(__resp.body||\"{}\").ok;}catch(__je){}\n                if(!__ok) break;\n                __done++;\n            }\n            if(__done){var __remain=__pending.slice(__done).join(\"\\n\");zdjl.writeFile(__QUEUE,__remain+(__remain?\"\\n\":\"\"));}\n        }catch(__syncErr){}\n        try{zdjl.toast(\"祝福10/10｜送\"+(__sender?\"√\":\"×\")+\" 收\"+(__receiver?\"√\":\"×\")+\"｜记录已保存\",2200);}catch(__toastErr){}\n    }\n}catch(__blessRecordErr){}\n__jumpEnd();"},"beforeFirstLoop":{"type":"运行JS代码","delay":"0","delayUnit":1,"desc":"性能仪表 + 祝福身份记录初始化","jsCode":"try{var __祝福修正=Number(zdjl.getVar(\"祝福移动修正\",\"global\"));if(!isFinite(__祝福修正))__祝福修正=0;if(__祝福修正>300)__祝福修正=300;if(__祝福修正<-300)__祝福修正=-300;zdjl.setVar(\"祝福移动修正\",__祝福修正,\"global\");}catch(__祝福修正Err){try{zdjl.setVar(\"祝福移动修正\",0,\"global\");}catch(__e){}}\ntry{zdjl.setVar(\"PERF_TMP_祝福\",String(Date.now()),\"global\");}catch(e){}\ntry{\n    zdjl.setVar(\"祝福结果已记录\",\"否\",\"global\");\n    zdjl.setVar(\"祝福送方OCR原文\",\"\",\"global\");\n    zdjl.setVar(\"祝福收方OCR原文\",\"\",\"global\");\n    zdjl.setVar(\"祝福好友位置记录\",\"第一个\",\"global\");\n}catch(__resetErr){}"},"afterAllLoop":{"type":"运行JS代码","delay":"0","delayUnit":1,"desc":"性能仪表：累计祝福","jsCode":"try{\nvar __s=Number(zdjl.getVar(\"PERF_TMP_祝福\",\"global\")||0);\nif(__s>0){\n    var __d=Math.max(0,Date.now()-__s);\n    var __k=\"PERF_祝福_毫秒\";\n    var __c=\"PERF_祝福_次数\";\n    zdjl.setVar(__k,String(Number(zdjl.getVar(__k,\"global\")||0)+__d),\"global\");\n    zdjl.setVar(__c,String(Number(zdjl.getVar(__c,\"global\")||0)+1),\"global\");\n    zdjl.setVar(\"PERF_TMP_祝福\",\"0\",\"global\");\n}\n}catch(e){}"}}}

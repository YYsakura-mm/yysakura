{"repeatCount":1,"pauseOnFail":false,"count":1,"minVerCode":2026000,"minVerName":"2.26.0","screenWidth":720,"screenHeight":1280,"screenDpi":2.0,"lastSaveScreenWidth":720,"lastSaveScreenHeight":1280,"lastSaveScreenDpi":2.0,"savedVerCode":26000050,"savedVerName":"26.5.0","delay":"0","description":"农场脚本云更新 V1｜正式版/测试版｜差异下载｜历史版本｜更新前备份","delayUnit":1}
{"type":"运行JS代码","delay":"0","delayUnit":1,"repeatCount":1,"desc":"农场脚本云更新 V1 主程序","jsCode":"(function () {\n    var SCOPE = \"farm_script_updater_v1\";\n    var CONFIG_KEY = \"config\";\n    var BASELINE_KEY = \"baseline\";\n    var LAST_BACKUP_KEY = \"last_backup\";\n    var LIST_FILE = \"农场脚本清单.json\";\n    var DEFAULT_FILES = [\n        \"1v1.zjs\",\"55.zjs\",\"切换账号.zjs\",\"升级农场.zjs\",\"升级小摊.zjs\",\"占位保存.zjs\",\n        \"嘎嘎祝福.zjs\",\"总控.zjs\",\"换16经验.zjs\",\"换经济作物.zjs\",\"查看状态.zjs\",\"浇水领奖.zjs\",\n        \"状态提示.zjs\",\"祝福.zjs\",\"祝福判定.zjs\",\"账号配置.zjs\",\"进游戏关闭广告.zjs\",\"退出农场.zjs\",\n        \"选择八小时作物.zjs\",\"选择英雄植物.zjs\",\"重启王者.zjs\"\n    ];\n\n    function trim(s) { return String(s == null ? \"\" : s).replace(/^\\s+|\\s+$/g, \"\"); }\n    function pad2(n) { return n < 10 ? \"0\" + n : String(n); }\n    function stamp() {\n        var d = new Date();\n        return d.getFullYear() + pad2(d.getMonth() + 1) + pad2(d.getDate()) + \"_\" + pad2(d.getHours()) + pad2(d.getMinutes()) + pad2(d.getSeconds());\n    }\n    function normalizeBaseDir(s) {\n        s = trim(s || \"/sdcard/自动精灵/\");\n        if (!s) s = \"/sdcard/自动精灵/\";\n        if (s.charAt(s.length - 1) !== \"/\") s += \"/\";\n        return s;\n    }\n    function normalizeServer(s) {\n        s = trim(s);\n        while (s.length > 0 && s.charAt(s.length - 1) === \"/\") s = s.substring(0, s.length - 1);\n        return s;\n    }\n    function loadJsonStorage(key, def) {\n        try {\n            var raw = zdjl.getStorage(key, SCOPE);\n            if (!raw) return def;\n            var obj = JSON.parse(raw);\n            return obj == null ? def : obj;\n        } catch (e) { return def; }\n    }\n    function saveJsonStorage(key, obj) {\n        zdjl.setStorage(key, JSON.stringify(obj), SCOPE);\n    }\n    function loadConfig() {\n        var c = loadJsonStorage(CONFIG_KEY, {});\n        return {\n            server: normalizeServer(c.server || \"\"),\n            token: String(c.token || \"\"),\n            adminToken: String(c.adminToken || \"\"),\n            baseDir: normalizeBaseDir(c.baseDir || \"/sdcard/自动精灵/\")\n        };\n    }\n    function saveConfig(c) {\n        c.server = normalizeServer(c.server);\n        c.baseDir = normalizeBaseDir(c.baseDir);\n        saveJsonStorage(CONFIG_KEY, c);\n    }\n    function configure(c) {\n        var server = zdjl.prompt(\"服务器地址（不要带 /api）\", c.server || \"http://服务器IP:8787\");\n        if (server == null) return null;\n        server = normalizeServer(server);\n        if (!server || server.indexOf(\"服务器IP\") >= 0) {\n            zdjl.alert(\"请填写真实服务器地址，例如 http://1.2.3.4:8787\", {title:\"设置未保存\"});\n            return null;\n        }\n        var token = zdjl.prompt(\"下载/读取密钥（与原 X-Farm-Token 相同）\", c.token || \"\");\n        if (token == null) return null;\n        var baseDir = zdjl.prompt(\"自动精灵脚本目录\", c.baseDir || \"/sdcard/自动精灵/\");\n        if (baseDir == null) return null;\n        var admin = c.adminToken || \"\";\n        if (zdjl.confirm(\"这台设备是否需要上传/发布权限？\\n\\n确定：设置管理员密钥\\n取消：只保留下载权限\", {title:\"上传权限\"})) {\n            var inputAdmin = zdjl.prompt(\"管理员密钥（X-Farm-Admin-Token）\", admin);\n            if (inputAdmin != null) admin = trim(inputAdmin);\n        }\n        c = {server:server, token:trim(token), adminToken:admin, baseDir:normalizeBaseDir(baseDir)};\n        saveConfig(c);\n        zdjl.toast(\"设置已保存\", 2000);\n        return c;\n    }\n\n    function request(c, method, path, body, admin) {\n        if (!c.server || !c.token) throw new Error(\"尚未设置服务器地址或下载密钥\");\n        var headers = [{\"Content-Type\":\"application/json\"}, {\"X-Farm-Token\":c.token}];\n        if (admin) {\n            if (!c.adminToken) throw new Error(\"本机尚未设置管理员密钥\");\n            headers.push({\"X-Farm-Admin-Token\":c.adminToken});\n        }\n        var opt = {url:c.server + path, method:method, headers:headers, timeout:20000, requestBody:\"\", requestType:\"TEXT\", responseType:\"TEXT\"};\n        if (body !== undefined && body !== null) opt.requestBody = JSON.stringify(body);\n        var resp = zdjl.requestUrl(opt);\n        if (!resp) throw new Error(\"服务器无响应\");\n        var code = Number(resp.code || 0);\n        var obj = null;\n        try { obj = JSON.parse(resp.body || \"{}\"); } catch (e) { obj = {}; }\n        if (code < 200 || code >= 300) throw new Error(obj.error || (\"服务器返回 \" + code));\n        return obj || {};\n    }\n\n    function utf8Bytes(str) {\n        var out = [], i, c, c2, cp;\n        str = String(str);\n        for (i = 0; i < str.length; i++) {\n            c = str.charCodeAt(i);\n            if (c >= 0xD800 && c <= 0xDBFF && i + 1 < str.length) {\n                c2 = str.charCodeAt(i + 1);\n                if (c2 >= 0xDC00 && c2 <= 0xDFFF) {\n                    cp = 0x10000 + ((c - 0xD800) << 10) + (c2 - 0xDC00);\n                    i++;\n                } else cp = c;\n            } else cp = c;\n            if (cp <= 0x7F) out.push(cp);\n            else if (cp <= 0x7FF) {\n                out.push(0xC0 | (cp >>> 6)); out.push(0x80 | (cp & 63));\n            } else if (cp <= 0xFFFF) {\n                out.push(0xE0 | (cp >>> 12)); out.push(0x80 | ((cp >>> 6) & 63)); out.push(0x80 | (cp & 63));\n            } else {\n                out.push(0xF0 | (cp >>> 18)); out.push(0x80 | ((cp >>> 12) & 63)); out.push(0x80 | ((cp >>> 6) & 63)); out.push(0x80 | (cp & 63));\n            }\n        }\n        return out;\n    }\n    function rotr(x, n) { return (x >>> n) | (x << (32 - n)); }\n    function hex32(x) { return (\"00000000\" + (x >>> 0).toString(16)).slice(-8); }\n    function sha256(str) {\n        var K = [\n            0x428a2f98,0x71374491,0xb5c0fbcf,0xe9b5dba5,0x3956c25b,0x59f111f1,0x923f82a4,0xab1c5ed5,\n            0xd807aa98,0x12835b01,0x243185be,0x550c7dc3,0x72be5d74,0x80deb1fe,0x9bdc06a7,0xc19bf174,\n            0xe49b69c1,0xefbe4786,0x0fc19dc6,0x240ca1cc,0x2de92c6f,0x4a7484aa,0x5cb0a9dc,0x76f988da,\n            0x983e5152,0xa831c66d,0xb00327c8,0xbf597fc7,0xc6e00bf3,0xd5a79147,0x06ca6351,0x14292967,\n            0x27b70a85,0x2e1b2138,0x4d2c6dfc,0x53380d13,0x650a7354,0x766a0abb,0x81c2c92e,0x92722c85,\n            0xa2bfe8a1,0xa81a664b,0xc24b8b70,0xc76c51a3,0xd192e819,0xd6990624,0xf40e3585,0x106aa070,\n            0x19a4c116,0x1e376c08,0x2748774c,0x34b0bcb5,0x391c0cb3,0x4ed8aa4a,0x5b9cca4f,0x682e6ff3,\n            0x748f82ee,0x78a5636f,0x84c87814,0x8cc70208,0x90befffa,0xa4506ceb,0xbef9a3f7,0xc67178f2\n        ];\n        var H = [0x6a09e667,0xbb67ae85,0x3c6ef372,0xa54ff53a,0x510e527f,0x9b05688c,0x1f83d9ab,0x5be0cd19];\n        var b = utf8Bytes(str), bitLen = b.length * 8, hi = Math.floor(bitLen / 0x100000000), lo = bitLen >>> 0;\n        b.push(0x80);\n        while ((b.length % 64) !== 56) b.push(0);\n        b.push((hi >>> 24) & 255,(hi >>> 16) & 255,(hi >>> 8) & 255,hi & 255,(lo >>> 24) & 255,(lo >>> 16) & 255,(lo >>> 8) & 255,lo & 255);\n        var off, i, w = new Array(64), a, bb, cc, d, e, f, g, h, s0, s1, ch, maj, t1, t2;\n        for (off = 0; off < b.length; off += 64) {\n            for (i = 0; i < 16; i++) w[i] = ((b[off+i*4] << 24) | (b[off+i*4+1] << 16) | (b[off+i*4+2] << 8) | b[off+i*4+3]) >>> 0;\n            for (i = 16; i < 64; i++) {\n                s0 = (rotr(w[i-15],7) ^ rotr(w[i-15],18) ^ (w[i-15] >>> 3)) >>> 0;\n                s1 = (rotr(w[i-2],17) ^ rotr(w[i-2],19) ^ (w[i-2] >>> 10)) >>> 0;\n                w[i] = (w[i-16] + s0 + w[i-7] + s1) >>> 0;\n            }\n            a=H[0]; bb=H[1]; cc=H[2]; d=H[3]; e=H[4]; f=H[5]; g=H[6]; h=H[7];\n            for (i = 0; i < 64; i++) {\n                s1 = (rotr(e,6) ^ rotr(e,11) ^ rotr(e,25)) >>> 0;\n                ch = ((e & f) ^ ((~e) & g)) >>> 0;\n                t1 = (h + s1 + ch + K[i] + w[i]) >>> 0;\n                s0 = (rotr(a,2) ^ rotr(a,13) ^ rotr(a,22)) >>> 0;\n                maj = ((a & bb) ^ (a & cc) ^ (bb & cc)) >>> 0;\n                t2 = (s0 + maj) >>> 0;\n                h=g; g=f; f=e; e=(d+t1)>>>0; d=cc; cc=bb; bb=a; a=(t1+t2)>>>0;\n            }\n            H[0]=(H[0]+a)>>>0; H[1]=(H[1]+bb)>>>0; H[2]=(H[2]+cc)>>>0; H[3]=(H[3]+d)>>>0;\n            H[4]=(H[4]+e)>>>0; H[5]=(H[5]+f)>>>0; H[6]=(H[6]+g)>>>0; H[7]=(H[7]+h)>>>0;\n        }\n        return hex32(H[0])+hex32(H[1])+hex32(H[2])+hex32(H[3])+hex32(H[4])+hex32(H[5])+hex32(H[6])+hex32(H[7]);\n    }\n\n    function readText(path) {\n        try { return zdjl.readFile(path); } catch (e) { return null; }\n    }\n    function writeText(path, content) {\n        zdjl.writeFile(path, content);\n    }\n    function getManagedFiles(c) {\n        var list = DEFAULT_FILES.slice(0), raw = readText(c.baseDir + LIST_FILE), obj, i, seen = {}, out = [];\n        if (raw) {\n            try {\n                obj = JSON.parse(raw);\n                if (obj && Object.prototype.toString.call(obj.files) === \"[object Array]\" && obj.files.length > 0) list = obj.files;\n            } catch (e) {}\n        }\n        list.push(LIST_FILE);\n        for (i = 0; i < list.length; i++) {\n            var n = trim(list[i]);\n            if (!n || seen[n]) continue;\n            if (!(n.slice(-4) === \".zjs\" || n.slice(-5) === \".json\")) continue;\n            if (n === \"脚本更新器.zjs\") continue;\n            seen[n] = true; out.push(n);\n        }\n        return out;\n    }\n    function localFile(c, name) {\n        var text = readText(c.baseDir + name);\n        if (text == null) return {name:name, exists:false, content:null, sha256:null};\n        return {name:name, exists:true, content:text, sha256:sha256(text)};\n    }\n    function manifestMap(manifest) {\n        var m = {}, a = (manifest && manifest.files) || [], i;\n        for (i = 0; i < a.length; i++) m[a[i].name] = a[i];\n        return m;\n    }\n    function loadBaseline() { return loadJsonStorage(BASELINE_KEY, {version:null, hashes:{}}); }\n    function saveBaselineFromManifestAndLocal(c, manifest) {\n        var fm = manifestMap(manifest), hashes = {}, names = getManagedFiles(c), i, lf, all = true;\n        for (i = 0; i < names.length; i++) {\n            if (!fm[names[i]]) continue;\n            lf = localFile(c, names[i]);\n            if (lf.exists && lf.sha256 === fm[names[i]].sha256) hashes[names[i]] = lf.sha256;\n            else all = false;\n        }\n        saveJsonStorage(BASELINE_KEY, {version: all ? manifest.version : \"mixed\", hashes:hashes, savedAt:Date.now()});\n    }\n    function compareLocal(c, manifest) {\n        var fm = manifestMap(manifest), baseline = loadBaseline(), names = getManagedFiles(c), out = [], i, n, lf, server, baseHash;\n        for (i = 0; i < names.length; i++) {\n            n = names[i]; server = fm[n]; lf = localFile(c, n); baseHash = baseline.hashes ? baseline.hashes[n] : null;\n            if (!server) {\n                out.push({name:n, status:\"server_missing\", local:lf, server:null});\n            } else if (!lf.exists) {\n                out.push({name:n, status:\"missing\", local:lf, server:server});\n            } else if (lf.sha256 === server.sha256) {\n                out.push({name:n, status:\"same\", local:lf, server:server});\n            } else if (baseHash && lf.sha256 !== baseHash && server.sha256 !== baseHash) {\n                out.push({name:n, status:\"conflict\", local:lf, server:server});\n            } else if (baseHash && lf.sha256 !== baseHash && server.sha256 === baseHash) {\n                out.push({name:n, status:\"local_modified\", local:lf, server:server});\n            } else {\n                out.push({name:n, status:\"update\", local:lf, server:server});\n            }\n        }\n        return out;\n    }\n    function summaryText(manifest, rows) {\n        var c = {same:0, missing:0, conflict:0, local_modified:0, update:0, server_missing:0}, i;\n        for (i = 0; i < rows.length; i++) c[rows[i].status] = (c[rows[i].status] || 0) + 1;\n        return \"服务器版本：\" + (manifest.version || \"?\") + \"\\n\" +\n            \"相同：\" + c.same + \"\\n\" +\n            \"可更新：\" + c.update + \"\\n\" +\n            \"本地缺失：\" + c.missing + \"\\n\" +\n            \"本地独自修改：\" + c.local_modified + \"\\n\" +\n            \"双方都改过/冲突：\" + c.conflict + \"\\n\" +\n            \"服务器清单缺失：\" + c.server_missing;\n    }\n    function getLatest(c, channel) {\n        var r = request(c, \"GET\", \"/api/scripts/latest?channel=\" + encodeURIComponent(channel || \"stable\"), null, false);\n        if (!r.manifest) throw new Error((channel === \"test\" ? \"测试版\" : \"正式版\") + \"尚未发布任何版本\");\n        return r.manifest;\n    }\n    function fetchVersion(c, version) {\n        var r = request(c, \"GET\", \"/api/scripts/manifest?version=\" + encodeURIComponent(version), null, false);\n        if (!r.manifest) throw new Error(\"版本不存在\");\n        return r.manifest;\n    }\n    function chooseRows(rows) {\n        var candidates = [], labels = [], i, p;\n        for (i = 0; i < rows.length; i++) {\n            if (rows[i].status === \"same\" || rows[i].status === \"server_missing\") continue;\n            candidates.push(rows[i]);\n            p = rows[i].status === \"missing\" ? \"[缺失] \" : rows[i].status === \"conflict\" ? \"[冲突] \" : rows[i].status === \"local_modified\" ? \"[本地改过] \" : \"[更新] \";\n            labels.push(p + rows[i].name);\n        }\n        if (!labels.length) return [];\n        var sel = zdjl.select({title:\"选择要下载的文件\", items:labels, selectItems:labels, multi:true});\n        if (!sel || !sel.items) return [];\n        var chosen = [], j;\n        for (i = 0; i < sel.items.length; i++) {\n            for (j = 0; j < labels.length; j++) if (sel.items[i] === labels[j]) { chosen.push(candidates[j]); break; }\n        }\n        return chosen;\n    }\n    function makeBackup(c, rows) {\n        var items = [], i, lf;\n        for (i = 0; i < rows.length; i++) {\n            lf = localFile(c, rows[i].name);\n            if (lf.exists) items.push({name:rows[i].name, sha256:lf.sha256, content:lf.content});\n        }\n        if (!items.length) return null;\n        var path = \"/sdcard/Download/农场脚本更新前备份_\" + stamp() + \".json\";\n        var obj = {createdAt:Date.now(), createdTime:(new Date()).toString(), baseDir:c.baseDir, items:items};\n        writeText(path, JSON.stringify(obj));\n        zdjl.setStorage(LAST_BACKUP_KEY, path, SCOPE);\n        return path;\n    }\n    function downloadRows(c, manifest, rows) {\n        if (!rows.length) { zdjl.toast(\"没有选择任何文件\", 2000); return; }\n        var i, r, data = [], row, actual;\n        for (i = 0; i < rows.length; i++) {\n            row = rows[i];\n            zdjl.toast(\"下载 \" + (i+1) + \"/\" + rows.length + \"：\" + row.name, 3000);\n            r = request(c, \"GET\", \"/api/scripts/file?version=\" + encodeURIComponent(manifest.version) + \"&name=\" + encodeURIComponent(row.name), null, false);\n            actual = sha256(r.content || \"\");\n            if (actual !== r.sha256 || actual !== row.server.sha256) throw new Error(row.name + \" 下载校验失败，未覆盖本地文件\");\n            data.push({name:row.name, content:r.content, sha256:actual});\n        }\n        var backup = makeBackup(c, rows), errors = [], x, verify;\n        for (i = 0; i < data.length; i++) {\n            x = data[i];\n            try {\n                writeText(c.baseDir + x.name, x.content);\n                verify = readText(c.baseDir + x.name);\n                if (verify == null || sha256(verify) !== x.sha256) throw new Error(\"写入后校验失败\");\n            } catch (e) { errors.push(x.name + \"：\" + e.message); }\n        }\n        if (errors.length) {\n            zdjl.alert(\"部分文件写入失败：\\n\" + errors.join(\"\\n\") + (backup ? \"\\n\\n已创建更新前备份：\\n\" + backup : \"\"), {title:\"更新未完整完成\"});\n            return;\n        }\n        saveBaselineFromManifestAndLocal(c, manifest);\n        zdjl.alert(\"版本：\" + manifest.version + \"\\n已更新 \" + data.length + \" 个文件\" + (backup ? \"\\n\\n更新前备份：\\n\" + backup : \"\"), {title:\"更新完成\"});\n    }\n    function downloadManifest(c, manifest, mode) {\n        var rows = compareLocal(c, manifest), candidates = [], conflicts = 0, i;\n        if (mode === \"check\") {\n            zdjl.alert(summaryText(manifest, rows), {title:\"脚本更新检查\"});\n            return;\n        }\n        if (mode === \"select\") {\n            candidates = chooseRows(rows);\n            if (candidates.length) downloadRows(c, manifest, candidates);\n            return;\n        }\n        for (i = 0; i < rows.length; i++) {\n            if (rows[i].status === \"update\" || rows[i].status === \"missing\" || rows[i].status === \"conflict\") {\n                candidates.push(rows[i]);\n                if (rows[i].status === \"conflict\") conflicts++;\n            }\n        }\n        if (!candidates.length) {\n            zdjl.alert(summaryText(manifest, rows), {title:\"已经是最新版\"});\n            return;\n        }\n        var msg = summaryText(manifest, rows) + \"\\n\\n本次将覆盖 \" + candidates.length + \" 个文件。\";\n        if (conflicts) msg += \"\\n⚠️ 其中 \" + conflicts + \" 个属于本地与服务器都修改过的冲突文件。\";\n        if (!zdjl.confirm(msg, {title:\"确认下载并覆盖\"})) return;\n        downloadRows(c, manifest, candidates);\n    }\n    function ensureAdmin(c) {\n        if (c.adminToken) return c;\n        var a = zdjl.prompt(\"此操作需要管理员密钥\", \"\");\n        if (a == null || !trim(a)) return null;\n        c.adminToken = trim(a); saveConfig(c); return c;\n    }\n    function uploadCurrent(c, channel) {\n        c = ensureAdmin(c); if (!c) return;\n        var names = getManagedFiles(c), files = [], missing = [], i, lf;\n        for (i = 0; i < names.length; i++) {\n            lf = localFile(c, names[i]);\n            if (!lf.exists) missing.push(names[i]); else files.push(lf);\n        }\n        if (missing.length) {\n            zdjl.alert(\"为了保证服务器上的每个版本都是完整快照，本次上传已停止。\\n\\n缺少：\\n\" + missing.join(\"\\n\"), {title:\"缺少脚本文件\"});\n            return;\n        }\n        var note = zdjl.prompt(\"版本说明（可留空）\", \"\");\n        if (note == null) return;\n        var title = channel === \"test\" ? \"上传为测试版\" : \"上传并发布正式版\";\n        if (!zdjl.confirm(\"将上传 \" + files.length + \" 个文件。\\n频道：\" + (channel === \"test\" ? \"测试版\" : \"正式版\") + \"\\n\\n只有全部文件上传并校验完成后，服务器才会切换最新版。\", {title:title})) return;\n        var start = request(c, \"POST\", \"/api/scripts/upload/start\", {expectedFiles:names, channel:channel, note:String(note || \"\")}, true);\n        for (i = 0; i < files.length; i++) {\n            zdjl.toast(\"上传 \" + (i+1) + \"/\" + files.length + \"：\" + files[i].name, 3000);\n            var ack = request(c, \"POST\", \"/api/scripts/upload/file\", {uploadId:start.uploadId, name:files[i].name, content:files[i].content}, true);\n            if (ack.sha256 !== files[i].sha256) throw new Error(files[i].name + \" 上传后服务器哈希不一致\");\n        }\n        var done = request(c, \"POST\", \"/api/scripts/upload/commit\", {uploadId:start.uploadId}, true);\n        if (!done.manifest) throw new Error(\"服务器提交版本失败\");\n        saveJsonStorage(BASELINE_KEY, {version:done.version, hashes:(function(){var x={},j;for(j=0;j<done.manifest.files.length;j++)x[done.manifest.files[j].name]=done.manifest.files[j].sha256;return x;})(), savedAt:Date.now()});\n        zdjl.alert(\"版本：\" + done.version + \"\\n文件：\" + files.length + \" 个\\n频道：\" + (channel === \"test\" ? \"测试版\" : \"正式版\") + \"\\n\\n服务器只有在完整上传成功后才切换指针。\", {title:\"上传发布完成\"});\n    }\n    function historyDownload(c) {\n        var r = request(c, \"GET\", \"/api/scripts/history?limit=30\", null, false), items = r.items || [], labels = [], i, it;\n        if (!items.length) { zdjl.alert(\"服务器还没有历史版本\", {title:\"历史版本\"}); return; }\n        for (i = 0; i < items.length; i++) {\n            it = items[i];\n            labels.push((it.isStable ? \"[正式] \" : it.isTest ? \"[测试] \" : \"\") + it.version + (it.note ? \"｜\" + it.note : \"\"));\n        }\n        var sel = zdjl.select({title:\"选择历史版本\", items:labels});\n        if (!sel || sel.result == null || sel.result < 0) return;\n        var manifest = fetchVersion(c, items[sel.result].version);\n        downloadManifest(c, manifest, \"select\");\n    }\n    function restoreLastBackup(c) {\n        var path = zdjl.getStorage(LAST_BACKUP_KEY, SCOPE);\n        if (!path) { zdjl.alert(\"没有记录到更新前备份\", {title:\"恢复备份\"}); return; }\n        var raw = readText(path), obj, i, item, errors = [];\n        if (!raw) { zdjl.alert(\"备份文件不存在：\\n\" + path, {title:\"恢复失败\"}); return; }\n        try { obj = JSON.parse(raw); } catch (e) { zdjl.alert(\"备份JSON损坏\", {title:\"恢复失败\"}); return; }\n        if (!obj.items || !obj.items.length) { zdjl.alert(\"备份中没有脚本\", {title:\"恢复失败\"}); return; }\n        if (!zdjl.confirm(\"将把 \" + obj.items.length + \" 个文件恢复到：\\n\" + c.baseDir + \"\\n\\n备份：\\n\" + path, {title:\"确认恢复\"})) return;\n        for (i = 0; i < obj.items.length; i++) {\n            item = obj.items[i];\n            try {\n                if (sha256(item.content || \"\") !== item.sha256) throw new Error(\"备份内容校验失败\");\n                writeText(c.baseDir + item.name, item.content);\n                if (sha256(readText(c.baseDir + item.name) || \"\") !== item.sha256) throw new Error(\"恢复后校验失败\");\n            } catch (e2) { errors.push(item.name + \"：\" + e2.message); }\n        }\n        if (errors.length) zdjl.alert(errors.join(\"\\n\"), {title:\"部分恢复失败\"});\n        else {\n            saveJsonStorage(BASELINE_KEY, {version:\"restored-backup\", hashes:{}, savedAt:Date.now()});\n            zdjl.alert(\"已恢复 \" + obj.items.length + \" 个文件\", {title:\"恢复完成\"});\n        }\n    }\n    function promoteTest(c) {\n        c = ensureAdmin(c); if (!c) return;\n        var test = getLatest(c, \"test\");\n        if (!zdjl.confirm(\"测试版：\" + test.version + \"\\n\" + (test.note || \"\") + \"\\n\\n设为正式最新版？\", {title:\"发布测试版\"})) return;\n        var r = request(c, \"POST\", \"/api/scripts/promote\", {version:test.version}, true);\n        zdjl.alert(\"正式版已切换到：\\n\" + r.stable, {title:\"发布完成\"});\n    }\n\n    try {\n        var c = loadConfig();\n        if (!c.server || !c.token) {\n            c = configure(c);\n            if (!c) return;\n        }\n        var menu = [\n            \"检查正式版更新\",\n            \"下载正式最新版（仅变化文件）\",\n            \"自选下载正式最新版\",\n            \"上传当前脚本并发布正式版\",\n            \"上传当前脚本为测试版\",\n            \"下载测试版（自选文件）\",\n            \"历史版本下载\",\n            \"恢复上一次更新前备份\",\n            \"把测试版设为正式版\",\n            \"设置服务器 / 密钥 / 脚本目录\"\n        ];\n        var sel = zdjl.select({title:\"农场脚本云更新 V1\", items:menu});\n        if (!sel || sel.result == null || sel.result < 0) return;\n        if (sel.result === 0) downloadManifest(c, getLatest(c, \"stable\"), \"check\");\n        else if (sel.result === 1) downloadManifest(c, getLatest(c, \"stable\"), \"all\");\n        else if (sel.result === 2) downloadManifest(c, getLatest(c, \"stable\"), \"select\");\n        else if (sel.result === 3) uploadCurrent(c, \"stable\");\n        else if (sel.result === 4) uploadCurrent(c, \"test\");\n        else if (sel.result === 5) downloadManifest(c, getLatest(c, \"test\"), \"select\");\n        else if (sel.result === 6) historyDownload(c);\n        else if (sel.result === 7) restoreLastBackup(c);\n        else if (sel.result === 8) promoteTest(c);\n        else if (sel.result === 9) configure(c);\n    } catch (e) {\n        zdjl.alert(String(e && e.message ? e.message : e), {title:\"脚本更新器出错\"});\n    }\n})();\n"}

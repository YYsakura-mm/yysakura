{"repeatCount":1,"pauseOnFail":false,"count":1,"minVerCode":2026000,"minVerName":"2.26.0","screenWidth":720,"screenHeight":1280,"screenDpi":2.0,"lastSaveScreenWidth":720,"lastSaveScreenHeight":1280,"lastSaveScreenDpi":2.0,"savedVerCode":26000050,"savedVerName":"26.5.0","delay":"0","delayUnit":1,"description":"记录报错｜一次调用=一次小失败｜同脚本相邻两步失败=一次大失败并立即写TXT"}
{"type":"运行JS代码","delay":"0","delayUnit":1,"repeatCount":1,"desc":"记录一次小失败；相邻两步连续失败时立即记录大失败TXT","jsCode":"function G(k,d){\n    try{\n        var v=zdjl.getVar(k,\"global\");\n        return (v===undefined || v===null || v===\"\") ? d : v;\n    }catch(e){ return d; }\n}\nfunction S(k,v){ try{ zdjl.setVar(k,v,\"global\"); }catch(e){} }\nfunction T(){\n    var d=new Date(), p=function(n){return n<10?\"0\"+n:String(n);};\n    return d.getFullYear()+\"-\"+p(d.getMonth()+1)+\"-\"+p(d.getDate())+\" \"+p(d.getHours())+\":\"+p(d.getMinutes())+\":\"+p(d.getSeconds());\n}\nfunction stepNum(v){\n    var m=String(v||\"\").match(/(\\d+)/);\n    return m ? Number(m[1]) : 0;\n}\n\n/*\n  最省事的调用方式：\n  调用前只设置一个全局字符串：\n  容错报错标签 = \"脚本名|步骤号|动作名\"\n  例如：\n  退出农场.zjs|2|返回大厅\n\n  可选第4段作为原因：\n  退出农场.zjs|2|返回大厅|A点击5次后仍未消失\n*/\nvar tag=String(G(\"容错报错标签\",\"\"));\nvar p=tag.split(\"|\");\n\nvar curScript=String(p[0] || G(\"容错当前脚本\",\"未标注脚本\"));\nvar curStep=String(p[1] || G(\"容错当前步骤\",\"未标注步骤\"));\nvar curAction=String(p[2] || G(\"容错当前动作\",\"未标注动作\"));\nvar curReason=String(p[3] || G(\"容错当前原因\",\"可靠点击耗尽后仍失败\"));\n\nvar small=Number(G(\"容错小失败次数\",0))||0;\nvar big=Number(G(\"容错大失败次数\",0))||0;\n\nvar prevScript=String(G(\"容错上次失败脚本\",\"\"));\nvar prevStep=String(G(\"容错上次失败步骤\",\"\"));\nvar prevAction=String(G(\"容错上次失败动作\",\"\"));\nvar prevReason=String(G(\"容错上次失败原因\",\"\"));\n\nvar chainRecorded=String(G(\"容错大失败链已记录\",\"否\"));\n\nsmall++;\n\nvar curN=stepNum(curStep);\nvar prevN=stepNum(prevStep);\n\n/*\n  不要求每个成功动作再额外“清零”。\n  只看本次失败是否刚好紧挨上一次失败：\n  同一脚本，并且步骤号 = 上次失败步骤 + 1。\n*/\nvar consecutive=(\n    curScript===prevScript &&\n    curN>0 &&\n    prevN>0 &&\n    curN===prevN+1\n);\n\nif(!consecutive){\n    chainRecorded=\"否\";\n}\n\nvar account=String(G(\"HUD当前账号\",\"\"));\nif(!account || account==\"?\") account=String(G(\"临时账号名称\",\"\"));\nif(!account) account=\"账号\"+String(G(\"当前第几个号\",\"?\"));\n\nvar area=String(G(\"当前区\",\"?\"))+\"/\"+String(G(\"总数区\",\"?\"));\nvar task=String(G(\"做啥\",\"?\"));\nvar logPath=\"/sdcard/Download/农场异常记录.txt\";\n\nif(consecutive){\n    if(chainRecorded!=\"是\"){\n        big++;\n        chainRecorded=\"是\";\n\n        var block=\n            \"\\n══════════════════════════\\n\"+\n            \"时间：\"+T()+\"\\n\"+\n            \"大失败：#\"+big+\"\\n\"+\n            \"账号：\"+account+\"\\n\"+\n            \"区：\"+area+\"\\n\"+\n            \"任务：\"+task+\"\\n\"+\n            \"\\n【前一个小失败】\\n\"+\n            \"脚本：\"+prevScript+\"\\n\"+\n            \"步骤：\"+prevStep+\"\\n\"+\n            \"动作：\"+prevAction+\"\\n\"+\n            \"原因：\"+prevReason+\"\\n\"+\n            \"\\n【当前小失败】\\n\"+\n            \"脚本：\"+curScript+\"\\n\"+\n            \"步骤：\"+curStep+\"\\n\"+\n            \"动作：\"+curAction+\"\\n\"+\n            \"原因：\"+curReason+\"\\n\"+\n            \"══════════════════════════\\n\";\n\n        try{ zdjl.appendFile(logPath,block); }catch(e){}\n    }else{\n        var more=\n            \"\\n【同一大失败继续】\\n\"+\n            \"时间：\"+T()+\"\\n\"+\n            \"脚本：\"+curScript+\"\\n\"+\n            \"步骤：\"+curStep+\"\\n\"+\n            \"动作：\"+curAction+\"\\n\"+\n            \"原因：\"+curReason+\"\\n\";\n\n        try{ zdjl.appendFile(logPath,more); }catch(e){}\n    }\n}\n\nS(\"容错小失败次数\",small);\nS(\"容错大失败次数\",big);\nS(\"容错大失败链已记录\",chainRecorded);\n\nS(\"容错上次失败脚本\",curScript);\nS(\"容错上次失败步骤\",curStep);\nS(\"容错上次失败动作\",curAction);\nS(\"容错上次失败原因\",curReason);\n\nS(\"容错通知文本\",\"小失败 \"+small+\"｜大失败 \"+big);\n\n/* 防止下一处忘记改标签时误用旧标签 */\nS(\"容错报错标签\",\"\");\n"}

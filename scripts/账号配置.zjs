{"type":"运行JS代码","delay":"0","delayUnit":1,"desc":"校验并永久保存账号配置","jsCode":"配置结果=\"失败\";\nvar names=String(账号名称表||\"\").trim().split(/[，,、;；]+/);\nvar cs=String(账号区数表||\"\").trim().split(/[\\s,，、;；]+/);\n\nif(names.length==8 && cs.length==8){\n    var ok=true;\n    for(var i=0;i<8;i++){\n        names[i]=String(names[i]||\"\").trim();\n        cs[i]=Number(cs[i]);\n        if(!names[i] || !(cs[i]>=1 && cs[i]<=36)) ok=false;\n    }\n\n    var skip=0;\n    var ss=String(跳11账号||\"\").trim();\n    if(ss && ss!=\"无\" && ss!=\"不跳\"){\n        var m=ss.match(/^(?:账号)?([1-8])(?:号)?$/);\n        if(m){\n            skip=Number(m[1]);\n        }else{\n            for(var j=0;j<8;j++){\n                if(ss==names[j]) skip=j+1;\n            }\n            if(skip==0) ok=false;\n        }\n    }\n\n    if(ok){\n        try{\n            zdjl.writeFile(\"/sdcard/Download/农场8账号配置.json\", JSON.stringify({version:1,names:names,counts:cs,skip:skip}));\n            配置结果=\"成功\";\n        }catch(e){\n            配置结果=\"失败\";\n        }\n    }\n}","scriptCallbacks":{"afterExecSuc":{"type":"系统提示","delay":"0","delayUnit":1,"condition":{"type":"jsExpression","expression":"配置结果==\"成功\"","desc":""},"desc":"配置保存成功","promptType":"toast","promptText":"账号配置已保存，以后主脚本会自动读取","promptTitle":"","showPosition":"bottom","playAudio":"false","useVibrator":"false"}}}

{"repeatCount":1,"pauseOnFail":false,"count":2,"minVerCode":2026000,"minVerName":"2.26.0","screenWidth":720,"screenHeight":1280,"screenDpi":2,"lastSaveScreenWidth":1280,"lastSaveScreenHeight":720,"lastSaveScreenDpi":2,"savedVerCode":26000050,"savedVerName":"26.5.0","delay":"0","delayUnit":1,"description":"V58｜每个账号的总区数和任意跳过区号独立设置；默认9077安卓16区跳过14；每180分钟安全维护诊断日志"}
{"type":"设置变量","delay":"0","delayUnit":1,"desc":"只修改选中的一个账号；跳过区号可填14或11,14；不跳填写0","vars":[{"name":"要设置的账号","value":{"varType":"string","varScope":"script","showInput":true,"mustInput":true,"rememberInputValue":true,"showInputWidthBasis":"auto","showInputContentAlign":"left","value":"9077安卓","stringItems":["9077安卓","账号1","账号2","账号3","账号4","账号5","账号6","账号7","账号8"]}},{"name":"总区数","value":{"varType":"string","varScope":"script","showInput":true,"mustInput":true,"rememberInputValue":true,"showInputWidthBasis":"auto","showInputContentAlign":"left","value":"16"}},{"name":"跳过区号","value":{"varType":"string","varScope":"script","showInput":true,"mustInput":true,"rememberInputValue":true,"showInputWidthBasis":"auto","showInputContentAlign":"left","value":"14"}},{"name":"跳过的区是否出现在选区列表","value":{"varType":"string","varScope":"script","showInput":true,"mustInput":true,"rememberInputValue":true,"showInputWidthBasis":"auto","showInputContentAlign":"left","value":"不显示","stringItems":["不显示","仍显示"]}},{"name":"日志维护间隔分钟","value":{"varType":"string","varScope":"script","showInput":true,"mustInput":true,"rememberInputValue":true,"showInputWidthBasis":"auto","showInputContentAlign":"left","value":"180"}}],"dialogTitle":"#MD\n<font color=#64B5F6 size=4>账号总区数／跳区设置 V58</font>\n只修改选中的账号，其它账号保持原样。","dialogOKText":"保存设置","dialogCancelText":"取消"}
{"type":"运行JS代码","delay":"0","delayUnit":1,"repeatCount":1,"desc":"保存当前账号跳区参数到Download/农场跳区配置.json，并读回确认","jsCode":"(function(){\n var name=String(要设置的账号||'').trim(),count=Number(String(总区数||'').trim());\n var skipText=String(跳过区号||'').trim(),missing=String(跳过的区是否出现在选区列表||'')==='不显示';\n var mins=Number(String(日志维护间隔分钟||'').trim());\n if(!/^(9077安卓|账号[1-8])$/.test(name)){zdjl.alert('请选择有效账号');return;}\n if(!(count>=1&&count<=36&&Math.floor(count)===count)){zdjl.alert('总区数请填1～36的整数');return;}\n if(!(mins>=0&&mins<=10080&&Math.floor(mins)===mins)){zdjl.alert('日志维护分钟数应为0～10080；填0为关闭');return;}\n var arr=[],parts=skipText?skipText.split(/[，,、;；\\s]+/):['0'];\n for(var i=0;i<parts.length;i++){\n  if(!parts[i])continue;\n  var n=Number(parts[i]);\n  if(!(n>=0&&n<=count&&Math.floor(n)===n)){zdjl.alert('跳过区号有误：'+parts[i]);return;}\n  if(n>0&&arr.indexOf(n)<0)arr.push(n);\n }\n if(arr.length>=count){zdjl.alert('不能跳过全部区');return;}\n arr.sort(function(a,b){return a-b;});\n var P='/sdcard/Download/农场跳区配置.json',data={version:2,rules:{},maintenanceMinutes:180};\n try{var old=String(zdjl.readFile(P)||'');if(old){var x=JSON.parse(old);if(x&&x.version===2){data=x;if(!data.rules)data.rules={};}}}catch(e){}\n data.rules[name]={total:count,skip:arr,missing:missing};\n data.maintenanceMinutes=mins;\n try{\n  var t=JSON.stringify(data);zdjl.writeFile(P,t);\n  if(String(zdjl.readFile(P)||'')!==t)throw Error('写入校验不一致');\n  zdjl.alert('保存成功：'+name+'，总数'+count+'区，跳过'+(arr.join('、')||'无')+'，列表'+(missing?'缺位':'仍显示')+'。日志维护每'+mins+'分钟（0为关闭）。');\n }catch(e){zdjl.alert('保存失败：'+String(e));}\n})();"}

{"type":"运行JS代码","delay":"0","delayUnit":1,"repeatCount":1,"desc":"按本轮绑定的Android用户实例重启王者｜v1.5请求重试","jsCode":"var __task=\"\";\ntry{__task=String(zdjl.getVar(\"王者绑定任务ID\",\"global\")||\"\");}catch(e){}\nif(!__task){\n    try{zdjl.runAction({\"type\":\"系统提示\",\"delay\":\"0\",\"delayUnit\":1,\"repeatCount\":1,\"promptType\":\"notification\",\"promptTitle\":\"王者重启失败\",\"promptText\":\"没有本轮王者绑定ID，已取消重启，避免误开主王者。\",\"showPosition\":\"default\",\"playAudio\":\"false\",\"useVibrator\":false});}catch(e2){}\n    try{zdjl.runAction({\"type\":\"控制执行\",\"delay\":\"0\",\"delayUnit\":1,\"controlRunType\":\"stop\",\"jumpToPosition\":\"\",\"ContinueParentExecute\":false});}catch(e3){}\n    throw new Error(\"没有本轮王者绑定ID\");\n}\nvar __token=__task+\"-\"+Date.now();\nvar __req=\"/sdcard/Download/王者重启请求.txt\";\nvar __result=\"/sdcard/Download/王者重启结果.txt\";\nvar __attempt=0,__lastWrite=0;\nfunction __writeRestartRequest(){\n    __attempt++;\n    __lastWrite=Date.now();\n    try{\n        zdjl.writeFile(__req,\n            \"task=\"+__task+\"\\n\"+\n            \"token=\"+__token+\"\\n\"+\n            \"request_epoch=\"+Date.now()+\"\\n\"+\n            \"attempt=\"+__attempt+\"\\n\"\n        );\n        return true;\n    }catch(__werr){return false;}\n}\n__writeRestartRequest();\nvar __deadline=Date.now()+22000;\nvar __txt=\"\";\nvar __ok=false;\nwhile(Date.now()<__deadline){\n    try{__txt=String(zdjl.readFile(__result)||\"\");}catch(__rerr){__txt=\"\";}\n    if(__txt.indexOf(\"token=\"+__token+\"\\n\")>=0){\n        __ok=(__txt.indexOf(\"status=ok\")>=0);\n        break;\n    }\n    if(Date.now()-__lastWrite>=2500) __writeRestartRequest();\n    zdjl.sleep(500);\n}\nif(!__ok){\n    var __reason=\"守护无响应或重启失败\";\n    var __m=/(?:^|\\n)reason=([^\\r\\n]*)/.exec(__txt);\n    if(__m) __reason=String(__m[1]||__reason);\n    try{zdjl.runAction({\"type\":\"系统提示\",\"delay\":\"0\",\"delayUnit\":1,\"repeatCount\":1,\"promptType\":\"notification\",\"promptTitle\":\"王者重启失败\",\"promptText\":\"已取消后续重启点击，避免打开错误实例。原因：\"+__reason+\"｜请求重发\"+__attempt+\"次\",\"showPosition\":\"default\",\"playAudio\":\"false\",\"useVibrator\":false});}catch(__nerr){}\n    try{zdjl.runAction({\"type\":\"控制执行\",\"delay\":\"0\",\"delayUnit\":1,\"controlRunType\":\"stop\",\"jumpToPosition\":\"\",\"ContinueParentExecute\":false});}catch(__serr){}\n    throw new Error(\"王者实例重启失败：\"+__reason);\n}\n"}
